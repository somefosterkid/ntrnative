<?xml version="1.0" encoding="utf-8"?>
<!-- Auto Backup and device-to-device transfer for Android 12 and newer (android:dataExtractionRules): the same files as backup_rules.xml. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="external" path="save.bin" />
        <include domain="external" path="sim_config.ini" />
        <include domain="external" path="Pokemon Black/save.bin" />
        <include domain="external" path="Pokemon Black/sim_config.ini" />
        <include domain="external" path="launcher.ini" />
    </cloud-backup>
    <device-transfer>
        <include domain="external" path="save.bin" />
        <include domain="external" path="sim_config.ini" />
        <include domain="external" path="Pokemon Black/save.bin" />
        <include domain="external" path="Pokemon Black/sim_config.ini" />
        <include domain="external" path="launcher.ini" />
    </device-transfer>
</data-extraction-rules>

-        void *memory = OS_AllocFromArenaLo(OS_ARENA_MAIN, defs[i].size, 4);
+        void *memory = OS_AllocFromArenaLo(OS_ARENA_MAIN, HEAP_AREA_SIZE(defs[i].size), 4);
 
         if (memory != NULL) {
-            sHeapMgr.heaps[i].handle = NNS_FndCreateExpHeapEx(memory, defs[i].size, 0);
+            sHeapMgr.heaps[i].handle = NNS_FndCreateExpHeapEx(memory, HEAP_AREA_SIZE(defs[i].size), 0);
             sHeapMgr.indices[i] = i;
         } else {

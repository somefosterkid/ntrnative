+// bw-port: Run speed (the port's RunSpeed setting; docs/speed-options.md "Platinum and HeartGold/SoulSilver"). The run action is
+// 4 px a frame for 4 frames with the run animation; for the player's own object it is 8 px for 2 frames at 2x and 16 px for 1 at
+// 4x (the new movement actions this would otherwise need are this one action with its own numbers: only the player's object,
+// local id 0xFF, takes them; an NPC's run is the game's). The 1-frame step starts and ends in one update, so it is noted
+// (PortSpeed4_NoteStep1F): player_move.c PlayerAvatar_UpdatePlayerMoveState reports its end and map_object.c sub_02062A14 keeps
+// its run animation for the frame. At the default setting it is exactly the game's run.
+int PortSpeed4_RunSteps(void);
+void PortSpeed4_NoteStep1F(void *mapObj, u32 anim);
+
+static void PortSpeed4_InitRun(MapObject *mapObj, int dir)
+{
+    int steps = PortSpeed4_RunSteps();
+
+    if (steps != 0 && MapObject_GetLocalID(mapObj) == 0xFF) {
+        MovementAction_InitWalk(mapObj, dir, FX32_CONST(4) << steps, 4 >> steps, MAP_OBJ_UNK_A0_09);
+        if ((4 >> steps) == 1) {
+            PortSpeed4_NoteStep1F(mapObj, MAP_OBJ_UNK_A0_09);   // 4x: its end and its animation
+        }
+    } else {
+        MovementAction_InitWalk(mapObj, dir, FX32_CONST(4), 4, MAP_OBJ_UNK_A0_09);
+    }
+}

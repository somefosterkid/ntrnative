+// bw-port: Walk speed and Surf speed (the port's settings; docs/speed-options.md "Platinum and HeartGold/SoulSilver"). The
+// player's own step pick swaps the game's walk (WALK_NORMAL, 8 frames a tile) for the next faster action (2x: WALK_FAST,
+// 4 frames) or the one after (4x: WALK_FASTER, 2) and Surf (WALK_FAST) for WALK_FASTER (2x and 4x: WALK_FASTEST's 1-frame step
+// breaks a step's end logic, the Surf legs ver58 and ver62 stop with it); the
+// action speed follows, which the following object reads. Only the overworld's step pick below calls them: NPCs, scripts, the
+// bike, water, grass, running, jumps and the distortion world keep the game's actions. At the default setting both return the
+// game's action and speed unchanged (port/game/speed_gen4.c).
+int PortSpeed4_WalkSteps(void);
+int PortSpeed4_SurfSteps(void);
+
+static enum MovementAction PortSpeed4_WalkAction(enum MovementAction movementAction, int *speed)
+{
+    if (movementAction == MOVEMENT_ACTION_WALK_NORMAL_NORTH) {
+        switch (PortSpeed4_WalkSteps()) {
+        case 1:
+            *speed = PLAYER_ACTION_SPEED_FAST;
+            return MOVEMENT_ACTION_WALK_FAST_NORTH;
+        case 2:
+            *speed = PLAYER_ACTION_SPEED_FASTER;
+            return MOVEMENT_ACTION_WALK_FASTER_NORTH;
+        }
+    }
+
+    return movementAction;
+}
+
+// The run's action speed: FASTER (a following object then walks WALK_FASTER) at a faster Run speed (unk_020655F4.c's run action).
+int PortSpeed4_RunSteps(void);
+
+static int PortSpeed4_RunActionSpeed(int speed)
+{
+    return PortSpeed4_RunSteps() != 0 ? PLAYER_ACTION_SPEED_FASTER : speed;
+}
+
+static enum MovementAction PortSpeed4_SurfAction(enum MovementAction movementAction, int *speed)
+{
+    switch (PortSpeed4_SurfSteps()) {
+    case 1:
+        *speed = PLAYER_ACTION_SPEED_FASTER;
+        return MOVEMENT_ACTION_WALK_FASTER_NORTH;
+    }
+
+    return movementAction;
+}

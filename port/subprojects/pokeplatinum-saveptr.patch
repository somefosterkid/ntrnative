+    int v3 = MapObject_GetZ(followed);
+    int v4 = MapObject_GetXPrev(followed);
+    int v5 = MapObject_GetZPrev(followed);
     int v6;
 
@@ -526,5 +527,5 @@
 {
     UnkStruct_0206A0BC *v0 = sub_02062A78(mapObj);
-    v0->unk_04 = param1;
+    v0->unk_04 = PortPlat_DsAddr(param1);

+// PC port (port/subprojects/pokeheartgold-zversion.patch): one build runs both versions. The version is the value
+// gGameVersion (pm_version.c), set from the ROM's game code before the game starts, not a define: every site that pret
+// chooses with HEARTGOLD / SOULSILVER reads it when it runs. (HEARTGOLD stays defined for what the patch leaves alone: asm data.)
+extern unsigned char gGameVersion;
+#define GAME_VERSION     gGameVersion
+#define GAME_IS_HEARTGOLD (gGameVersion == VERSION_HEARTGOLD)
+#elif defined(HEARTGOLD)
 #define GAME_VERSION VERSION_HEARTGOLD

pokebw2-dsprot.patch (tools/pokebw2_fetch.sh, the maintainers' notes): DS Protect's callers checksum the first 37 words of the
function they are about to call (DSProt_CallRunChecks1 to 4, overlay 165's DSProt_CallRunChecks) and call the tamper
function instead when the sum is not the ROM code's. On the PC those functions are the port's stand-ins
(port/src/stub_b2w2.c: a genuine cartridge, as Black's port/src/stub_dsprot.c), not ARM code, so under SDK_PORT the
check passes (DSPROT_CODE_OK); otherwise every anti-piracy hook would fire (the random numbers skipping two more each
frame, the party list's crash).

diff --git a/lib/dsprot/include/dsprot/dsprot.h b/lib/dsprot/include/dsprot/dsprot.h
index 9ca1be32d..d748bae0d 100644
--- a/lib/dsprot/include/dsprot/dsprot.h
+++ b/lib/dsprot/include/dsprot/dsprot.h
@@ -10,6 +10,14 @@
 
 #define DSPROT_CHECKSUM 0x9f75a8d6
 
+// Whether a DS Protect function's code checksum says its code is unchanged. On the PC its code is the port's
+// stand-in's, not the ROM's ARM code (port/src/stub_b2w2.c), so the check passes as on a genuine cartridge
+#ifdef SDK_PORT
+#define DSPROT_CODE_OK(checksum) ((void)(checksum), TRUE)
+#else
+#define DSPROT_CODE_OK(checksum) ((checksum) == DSPROT_CHECKSUM)
+#endif
+
 typedef void *(*DSProtCallback)(void *arg0, void *arg1);
 
 extern u32 data_ov337_02182440;
@@ -33,7 +41,7 @@ extern DSProtCallback data_ov337_02182444[2];
             checksum ^= (*code >> i) | (*code << (32 - i));                                                            \
             code++;                                                                                                    \
         }                                                                                                              \
-        if (checksum == DSPROT_CHECKSUM) {                                                                             \
+        if (DSPROT_CODE_OK(checksum)) {                                                                             \
             func(arg0, arg1);                                                                                          \
         } else {                                                                                                       \
             data_ov337_02182444[tamperIndex](arg0, arg1);                                                              \
@@ -51,7 +59,7 @@ extern DSProtCallback data_ov337_02182444[2];
             checksum ^= (*code >> i) | (*code << (32 - i));                                                            \
             code++;                                                                                                    \
         }                                                                                                              \
-        if (checksum == DSPROT_CHECKSUM) {                                                                             \
+        if (DSPROT_CODE_OK(checksum)) {                                                                             \
             ret = func(callback, arg0, arg1);                                                                          \
         } else {                                                                                                       \
             ret = tamper(NULL, NULL);                                                                                  \

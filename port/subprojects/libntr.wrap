[wrap-git]
# libntr (MIT): NitroSDK/TwlSDK for PC. The commit docs/libntr/compile.md and coverage.md measured.
url = https://github.com/cybervisi0n/libntr.git
revision = f6b3a690c72b1484fda86c47021dbda2b54ffb69
depth = 1
# packagefiles: libntr-clang.patch (what clang refuses and gcc folds), libntr-sdk-gaps.patch (SVC_GetCRC16, the fx
# matrices, FSi_InitOverlay, PM answers on PC), libntr-port-runtime.patch (FS on host files, save.bin),
# libntr-x86-parameter-buf.patch (the TWL parameter buffer, an NTR game's extra heap, in the simulated main memory),
# libntr-hw.patch (the DS's VRAM and registers as libntr's host memory: the sub OBJ VRAM's size, a direct-colour
# bitmap BG's pixels as colours, the geometry FIFO's matrix sends as simulator commands and MI_CpuSend32 to one port,
# not copies over the registers after the FIFO), libntr-boot.patch (G3X_GetVectorMtx; docs/port-boot.md),
# libntr-vram.patch (the VRAM banks: a bank's data moves between s_HW_LCDC_VRAM and the BG/OBJ arrays when VRAMCNT
# maps it elsewhere; docs/port-runtime.md), libntr-snd.patch (the sound commands run with SDL's audio callback locked
# out: the sequencer runs there; the invalidations and parameters libntr's ARM7 dropped), libntr-vcount.patch (the
# V-count runs from the V-blank with the time, as the DS's lines: it was always 0; docs/port-boot.md),
# libntr-3dswap.patch (the 3D layer shows the frame of the last G3_SwapBuffers until the next, as the DS's), libntr-vblankcount.patch (OS_GetVBlankCount reads the word the simulator counts in:
# the TWL header's inline read past main memory, always 0; docs/port-build.md Keys)
# libntr-3dswap.patch (the 3D layer shows the frame of the last G3_SwapBuffers until the next, as the DS's), libntr-hwaddr.patch (the TWL headers' raw DS addresses for the system words, past the 8 MB main memory, point where the simulator keeps them; docs/port-runtime.md)
# libntr-3dswap.patch (the 3D layer shows the frame of the last G3_SwapBuffers until the next, as the DS's),
# libntr-g3regs.patch (TEXCOORD and NORMAL written as registers reach the 3D: mcss.c's sprite quads)
# libntr-3dswap.patch (the 3D layer shows the frame of the last G3_SwapBuffers until the next, as the DS's),
# libntr-capture.patch (the display capture, DISPCAPCNT, into a VRAM bank; the main engine's VRAM display mode;
# bitmap OBJ colours)
# libntr-3dswap.patch (the 3D layer shows the frame of the last G3_SwapBuffers until the next, as the DS's), libntr-pacing.patch (the frame cap after the swap, swap interval 0 under it, timeBeginPeriod(1); BWPORT_FPSLOG)
# libntr-gxasync.patch (MI_SendGXCommandAsync(Fast) on PC: the list sent at once and the callback run then; it never
# ran, so NitroSystem's display-list flag stayed set and its command buffer took every later command: docs/port-boot.md stop 20)
# libntr-fogview.patch (the fog shader blends from the lower table entry to the upper; G3_ViewPort honoured; the 3D frame cleared to G3X_SetClearColor's colour, alpha and depth)
# libntr-waitintr.patch (OS_WaitInterrupt draws the frame for a V-blank, as OS_WaitIrq does: nothing else drew one, so
# a wait for the V-blank there spun forever: the field's save hung in FldActSys_ForceFullSync; docs/port-boot.md stop 23)
# libntr-inputpanel.patch (the input panel beside the screens, F1 and a Config checkbox, ShowInputPanel in sim_config.ini; the frame budget line of the debug GUI)
# libntr-fxunion.patch (MtxFx33/43/44 unions list m[][] first: the decomp's nested {{{a,b,c},..}} initializers filled only _00, e.g. the title model's base rotation)
# libntr-waits.patch (the wait audit: OS_WaitIrq draws the frame for any flags with the V-blank, OS_WaitAnyIrq draws one, and PM's V-blank count spins (sleep mode, reset) draw the frame instead of spinning on a count only a frame advances)
# libntr-render2.patch (the 3D texture decoders take T rows of S pixels: a non-square texture was scrambled, Reshiram had no face; the debug window's fps from the real frame period)
# libntr-boxtest.patch (the box test's clipped vertices computed, not left as stack garbage: the field's chunk and prop
# culling answered at random, Nuvema Town's map vanished; the far plane rule from the polygon attributes latched at BEGIN)
# libntr-g3imm.patch (G3_LightVector/LightColor/End/ViewPort/BoxTest/PositionTest/VectorTest/Direct2/3 and G3_Shininess
# reach the simulator, not only the register variables; the list parser's SHININESS/POS_TEST/VEC_TEST parameters and
# VIEWPORT/SWAP_BUFFERS words; normals and light vectors decoded as two's complement (the low 8 bits, sign dropped, before),
# light vectors multiplied by the vector matrix at LIGHT_VECTOR, GBATEK's half-vector specular and shininess table, SPE_EMI
# bit 15 the table's enable; POS_TEST/VEC_TEST results)
# libntr-vcapture.patch (BWPORT_VCAPTURE=DIR,N,A-B,A-B/STEP: the frame-state capture for port/vcore, off unless set: the
# registers, VRAM banks A-I, palettes, OAM, the shown frame's 3D commands after a prologue that rebuilds the geometry
# engine's state, and libntr's picture, into DIR/fNNNNNN.vcs; the format: <ref>/VCS_FORMAT.md, tools/vcs_dump.py)
# libntr-vbridge.patch (the in-process frame renderer: port/vcore draws the screens when sim_config.ini Renderer=vcore,
# the default, or BWPORT_RENDERER=vcore; SIM_SetFrameRenderer, SIM_VCapGather fills its state each frame, the picture
# drawn as a texture with the screen quads; a Renderer combo in the Config window; port/bridge/vcore_bridge.c)
# libntr-acapture.patch (SIM_sndCaptureHook in sim7's PXI sound path: port/src/acapture.c, BWPORT_ACAPTURE=FILE.acs[,FRAMES]
# records the ARM9's sound command lists and wakeups as a .acs stream; docs/acore.md)
# libntr-acore.patch (sim_config.ini Sound=acore|libntr, BWPORT_SOUND overrides it: a sound backend the program registers
# (SIM_soundBackend, port/src/acore_glue.c + port/bridge/acore_bridge.c) renders the audio callback and takes the PXI
# sound commands instead of sim7's driver; docs/acore.md piece 18)
# libntr-wavout.patch (sim7 PXI: SETUP_CHANNEL_PCM / START_TIMER / STOP_TIMER start and stop wave-out channels (cries) and SNDi_SharedWork->channelStatus follows the channels; before, NNS_SndWaveOutIsPlaying was false one frame after a start and a cry wait lasted one frame)
# libntr-gpu.patch (Renderer=gpu and Scale=N in sim_config.ini and the Config window, BWPORT_RENDERER=gpu / BWPORT_GPU_SCALE; SIM_SetFrameRendererGL: port/gpu's bridge hands libntr a GL texture of the N x picture; SIM_GLGetProc, SIM_GLRendererScale; docs/gpu.md)
# libntr-soundclock.patch (the sound side's time follows the game's frames: SIM_Audio_FrameTick at the end of each frame
# in SIM_Render steps sim7's driver and channels or the program's backend (acore, SIM_SoundBackend.run) by 560190 ARM7
# cycles into a ring of DS-rate samples that the audio callback plays, resampled; SND_RecvCommandReply's wait steps the
# sound itself (SIM_Audio_WaitPump), the PXI thread is drained before each step (SIM_PxiDrain). BWPORT_SOUNDCLOCK=device
# goes back to the callback's real-time clock; BWPORT_AUDIOLOG=1 prints the ring each second; docs/acore.md "The time base")
# libntr-frameskip.patch (frame skip: sim_config.ini FrameSkip=0|1|2|3|auto, BWPORT_FRAMESKIP=N|auto, a Config window combo; SIM_Render decides each frame (SIM_FrameSkipDecide), the bridges ask SIM_FrameSkipping() and show the last picture again; SIGUSR2 / SIM_FrameForceDraw force the next frames drawn; capture frames are always drawn; the maintainers' notes "Frame skip")
# libntr-norender.patch (with a frame renderer drawing the screens, Renderer=vcore or gpu, libntr no longer rasterizes its own 3D: SIM_G3RasterOn in sim_main.cpp, G3SIM_FlushArray drops the batch before its texture decode/upload and GL draw, no shown-frame blit or clear, no 2D layer clears; libntr's raster stays on for Renderer=libntr, BWPORT_VCAPTURE, BWPORT_G3RASTER=1 and once the renderers fail a frame)
# libntr-glselect.patch (SIM_SetGLHooks: port/src/gl_select.c picks the GL library before the window is created (the system's, or a bundled Mesa) and reports it after; the LP_NUM_THREADS rule moved there; no context = a message, not a crash)
# libntr-onerender.patch (libntr's own renderer is gone: no 2D engines, 3D raster, capture/VRAM-display pass, GL textures or
# shaders (sim_g2.cpp, sim_g3_Texture*.cpp, sim_shaders.cpp are no longer built; g3_draw.cpp is no-op stubs). One setting
# each: Renderer=auto|vcore|gpu (auto: the GPU renderer when SIM_GLIsHardware, else vcore; old Renderer=libntr loads as auto)
# and Resolution=1..8 (default 1; the old Scale= loads as Resolution, InternalResolutionScale is ignored); SIM_RenderScale,
# SIM_RendererWanted/Active/Serial/Failed/Status/Picture, a status line (title, overlay, Config window), BWPORT_RESOLUTION,
# BWPORT_SWITCH_TEST=gpu:2,vcore:1,...[/FRAMES] (the live switch test); weak SIM_GLIsHardware/SIM_GLRendererName defaults)
# libntr-vscale.patch (SIM_SetFrameRendererSized: the software frame hook returns its pixels and size, so port/vcore can draw at N x; port/bridge/vcore_bridge.c)
# libntr-present.patch (integer scale, fullscreen keys, the touch rectangle from the view: sim_main.cpp, sim_config, sim_gui_config)
# libntr-sounddefault.patch (owner 10-29 "audio seems fine, lets go with ours"): Sound=acore when sim_config.ini has no Sound line
# libntr-aa70.patch (Antialiasing=off|2x|4x in sim_config.ini, BWPORT_AA, Video window/menu and Config rows: supersampling; SIM_AntialiasWanted, SIM_RendererAAUsed, the status line says a lowered k; switch test steps "gpu:2a4")
# libntr-aa74.patch (the look option rows (Dot, Line, Edge, Filter) follow Resolution only, not Resolution x Antialiasing: greyed at Resolution 1 whatever the Antialiasing; sim_gui.cpp)
# libntr-pf82.patch (the per-stage timing readout: the Metrics window's Breakdown section and Debug > Save performance log (perf_log.txt next to save.bin); SIM_PerfOn / SIM_PerfStage / SIM_PerfGpuTimers for the bridges; GL timer queries around the present and the UI; BWPORT_BREAKDOWN=1, BWPORT_PERFLOG=N; docs/perf.md)
# libntr-ios-settings.patch (iOS touch mode: the native settings sheet replaces the ImGui touch screen; SIM_UISettingGet/Set, the performance overlay, Overlay* in sim_config.ini; port/src/ios_settings.m)
# libntr-ios-pace.patch (the pacing audit, docs/perf.md 2026-11-01 'Settings combinations'): FrameSkip=N counts presented ticks (Game speed x frame skip froze the picture), auto skip's budget is the tick at the Game speed, fast forward presents at most 60 a second and draws only those ticks, a skipped vcore frame is not uploaded again, iOS: no swap-interval call; the overlay shows presents/s and the game's real speed; BWPORT_PACELOG, cfgscript speed/frameskip/smooth/ff/bench/restore/perftest, SIM_PerfTestStart (iOS Settings > About > Run performance test)
# libntr-ios-speedui.patch (the iOS speed model: Fast-forward speed 2x/3x/4x/Max (FastForwardSpeed, config ffSpeed; an old GameSpeed > 1 moves into it once and play is 1x), the frame rate automatic from Smooth motion, Frame skip one switch (skipslow), the fast-forward touch button a pill in the controls showing its speed and switching through the Game speed timeline (Max = the uncapped path); SIM_UISettingGet/Set ffspeed, skipslow)
# libntr-ios-input.patch (iOS responsiveness: the touch fingers are all forgotten when the settings sheet closes (each opening leaked one, ten made every button dead); the sheet's wait runs the run loop asleep between its events (bwport_ios_settings_run) instead of a pump every 10 ms; the input latency, finger to present, in the pace log, an "input:" line for slow presses and the overlay's Detailed mode; the run loop's turns in the pace log; Smooth motion turns itself off only when a second's ticks fall under 95% of the speed (one late tick, e.g. a present waiting into the next tick on the 120 Hz panel, kept it off for good on the phone); a second performance test start is ignored; the sheet code is iOS only (a desktop BWPORT_TOUCH run aborted in its weak symbols, which ld64 resolves to abort stubs))
# libntr-ios-inputprio.patch (iOS input ahead of the game: the touch layer takes each finger the moment SDL gets it (an SDL event filter on the main thread, inside UIKit's delivery), not at the next frame's event loop; on iOS the game's frame-time waits run the main run loop instead of sleeping, so UIKit delivers touches while the game waits (presents after a wait are skipped once the app is going to the background); the touch buttons are written to the pad registers again after the waits, so the tick that starts next sees them; the window's system gesture recognizers (the home indicator's edge gate) no longer delay touch ends; each release later than 50 ms logs 'input: release N ms late' with where it was held; cfgscript stall=MS; desktop: only the key script's fingers go through the main thread's queue on macOS)
# libntr-ios-lag.patch (the queue between drawing and the glass: a GL fence per present, polled with timeout 0 each frame and about every ms while the pacing sleeps; before a swap the frame two presents back must be GPU-done (at most two frames in flight; BWPORT_GPUQUEUE=N, 0 = no bound; BWPORT_GPUSLOW=N forces a slow GPU); presses and releases followed from the glass to the GPU done ('input: press|release shown N ms late (...)' over 100 ms, every one with BWPORT_LAGLOG); iOS: a model of the panel from the CADisplayLink (shown at the first refresh after GPU done, one picture a refresh) and presents dropped when two are already waiting for it (BWPORT_PRESENTDROP=0: never); the overlay's Detailed mode, the pace log and the bench / performance test table show GPU lag, frames in flight, shown lag and drops; cfgscript quit flushes BWPORT_PRESENTLOG)
# libntr-ios-panel.patch (presents follow the real panel: Frame rate=Monitor's slot length is the CADisplayLink's refresh period on iOS (SDL reports the screen's maximum, 120, whatever the panel runs at), rounded to whole Hz, so Smooth motion's in-between pictures stop at 60 Hz and the presents never outrun the glass; the slots are phase-locked to the link's refreshes (each present ~1 ms after one); BWPORT_PANELHZ=N pretends a panel rate on every platform; a log line when the rate changes)
# libntr-ios-ffpace.patch (fast-forward toggles leave pacing as it was: Smooth motion's backoff no longer judges ticks with no room for an in-between picture (the FF button's 4x) and restarts its second on a speed change; the panel model takes the earliest GPU-done time (the last busy poll), not a late poll, so it stops dropping presents the panel could show; a timeline restart keeps the slots on the display link's refreshes; BWPORT_PANELHZ=N on a desktop pretends a display link at N Hz (swaps stop waiting for the V-blank) so the iOS present path runs there for tests)
# libntr-ios-input2.patch (the controller: the first real one is opened, again when one is added or taken away (a pad that slept comes back), the phone's accelerometer is not a joystick (SDL_HINT_ACCELEROMETER_AS_JOYSTICK=0), iOS reads the SDL game controller in the desktop's layout; keyboard, controller and touch each keep their own held mask and the pad bits are the OR of them; a turn of the screen lets go of fingers on the buttons and D-pad; the setting hidetouch (HideTouchWithController, default on) hides the buttons and D-pad while a controller is connected, the menu and fast-forward buttons stay; BWPORT_VPAD drives a virtual pad for tests)
# libntr-ios-sound.patch (the ring's rate control: a PI controller on the low-passed fill, at most +-0.25 % fast and a slow integral up to +-3 % (was the raw fill x 6 %: a +-25 cent wobble at the frame rhythm, 85 cents sharp while full); a full ring skips pieces with a 128-frame cross-fade (was single frames: a buzz at Max); a dry ring fades out and restarts clean; SIM_Audio_Pause fades before SDL pauses (the settings sheet, the background); the device opened at its own rate (no second resampler in SDL); BWPORT_AUDIO_TONE / _MUTE / _SLOW and the lock time in BWPORT_AUDIOLOG for measuring)
# libntr-ios-appfix.patch (iOS app-layer fixes: sim_config.ini and save.bin written with the open and the write checked (temp file + rename), the perf test never saves its settings and ends when the sheet opens or the app leaves, the sheet's wait is one loop after a background trip, fast forward and fingers reset on background, the volume slider saves on release, rate-limited log lines)
# libntr-ios-render.patch (renderer glue: when the GPU path draws again after vcore drew a fallback frame, vcore's idle hook gives back its states and in-between pictures, and the cap loop asks vcore's bridge for an in-between only on a tick vcore drew: its stale one came back at empty slots; on iOS no in-between GL pass and no end-of-frame clear once the app is in the background)
# libntr-ios-pacefix.patch (frame pacing review fixes: a pause (the settings sheet, the background, cfgscript pause=MS) is not counted as a frame's work, so Auto frame skip no longer shows ~12 pictures a second for 1-2 s after it (the frame time is restamped after the wait, and one frame counts at most 4 present intervals); Auto skip's credit may hold a present interval (Game speed 2x-4x: 13-32 drawn/s at 4x, now ~59); SDL's 59/119/143 Hz are taken as the 1000/1001 rates (Windows truncates 59.94 to 59); desktop Monitor's in-between presents are called 1.5 ms before the slot as the tick's own; the iOS display link's rate is followed once it has held 0.5 s; Frame rate 120 on a display link below ~100 Hz runs as Monitor)
# libntr-ios-audiowait.patch (a game freeze in a sound command wait: the PXI queues (sim/queue.c) are read and written by different threads with no lock, and on ARM64 the PXI thread could see the new head before the slot's write, take the message as NULL and drop it: a sound list never reached the driver and SND_RecvCommandReply waited for ever at 100 % CPU. One spinlock for the queues, and a full queue is logged. The wait's safety net: after 64 ticks the sound steps once a millisecond, after 300 ms the wait logs 'audio: command reply wait timed out (...)' with the backend's state and the backend (waitStuck) counts one list finished when it holds none)
# libntr-android-gles.patch (Android: the iOS OpenGL ES 3.0 path (context, `#version 300 es` shaders, no glProgramUniform, full-screen window, main renamed SIM_main for port/src/android_main.c's SDL_main) under SIM_GLES = iOS or Android; the touch controls on; nothing changes elsewhere)
# libntr-android-settings.patch (Android: the touch layout's menu button opens the native settings dialog, SimTouchSettingsWait's Android branch: the game and its sound stand still while port/src/android_settings.c says it is open; nothing changes elsewhere)
# libntr-android-touch.patch (the touch controls in dp on Android: sim_touch.cpp lays out in points / dp and scales by the display density (bwport_android_density, BWPORT_TOUCH_SCALE=N pretends one on a desktop), the insets from the Java activity's WindowInsets (bwport_android_insets), narrow windows shrink the D-pad and diamond cells; the performance overlay scales; nothing changes where the unit is 1: iOS, macOS, Windows, Linux)
# libntr-android-diag.patch (Android: the overlay shows the renderer and the GL renderer string for the first 20 s)
# libntr-ios-smoothdrop.patch (Smooth motion gives up an in-between picture at a time, no longer all of them for 2-60 s: none on a tick that starts a quarter tick late, while the GPU has the presents' bound in flight, or after one whose CPU half or GPU work came late (1, 2, 4 ... 32 ticks, then one is tried); the in-between's GL half is flushed at once; the pace line, bench rows (behind/s gpu/s late/s none/s) and a 10 s log line say how many were not shown and why; the perf test gains a second 4-sample Smooth row and Resolution 5 with 4 samples)
# libntr-ios-passes.patch (the perf test measures the phone's GPU: Unlimited rows at Resolution 3 with AA off and 4 samples, and two rows with cfgscript passes=1, where the GPU path runs its GL half with glFinish after each pass and a "passes:" line after the row gives the CPU half (geometry, span records, 2D) and the GPU passes (uploads, R, E+P, compose) in ms a frame; the phone's GLES has no timer queries)
# libntr-ios-stuckinput.patch (the stuck-input checks, always on: 'anomaly:' lines when a release is lost or a source holds a button its device does not, a finger UIKit ended whose end the view did not get is let go at once, fingers checked against UIKit each frame, keyboard/controller masks against the devices (150 ms stale: let go); iOS 'stall:' lines for frames over 50 ms with their parts (BWPORT_STALLLOG elsewhere); docs/perf.md 'Stuck buttons')
# libntr-ios-smaa.patch (Antialiasing=SMAA, a third value: the GPU renderer at Resolution 2 and up, one sample per pixel and SMAA on its 3D layer; sim_config.ini, BWPORT_AA, cfgscript antialias=3, the Config window, the menus, the iOS sheet's value 2)
# libntr-ios-testbadge.patch (while the performance test runs, the touch overlay's fast-forward pill reads TEST n/N, lit, and takes no tap: SIM_PerfTestProgress counts the script's bench rows and the finished ones)
# libntr-ios-smoothfix.patch (Smooth motion's skip rules fixed: behind is the cap sleep's lateness grown over its 64-tick least, not the tick top after the game's own work; gpu does not count the present just sent; a dropped in-between's deadline no longer carries to the next present; behind skips repeated pictures whose slot passed; a fence done by its deadline counts as on time; held/s, mdrop/s, glate/s counted; the 10 s line not for nothing-to-blend alone; BWPORT_DRAWABLES=N, a test aid: an iOS-like drawable pool with BWPORT_PANELHZ; docs/perf.md 'Smooth motion's skip rules, fixed')
# libntr-threadwait.patch (OS_SleepThread blocks on a condition variable until OS_WakeupThread/OS_WakeupThreadDirect, a 50 ms backstop, instead of returning after 1 ms: the CARD, CTRDG and WM threads and every SDK wait loop stopped polling at 1 kHz; a wake count noted at OS_DisableInterrupts closes the check-then-sleep race; each unregistered host thread its own OSThread; OS_ReceiveMessage sleeps on its queue (was a 1 ms semaphore poll); the NET thread looks for a session every 50 ms while there is none)
# libntr-ios-metal.patch (Apple builds: the window can present with Metal, sim_config.ini Present=metal / BWPORT_PRESENT=metal, decided at window creation: SDL's Metal view and CAMetalLayer, the picture, ImGui (Dear ImGui's Metal backend) and the fences through port/src/metal_present.mm, one command buffer a present, the pacing's GPU-done fences its completion handlers and the GPU figures its GPUStartTime/GPUEndTime; Renderer=gpu keeps the GL present until its Metal picture exists (docs/gpu-backends.md M3/M4); nothing changes on Windows, Linux or Android)
# libntr-ios-gpuapi.patch (the GPU renderer under Present=metal: its frame and in-between hooks hand back names of the program's Metal textures, SIM_SetFrameTextureMetal turns them into id<MTLTexture>s for bwport_mtl_quad; Renderer=gpu and auto no longer fall back to vcore or to the GL present under Metal; BWPORT_GPU_API=metal|gl sets Present; a Graphics API row (OpenGL / Metal, at the next start) in the Video window on Apple builds; SIM_UISettingGet/Set "present" for the iOS sheet; the renderer texture's GL test reads off under Metal; port/bridge/gpu_bridge_mtl.m)
# libntr-ios-configlink.patch (a settings save follows sim_config.ini when it is a link, as on iOS where it links to Documents/sim_config.ini: the new file replaced the link itself and the next start put the link back, so no change made in the app outlived a restart)
# libntr-ios-metaltune.patch (the Metal tuning round, M5: the performance test trimmed to 18 rows, each setting every key it depends on, with Max fast forward at gpu 3x 4 samples and SMAA; the bench's metal: line adds the renderer's command buffers' GPU ms/s and the drawable thread's waits; Present=metal is the Apple default for a missing key, sim_config.c; the Video window's Graphics API row asks to restart (Restart now / Later; RestartProgram now restarts on macOS too, so Game > Reset is there as well; BWPORT_UIOPEN=apiask shows the prompt))
# libntr-nvramtext.patch (the maintainer's nickname and comment in sim_config.ini as the DS's u16 text, not wchar_t: wchar_t is 4 bytes on Apple and Linux, so once the file had been read every save failed with EILSEQ ("write failed (Illegal byte sequence); the old file stays") and no setting changed in the app outlived a restart; the default's wcscpy and the comment's swprintf also wrote past their arrays; Option_RTCOffset, an s64, was written with %d)
# libntr-ios-maclink.patch (macOS under Present=metal: Frame rate Monitor follows the display's real refreshes, a CVDisplayLink in port/src/metal_present.mm (bwport_mtl_vsync), as iOS follows its CADisplayLink: SpLink returns it for Monitor without fast forward, so the slots lock to the refreshes and the panel model runs; 60, 120, Unlimited and fast forward stay on the program's clock; the bench's glass: line after metal: (each drawable's presentedTime, and the present calls on the link's refreshes); nothing changes on GL, Windows, Linux or Android)
# libntr-ios-2dskip.patch (the passes line says how often the GPU renderer reused an unchanged engine's 2D: "2D 0.40 (skipped A 90%, B 100%)", SIM_Pass2DSkip per frame of the row; docs/gpu-2d.md option 1)
# libntr-ios-threads.patch (each bench row is followed by a 'threads:' line, the row's CPU a drawn frame split by thread name: weak hooks into port/src/sysmetrics.c, called at the row's start and end on the game thread)
# libntr-ios-vcapcost.patch (the 3D command recorder of the in-process renderers, sim_vcapture.cpp: NORMAL and TEXCOORD no longer copy the vector and texture matrices at each vertex, the copy is made when a matrix command is about to change them or the stream's start state is read; a command's parameter count is looked up again only for a list's: the same streams, fewer cycles on the game thread)
# libntr-ios-o2flags.patch (the SDK's C, not the C++ simulator, gets -fwrapv -fno-strict-aliasing -fno-delete-null-pointer-checks on every PC target: the macOS and iOS builds
# compile it at -O2 since 8abee34f8, where clang would exploit what the DS compiler and -O0 forgave; no change at -O0 (Windows, Linux, Android): the maintainers' notes "-O2 safety")
# libntr-ios-smoothhold.patch (Smooth motion: an in-between late on the GPU holds the next tick's in-between only, it no longer doubles the wait as a late CPU half does (its lone probes were all late on a test iPhone: in-betweens 3-4/s for 40 s); a log line if a hold outlasts what it was set for; cfgscript glate=N and glowclock=1, test aids; docs/perf.md)
# libntr-ios-cpubatch.patch (CPU cuts, behaviour unchanged: ImGui's frame is built only for a tick that is presented (the pacing decision comes first; BWPORT_UIEVERY=1 builds it every tick as before); SIM_VCapGather writes only the 4 KB pieces of VRAM that changed since the slot's earlier frame and copies the 3D stream once (BWPORT_VCAPGATHER=copy: the old way); Smooth motion: the first in-between after a CPU half's hold is a warm-up whose lateness does not renew the hold (BWPORT_SMOOTHWARM=0: off), and the 10 s smooth motion line says how often the first and second mids after a hold were late; docs/perf.md)
# libntr-ios-fast3d.patch (the 3D renderer setting: Renderer3D=exact|fast in sim_config.ini, BWPORT_RENDERER3D, SIM_GLRendererOption(4), the Video window's "3D renderer" row, SIM_UISetting "renderer3d" for the iOS sheet, cfgscript renderer3d=exact|fast; docs/gpu-hwraster.md)
# libntr-ios-testkeys.patch (test-only cfgscript keys, off unless set: side=0 skips DrawSide, pump=1 polls SDL events only on a tick after a presented one, soundquality=0|1; docs/perf.md "Three CPU ceilings")
# libntr-ios-savespeed.patch (Save speed: SaveSpeed=1|2|4 in sim_config.ini, BWPORT_SAVESPEED, cfgscript savespeed=, SIM_UISetting "savespeed", the Config window's and side panel's "Save speed" rows; SIM_SetSave, a third speed window beside the battle's and the transition's, which port/extern/src/system/game_event.c opens while the game saves; the maintainers' notes)
# libntr-ios-restart.patch (Game > Restart to title... and cfgscript restart=1 press the game's own soft reset: port/src/restart_press.c)
# libntr-ios-macaddr.patch (a sim_config.ini without MacAddr= gets the random one added, so the DS MAC the save keeps is the same each launch)
# libntr-ios-configpath.patch (sim_config.ini's path is a variable main_start.c sets to the launcher's root, absolute, so the game can run in its own folder; docs/launcher.md)
# libntr-ios-reset.patch (the in-process restart, port/src/machine.c: Apple builds put libntr's C data and sim_vars.c in the machine's sections, __DATA,__machdata and the zero-fill __machbss, libsim's other files stay the host's; SIM_RunGame where NitroMain was called; SIM_MachineExtra lists the machine globals of sim_main.cpp; SIM_PxiQuiesce drains PXI both ways and stops the ARM7 alarm threads; FS_PortCloseAll; SIM_ResetHost: both renderers made again at the next frame, cfgscript pN steps from the new boot)
# libntr-ios-launcher.patch (the desktop's launcher, port/src/launcher_gui.cpp: SIM_LauncherFrame, a frame of the GUI with nothing of the game running; the Games window under the settings windows; Game > Games... on macOS and cfgscript games=1; SIM_ShotRequest; docs/launcher.md)
# libntr-ios-savemax.patch (the save window does not apply while fast forward is at Max: uncapped is already the highest, so a save gets the higher of the two speeds and never both)
# libntr-nnsys.patch (our NitroSystem, lib/nnsys, on libntr: MtxFx43's rt view, the rotation and the translation, with MtxFx33 declared first; SIM_G3PendingHook, called at the top of SIM_HandleG3Command and in the G3X reads, sends the geometry commands port/src/nnsys_g3stage.c holds back first; docs/nnsys-port.md)
diff_files = libntr-clang.patch, libntr-port-runtime.patch, libntr-sdk-gaps.patch, libntr-x86-parameter-buf.patch, libntr-hw.patch, libntr-boot.patch, libntr-vram.patch, libntr-snd.patch, libntr-vcount.patch, libntr-3dswap.patch, libntr-vblankcount.patch, libntr-hwaddr.patch, libntr-g3regs.patch, libntr-capture.patch, libntr-pacing.patch, libntr-gxasync.patch, libntr-fogview.patch, libntr-texfetch.patch, libntr-waitintr.patch, libntr-inputpanel.patch, libntr-fxunion.patch, libntr-waits.patch, libntr-render2.patch, libntr-boxtest.patch, libntr-g3imm.patch, libntr-vcapture.patch, libntr-vbridge.patch, libntr-acapture.patch, libntr-audiofallback.patch, libntr-acore.patch, libntr-gpu.patch, libntr-gpuopt.patch, libntr-wavout.patch, libntr-soundclock.patch, libntr-frameskip.patch, libntr-norender.patch, libntr-sndlock.patch, libntr-glselect.patch, libntr-onerender.patch, libntr-vscale.patch, libntr-present.patch, libntr-sounddefault.patch, libntr-ui68.patch, libntr-switchcheck.patch, libntr-ux69.patch, libntr-vs70.patch, libntr-look70.patch, libntr-ui70.patch, libntr-aa70.patch, libntr-fx71.patch, libntr-aa74.patch, libntr-tp73.patch, libntr-ui73.patch, libntr-fx72.patch, libntr-sp76.patch, libntr-sp77.patch, libntr-ib78.patch, libntr-ib79.patch, libntr-rn80.patch, libntr-pf82.patch, libntr-mu83.patch, libntr-ios-nasm.patch, libntr-ios-gl.patch, libntr-ios-hidden.patch, libntr-ios-gles.patch, libntr-ios-ui.patch, libntr-ios-touch.patch, libntr-ios-cfgscript.patch, libntr-ios-shotdraw.patch, libntr-ios-settings.patch, libntr-ios-pace.patch, libntr-ios-speedui.patch, libntr-desktop-speed.patch, libntr-ios-input.patch, libntr-ios-soundq.patch, libntr-ios-inputprio.patch, libntr-ios-lag.patch, libntr-ios-panel.patch, libntr-ios-ffpace.patch, libntr-ios-input2.patch, libntr-ios-sound.patch, libntr-ios-appfix.patch, libntr-ios-render.patch, libntr-ios-pacefix.patch, libntr-ios-audiowait.patch, libntr-ios-msaa.patch, libntr-ios-sysmetrics.patch, libntr-ios-stuckinput.patch, libntr-audiodummy.patch, libntr-android-gles.patch, libntr-switchrule.patch, libntr-android-settings.patch, libntr-android-touch.patch, libntr-android-diag.patch, libntr-ios-smoothdrop.patch, libntr-ios-passes.patch, libntr-ios-smaa.patch, libntr-ios-testbadge.patch, libntr-ios-smoothfix.patch, libntr-threadwait.patch, libntr-ios-metal.patch, libntr-ios-gpuapi.patch, libntr-ios-configlink.patch, libntr-ios-metaltune.patch, libntr-nvramtext.patch, libntr-ios-maclink.patch, libntr-ios-passe.patch, libntr-ios-2dskip.patch, libntr-ios-threads.patch, libntr-ios-vcapcost.patch, libntr-ios-o2flags.patch, libntr-ios-ablate.patch, libntr-ios-presentcpu.patch, libntr-ios-benchpin.patch, libntr-ios-smoothhold.patch, libntr-ios-cpubatch.patch, libntr-ios-fast3d.patch, libntr-ios-fastgl.patch, libntr-ios-cfglen.patch, libntr-ios-g3skip.patch, libntr-ios-testkeys.patch, libntr-ios-cfgunknown.patch, libntr-ios-vcaplist.patch, libntr-ios-vcapmetal.patch, libntr-ios-perfrows.patch, libntr-ios-settingstext.patch, libntr-ios-battlespeed.patch, libntr-ios-textspeed.patch, libntr-ios-fadespeed.patch, libntr-ios-movesettings.patch, libntr-ios-transitions.patch, libntr-ios-shotmid.patch, libntr-ios-ffkeep.patch, libntr-ios-savespeed.patch, libntr-ios-restart.patch, libntr-ios-macaddr.patch, libntr-ios-configpath.patch, libntr-ios-reset.patch, libntr-ios-launcher.patch, libntr-ios-savemax.patch, libntr-pc-launcher.patch, libntr-hidden-pc.patch, libntr-nnsys.patch


# libntr (MIT, https://github.com/cybervisi0n/libntr): NitroSDK/TwlSDK for PC. Upstream's commit f6b3a690c is fetched by meson at
# the first configure into port/subprojects/libntr/, then our changes (the port's fixes and additions: one patch of 82 files,
# packagefiles/libntr-ours.patch) are applied on top. Only our changes are in this repository, none of upstream's files.
[wrap-git]
url = https://github.com/cybervisi0n/libntr.git
revision = f6b3a690c72b1484fda86c47021dbda2b54ffb69
depth = 1
diff_files = libntr-ours.patch

[provide]
dependency_names = NitroSDK

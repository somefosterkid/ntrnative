@@ -99,4 +101,5 @@ void SPLEmitter_EmitParticles(SPLEmitter *emtr, SPLParticleList *list)
             return;
         }
+        SIM_G3TagDrop(ptcl); // bw-port: a new particle, a new tag id
 
         SPLParticleList_PushFront(&emtr->particles, ptcl);
@@ -294,4 +297,5 @@ void SPLEmitter_EmitChildren(SPLParticle *ptcl, SPLEmitter *emtr, SPLParticleLis
             return;
         }
+        SIM_G3TagDrop(child); // bw-port: a new particle, a new tag id
 
         SPLParticleList_PushFront(&emtr->childParticles, child);

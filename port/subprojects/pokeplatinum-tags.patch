diff --git a/src/billboard.c b/src/billboard.c
index 8cdadfd67..abe8bf2d8 100644
--- a/src/billboard.c
+++ b/src/billboard.c
@@ -1,4 +1,6 @@
 #include "billboard.h"
 
+#include <simulator/sim_g3tag.h> // bw-port: Smooth motion's tags
+
 #include "billboard_vram_transfer.h"
 #include "easy3d.h"
@@ -237,4 +239,18 @@ static BillboardList *FindFirstFreeBillboardList(void)
 }
 
+// bw-port: Smooth motion's tag for a sprite (simulator/sim_g3tag.h): its list, itself, and the image its animation shows
+// now (the texture and palette indexes UpdateTexPlttAddressesForCurrentFrame or the VRAM transfer use)
+static void PortG3Tag_Billboard(BillboardList *list, Billboard *billboard)
+{
+    u32 state = 0;
+
+    if (billboard->gfxSequence.seqCount != 0) {
+        BillboardTexPlttIndex indexes = BillboardGfxSequence_GetTexPlttIndexAt(&billboard->gfxSequence, billboard->frameNum >> FX32_SHIFT);
+        state = indexes.textureIdx | indexes.plttIdx << 8;
+    }
+
+    SIM_G3Tag(SIM_G3TAG_OWNER(SIM_G3TAG_SPRITE, list), SIM_G3TagId(billboard), state);
+}
+
 static void BillboardList_Draw(BillboardList *list)
 {
@@ -267,4 +283,8 @@ static void BillboardList_Draw(BillboardList *list)
             }
 
+            if (SIM_G3TagOn) { // bw-port
+                PortG3Tag_Billboard(list, billboard);
+            }
+
             Easy3D_DrawRenderObj(&billboard->renderObj, &billboard->pos, rotMatrix, &billboard->scale);
             ReleaseVRAMKeysAndModelSet(billboard);
@@ -273,4 +293,8 @@ static void BillboardList_Draw(BillboardList *list)
         billboard = billboard->next;
     }
+
+    if (SIM_G3TagOn) { // bw-port
+        SIM_G3Tag(0, 0, 0);
+    }
 }
 
@@ -740,4 +764,5 @@ static Billboard *BillboardList_AllocBillboard(BillboardList *list)
     Billboard *billboard = list->freeBillboards[list->freeBillboardHead];
     list->freeBillboardHead++;
+    SIM_G3TagDrop(billboard); // bw-port: a new sprite, a new tag id
 
     return billboard;

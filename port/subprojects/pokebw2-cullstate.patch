pokebw2-cullstate.patch (tools/pokebw2_fetch.sh, the maintainers' notes): clact.c's surface culling callback (ClAct_CullOam,
a surface's pBeforeDrawOamBackFunc once ClActRenderer_SetCulling is on) took the renderer as a DS-offset overlay,
ClActDrawState { u8 unk0[0x30]; BOOL skip; u32 unk34; GXOamAttr oam; }: the renderer core's bDrawEnable and currentOam
at their DS offsets. On a 64-bit host the core's 0x30 is pFuncOamRegister, so the first culled OAM wrote 0 or 1 over its
low 32 bits and the next OAM called 0x0000555500000000 (the Hall of Fame demo's second scene, SIGSEGV in
DoRenderByRndCore2D_; also the PokeStar Studios cut-in, the beacon detail, the download and Key System screens). The
callback now names the renderer's own fields (rend->rendererCore.currentOam / bDrawEnable): the same offsets on the DS.
Black's lib/gfl/src/clact.c had the same overlay (func_0204c2c8), fixed the same way.

diff --git a/src/gfl/clact.c b/src/gfl/clact.c
index 0c0b36ac1..2bc1f4f15 100644
--- a/src/gfl/clact.c
+++ b/src/gfl/clact.c
@@ -85,14 +85,6 @@ typedef struct {
     NNSG2dCharacterData *transferChar;
 } ClActResSetup;
 
-// What the renderers pass the culling callback of a surface for each OAM, which sets skip when it is out of view
-typedef struct {
-    u8 unk0[0x30];
-    BOOL skip;
-    u32 unk34;
-    GXOamAttr oam;
-} ClActDrawState;
-
 ClActSys *g_ClActSys;
 
 void ClActRenderer_InitForSystem(ClActRenderer *renderer, const ClActSysSetup *setup, HeapID heapId);
@@ -123,7 +115,7 @@ static u16 ClActAffine_EntryMain(const MtxFx22 *mtx);
 static u16 ClActAffine_EntrySub(const MtxFx22 *mtx);
 static BOOL ClAct_IsCellInViewTransformed(const NNSG2dCellData *cell, const MtxFx32 *mtx, const NNSG2dViewRect *view);
 static BOOL ClAct_IsCellInView(const NNSG2dCellData *cell, const MtxFx32 *mtx, const NNSG2dViewRect *view);
-static void ClAct_CullOam(ClActDrawState *state, const NNSG2dViewRect *view, u32 a2, u32 a3, const MtxFx32 *mtx);
+static void ClAct_CullOam(NNSG2dRendererInstance *rend, const NNSG2dViewRect *view, u32 a2, u32 a3, const MtxFx32 *mtx);
 static BOOL ClAct_IsRectInView(fx32 posX, fx32 posY, fx32 left, fx32 right, fx32 top, fx32 bottom, const MtxFx32 *mtx,
                                const NNSG2dViewRect *view);
 static void ClActTransfer_Init(ClActTransfer *transfer, u8 count, HeapID heapId);
@@ -1388,9 +1380,11 @@ static inline s16 ClAct_WrapOamY(s16 y) {
     return y;
 }
 
-// Called by the renderers before each OAM: skips one that is out of view
-static void ClAct_CullOam(ClActDrawState *state, const NNSG2dViewRect *view, u32 a2, u32 a3, const MtxFx32 *mtx) {
-    GXOamAttr *oam = &state->oam;
+// The surface's callback before each OAM (NNSG2dRndDrawOamCallBack: the renderer, its surface, whose view rect it
+// starts with): skips the OAM, through the core's bDrawEnable, when it is out of view. The renderer's own fields, not
+// a DS-offset overlay of it: on a 64-bit host the core's 0x30 is pFuncOamRegister, not bDrawEnable
+static void ClAct_CullOam(NNSG2dRendererInstance *rend, const NNSG2dViewRect *view, u32 a2, u32 a3, const MtxFx32 *mtx) {
+    GXOamAttr *oam = &rend->rendererCore.currentOam;
     GXOamShape shape = oam->attr01 & GX_OAM_ATTR01_SHAPE_MASK;
     fx32 left = ClAct_WrapOamX(oam->x) << FX32_SHIFT;
     fx32 right = (ClAct_WrapOamX(oam->x) + NNS_G2dGetOamSizeX(&shape)) << FX32_SHIFT;
@@ -1399,9 +1393,9 @@ static void ClAct_CullOam(ClActDrawState *state, const NNSG2dViewRect *view, u32
 
     if (ClAct_IsRectInView(mtx->_20 - view->posTopLeft.x, mtx->_21 - view->posTopLeft.y, left, right, top, bottom, mtx,
                            view)) {
-        state->skip = TRUE;
+        rend->rendererCore.bDrawEnable = TRUE;
     } else {
-        state->skip = FALSE;
+        rend->rendererCore.bDrawEnable = FALSE;
     }
 }
 

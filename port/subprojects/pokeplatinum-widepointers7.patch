pokeplatinum-widepointers7.patch (tools/pokeplat_gen.py applies it to build/pokeplatinum, after widepointers.patch): heap
blocks 8-aligned where a pointer is 8 bytes. pret's heap.c asks the NNS expanded heap for an alignment of 4 (-4 from the
heap's end: Heap_Alloc, Heap_AllocAtEnd, the child heaps, HeapExp_FndInitAllocator's callers), the DS's word; on a
64-bit host the blocks hold pointers, and a 4 put half of them at 4 mod 8 (the sanitizer's misaligned-pointer rows).
HEAP_HOST_ALIGN raises |alignment| below 8 to 8 and keeps the sign (head or tail); sizes are unchanged. With
libntr-arenaalign.patch (the arena's blocks, from which the system heaps come, 8-aligned too).
diff --git a/src/heap.c b/src/heap.c
index e6bdf1c71..8b4257f25 100644
--- a/src/heap.c
+++ b/src/heap.c
@@ -37,6 +37,15 @@ static BOOL CreateHeapInternal(enum HeapID parent, enum HeapID child, u32 size,
 #define HEAP_HOST_SIZE(size) (size)
 #endif
 
+// A heap block's alignment where a pointer is 8 bytes: the DS's 4 (or -4, from the heap's end) raised to 8, the sign
+// kept, as its blocks hold pointers (MemoryBlock's 16 bytes keep the caller's pointer at the block's alignment). The
+// child heaps, Heap_Alloc* and the NNS allocators of HeapExp_FndInitAllocator; an alignment of 8 or more is as given.
+#if UINTPTR_MAX > 0xFFFFFFFFu
+#define HEAP_HOST_ALIGN(alignment) ((alignment) >= 0 ? ((alignment) < 8 ? 8 : (alignment)) : ((alignment) > -8 ? -8 : (alignment)))
+#else
+#define HEAP_HOST_ALIGN(alignment) (alignment)
+#endif
+
 void Heap_InitSystem(const HeapParam *templates, u32 nTemplates, u32 totalNumHeaps, u32 preSize)
 {
     void *ptr;
@@ -136,7 +145,7 @@ static BOOL CreateHeapInternal(enum HeapID parent, enum HeapID child, u32 size,
     if (sHeapInfo.unallocatedHeapID == ptr[child]) {
         NNSFndHeapHandle parentHeap = sHeapInfo.heapHandles[ptr[parent]];
         if (parentHeap != NNS_FND_HEAP_INVALID_HANDLE) {
-            void *newHeapAddr = NNS_FndAllocFromExpHeapEx(parentHeap, size, alignment);
+            void *newHeapAddr = NNS_FndAllocFromExpHeapEx(parentHeap, size, HEAP_HOST_ALIGN(alignment));
             if (newHeapAddr != NULL) {
                 s32 i = FindFirstAvailableHeapHandle();
                 if (i >= 0) {
@@ -198,7 +207,7 @@ static void *AllocFromHeapInternal(NNSFndHeapHandle heap, u32 size, s32 alignmen
 
     OSIntrMode intrMode = OS_DisableInterrupts();
     size += sizeof(MemoryBlock);
-    void *ptr = NNS_FndAllocFromExpHeapEx(heap, size, alignment);
+    void *ptr = NNS_FndAllocFromExpHeapEx(heap, size, HEAP_HOST_ALIGN(alignment));
 
     OS_RestoreInterrupts(intrMode);
     if (ptr != NULL) {
@@ -318,7 +327,7 @@ void HeapExp_FndInitAllocator(NNSFndAllocator *pAllocator, u32 heapID, int align
 {
     if ((u32)heapID < sHeapInfo.totalNumHeaps) {
         u8 index = sHeapInfo.heapIdxs[heapID];
-        NNS_FndInitAllocatorForExpHeap(pAllocator, sHeapInfo.heapHandles[index], alignment);
+        NNS_FndInitAllocatorForExpHeap(pAllocator, sHeapInfo.heapHandles[index], HEAP_HOST_ALIGN(alignment));
         return;
     }
 

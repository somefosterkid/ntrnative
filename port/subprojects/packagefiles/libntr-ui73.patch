+
+unsigned long long FtNext() {
+    double ms = sFt.base;
+    if (sFt.every > 0.0 && sFt.t >= sFt.nextSpike) {
+        sFt.nextSpike += (unsigned long long)(sFt.every * 1e9);
+        if ((double)sFt.t < sFt.stop * 1e9) { ms = sFt.spike; }
+    }
+    unsigned long long ns = (unsigned long long)(ms * 1e6 + 0.5);
+    sFt.t += ns;
+    return ns;

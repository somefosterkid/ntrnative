+        std::vector<float> v;
+        double sum = 0.0;
+        float mn = 1e9f, mx = 0.0f;
+        for (const FrameRec & f : sFt.all) {
+            bool in = pass == 0 ? f.end / 10000000ull >= sSnapB0 : (double)(sTotalNs - f.end) < lim;
+            if (!in) { continue; }
+            v.push_back(f.ms); sum += f.ms; mn = std::min(mn, f.ms); mx = std::max(mx, f.ms);
+        }
+        if (v.empty()) { return; }
+        std::sort(v.begin(), v.end(), std::greater<float>());
+        size_t want = (v.size() + 99) / 100;
+        double ls = 0.0;
+        for (size_t i = 0; i < want; i++) { ls += v[i]; }
+        if (pass == 0) {
+            fprintf(sFt.out, "t=%.2f p=%d ncols=%d colB=%u label: n=%llu min=%.3f avg=%.3f max=%.3f low=%.3f top=%.1f | cols: n=%zu min=%.3f avg=%.3f max=%.3f low=%.3f",
+                    (double)sTotalNs / 1e9, p, sGraphCols, colB, sSnap.pFrames, sSnap.pMin, sSnap.pAvg, sSnap.pMax, sSnap.pLowMs, sSnap.top,
+                    v.size(), mn, sum / (double)v.size(), mx, ls / (double)want);
+        } else {
+            fprintf(sFt.out, " | strict: n=%zu min=%.3f avg=%.3f max=%.3f low=%.3f\n", v.size(), mn, sum / (double)v.size(), mx, ls / (double)want);
+            fflush(sFt.out);
+        }
+    }
+}

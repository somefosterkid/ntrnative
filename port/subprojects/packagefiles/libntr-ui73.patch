+    double sum = 0.0;
+    float bmn = 1e9f, bmx = 0.0f;
+    size_t bn = 0;
+    for (const FrameRec & f : sFt.all) {
+        long long b = (long long)(f.end / 10000000ull);
+        if (b < c * (long long)colB || b >= (c + 1) * (long long)colB || b < b0) { continue; }
+        bn++; sum += f.ms; bmn = std::min(bmn, f.ms); bmx = std::max(bmx, f.ms);
+    }
+    fprintf(sFt.out, "hover t=%.2f col=%lld final=%d tooltip: n=%d min=%.3f avg=%.3f max=%.3f | brute: n=%zu min=%.3f avg=%.3f max=%.3f\n",
+            (double)sTotalNs / 1e9, c, (int)final, n, mn, avg, mx, bn, bn ? bmn : 0.0f, bn ? sum / (double)bn : 0.0, bmx);

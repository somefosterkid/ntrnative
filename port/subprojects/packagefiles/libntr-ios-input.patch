+// libntr-ios-input.patch: the input latency. A finger that presses a button, the D-pad or the touch screen stamps the time it touched
+// the glass (sPendT0); SimTouch_Pressed hands it over when the game's pad bits (or the stylus) change, the main loop times the rest
+unsigned long long sPendT0, sPendGate, sPendAt, sTakenT0, sTakenGate;
+bool sTaken;
+
+unsigned long long NowNs() {   // sim_main.cpp's SpNowNs (on iOS the clock of UITouch.timestamp)
+    Uint64 c = SDL_GetPerformanceCounter(), f = SDL_GetPerformanceFrequency();
+    return (c / f) * 1000000000ull + (c % f) * 1000000000ull / f;
+}
+
+void PressTime(const SDL_Event * e) {
+    if (sPendT0 != 0) return;
+    unsigned long long now = NowNs(), hw = 0, gate = 0;
+    unsigned seq = 0;
+    static unsigned sSeqSeen;
+    sPendAt = now;
+    // a real touch: UIKit's record of it (SDL turned it into this event inside the same sendEvent:)
+#if SIM_TOUCH_IOS
+    if (bwport_ios_touch_time(&hw, &gate, &seq) && seq != sSeqSeen && hw <= now) {
+        sSeqSeen = seq;
+        sPendT0 = hw;
+        sPendGate = gate;
+        return;
+    }
+#endif
+    // a pushed one (BWPORT_KEYS tap:, a desktop): the event's own time, in ms
+    Uint32 age = SDL_GetTicks() - e->tfinger.timestamp;
+    sPendT0 = now - (unsigned long long)(age < 1000 ? age : 0) * 1000000ull;
+    sPendGate = 0;
+}
 

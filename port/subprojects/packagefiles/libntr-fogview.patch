 void SIM_PreRenderVBlank() { SDL_SemPost(vcountVblankSemaphore); }
 
+// bw-port: the 3D viewport, G3_ViewPort's x1 | y1 << 8 | x2 << 16 | y2 << 24 (y counted from the bottom, as GL's); the
+// 3D engine's screen is the upper half of the render target when POWCNT's bit 15 says so. 0 (never written) is the
+// whole screen
+extern "C" void SIM_ApplyG3Viewport(void) {
+  u32 vp = s_reg_G3_VIEWPORT;
+  u32 x1 = vp & 0xFF, y1 = (vp >> 8) & 0xFF, x2 = (vp >> 16) & 0xFF, y2 = (vp >> 24) & 0xFF;
+  if (vp == 0 || x2 < x1 || y2 < y1 || y2 >= SIM_NDS_SCREEN_HEIGHT) {
+    x1 = 0; y1 = 0; x2 = SIM_NDS_SCREEN_WIDTH - 1; y2 = SIM_NDS_SCREEN_HEIGHT - 1;
+  }
+  int sc = s_SIM_config.internalResolutionScale;
+  int top = (s_reg_GX_POWCNT >> 15) ? SIM_NDS_SCREEN_HEIGHT : 0;
+  glViewport(x1 * sc, (top + y1) * sc, (x2 - x1 + 1) * sc, (y2 - y1 + 1) * sc);
+}
+
+// bw-port: the 3D frame starts from G3X_SetClearColor's colour, alpha (0 leaves the 3D layer transparent there) and
+// depth. Not done: the clear polygon ID, the clear image (rear-plane bitmap: no place for it in libntr)
+static void SIM_ClearG3(void) {
+  u32 c = s_reg_G3X_CLEAR_COLOR;
+  float a = (float)((c >> 16) & 0x1F) / 31.0f;
+  float d = (float)(s_reg_G3X_CLEAR_DEPTH & 0x7FFF) / 32767.0f;
+  glClearColor((float)(c & 0x1F) / 31.0f, (float)((c >> 5) & 0x1F) / 31.0f, (float)((c >> 10) & 0x1F) / 31.0f, a);
+  glClearDepth(d);
+  glClear(GL_COLOR_BUFFER_BIT | GL_DEPTH_BUFFER_BIT);
+}

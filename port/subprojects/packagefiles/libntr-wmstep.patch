 static void SIM_PxiPendInit(void);
 static volatile int s_pxi7to9Pending = 0;
 
+// bw-port (libntr-wmstep.patch): the wireless stepped from the game's frames. The ARM7's WM request thread and the
+// callbacks it sends back (the game's WM callbacks, run on the 7-to-9 PXI thread) ran whenever the host scheduled them,
+// so which frame of the game saw a scan's result changed from run to run, and with it the order of the game's random
+// numbers (Black 2's beacon search draws from the LC its field's NPCs use). Once SIM_WmStep has been called (the port's
+// frame end, under its bench pin), the game's WM requests wait here, and SIM_WmStep runs them all and waits for their
+// callbacks: every request a frame makes is answered before the next frame, on every run.
+#define WM_STEP_MAX 64
+static volatile int s_wmStep = 0;
+static SDL_mutex * s_wmMx = NULL;
+static uPtr s_wmData[WM_STEP_MAX];
+static BOOL s_wmErr[WM_STEP_MAX];
+static int s_wmCount = 0;
+extern volatile int SIM_wmRequestsPending;   // wmsp_system.c: sent to the request thread and not done yet
+void SIM_PxiDrain(void);
+
+void SIM_WmStep(void)
+{
+	uPtr data[WM_STEP_MAX];
+	BOOL err[WM_STEP_MAX];
+	int n, i;
+	Uint32 t0;
+
+	if( s_wmMx == NULL )
+	{
+		s_wmMx = SDL_CreateMutex();
+		s_wmStep = 1;
+		return;
+	}
+	SIM_PxiDrain();   // the frame's requests reached the list
+	SDL_LockMutex( s_wmMx );
+	n = s_wmCount;
+	for( i = 0; i < n; i++ )
+	{
+		data[i] = s_wmData[i];
+		err[i] = s_wmErr[i];
+	}
+	s_wmCount = 0;
+	SDL_UnlockMutex( s_wmMx );
+	for( i = 0; i < n; i++ )
+	{
+		if( FifoRecvCallbackTable7[PXI_FIFO_TAG_WM] )
+		{
+			FifoRecvCallbackTable7[PXI_FIFO_TAG_WM]( PXI_FIFO_TAG_WM, data[i], err[i] );
+		}
+	}
+	t0 = SDL_GetTicks();
+	while( ( SIM_wmRequestsPending > 0 || s_pxi7to9Pending > 0 ) && SDL_GetTicks() - t0 < 1000 )
+	{
+		SDL_Delay( 0 );
+	}
+}

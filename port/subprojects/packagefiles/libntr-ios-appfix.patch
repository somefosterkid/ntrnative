+// libntr-ios-appfix.patch: a line that can repeat all session (slow settings, a drop condition) is printed at most `perMin` times a
+// minute; the lines left out are counted and the next one says how many
+struct LogBudget { u64 winStart; int used; int skipped; };
+static bool LogBudgetOk(LogBudget &b, int perMin, int *skippedBefore) {
+  struct timespec ts;
+  clock_gettime(CLOCK_MONOTONIC, &ts);
+  u64 now = (u64)ts.tv_sec * 1000000000ull + (u64)ts.tv_nsec;
+  if (b.winStart == 0 || now - b.winStart > 60000000000ull) { b.winStart = now; b.used = 0; }
+  if (b.used >= perMin) { b.skipped++; return false; }
+  b.used++;
+  *skippedBefore = b.skipped;
+  b.skipped = 0;
+  return true;
+}

+// bw-port (libntr-aa70.patch): Antialiasing=off|2x|4x. The renderers draw at Resolution x k and show the k x k box average at
+// Resolution; the bridges cap the internal size (8x) by lowering k and report what they used.
+extern "C" int SIM_AntialiasWanted(void) {
+  int k = s_SIM_config.antialias;
+  return k >= 4 ? 4 : k >= 2 ? 2 : 1;
+}
+extern "C" void SIM_RendererAAUsed(int k) { sAAUsed = k; }
+// " AA 2x" when the setting is on and in force, " AA 4x -> 2x (8x cap)" when it was lowered, " AA 4x off (8x cap)" when no k fits
+static const char *AAText(char *buf, size_t n) {
+  int w = SIM_AntialiasWanted();
+  buf[0] = 0;
+  if (w <= 1) return buf;
+  if (sAAUsed == w || sAAUsed == 0) snprintf(buf, n, ", AA %dx", w);
+  else if (sAAUsed > 1) snprintf(buf, n, ", AA %dx lowered to %dx (internal size capped at 8x: %dx x %d)", w, sAAUsed, SIM_RenderScale(), sAAUsed);
+  else snprintf(buf, n, ", AA %dx not drawn (internal size capped at 8x: %dx x %d)", w, SIM_RenderScale(), w);
+  return buf;
+}

+            fixed.tm_isdst = -1;
+            pinned = mktime(&fixed) != (time_t)-1;   /* sets tm_wday */
+        }
+    }
+    if (pinned) {
+        return &fixed;
+    }
+    currentTime = time( NULL );
+    return localtime( &currentTime );
+}

+namespace SIM::GUI { void PerfLogStartNamed(const char *file); bool PerfLogBusy(); }
+// bw-port (libntr-ios-cfgscript.patch): BWPORT_CFGSCRIPT="f11100:renderer=gpu,resolution=4;f11400:renderer=vcore,framerate=60;..." applies
+// settings at V-blank frames (the keys script's frame count), as the Config window does: the same fields of s_SIM_config, which the
+// frame loop reads (renderer, Resolution, Frame rate; the swap interval follows in SIM_Render). A step logs "cfgscript: fN ..." to
+// stderr when it applies. "pN:..." instead of "fN:..." applies N frames after the previous step and after any performance log has finished. Keys: renderer=auto|vcore|gpu, resolution=1..8, framerate=60|120|monitor|unlimited, antialias=1|2|4,
+// shot=NAME (the window's picture to NAME.png), quit=1 (ends the run), perflog=NAME (records 5 s of per-frame stage times to perf_NAME.txt, as Debug > Save performance log).
+static char sCfgShot[64];  // shot=NAME: SIM_ShotMaybe (libntr-ios-hidden.patch) writes NAME.png at the next present
+static void SIM_CfgScript(void) {
+  struct Step { u32 frame; bool rel; char text[96]; };
+  static std::vector<Step> sSteps;
+  static int sInit = 0;
+  static size_t sNext = 0;
+  if (!sInit) {
+    sInit = 1;
+    const char *e = getenv("BWPORT_CFGSCRIPT");
+    if (e == NULL || !*e) return;
+    char *dup = strdup(e);
+    char *save = NULL;
+    for (char *tok = strtok_r(dup, ";", &save); tok != NULL; tok = strtok_r(NULL, ";", &save)) {
+      char *colon = strchr(tok, ':');
+      if ((tok[0] != 'f' && tok[0] != 'p') || colon == NULL) continue;
+      Step st;
+      st.frame = (u32)atoi(tok + 1);
+      st.rel = tok[0] == 'p';
+      snprintf(st.text, sizeof st.text, "%s", colon + 1);
+      sSteps.push_back(st);
+    }
+    free(dup);
+  }
+  u32 now = *((u32 *)HW_VBLANK_COUNT_BUF);
+  static u32 sMark = 0;  // the frame a performance log was last running or a step last applied, for the pN steps
+  while (sNext < sSteps.size()) {
+    bool busy = SIM::GUI::PerfLogBusy();
+    if (busy) sMark = now;
+    const Step &cur = sSteps[sNext];
+    if (cur.rel ? (busy || now < sMark + cur.frame) : now < cur.frame) break;
+    sMark = now;
+    char *save = NULL;
+    char text[96];
+    snprintf(text, sizeof text, "%s", sSteps[sNext].text);
+    for (char *kv = strtok_r(text, ",", &save); kv != NULL; kv = strtok_r(NULL, ",", &save)) {
+      char *eq = strchr(kv, '=');
+      if (eq == NULL) continue;
+      *eq = 0;
+      const char *v = eq + 1;
+      if (strcmp(kv, "renderer") == 0) {
+        s_SIM_config.renderer = (u8)(strcmp(v, "gpu") == 0 ? SIM_CONFIG_RENDERER_GPU : strcmp(v, "vcore") == 0 ? SIM_CONFIG_RENDERER_VCORE : SIM_CONFIG_RENDERER_AUTO);
+      } else if (strcmp(kv, "resolution") == 0) {
+        int n = atoi(v);
+        s_SIM_config.resolution = (u8)(n < 1 ? 1 : n > 8 ? 8 : n);
+      } else if (strcmp(kv, "antialias") == 0) {
+        int n = atoi(v);
+        s_SIM_config.antialias = (u8)(n >= 4 ? 4 : n >= 2 ? 2 : 1);
+      } else if (strcmp(kv, "perflog") == 0) {  // a 5 s performance log into perf_NAME.txt
+        char fn[128];
+        snprintf(fn, sizeof fn, "perf_%s.txt", v);
+        SIM::GUI::PerfLogStartNamed(fn);
+      } else if (strcmp(kv, "shot") == 0) {  // the window's picture to NAME.png (macOS, BWPORT_HIDDEN)
+        snprintf(sCfgShot, sizeof sCfgShot, "%s", v);
+      } else if (strcmp(kv, "quit") == 0) {  // end the run here (after this step's other keys; a shot needs a frame: put quit a few frames later)
+        fprintf(stderr, "cfgscript: quit at f%u\n", now);
+        fflush(stderr);
+        _exit(0);
+      } else if (strcmp(kv, "framerate") == 0) {
+        u8 r = strcmp(v, "unlimited") == 0 ? SIM_CONFIG_DISPLAYCAP_UNLIMITED : strcmp(v, "monitor") == 0 ? SIM_CONFIG_DISPLAYCAP_MONITOR
+             : atoi(v) >= 120 ? SIM_CONFIG_DISPLAYCAP_120 : SIM_CONFIG_DISPLAYCAP_60;
+        if (r != SIM_CONFIG_DISPLAYCAP_UNLIMITED) s_SIM_config.displayCapBack = r;
+        else if (s_SIM_config.displayCap != SIM_CONFIG_DISPLAYCAP_UNLIMITED) s_SIM_config.displayCapBack = s_SIM_config.displayCap;
+        s_SIM_config.displayCap = r;
+      }
+    }
+    fprintf(stderr, "cfgscript: %c%u (now f%u) %s\n", sSteps[sNext].rel ? 'p' : 'f', sSteps[sNext].frame, now, sSteps[sNext].text);
+    fflush(stderr);
+    sNext++;
+  }
+}

+// The V-count as the DS's would read: 192 at the V-blank (the V-blank interrupt, and again when OS_WaitIrq returns
+// and the game's own V-blank work starts), then a line every 63.555 us (263 lines at 59.8261 Hz), 0 after 262, and
+// held at 191 when the frame runs longer than the DS's. Code that does its VRAM loads early in the V-blank (mcss.c's
+// load tasks, 192 to 200) and code that spreads work over the frame read what the DS would; it was always 0
+static struct timespec s_SIM_vblankStart;
+
+static void SIM_StartVBlankLines() { clock_gettime(CLOCK_MONOTONIC, &s_SIM_vblankStart); }
+
+extern "C" REGType16v *SIM_GetVCountReg(void) {
+  struct timespec now;
+  clock_gettime(CLOCK_MONOTONIC, &now);
+  s64 ns = (s64)(now.tv_sec - s_SIM_vblankStart.tv_sec) * 1000000000LL + (now.tv_nsec - s_SIM_vblankStart.tv_nsec);
+  s64 line = 192 + ns / 63555;
+  if (line >= 263) {
+    line -= 263;
+    if (line > 191) {
+      line = 191;
+    }
+  }
+  s_reg_GX_VCOUNT = (u16)line;
+  return &s_reg_GX_VCOUNT;
+}
+
 void SIM_PreRenderVBlank() { SDL_SemPost(vcountVblankSemaphore); }
 
 void SIM_PostRenderVBlank() {
@@ -1400,8 +1425,8 @@
     glClear(GL_COLOR_BUFFER_BIT | GL_DEPTH_BUFFER_BIT);
     G3SIM_ResetSwapBuffersCall();
   }
-  // Reset Vcount
-  s_reg_GX_VCOUNT = 0;
+  // The game's V-blank work (after OS_WaitIrq) starts at line 192 too
+  SIM_StartVBlankLines();
   SDL_SemPost(vcountResetSemaphore);
 }
 

+// ---- The input panel: a DS's buttons in their places, each with the key it is mapped to, lit while pressed
+static std::string KeyLabel(int key) {
+    std::string n = SDL_GetKeyName(key);
+    static const char * const sShort[][2] = {
+        {"Return", "Enter"}, {"Right Shift", "R-Shift"}, {"Left Shift", "L-Shift"}, {"Right Ctrl", "R-Ctrl"},
+        {"Left Ctrl", "L-Ctrl"}, {"Right Alt", "R-Alt"}, {"Left Alt", "L-Alt"}, {"Backspace", "Bksp"},
+        {"Keypad ", "KP "}, {"Escape", "Esc"}, {"Page Down", "PgDn"}, {"Page Up", "PgUp"}, {"Delete", "Del"},
+    };
+    for (auto & s : sShort) {
+        if (n.compare(0, strlen(s[0]), s[0]) == 0) {
+            n = std::string(s[1]) + n.substr(strlen(s[0]));
+            break;
+        }
+    }
+    return n.empty() ? "-" : n;
+}
+
+void DrawInputPanel(float px, float py, float pw, float ph, unsigned pressed) {
+    ImDrawList * dl = ImGui::GetBackgroundDrawList();
+    ImFont * font = ImGui::GetFont();
+    SIM_config_type * cfg = SIM_GetConfigPtr();
+    const SIM_config_pad_settings_type & pad = cfg->padSettings;
+    const float CW = 240.0f, CH = 300.0f;    // the drawing's own units
+    float u = std::min(pw / (CW + 20.0f), ph / (CH + 20.0f));
+    if (u <= 0.0f) {
+        return;
+    }
+    float ox = px + (pw - CW * u) / 2.0f, oy = py + (ph - CH * u) / 2.0f;
+    const ImU32 cBack = IM_COL32(22, 22, 28, 255), cBody = IM_COL32(52, 54, 68, 255), cBtn = IM_COL32(86, 88, 104, 255),
+                cLit = IM_COL32(255, 205, 60, 255), cEdge = IM_COL32(150, 152, 168, 255),
+                cText = IM_COL32(235, 235, 240, 255), cTextLit = IM_COL32(20, 20, 24, 255),
+                cDim = IM_COL32(160, 162, 176, 255);
+
+    auto P = [&](float x, float y) { return ImVec2(ox + x * u, oy + y * u); };
+    // text centred on (cx, cy), at most maxW wide (units)
+    auto Text = [&](float cx, float cy, float size, const std::string & s, ImU32 col, float maxW) {
+        float fs = size * u;
+        ImVec2 sz = font->CalcTextSizeA(fs, 100000.0f, 0.0f, s.c_str());
+        if (sz.x > maxW * u) {
+            fs *= maxW * u / sz.x;
+            sz = font->CalcTextSizeA(fs, 100000.0f, 0.0f, s.c_str());
+        }
+        ImVec2 c = P(cx, cy);
+        dl->AddText(font, fs, ImVec2(c.x - sz.x / 2.0f, c.y - sz.y / 2.0f), col, s.c_str());
+    };
+    auto Rect = [&](float x, float y, float w, float h, float r, bool lit) {
+        dl->AddRectFilled(P(x, y), P(x + w, y + h), lit ? cLit : cBtn, r * u);
+        dl->AddRect(P(x, y), P(x + w, y + h), cEdge, r * u, 0, std::max(1.0f, u));
+    };
+    auto Circle = [&](float cx, float cy, float r, bool lit) {
+        dl->AddCircleFilled(P(cx, cy), r * u, lit ? cLit : cBtn, 32);
+        dl->AddCircle(P(cx, cy), r * u, cEdge, 32, std::max(1.0f, u));
+    };
+    auto Lit = [&](int bit) { return (pressed >> bit & 1) != 0; };
+
+    dl->AddRectFilled(ImVec2(px, py), ImVec2(px + pw, py + ph), cBack);
+    dl->AddRectFilled(P(-6, -6), P(CW + 6, CH + 6), cBody, 16.0f * u);
+
+    // shoulder buttons
+    Rect(8, 6, 100, 30, 8, Lit(4));
+    Text(58, 21, 13, "L   " + KeyLabel(pad.lKey), Lit(4) ? cTextLit : cText, 92);
+    Rect(132, 6, 100, 30, 8, Lit(5));
+    Text(182, 21, 13, "R   " + KeyLabel(pad.rKey), Lit(5) ? cTextLit : cText, 92);
+
+    // D-pad, arms of 34
+    struct Arm { float x, y; int bit; int key; };
+    const Arm arms[] = {{45, 64, 8, pad.upKey}, {45, 132, 9, pad.downKey}, {11, 98, 10, pad.leftKey},
+                        {79, 98, 11, pad.rightKey}};
+    dl->AddRectFilled(P(45, 98), P(79, 132), cBtn);
+    for (const Arm & a : arms) {
+        Rect(a.x, a.y, 34, 34, 5, Lit(a.bit));
+        Text(a.x + 17, a.y + 17, 11, KeyLabel(a.key), Lit(a.bit) ? cTextLit : cText, 30);
+    }
+
+    // A B X Y
+    struct Face { float x, y; int bit; const char * name; int key; };
+    const Face faces[] = {{178, 78, 2, "X", pad.xKey}, {144, 112, 3, "Y", pad.yKey}, {212, 112, 0, "A", pad.aKey},
+                          {178, 146, 1, "B", pad.bKey}};
+    for (const Face & f : faces) {
+        Circle(f.x, f.y, 19, Lit(f.bit));
+        Text(f.x, f.y - 7, 15, f.name, Lit(f.bit) ? cTextLit : cText, 30);
+        Text(f.x, f.y + 9, 10, KeyLabel(f.key), Lit(f.bit) ? cTextLit : cText, 32);
+    }
+
+    // Start, Select
+    Rect(130, 196, 102, 28, 14, Lit(6));
+    Text(181, 210, 12, "START  " + KeyLabel(pad.startKey), Lit(6) ? cTextLit : cText, 94);
+    Rect(130, 232, 102, 28, 14, Lit(7));
+    Text(181, 246, 12, "SELECT  " + KeyLabel(pad.selectKey), Lit(7) ? cTextLit : cText, 94);
+
+    // the emulator's own keys
+    const std::string hints[] = {
+        "F1  hide this panel", KeyLabel(pad.frameCapToggleKey) + "  frame cap on/off",
+        KeyLabel(pad.frameCapKey) + "  hold: fast forward", KeyLabel(pad.guiKey) + "  debug window",
+    };
+    float hy = 200.0f;
+    for (const std::string & h : hints) {
+        ImVec2 c = P(10, hy);
+        float fs = 10.0f * u;
+        ImVec2 sz = font->CalcTextSizeA(fs, 100000.0f, 0.0f, h.c_str());
+        if (sz.x > 106.0f * u) {
+            fs *= 106.0f * u / sz.x;
+        }
+        dl->AddText(font, fs, ImVec2(c.x, c.y - fs / 2.0f), cDim, h.c_str());
+        hy += 16.0f;
+    }
+}

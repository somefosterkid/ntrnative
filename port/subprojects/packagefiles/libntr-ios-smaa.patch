     u8 resolution; /* the picture at this many times the DS resolution, 1..8 (sim_config.ini Resolution, BWPORT_RESOLUTION; old: Scale, BWPORT_GPU_SCALE) */
-    u8 antialias; /* bw-port (libntr-aa70.patch, libntr-ios-msaa.patch): k, 1 (off, the default) or 2 (k x k = 4 samples per pixel): sim_config.ini Antialiasing=off|4 samples (the old 2x and 4x read as 4 samples), BWPORT_AA */
+    u8 antialias; /* bw-port (libntr-aa70.patch, libntr-ios-msaa.patch): k, 1 (off, the default) or 2 (k x k = 4 samples per pixel), or 3 SMAA (libntr-ios-smaa.patch: the GPU renderer at Resolution 2 and up, one sample per pixel): sim_config.ini Antialiasing=off|4 samples|SMAA (the old 2x and 4x read as 4 samples), BWPORT_AA */
     u8 gpuDot;    /* Renderer=gpu, Scale > 1: 0 = a 1-dot polygon is an N x N block (Dot=block), 1 = one N x pixel (Dot=fine); BWPORT_GPU_DOT */
     u8 gpuLine;   /* 0 = lines and wire-frames N wide (Line=wide), 1 = one N x pixel (Line=thin); BWPORT_GPU_LINE */
     u8 gpuEdge;   /* 0 = edge marking one DS pixel wide (Edge=ds), 1 = one N x pixel (Edge=fine); BWPORT_GPU_EDGE */

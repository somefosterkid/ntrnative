+// libntr-ios-inputprio.patch: a finger event pushed on the game's thread (UIKit's delivery, SDL's pump) is handled now and not
+// queued; one from another thread waits for the event loop, as before
+int Filter(void *, SDL_Event * e) {
+    if (e->type != SDL_FINGERDOWN && e->type != SDL_FINGERMOTION && e->type != SDL_FINGERUP) return 1;
+    if (sL.winW == 0 || SDL_ThreadID() != sMainThread) return 1;
+    Event(e);
+    return 0;
+}
+
+// the releases the pad bits now show: each one logged when it came late
+void ReleasesShown(unsigned m) {
+    unsigned long long now = NowNs();
+    int k = 0;
+    for (int i = 0; i < sRelN; i++) {
+        Rel & r = sRel[i];
+        bool shown = (m & r.mask) == 0, old = now - r.sdl > 2000000000ull;   // (another finger still holds it: no release)
+        if (shown && r.hw != 0 && !r.tap) {
+            double late = (now - r.hw) / 1e6;
+            if (late > 50.0 || TouchLog()) {
+                fprintf(stderr, "input: release %.0f ms late (glass to app %.0f, app to touch layer %.0f, touch layer to pad %.0f)\n",
+                        late, (r.app - r.hw) / 1e6, (r.sdl - r.app) / 1e6, (now - r.sdl) / 1e6);
+            }
+        }
+        if (!shown && !old) sRel[k++] = r;
+    }
+    sRelN = k;
+}

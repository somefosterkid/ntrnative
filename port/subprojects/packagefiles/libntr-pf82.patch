 // ---- the menu bar -------------------------------------------------------------------------------------------------
 
+// ---- the per-stage timing readout (libntr-pf82.patch) -------------------------------------------------------------------
+// Where a frame's time goes, for a PC with a real GPU (the test host has none): the frame thread's parts (sim_main.cpp: the
+// game's logic, the events and the UI's build, the renderer's call, the picture's upload and quad, the game's V-blank work,
+// the UI's draw, the swap, the frame-rate wait, the sound step: they add up to the frame's period), the renderer bridge's own
+// stages (SIM_PerfStage: inside its call; on its worker threads beside the game) and GPU time (GL_TIME_ELAPSED queries read a
+// few frames late, so they never stall: the GPU path's passes, the present, the UI). The Metrics window's Breakdown shows
+// the mean per frame of the refresh window (Metrics refresh; a stage absent from a frame counts 0 there: what it costs a
+// frame on average) and the window's max; a stage reported in no frame of the window is hidden (the other renderer's).
+// Debug > Save performance log records kPerfLogS seconds of frames and writes perf_log.txt next to save.bin (the working
+// directory) with the GL renderer and the video settings. Nothing is timed while neither shows (PerfWanted, read by
+// sim_main once a frame). BWPORT_BREAKDOWN=1 opens the Breakdown at start, BWPORT_PERFLOG=N starts the log at frame N.
+namespace {
+const int kPerfMax = 48;
+const double kPerfLogS = 5.0;
+const char * const kPerfKind[4] = {"frame", "call", "worker", "gpu"};
+struct PerfStage {
+    const char * key;       // the caller's string (compared first)
+    char name[40];
+    int kind;               // 0 the frame thread's parts, 1 inside the renderer's call, 2 the renderer's workers, 3 GPU
+    bool rep, inLog, live;  // reported this frame; while the log records; in the last refresh window
+    double frame;           // this frame's ms
+    double win, winMax;     // the refresh window's sum and max
+    unsigned winN;          // the window's frames that reported it
+    float avg, mx;          // shown: the last window's mean per frame and max
+    double logSum, logMax;
+};
+PerfStage sPerf[kPerfMax];
+int sPerfN;
+unsigned long long sPerfWinFrames, sPerfCalls;
+double sPerfWinPeriod;
+float sPerfPeriodAvg;
+bool sPerfShown;            // the Breakdown was drawn open since PerfWanted last looked
+bool sPerfOpenLast;         // the Breakdown was open when last drawn: the metrics take the whole side (DrawSide)
+bool sPerfEnvRead, sPerfOpenAtStart;
+long long sPerfLogAt = -1;
+char sGpuNote[160];
+std::string sGlVersion;
+struct PerfRow { float period; float v[kPerfMax]; };
+std::vector<PerfRow> sLogRows;
+bool sLogOn;
+double sLogMs;
+std::string sLogHead;
+char sLogMsg[200];
+} // namespace
+
+void PerfGpuNote(const char * note) { snprintf(sGpuNote, sizeof sGpuNote, "%s", note != nullptr ? note : ""); }
+void PerfGlVersion(const char * version) { sGlVersion = version != nullptr ? version : ""; }
+
+void PerfAdd(const char * name, int kind, double ms) {
+    for (int i = 0; i < sPerfN; i++) {
+        PerfStage & p = sPerf[i];
+        if (p.kind == kind && (p.key == name || strcmp(p.name, name) == 0)) {
+            p.frame += ms;
+            p.rep = true;
+            return;
+        }
+    }
+    if (sPerfN >= kPerfMax) {
+        return;
+    }
+    PerfStage & p = sPerf[sPerfN++];
+    p = PerfStage{};
+    p.key = name;
+    snprintf(p.name, sizeof p.name, "%s", name);
+    p.kind = kind;
+    p.frame = ms;
+    p.rep = true;
+}
+
+// the settings a log was taken with
+static std::string PerfSettings() {
+    SIM_config_type * c = C();
+    int pw = 0, ph = 0, ww = 0, wh = 0;
+    SIM_RendererPicture(&pw, &ph);
+    if (sWindow != nullptr) {
+        SDL_GL_GetDrawableSize(sWindow, &ww, &wh);
+    }
+    std::string skip = c->frameSkip == SIM_CONFIG_FRAMESKIP_AUTO ? "auto" : c->frameSkip == 0 ? "off" : std::to_string((int)c->frameSkip);

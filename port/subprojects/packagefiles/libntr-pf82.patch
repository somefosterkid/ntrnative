+    snprintf(b, sizeof b,
+             "# GL renderer: %s\n# GL version: %s\n"
+             "# Renderer: %s, Resolution %d (picture %d x %d), Antialiasing %s, Smooth motion %s, Frame rate %s, Game speed %s,"
+             " Frame skip %s, Sound %s, window %d x %d\n",
+             SIM_GLRendererName(), sGlVersion.c_str(), ActiveRenderer(), SIM_RenderScale(), pw, ph,
+             AntialiasNames[AntialiasIndex(c->antialias)], c->interpolation ? "on" : "off", DisplayCapShort[DisplayCapIndex()],
+             SpeedShort[SpeedIndex()], skip.c_str(), c->sound == SIM_CONFIG_SOUND_ACORE ? "acore" : "libntr", ww, wh);
+    return b;
+}
+
+static void PerfLogStart() {
+    sLogRows.clear();
+    sLogRows.reserve(2048);
+    for (int i = 0; i < sPerfN; i++) {
+        sPerf[i].inLog = false;
+        sPerf[i].logSum = sPerf[i].logMax = 0.0;
+    }
+    sLogMs = 0.0;
+    sLogHead = PerfSettings();
+    sLogOn = true;
+    snprintf(sLogMsg, sizeof sLogMsg, "recording %g s of frames...", kPerfLogS);
+}
+
+static void PerfLogWrite() {
+    sLogOn = false;
+    size_t n = sLogRows.size();
+    FILE * f = n > 0 ? fopen("perf_log.txt", "w") : nullptr;
+    if (f == nullptr) {
+        snprintf(sLogMsg, sizeof sLogMsg, "perf_log.txt could not be written");
+        printf("bwport: perf log: perf_log.txt could not be written\n");
+        fflush(stdout);
+        return;
+    }
+    double sum = 0.0, worst = 0.0;
+    for (const PerfRow & r : sLogRows) {
+        sum += r.period;
+        worst = std::max(worst, (double)r.period);
+    }
+    time_t now = time(nullptr);
+    char ts[64] = "";
+    const struct tm * lt = localtime(&now);
+    if (lt != nullptr) {
+        strftime(ts, sizeof ts, "%Y-%m-%d %H:%M:%S", lt);
+    }
+    fprintf(f, "# bw-port performance log (Debug > Save performance log), %s. docs/perf.md says how to read it.\n", ts);
+    fputs(sLogHead.c_str(), f);
+    fprintf(f, "# GPU times: %s\n", sGpuNote[0] != 0 ? sGpuNote : "GL timer queries (GL_TIME_ELAPSED), read 5 frames late: a row's gpu columns are of a frame about 5 rows earlier");
+    fprintf(f, "# %zu frames in %.2f s: %.1f fps; frame period avg %.3f ms, worst %.3f ms\n", n, sum / 1000.0,
+            sum > 0.0 ? (double)n * 1000.0 / sum : 0.0, sum / (double)n, worst);
+    fprintf(f, "#\n# ms per frame, avg (a frame without the stage counts 0) and max. kind: frame = the main thread's parts of a frame (they add\n"
+               "# up to the period); call = inside the renderer's call (part of 'renderer'); worker = the renderer's own threads, beside the\n"
+               "# game (they overlap the frame thread: 'wait for the worker' in call is when they did not); gpu = GPU time\n");
+    fprintf(f, "# %-6s %-36s %9s %9s\n", "kind", "stage", "avg", "max");
+    int cols[kPerfMax], nc = 0;
+    for (int k = 0; k < 4; k++) {
+        double ksum = 0.0;
+        bool any = false;
+        for (int i = 0; i < sPerfN; i++) {
+            const PerfStage & p = sPerf[i];
+            if (p.kind != k || !p.inLog) {
+                continue;
+            }
+            any = true;
+            cols[nc++] = i;
+            ksum += p.logSum / (double)n;
+            fprintf(f, "  %-6s %-36s %9.3f %9.3f\n", kPerfKind[k], p.name, p.logSum / (double)n, p.logMax);
+        }
+        if (any && (k == 0 || k == 3)) {
+            fprintf(f, "  %-6s %-36s %9.3f\n", kPerfKind[k], k == 0 ? "(sum)" : "(sum: the GPU's busy time a frame)", ksum);
+        }
+    }
+    fprintf(f, "#\n# per frame, ms: the frame's period, then the stages above (kind:name)\nframe period");
+    for (int j = 0; j < nc; j++) {
+        std::string nm = sPerf[cols[j]].name;
+        for (char & ch : nm) {
+            if (ch == ' ') { ch = '_'; }
+        }
+        fprintf(f, " %s:%s", kPerfKind[sPerf[cols[j]].kind], nm.c_str());
+    }
+    fprintf(f, "\n");
+    for (size_t r = 0; r < n; r++) {
+        fprintf(f, "%zu %.3f", r, sLogRows[r].period);
+        for (int j = 0; j < nc; j++) {
+            fprintf(f, " %.3f", sLogRows[r].v[cols[j]]);
+        }
+        fprintf(f, "\n");
+    }
+    fclose(f);
+    snprintf(sLogMsg, sizeof sLogMsg, "perf_log.txt written: %zu frames, %.1f fps", n, sum > 0.0 ? (double)n * 1000.0 / sum : 0.0);
+    printf("bwport: perf log: perf_log.txt, %zu frames in %.2f s\n", n, sum / 1000.0);
+    fflush(stdout);
+    sLogRows.clear();
+    sLogRows.shrink_to_fit();
+}
+
+void PerfFrameEnd(double periodMs) {
+    sPerfWinFrames++;
+    sPerfWinPeriod += periodMs;
+    PerfRow * row = nullptr;
+    if (sLogOn) {
+        sLogRows.emplace_back();
+        row = &sLogRows.back();
+        row->period = (float)periodMs;
+        for (int i = 0; i < kPerfMax; i++) { row->v[i] = 0.0f; }
+    }
+    for (int i = 0; i < sPerfN; i++) {
+        PerfStage & p = sPerf[i];
+        if (p.rep) {
+            p.win += p.frame;
+            p.winMax = std::max(p.winMax, p.frame);
+            p.winN++;
+            if (row != nullptr) {
+                row->v[i] = (float)p.frame;
+                p.inLog = true;
+                p.logSum += p.frame;
+                p.logMax = std::max(p.logMax, p.frame);
+            }
+        }
+        p.frame = 0.0;
+        p.rep = false;
+    }
+    if (sLogOn) {
+        sLogMs += periodMs;
+        if (sLogMs >= kPerfLogS * 1000.0) {
+            PerfLogWrite();
+        }
+    }
+}
+
+// at each refresh of the metrics (FrameSnapshot): the window's means become the shown ones
+static void PerfSnapshot() {
+    for (int i = 0; i < sPerfN; i++) {
+        PerfStage & p = sPerf[i];
+        p.live = sPerfWinFrames > 0 && p.winN > 0;
+        p.avg = sPerfWinFrames > 0 ? (float)(p.win / (double)sPerfWinFrames) : 0.0f;
+        p.mx = (float)p.winMax;
+        p.win = p.winMax = 0.0;
+        p.winN = 0;
+    }
+    sPerfPeriodAvg = sPerfWinFrames > 0 ? (float)(sPerfWinPeriod / (double)sPerfWinFrames) : 0.0f;
+    sPerfWinFrames = 0;
+    sPerfWinPeriod = 0.0;
+}
+
+bool PerfWanted() {
+    if (!sPerfEnvRead) {
+        sPerfEnvRead = true;
+        const char * e = getenv("BWPORT_BREAKDOWN");
+        sPerfOpenAtStart = e != nullptr && e[0] != 0 && e[0] != '0';
+        e = getenv("BWPORT_PERFLOG");
+        if (e != nullptr && e[0] != 0) { sPerfLogAt = atoll(e); }
+    }
+    sPerfCalls++;
+    if (sPerfLogAt >= 0 && (long long)sPerfCalls >= sPerfLogAt) {
+        sPerfLogAt = -1;
+        PerfLogStart();
+    }
+    bool w = sPerfShown || sLogOn;
+    sPerfShown = false;
+    return w;
+}

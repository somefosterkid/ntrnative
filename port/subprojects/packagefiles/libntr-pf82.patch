+// the Metrics window's Breakdown (a collapsing section: closed, nothing is timed)
+static void PerfBreakdown() {
+    if (sPerfOpenAtStart) {
+        ImGui::SetNextItemOpen(true, ImGuiCond_Once);
+    }
+    bool open = ImGui::CollapsingHeader("Breakdown##perf");
+    sPerfOpenLast = open;
+    if (ImGui::IsItemHovered()) {
+        ImGui::SetTooltip("where a frame's time goes, ms per frame: the mean of the last refresh and its max (grey).\n"
+                          "Frame thread: the main thread's parts; they add up to the frame's period.\n"
+                          "Renderer call: inside 'renderer'. Workers: the renderer's threads beside the game (they overlap).\n"
+                          "GPU: GL timer queries, read 5 frames late.\n"
+                          "Debug > Save performance log writes %g s of it, frame by frame, to perf_log.txt.", kPerfLogS);
+    }
+    if (!open) {
+        return;
+    }
+    sPerfShown = true;
+    bool any = false;
+    for (int i = 0; i < sPerfN; i++) { any = any || sPerf[i].live; }
+    if (!any) {
+        ImGui::TextDisabled("measuring...");
+        return;
+    }
+    static const char * const head[4] = {"Frame thread", "Renderer call", "Renderer workers (beside the game)", "GPU"};
+    const ImVec4 hc(0.55f, 0.75f, 1.0f, 1.0f);
+    float numW = ImGui::CalcTextSize("000.00").x;
+    bool labels = false;
+    if (ImGui::BeginTable("##perft", 3, ImGuiTableFlags_None)) {
+        ImGui::TableSetupColumn("stage", ImGuiTableColumnFlags_WidthStretch);
+        ImGui::TableSetupColumn("ms", ImGuiTableColumnFlags_WidthFixed, numW);
+        ImGui::TableSetupColumn("max", ImGuiTableColumnFlags_WidthFixed, numW);
+        for (int k = 0; k < 4; k++) {
+            bool hdr = false;
+            double sum = 0.0;
+            for (int i = 0; i < sPerfN; i++) {
+                const PerfStage & p = sPerf[i];
+                if (p.kind != k || !p.live) {
+                    continue;
+                }
+                sum += p.avg;
+                if (p.mx < 0.005f) {
+                    continue; // nothing to see (the game's V-blank, the wait without a cap): the log keeps it
+                }
+                if (!hdr) {
+                    hdr = true;
+                    ImGui::TableNextRow();
+                    ImGui::TableNextColumn();
+                    ImGui::TextColored(hc, "%s", head[k]);
+                    if (!labels) {
+                        labels = true;
+                        ImGui::TableNextColumn();
+                        ImGui::TextDisabled("  ms");
+                        ImGui::TableNextColumn();
+                        ImGui::TextDisabled("  max");
+                    }
+                }
+                ImGui::TableNextRow();
+                ImGui::TableNextColumn();
+                ImGui::Text("  %s", p.name);
+                ImGui::TableNextColumn();
+                ImGui::Text("%6.2f", p.avg);
+                ImGui::TableNextColumn();
+                ImGui::TextDisabled("%6.2f", p.mx);
+            }
+            if (hdr && (k == 0 || k == 3)) {
+                ImGui::TableNextRow();
+                ImGui::TableNextColumn();
+                if (k == 0) {
+                    ImGui::TextDisabled("  sum (frame period %.2f)", sPerfPeriodAvg);
+                } else {
+                    ImGui::TextDisabled("  sum (GPU busy)");
+                }
+                ImGui::TableNextColumn();
+                ImGui::TextDisabled("%6.2f", sum);
+            }
+            if (k == 3 && !hdr) {
+                ImGui::TableNextRow();
+                ImGui::TableNextColumn();
+                ImGui::TextColored(hc, "GPU");
+                ImGui::TableNextRow();
+                ImGui::TableNextColumn();
+                ImGui::TextDisabled("  %s", sGpuNote[0] != 0 ? sGpuNote : "waiting for the first results");
+            }
+        }
+        ImGui::EndTable();
+    }
+    if (sLogMsg[0] != 0) {
+        ImGui::TextDisabled("%s", sLogMsg);
+    }
+}

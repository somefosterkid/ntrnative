+static void SwMeanRgba(const unsigned char *p, int w, int h) {
+  unsigned long long sum = 0, n = 0;
+  size_t total = (size_t)w * h;
+  for (size_t i = 0; i < total; i += 3) {  // every third pixel
+    sum += p[i * 4] + p[i * 4 + 1] + p[i * 4 + 2];
+    n += 3;
+  }
+  sSwMean = n ? (double)sum / n : 0;
+  sSwPicPx = (long)total;
+}
+static void SwMeanTex(unsigned tex, int w, int h) {
+  if (w <= 0 || h <= 0) return;
+  unsigned char *buf = (unsigned char *)malloc((size_t)w * h * 4);
+  if (buf == NULL) return;
+  GLint prevRead = 0;
+  glGetIntegerv(GL_READ_FRAMEBUFFER_BINDING, &prevRead);
+  GLuint fbo = 0;
+  glGenFramebuffers(1, &fbo);
+  glBindFramebuffer(GL_READ_FRAMEBUFFER, fbo);
+  glFramebufferTexture2D(GL_READ_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, tex, 0);
+  GLint prevPack = 4;
+  glGetIntegerv(GL_PACK_ALIGNMENT, &prevPack);
+  glPixelStorei(GL_PACK_ALIGNMENT, 1);
+  if (glCheckFramebufferStatus(GL_READ_FRAMEBUFFER) == GL_FRAMEBUFFER_COMPLETE) {
+    glReadPixels(0, 0, w, h, GL_RGBA, GL_UNSIGNED_BYTE, buf);
+    SwMeanRgba(buf, w, h);
+  }
+  glPixelStorei(GL_PACK_ALIGNMENT, prevPack);
+  glBindFramebuffer(GL_READ_FRAMEBUFFER, (GLuint)prevRead);
+  glDeleteFramebuffers(1, &fbo);
+  free(buf);
+}
+
+static void SwMemory(double *rssMB, double *privMB) {
+  *rssMB = *privMB = 0;
+#ifdef SDK_BUILD_WIN64
+  struct PMC { DWORD cb, faults; SIZE_T peak, ws, qpp, qp, qnpp, qnp, pf, ppf; } pmc;
+  memset(&pmc, 0, sizeof pmc);
+  pmc.cb = sizeof pmc;
+  typedef BOOL (WINAPI *Fn)(HANDLE, void *, DWORD);
+  Fn fn = (Fn)GetProcAddress(GetModuleHandleA("kernel32.dll"), "K32GetProcessMemoryInfo");
+  if (fn != NULL && fn(GetCurrentProcess(), &pmc, sizeof pmc)) {
+    *rssMB = pmc.ws / 1048576.0;
+    *privMB = pmc.pf / 1048576.0;
+  }
+#else
+  FILE *f = fopen("/proc/self/statm", "r");
+  if (f != NULL) {
+    long size = 0, res = 0;
+    if (fscanf(f, "%ld %ld", &size, &res) == 2) {
+      *privMB = size * 4096.0 / 1048576.0;
+      *rssMB = res * 4096.0 / 1048576.0;
+    }
+    fclose(f);
+  }
+#endif
+}

+struct SwGLCensus { int tex, fbo, buf, prog, vao, rbo; double texMB; };
+static SwGLCensus SwCensus(void) {
+  SwGLCensus c = {};
+  while (glGetError() != GL_NO_ERROR) {}
+  GLint prevTex = 0;
+  glGetIntegerv(GL_TEXTURE_BINDING_2D, &prevTex);
+  // ids are small numbers in every driver we run on (the context's own count); 8192 is far past what the game makes
+  for (GLuint id = 1; id < 8192; id++) {
+    if (glIsTexture(id)) {
+      c.tex++;
+      glBindTexture(GL_TEXTURE_2D, id);
+      GLint w = 0, h = 0, bits = 0, v = 0;
+      glGetTexLevelParameteriv(GL_TEXTURE_2D, 0, GL_TEXTURE_WIDTH, &w);
+      glGetTexLevelParameteriv(GL_TEXTURE_2D, 0, GL_TEXTURE_HEIGHT, &h);
+      static const GLenum sizes[] = {GL_TEXTURE_RED_SIZE, GL_TEXTURE_GREEN_SIZE, GL_TEXTURE_BLUE_SIZE, GL_TEXTURE_ALPHA_SIZE,
+                                     GL_TEXTURE_DEPTH_SIZE, GL_TEXTURE_STENCIL_SIZE};
+      for (GLenum s : sizes) {
+        v = 0;
+        glGetTexLevelParameteriv(GL_TEXTURE_2D, 0, s, &v);
+        bits += v;
+      }
+      c.texMB += (double)w * h * (bits / 8.0) / 1048576.0;
+    }
+    if (glIsFramebuffer(id)) c.fbo++;
+    if (glIsBuffer(id)) c.buf++;
+    if (glIsProgram(id)) c.prog++;
+    if (glIsVertexArray(id)) c.vao++;
+    if (glIsRenderbuffer(id)) c.rbo++;
+  }
+  glBindTexture(GL_TEXTURE_2D, (GLuint)prevTex);
+  while (glGetError() != GL_NO_ERROR) {}
+  return c;
+}

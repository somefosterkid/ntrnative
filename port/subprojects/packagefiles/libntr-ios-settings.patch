+
+// bw-port (libntr-ios-settings.patch): the menu button (or BWPORT_SETTINGS_TEST) opens the native settings sheet
+// (port/src/ios_settings.m); the game and its sound stand still, and the run loop is pumped for UIKit, until it is dismissed
+extern "C" void bwport_ios_settings_present(void) __attribute__((weak));
+extern "C" int bwport_ios_settings_is_open(void) __attribute__((weak));
+extern "C" int bwport_ios_settings_test_wants(void) __attribute__((weak));
+static void SimTouchSettingsWait(void) {
+  if (!SimTouch_Active()) return;
+  if (bwport_ios_settings_test_wants != NULL && bwport_ios_settings_test_wants()) SimTouch_MenuRequest();
+  if (!SimTouch_MenuOpen()) return;
+  if (bwport_ios_settings_present == NULL) {
+    SimTouch_MenuClose();
+    return;
+  }
+  fprintf(stderr, "bwport: settings open: paused\n");
+  SDL_PauseAudio(1);
+  bwport_ios_settings_present();
+  while (bwport_ios_settings_is_open() && !SimTouch_Background()) {
+    SDL_PumpEvents();
+    SDL_Delay(10);
+  }
+  while (bwport_ios_settings_is_open()) {  // (backgrounded with the sheet up: wait for the foreground, then for its end)
+    SDL_PumpEvents();
+    SDL_Delay(50);
+  }
+  SDL_FlushEvents(SDL_FINGERDOWN, SDL_FINGERMOTION);
+  SimTouch_MenuClose();
+  SDL_PauseAudio(0);
+  fprintf(stderr, "bwport: settings closed: resumed\n");
 }
 

+// ---- the native settings sheet's way in (port/src/ios_settings.m), libntr-ios-settings.patch ------------------------------------
+// Every setting is an int by name; a write applies it through the same helpers as the desktop menus and saves sim_config.ini.
+// renderer 0..2 (auto, vcore, gpu); resolution 1..8; antialias 0..2 (off, 2x, 4x); smooth, filter (0 nearest, 1 bilinear), line, edge,
+// musicnormal, overlay, corner (0 left, 1 right), detail (0 compact, 1 detailed) 0/1; speed 1..4; framerate 0..3 (60, 120, Monitor,
+// Unlimited); frameskip 0..4 (off, 1, 2, 3, auto); volume 0..100. Read only: active (0 starting, 1 vcore, 2 gpu), scale.
+extern "C" int SIM_UISettingGet(const char * k) {
+    using namespace SIM::GUI;
+    SIM_config_type * c = C();
+    if (!strcmp(k, "renderer")) return c->renderer < 3 ? c->renderer : 0;
+    if (!strcmp(k, "resolution")) return c->resolution;
+    if (!strcmp(k, "antialias")) return AntialiasIndex(c->antialias);
+    if (!strcmp(k, "smooth")) return c->interpolation != 0;
+    if (!strcmp(k, "filter")) return c->gpuFilter != 0;
+    if (!strcmp(k, "line")) return c->gpuLine != 0;
+    if (!strcmp(k, "edge")) return c->gpuEdge != 0;
+    if (!strcmp(k, "speed")) return SpeedIndex() + 1;
+    if (!strcmp(k, "framerate")) return DisplayCapIndex();
+    if (!strcmp(k, "musicnormal")) return c->musicNormalSpeed != 0;
+    if (!strcmp(k, "frameskip")) return FrameSkipIndex();
+    if (!strcmp(k, "volume")) return (int)((c->masterVolume * 100 + 63) / 127);
+    if (!strcmp(k, "overlay")) return c->overlay != 0;
+    if (!strcmp(k, "corner")) return c->overlayCorner != 0;
+    if (!strcmp(k, "detail")) return c->overlayDetail != 0;
+    if (!strcmp(k, "active")) return SIM_RendererActive();
+    if (!strcmp(k, "scale")) return SIM_RenderScale();
+    return -1;
+}
+
+extern "C" const char * SIM_UIStatus(void) { return SIM_RendererStatus(); }
+
+extern "C" void SIM_UISettingSet(const char * k, int v) {
+    using namespace SIM::GUI;
+    SIM_config_type * c = C();
+    if (!strcmp(k, "renderer")) c->renderer = (u8)(v < 0 ? 0 : v > 2 ? 2 : v);
+    else if (!strcmp(k, "resolution")) c->resolution = (u8)(v < 1 ? 1 : v > 8 ? 8 : v);
+    else if (!strcmp(k, "antialias")) c->antialias = (u8)(v >= 2 ? 4 : v == 1 ? 2 : 1);
+    else if (!strcmp(k, "smooth")) c->interpolation = (u8)(v != 0);
+    else if (!strcmp(k, "filter")) c->gpuFilter = (u8)(v != 0);
+    else if (!strcmp(k, "line")) c->gpuLine = (u8)(v != 0);
+    else if (!strcmp(k, "edge")) c->gpuEdge = (u8)(v != 0);
+    else if (!strcmp(k, "speed")) SetSpeed((v < 1 ? 1 : v > 4 ? 4 : v) - 1);
+    else if (!strcmp(k, "framerate")) SetDisplayCap(v < 0 ? 0 : v > 3 ? 3 : v);
+    else if (!strcmp(k, "musicnormal")) c->musicNormalSpeed = (u8)(v != 0);
+    else if (!strcmp(k, "frameskip")) SetFrameSkip(v < 0 ? 0 : v > 4 ? 4 : v);
+    else if (!strcmp(k, "volume")) c->masterVolume = (u8)(((v < 0 ? 0 : v > 100 ? 100 : v) * 127 + 50) / 100);
+    else if (!strcmp(k, "overlay")) c->overlay = (u8)(v != 0);
+    else if (!strcmp(k, "corner")) c->overlayCorner = (u8)(v != 0);
+    else if (!strcmp(k, "detail")) c->overlayDetail = (u8)(v != 0);
+    else return;
+    SIM_Config_SaveConfigFile(c);
+    fprintf(stderr, "bwport: setting %s=%d\n", k, v);
+}

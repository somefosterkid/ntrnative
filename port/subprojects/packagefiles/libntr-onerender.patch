-// Texture slot n (128 KB at n*0x20000 of texture memory) is the n-th mapped bank in A..D order
-// (GX_VRAM_TEX_01_AC: A is slot 0, C slot 1). NULL when the slot has no bank.
-static u8* getTextureSlot(u32 slot)
-{
-	u32 mask = (u32)s_SIM_GXVRamTex;
-	for(u32 bank = 0; bank < 4; bank++) {
-		if(mask & (1u << bank)) {
-			if(slot == 0) {
-				return (u8*)((uPtr)HW_LCDC_VRAM_A + bank * 0x20000);
-			}
-			slot--;
-		}
-	}
-	return NULL;
-}
-
-// Copy len bytes of texture memory from off into dst; missing slots read as 0.
-static void readTextureVram(u8* dst, u32 off, u32 len)
-{
-	while(len) {
-		u32 inSlot = 0x20000 - (off & 0x1FFFF);
-		u32 n = len < inSlot ? len : inSlot;
-		u8* slot = (off < 0x80000) ? getTextureSlot(off >> 17) : NULL;
-		if(slot) {
-			memcpy(dst, slot + (off & 0x1FFFF), n);
-		} else {
-			memset(dst, 0, n);
-		}
-		dst += n; off += n; len -= n;
-	}
-}
-
-// GX_TEXFMT_COMP4x4: 2 bit texels in 4x4 blocks (4 bytes each) at off, one u16 per block (palette
-// offset in words in bits 0-13, mode in 14-15) at the slot 1/3 area, half the offset.
-static void decodeTexComp4x4(const u8* texels, const u16* idx, const u16* pal, u8* out, u32 w, u32 h)
-{
-	for(u32 by = 0; by < h / 4; by++) {
-		for(u32 bx = 0; bx < w / 4; bx++) {
-			u32 blk = by * (w / 4) + bx;
-			u16 ix = idx[blk];
-			const u16* pp = pal + (ix & 0x3FFF) * 2;
-			u32 mode = ix >> 14;
-			u8 c[4][4]; // r g b a
-			u16 raw[4] = { pp[0], pp[1], pp[2], pp[3] };
-			u8 rgb[4][3];
-			for(int k = 0; k < 4; k++) {
-				SIM_u16ToRGB(raw[k], &rgb[k][0], &rgb[k][1], &rgb[k][2]);
-			}
-			for(int k = 0; k < 4; k++) {
-				c[k][0] = rgb[k][0]; c[k][1] = rgb[k][1]; c[k][2] = rgb[k][2]; c[k][3] = 255;
-			}
-			if(mode == 0 || mode == 1) {
-				c[3][0] = c[3][1] = c[3][2] = c[3][3] = 0;
-			}
-			if(mode == 1) {
-				for(int k = 0; k < 3; k++) c[2][k] = (u8)((rgb[0][k] + rgb[1][k]) / 2);
-			} else if(mode == 3) {
-				for(int k = 0; k < 3; k++) {
-					c[2][k] = (u8)((rgb[0][k] * 5 + rgb[1][k] * 3) / 8);
-					c[3][k] = (u8)((rgb[0][k] * 3 + rgb[1][k] * 5) / 8);
-				}
-			}
-			for(u32 y = 0; y < 4; y++) {
-				u8 row = texels[blk * 4 + y];
-				for(u32 x = 0; x < 4; x++) {
-					u32 v = (row >> (x * 2)) & 3;
-					u8* o = out + (((by * 4 + y) * w) + bx * 4 + x) * 4;
-					o[0] = c[v][0]; o[1] = c[v][1]; o[2] = c[v][2]; o[3] = c[v][3];
-				}
-			}
-		}
-	}
-}

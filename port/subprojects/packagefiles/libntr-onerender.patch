+  const char *an = sActive == 2 ? "gpu" : "vcore";
+  char gl[100] = "";
+  if (sActive == 2) {
+    const char *name = SIM_GLRendererName();
+    if (name == NULL || name[0] == 0) name = (const char *)glGetString(GL_RENDERER);
+    if (name != NULL) snprintf(gl, sizeof gl, " on %s", name);
+  }
+  if (sFailReason[0] != 0 && sFailWanted == want && sActive != (want == SIM_CONFIG_RENDERER_GPU ? 2 : 1)) {
+    snprintf(buf, sizeof buf, "%s %dx failed (%s): %s draws %dx%d, %.1f ms", wn, n, sFailReason, an, sPicW, sPicH, sCostMs);
+  } else if (sActive != (want == SIM_CONFIG_RENDERER_GPU ? 2 : 1)) {
+    snprintf(buf, sizeof buf, "%s %dx: %s draws %dx%d, %.1f ms", wn, n, an, sPicW, sPicH, sCostMs);
+  } else {
+    snprintf(buf, sizeof buf, "%s %dx: %dx%d, %.1f ms%s", an, n, sPicW, sPicH, sCostMs, gl);
+  }
+  return buf;
+}
+
+// each frame, before the picture is drawn: a changed renderer or resolution bumps the serial, starts the overlay and
+// retitles the window
+static void SIM_RendererPoll(void) {
+  int want = SIM_RendererWanted(), n = SIM_RenderScale();
+  u32 frame = *((u32 *)HW_VBLANK_COUNT_BUF);
+  if (want != sLastWanted || n != sLastRes) {
+    sLastWanted = want;
+    sLastRes = n;
+    sRendererSerial++;
+    sFailReason[0] = 0;
+    sStatusUntil = frame + 240;
+    sLogAt = frame + 8;
+  }
+  if (sLogAt != 0 && frame >= sLogAt) { // the log: what the settings gave, once the new renderer has drawn
+    sLogAt = 0;
+    fprintf(stderr, "bwport: renderer: %s\n", SIM_RendererStatus());
+    fflush(stderr);
+  }
+  if (window != NULL) {
+    char t[256];
+    int ok = sActive == (want == SIM_CONFIG_RENDERER_GPU ? 2 : 1);
+    snprintf(t, sizeof t, "%s - %s %dx%s", sBaseTitle.c_str(), want == SIM_CONFIG_RENDERER_GPU ? "gpu" : "vcore", n,
+             ok || sActive == 0 ? "" : (sActive == 2 ? " (gpu drawing)" : " (vcore drawing)"));
+    if (sShownTitle != t) {
+      sShownTitle = t;
+      SDL_SetWindowTitle(window, t);
+    }
+  }
+  if (frame < sStatusUntil) SIM::GUI::DrawStatus(SIM_RendererStatus());
+}
+
+// BWPORT_SWITCH_TEST=renderer:N,renderer:N,...[/FRAMES]: the live switch test. Each step sets the renderer (auto, vcore,
+// gpu) and the resolution as the Config window would, runs FRAMES frames (default 90, 60 more at the start), and checks
+// at the end that the renderer in force drew a picture of 256N x 384N; the cost of a frame (render work in ms, the
+// last two thirds of the step) is printed to stderr and switch_test.txt. Exit status 0 when every step passed.
+// Example: BWPORT_SWITCH_TEST=vcore:1,gpu:1,gpu:2,gpu:4,gpu:1,vcore:1/60
+struct SwStep { int renderer, res; };
+static std::vector<SwStep> sSwSteps;
+static int sSwFrames = 90, sSwIdx = -2, sSwFrame, sSwN, sSwFails;
+static double sSwCost, sSwPrevCost;
+static int sSwActive, sSwW, sSwH;
+
+static void SwOut(const char *fmt, ...) {
+  char line[400];
+  va_list ap;
+  va_start(ap, fmt);
+  vsnprintf(line, sizeof line, fmt, ap);
+  va_end(ap);
+  fputs(line, stderr);
+  fflush(stderr);
+  FILE *f = fopen("switch_test.txt", "a");
+  if (f != NULL) {
+    fputs(line, f);
+    fclose(f);
+  }
+}
+
+static void SwApply(int i) {
+  s_SIM_config.renderer = (u8)sSwSteps[i].renderer;
+  s_SIM_config.resolution = (u8)sSwSteps[i].res;
+  sSwFrame = 0;
+  sSwN = 0;
+  sSwCost = 0;
+}
+
+static void SIM_SwitchTest(void) {
+  if (sSwIdx == -2) {
+    const char *e = getenv("BWPORT_SWITCH_TEST");
+    sSwIdx = -3;
+    if (e == NULL || !*e) return;
+    char *dup = strdup(e);
+    char *slash = strchr(dup, '/');
+    if (slash != NULL) {
+      *slash = 0;
+      sSwFrames = atoi(slash + 1) > 6 ? atoi(slash + 1) : 90;
+    }
+    for (char *tok = strtok(dup, ","); tok != NULL; tok = strtok(NULL, ",")) {
+      char *colon = strchr(tok, ':');
+      SwStep st;
+      st.res = colon != NULL ? atoi(colon + 1) : 1;
+      st.res = st.res < 1 ? 1 : st.res > 8 ? 8 : st.res;
+      st.renderer = strncmp(tok, "gpu", 3) == 0 ? SIM_CONFIG_RENDERER_GPU
+                  : strncmp(tok, "vcore", 5) == 0 ? SIM_CONFIG_RENDERER_VCORE : SIM_CONFIG_RENDERER_AUTO;
+      sSwSteps.push_back(st);
+    }
+    free(dup);
+    if (sSwSteps.empty()) return;
+    remove("switch_test.txt");
+    sSwIdx = -1;
+    sSwFrame = 0;
+    SwOut("switch-test: %d steps of %d frames\n", (int)sSwSteps.size(), sSwFrames);
+  }
+  if (sSwIdx == -3) return;
+  sSwFrame++;
+  if (sSwIdx == -1) { // the game runs a while before the first step
+    if (sSwFrame >= 60) { sSwIdx = 0; SwApply(0); }
+    return;
+  }
+  if (sSwFrame > sSwFrames / 3) { // the first third of a step settles (a renderer starting up takes long frames)
+    sSwCost += sRenderWorkTime / 1e6;
+    sSwN++;
+    sSwActive = sActive;
+    SIM_RendererPicture(&sSwW, &sSwH);
+  }
+  if (sSwFrame < sSwFrames) return;
+  SwStep st = sSwSteps[sSwIdx];
+  int want = st.renderer;
+  if (want == SIM_CONFIG_RENDERER_AUTO) want = SIM_RendererWanted();
+  int wantActive = want == SIM_CONFIG_RENDERER_GPU ? 2 : 1;
+  double cost = sSwN > 0 ? sSwCost / sSwN : 0;
+  bool ok = sSwActive == wantActive && sSwW == 256 * st.res && sSwH == 384 * st.res && cost > 0;
+  if (!ok) sSwFails++;
+  SwOut("switch-test step %d: %s:%d -> %s drew %dx%d (want %dx%d), render %.2f ms (was %.2f): %s\n", sSwIdx,
+        st.renderer == SIM_CONFIG_RENDERER_GPU ? "gpu" : st.renderer == SIM_CONFIG_RENDERER_VCORE ? "vcore" : "auto",
+        st.res, sSwActive == 2 ? "gpu" : sSwActive == 1 ? "vcore" : "nothing", sSwW, sSwH, 256 * st.res, 384 * st.res, cost,
+        sSwPrevCost, ok ? "ok" : "FAIL");
+  sSwPrevCost = cost;
+  if (++sSwIdx >= (int)sSwSteps.size()) {
+    SwOut("switch-test: %s\n", sSwFails == 0 ? "PASS" : "FAIL");
+    fflush(NULL);
+    _exit(sSwFails == 0 ? 0 : 1);
+  }
+  SwApply(sSwIdx);
 }

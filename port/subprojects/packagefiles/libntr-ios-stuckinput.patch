+          ms(sStT[3], sStT[4]), ms(sStT[4], sStT[5]), ms(sStT[5], sStT[6]), ms(sStT[6], sStT[7]), ms(sStT[7], endNs), over / 1e6,
+          SIM_PadNames(sPadSrc[2], t), SIM_PadNames(sPadSrc[0], k), SIM_PadNames(sPadSrc[1], c));
+  if (skipped > 0) fprintf(stderr, " (%d left out before)", skipped);
+  fputc('\n', stderr);
+}

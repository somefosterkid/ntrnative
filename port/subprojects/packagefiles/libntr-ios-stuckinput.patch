+// reach SDL's key state).
+static void PadStaleCheck(void) {
+  static u64 since[2][12];
+  static int keysTest = -1;
+  if (keysTest < 0) keysTest = getenv("BWPORT_KEYS") != NULL || getenv("BWPORT_VPAD") != NULL;
+  const u64 now = SpNowNs();
+  const Uint8 *ks = SDL_GetKeyboardState(NULL);
+  const SDL_Keycode keys[12] = {s_SIM_config.padSettings.aKey, s_SIM_config.padSettings.bKey, s_SIM_config.padSettings.xKey,
+                                s_SIM_config.padSettings.yKey, s_SIM_config.padSettings.lKey, s_SIM_config.padSettings.rKey,
+                                s_SIM_config.padSettings.startKey, s_SIM_config.padSettings.selectKey, s_SIM_config.padSettings.upKey,
+                                s_SIM_config.padSettings.downKey, s_SIM_config.padSettings.leftKey, s_SIM_config.padSettings.rightKey};
+  for (int src = 0; src < 2; src++) {
+    for (int b = 0; b < 12; b++) {
+      bool stale = false;
+      if ((sPadSrc[src] >> b) & 1) {
+        if (src == 0 && SIM_IOS && !keysTest) {
+          stale = !ks[SDL_GetScancodeFromKey(keys[b])];
+        } else if (src == 1 && sPadUseGC && sPadGC != NULL) {
+          stale = true;
+          for (int k = 0; k < SDL_CONTROLLER_BUTTON_MAX; k++) {
+            if (sPadGCMap[k] == b && SDL_GameControllerGetButton(sPadGC, (SDL_GameControllerButton)k)) stale = false;
+          }
+        }
+      }
+      if (!stale) { since[src][b] = 0; continue; }
+      if (since[src][b] == 0) since[src][b] = now;
+      if (now - since[src][b] < 150000000ull) continue;
+      char nm[64];
+      SIM_Anomaly("%s holds %s but the %s reports it up (%.0f ms): let go", src == 0 ? "keyboard" : "controller",
+                  SIM_PadNames(1u << b, nm), src == 0 ? "key state" : "controller", (now - since[src][b]) / 1e6);
+      PadSrcSet(src, b, false);
+      since[src][b] = 0;

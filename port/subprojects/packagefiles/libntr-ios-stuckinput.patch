+// a finger leaves the glass (its up, or libntr-ios-stuckinput.patch: UIKit ended it and the up did not come): its buttons are let go and
+// the release is followed to the pad bits (hw, app: when it left the glass and when the app got that; 0 unknown)
+void Lift(Finger * f, unsigned long long hw, unsigned long long app) {
+    unsigned held = HeldBy(*f);
+    if (held != 0 || TouchLog()) {
+        Rel r = {held, hw, app, NowNs(), false};
+        if (r.hw > r.sdl || r.app > r.sdl) r.hw = r.app = 0;
+        for (int i = 0; i < B_COUNT; i++) {

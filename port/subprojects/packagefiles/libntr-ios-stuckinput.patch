+        if (TouchLog()) {
+            fprintf(stderr, "bwport: touch finger %llx up at %.0f,%.0f held %03x: glass to app %.1f ms, app to touch layer %.1f ms\n",
+                    (unsigned long long)f->id, f->x, f->y, held, r.hw ? (r.app - r.hw) / 1e6 : -1.0, r.hw ? (r.sdl - r.app) / 1e6 : -1.0);
+        }
+        if (held != 0) {
+            if (sRelN == 10) memmove(&sRel[0], &sRel[1], 9 * sizeof(Rel));

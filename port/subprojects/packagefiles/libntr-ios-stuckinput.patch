+                        (unsigned long long)f.id, SIM_PadNames(HeldBy(f), nm), f.kind, (now - f.downAt) / 1e6, (now - endApp) / 1e6);
+            Lift(&f, 0, 0);
+        } else if (endApp == 0 && !f.missLogged && seen != 0 && lastEv > seen && now - seen > 500000000ull) {
+            f.missLogged = true;
+            SIM_Anomaly("touch finger %llx (%s, kind %d, %.0f ms) missing from UIKit's touch events for %.0f ms, no end seen: still held",
+                        (unsigned long long)f.id, SIM_PadNames(HeldBy(f), nm), f.kind, (now - f.downAt) / 1e6, (now - seen) / 1e6);
+        }
+    }
+}

+// libntr-ios-stuckinput.patch (port/src/ios_input.m, main thread): UIKit has dispatched a touch's end or cancel. SDL's view turns it
+// into the finger up inside that dispatch, so a finger the layer still holds now had its end held back from the view (a gesture
+// recognizer that delays ends): it is let go now and logged.
+void SimTouch_UIKitEnded(unsigned long long finger, int cancelled, unsigned long long hwNs, unsigned long long appNs) {
+    if (sL.winW == 0) return;
+    Finger * f = FindFinger((SDL_FingerID)finger);
+    if (f == NULL) return;
+    if (f->kind != K_DEAD) {
+        char nm[64];
+        SIM_Anomaly("touch finger %llx (%s, kind %d, %.0f ms) %s by UIKit but the end did not reach the game's view: let go", finger,
+                    SIM_PadNames(HeldBy(*f), nm), f->kind, (NowNs() - f->downAt) / 1e6, cancelled ? "cancelled" : "ended");
+    }
+    Lift(f, hwNs <= appNs ? hwNs : 0, appNs);
+}
+// a cancel SDL's view got (a recognizer or the system took the touch): logged; SDL sends the up

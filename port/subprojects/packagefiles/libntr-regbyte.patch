libntr-regbyte.patch: a byte offset on a register address is a byte, as on the DS (HW_IOREG + 0x4c + 1).
The X86 map makes REG_x_ADDR the address of a host variable typed REGType16v, so REG_MOSAIC_ADDR + 1 was
two bytes on: the next host variable (the low byte of BLDCNT), not the OBJ mosaic byte. libntr's own
G2_SetOBJMosaicSize / G2_SetDBOBJMosaicSize / G2_GetWnd1InsidePlane / ...OutsidePlane (the (+ 1) in nitro/gx/g2.h)
and the games' raw (s8 *)(REG_MOSAIC_ADDR + 1) and *(u8 *)(REG_WININ_ADDR + 1) wrote and read the wrong
register. The six that are stepped by one byte are `u8 *` now; the reg_* macros cast them as before.

--- a/include/nitro/hw/X86/ioreg_G2.h
+++ b/include/nitro/hw/X86/ioreg_G2.h
@@ -252,19 +252,19 @@
 /* WININ */
 
 #define REG_WININ_OFFSET                                   0x048
-#define REG_WININ_ADDR                                     (&s_reg_G2_WININ)
+#define REG_WININ_ADDR                                     ((u8 *)&s_reg_G2_WININ)
 #define reg_G2_WININ                                       (*( REGType16v *) REG_WININ_ADDR)
 
 /* WINOUT */
 
 #define REG_WINOUT_OFFSET                                  0x04a
-#define REG_WINOUT_ADDR                                    (&s_reg_G2_WINOUT)
+#define REG_WINOUT_ADDR                                    ((u8 *)&s_reg_G2_WINOUT)
 #define reg_G2_WINOUT                                      (*( REGType16v *) REG_WINOUT_ADDR)
 
 /* MOSAIC */
 
 #define REG_MOSAIC_OFFSET                                  0x04c
-#define REG_MOSAIC_ADDR                                    (&s_reg_G2_MOSAIC)
+#define REG_MOSAIC_ADDR                                    ((u8 *)&s_reg_G2_MOSAIC)
 #define reg_G2_MOSAIC                                      (*( REGType16v *) REG_MOSAIC_ADDR)
 
 /* BLDCNT */
--- a/include/nitro/hw/X86/ioreg_G2S.h
+++ b/include/nitro/hw/X86/ioreg_G2S.h
@@ -251,19 +251,19 @@
 /* DB_WININ */
 
 #define REG_DB_WININ_OFFSET                                0x1048
-#define REG_DB_WININ_ADDR                                  (&s_reg_G2S_DB_WININ)
+#define REG_DB_WININ_ADDR                                  ((u8 *)&s_reg_G2S_DB_WININ)
 #define reg_G2S_DB_WININ                                   (*( REGType16v *) REG_DB_WININ_ADDR)
 
 /* DB_WINOUT */
 
 #define REG_DB_WINOUT_OFFSET                               0x104a
-#define REG_DB_WINOUT_ADDR                                 (&s_reg_G2S_DB_WINOUT)
+#define REG_DB_WINOUT_ADDR                                 ((u8 *)&s_reg_G2S_DB_WINOUT)
 #define reg_G2S_DB_WINOUT                                  (*( REGType16v *) REG_DB_WINOUT_ADDR)
 
 /* DB_MOSAIC */
 
 #define REG_DB_MOSAIC_OFFSET                               0x104c
-#define REG_DB_MOSAIC_ADDR                                 (&s_reg_G2S_DB_MOSAIC)
+#define REG_DB_MOSAIC_ADDR                                 ((u8 *)&s_reg_G2S_DB_MOSAIC)
 #define reg_G2S_DB_MOSAIC                                  (*( REGType16v *) REG_DB_MOSAIC_ADDR)
 
 /* DB_BLDCNT */

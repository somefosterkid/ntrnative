+// libntr-ios-ffpace.patch: the display link: iOS's CADisplayLink; elsewhere, with BWPORT_PANELHZ=N, a pretended one (refreshes every
+// 1/N s on the clock, the swaps no longer wait for the V-blank), so the iOS present path (slots locked to the link, the panel model
+// and its drops) runs on a desktop for tests. 0: no link (the swap waits for the V-blank as before).
+static int SpPanelEnvHz(void) {
+  static int hz = -1;
+  if (hz < 0) hz = getenv("BWPORT_PANELHZ") != NULL ? atoi(getenv("BWPORT_PANELHZ")) : 0;
+  return hz < 0 ? 0 : hz;
+}
+static int SpLink(u64 *vs, u64 *per) {
+#if SIM_IOS
+  unsigned long long a = 0, b = 0;
+  int ok = bwport_ios_vsync(&a, &b);
+  *vs = a;
+  *per = b;
+  return ok;
+#else
+  if (SpPanelEnvHz() <= 0) return 0;
+  *per = 1000000000ull / (u64)SpPanelEnvHz();
+  *vs = SpNowNs() / *per * *per;
+  return 1;
+#endif
+}

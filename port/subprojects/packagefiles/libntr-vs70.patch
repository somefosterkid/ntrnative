+static inline u64 FLNow(void) {
+  struct timespec t;
+  clock_gettime(CLOCK_MONOTONIC, &t);
+  return (u64)t.tv_sec * 1000000000ull + (u64)t.tv_nsec;
+}
+static inline void FLStamp(int i) {
+  if (sFLOn > 0) sFLT[i] = FLNow();
+}
+static void FLClose(void) {
+  if (sFLFile != NULL) fclose(sFLFile);
+  sFLFile = NULL;
+}
+extern "C" u64 SIM_FrameLogNow(void) { return sFLOn > 0 ? FLNow() : 0; } // the bridges time their parts with this
+extern "C" int SIM_FrameLogOn(void) { return sFLOn > 0; }
+extern "C" void SIM_FrameLogExtra(int i, u64 ns) {
+  if (sFLOn > 0 && i >= 0 && i < 8) sFLExtra[i] = ns;
+}
+// BWPORT_NOPRESENT=1: nothing is uploaded, drawn or swapped (no frame reaches the window): the frame loop's CPU side alone,
+// for timing the game and the renderers on a host whose GL (llvmpipe, GDI) is slower than the machine they are for
+static int sNoPresent = -1;
+extern "C" int SIM_NoPresent(void) {
+  if (sNoPresent < 0) {
+    const char *e = getenv("BWPORT_NOPRESENT");
+    sNoPresent = e != NULL && e[0] != 0 && e[0] != '0';
+  }
+  return sNoPresent;
+}
+static void FLInit(void) {
+  const char *f = getenv("BWPORT_FRAMELOG");
+  sFLOn = 0;
+  if (f != NULL && f[0] != 0) {
+    sFLFile = fopen(f, "w");
+    if (sFLFile != NULL) {
+      static char buf[1 << 16];
+      setvbuf(sFLFile, buf, _IOFBF, sizeof buf);
+      fprintf(sFLFile, "# n t_ms period game events imgui_new render vblank imgui_render swap cap sound upload skip x0 x1 x2 x3 x4 x5 x6 x7 (us)\n");
+      atexit(FLClose);
+      sFLOn = 1;
+    }
+  }
+}

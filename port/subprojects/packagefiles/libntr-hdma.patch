+/* bw-port (libntr-hdma.patch): an H-blank DMA copies `size` bytes from src to dest in the H-blank after each of the
+ * lines 0-191 (the source advances, the destination reloads), so line y > 0 shows src's entry y - 1 and the register
+ * holds entry 191 after the frame. The PC has no H-blank: the channel is recorded here and the frame renderer reads it
+ * (sim_vcapture.cpp's SIM_VCapHDma: one register value per line; SIM_HDmaFrameDone: entry 191 into the register
+ * after the frame). MI_StopDma ends it. It was one memcpy of size bytes: only entry 0 reached the register. */
+static struct {
+    const void *src;
+    void *dest;
+    u32 size;
+} sHDma[4];
+
+int MIi_PortHDmaGet(u32 dmaNo, const void **src, void **dest, u32 *size)
+{
+    if (dmaNo > 3 || sHDma[dmaNo].dest == NULL) return 0;
+    *src = sHDma[dmaNo].src;
+    *dest = sHDma[dmaNo].dest;
+    *size = sHDma[dmaNo].size;
+    return 1;
+}
+
+void MIi_PortHDmaStop(u32 dmaNo)
+{
+    if (dmaNo <= 3) sHDma[dmaNo].dest = NULL;
+}
+
+static void PortHDmaStart(u32 dmaNo, const void *src, void *dest, u32 size)
+{
+    if (dmaNo > 3) return;
+    sHDma[dmaNo].dest = NULL;
+    if (size == 0 || src == NULL || dest == NULL) return;
+    sHDma[dmaNo].src = src;
+    sHDma[dmaNo].size = size;
+    sHDma[dmaNo].dest = dest;
+}
+
 void MI_HBlankDmaCopy32(u32 dmaNo, const void *src, void *dest, u32 size)
 {
-    memcpy(dest, src, size);
+    PortHDmaStart(dmaNo, src, dest, size);
 }
 
 void MI_HBlankDmaCopy16(u32 dmaNo, const void *src, void *dest, u32 size)
 {
-    memcpy(dest, src, size);
+    PortHDmaStart(dmaNo, src, dest, size);
 }
 
 void MI_HBlankDmaCopy32If(u32 dmaNo, const void *src, void *dest, u32 size)
 {
-    memcpy(dest, src, size);
+    PortHDmaStart(dmaNo, src, dest, size);
 }
 
 void MI_HBlankDmaCopy16If(u32 dmaNo, const void *src, void *dest, u32 size)
 {
-    memcpy(dest, src, size);
+    PortHDmaStart(dmaNo, src, dest, size);
 }
 #endif

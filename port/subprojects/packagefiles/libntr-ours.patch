+// a submenu of radio items over a names list (value index, change callback done by the caller through the return: -1 = no change)
+static int MenuPick(const char * title, const char * const * names, int n, int cur) {
+    int pick = -1;
+    if (ImGui::BeginMenu(title)) {
+        for (int i = 0; i < n; i++) {
+            if (MenuRadio(names[i], cur == i)) { pick = i; }
+        }
+        ImGui::EndMenu();
+    }
+    return pick;

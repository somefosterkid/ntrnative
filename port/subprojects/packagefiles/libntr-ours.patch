+void DrawSide(float x, float y, float w, float h, unsigned pressed, int metrics, int controller) {
+    sSideRect[0] = x; sSideRect[1] = y; sSideRect[2] = w; sSideRect[3] = h;
+    sSideMetrics = metrics; sSideController = controller;
+    if (w <= 0.0f || h <= 0.0f) {
+        return;
+    }
+    ImDrawList * bg = ImGui::GetBackgroundDrawList();
+    bg->AddRectFilled(ImVec2(x, y), ImVec2(x + w, y + h), cBack);
+    float mh = 0.0f;
+    sSideH = h;
+    if (metrics && controller && !sPerfOpenLast) {
+        mh = floorf(std::min(h * 0.75f, std::max(h * 0.40f, sMetricsContentH)));
+    } else if (metrics) {
+        mh = h; // libntr-pf82.patch: with the Breakdown open the metrics take the whole side (the controller comes back when it closes)
+    }
+    if (metrics) {
+        SideMetrics(x, y, w, mh);
+    }
+    if (controller && mh < h) {
+        SideController(x, y + mh, w, h - mh, pressed);
+    }
+}

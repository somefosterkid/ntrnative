+    else if (!strcmp(k, "texsmooth")) c->texSmooth = (u8)(v < 0 ? 0 : v > 2 ? 2 : v);
+    else if (!strcmp(k, "filter2d")) c->filter2d = (u8)(v < 0 ? 0 : v > 2 ? 2 : v);
+    else if (!strcmp(k, "fog")) c->gpuFog = (u8)(v != 0);
+    else if (!strcmp(k, "color")) c->gpuColor = (u8)(v != 0);
+    else if (!strcmp(k, "renderer3d")) c->gpuFast = (u8)(v != 0);   // libntr-ios-fast3d.patch
+    else if (!strcmp(k, "line")) c->gpuLine = (u8)(v != 0);
+    else if (!strcmp(k, "edge")) c->gpuEdge = (u8)(v != 0);
+    else if (!strcmp(k, "speed")) SetSpeed((v < 1 ? 1 : v > 4 ? 4 : v) - 1);
+    else if (!strcmp(k, "framerate")) SetDisplayCap(v < 0 ? 0 : v > 3 ? 3 : v);
+    else if (!strcmp(k, "musicnormal")) c->musicNormalSpeed = (u8)(v != 0);
+    else if (!strcmp(k, "soundquality")) c->soundQuality = (u8)(v != 0);
+    else if (!strcmp(k, "frameskip")) SetFrameSkip(v < 0 ? 0 : v > 4 ? 4 : v);
+    else if (!strcmp(k, "ffspeed")) c->ffSpeed = (u8)(v < 2 ? 2 : v > 5 ? 5 : v);   // libntr-ios-speedui.patch: 2..4 or 5 = Max
+    else if (!strcmp(k, "textspeed")) c->textSpeed = (u8)(v < 0 ? 0 : v > 3 ? 3 : v);   // libntr-ios-textspeed.patch
+    else if (!strcmp(k, "fadespeed")) c->fadeSpeed = (u8)(v < 0 ? 0 : v > 3 ? 3 : v);   // libntr-ios-fadespeed.patch
+    else if (!strcmp(k, "walkspeed")) c->walkSpeed = (u8)(v >= 4 ? 4 : v >= 2 ? 2 : 1);   // libntr-ios-movesettings.patch
+    else if (!strcmp(k, "runspeed")) c->runSpeed = (u8)(v >= 4 ? 4 : v >= 2 ? 2 : 1);   // libntr-ios-movesettings.patch
+    else if (!strcmp(k, "surfspeed")) c->surfSpeed = (u8)(v >= 4 ? 4 : v >= 2 ? 2 : 1);   // libntr-ios-movesettings.patch
+    else if (!strcmp(k, "savespeed")) c->saveSpeed = (u8)(v >= 4 ? 4 : v >= 2 ? 2 : 1);   // libntr-ios-savespeed.patch
+    else if (!strcmp(k, "battlespeed")) c->battleSpeed = (u8)(v < 1 ? 1 : v > 4 ? 4 : v);   // libntr-ios-battlespeed.patch
+    else if (!strcmp(k, "skipslow")) SetFrameSkip(v != 0 ? 4 : 0);
+    else if (!strcmp(k, "volume") || !strcmp(k, "volumelive")) {
+        // libntr-ios-appfix.patch: "volumelive" (a slider being dragged) applies without writing the ini or the log; "volume" (the
+        // finger lifted) saves, as the desktop does when the mouse comes up
+        c->masterVolume = (u8)(((v < 0 ? 0 : v > 100 ? 100 : v) * 127 + 50) / 100);
+        if (!strcmp(k, "volumelive")) return;
+    }
+    else if (!strcmp(k, "metrics")) {
+        (SimTouch_Active() ? c->overlay : c->showMetrics) = (u8)(v != 0);
+        if (v != 0) c->overlayDetail = (u8)(v >= 2);
+    }
+    else if (!strcmp(k, "overlay")) c->overlay = (u8)(v != 0);
+    else if (!strcmp(k, "corner")) c->overlayCorner = (u8)(v != 0);
+    else if (!strcmp(k, "detail")) c->overlayDetail = (u8)(v != 0);
+    else if (!strcmp(k, "hidetouch")) c->hideTouch = (u8)(v != 0);
+    else if (!strcmp(k, "present")) c->present = (u8)(v != 0);
+    else return;
+    SIM_Config_SaveConfigFile(c);
+    fprintf(stderr, "bwport: setting %s=%d\n", k, v);
+}

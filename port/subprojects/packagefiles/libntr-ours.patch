+// live changes); the player's own Game speed is kept in sBtlUser and comes back when the battle ends. The settings file,
+// the fast-forward state and its label see the player's speed (SIM_UserSpeed), never the battle's.
+static int sBtlOn, sBtlApplied, sBtlUser;
+extern "C" void SIM_SetBattle(int on) { sBtlOn = on != 0; }
+// bw-port (libntr-ios-transitions.patch): the transition window, a second window beside the battle's. The port
+// (port/extern/src/system/game_event.c) passes the speed while a door, warp, map change, the Pokemon Center heal or the
+// Waterfall climb runs (2 or 4 from the Transitions setting), 0 when none does; the highest of it, the battle's and the
+// player's speed applies, and the player's speed comes back when it ends, as with a battle.
+static int sTrSpeed;
+extern "C" void SIM_SetTransition(int speed) { sTrSpeed = speed < 0 ? 0 : speed > 4 ? 4 : speed; }
+// bw-port (libntr-ios-savespeed.patch): the save window, a third one. The port (port/extern/src/system/game_event.c) passes the
+// SaveSpeed setting while the game saves (the field menu's Save from the player's Yes to its end, the write of any other
+// save), 0 otherwise; the highest of the windows and the player's speed applies, as for the transition window.
+static int sSvSpeed;
+extern "C" void SIM_SetSave(int speed) { sSvSpeed = speed < 0 ? 0 : speed > 4 ? 4 : speed; }
+static int SIM_UserSpeed(void) { return sBtlApplied && s_SIM_config.speed == sBtlApplied ? sBtlUser : s_SIM_config.speed; }
+extern "C" int SIM_SpeedForFile(int speed) { return sBtlApplied && speed == sBtlApplied ? sBtlUser : speed; }
+// a Game speed set by the player (fast forward, the settings, a script) while a battle's speed is applied
+extern "C" void SIM_SpeedSetUser(int v) {
+  if (sBtlApplied) {
+    sBtlUser = v;
+    s_SIM_config.speed = (u8)(v > sBtlApplied ? v : sBtlApplied);
+  } else {
+    s_SIM_config.speed = (u8)v;
+  }
+}
+// at the top of each tick
+static void SpBattleApply(void) {
+  int user = SIM_UserSpeed();
+  int bs = s_SIM_config.battleSpeed < 1 ? 1 : s_SIM_config.battleSpeed > 4 ? 4 : s_SIM_config.battleSpeed;
+  int want = sBtlOn && bs > user ? bs : 0;
+  if (sTrSpeed > user && sTrSpeed > want) want = sTrSpeed;  // libntr-ios-transitions.patch
+  // libntr-ios-savespeed.patch; libntr-ios-savemax.patch: never with fast forward at Max on. Max (uncapped) is already the highest,
+  // and the window's 2x/4x on top of it only put the sound's time-stretch at 4x over an uncapped game (the maintainer's "only the
+  // highest, never the two together, for saves"); Max off again and the window applies as before
+  if (sSvSpeed > user && sSvSpeed > want && !sFastForward) want = sSvSpeed;
+  static const char *sWinName = "battle";  // libntr-ios-savespeed.patch: the window that set the speed, named at its on and its off
+  if (want) sWinName = sBtlOn ? "battle" : want == sSvSpeed ? "save" : "transition";
+  if (want != sBtlApplied) fprintf(stderr, "bwport: %s speed %s (game speed %d)\n", sWinName, want ? "on" : "off", want ? want : user);
+  if (want) {
+    sBtlUser = user;
+    s_SIM_config.speed = (u8)want;
+  } else if (sBtlApplied) {
+    s_SIM_config.speed = (u8)user;
+  }
+  sBtlApplied = want;
+}
+extern "C" int SIM_FFOn(void) { return SIM_UserSpeed() > 1 || sFastForward; }
+extern "C" void SIM_FFSet(int on) {
+  const bool max = s_SIM_config.ffSpeed >= 5;
+  SIM_SpeedSetUser(on && !max ? (s_SIM_config.ffSpeed < 2 ? 2 : s_SIM_config.ffSpeed) : 1);  // (libntr-ios-battlespeed.patch)
+  sFastForward = on && max;
+  sFFMsgUntil = *((u32 *)HW_VBLANK_COUNT_BUF) + 90;
+  fprintf(stderr, "bwport: fast forward %s: game speed %d%s\n", on ? "on" : "off", (int)s_SIM_config.speed, sFastForward ? " + uncapped (Max)" : "");
+}
+static const char * FFLabel(char * b, size_t n) {
+  if (!SIM_FFOn()) { b[0] = 0; return b; }
+  if (sFastForward) snprintf(b, n, "FF Max");
+  else snprintf(b, n, "FF %dx", SIM_UserSpeed());
+  return b;
+}
+static double sCostMs;            // render work per frame, smoothed
+static std::string sBaseTitle;
+static std::string sShownTitle;
+
+extern "C" int SIM_RenderScale(void) {
+  int n = s_SIM_config.resolution;
+  return n < 1 ? 1 : n > 8 ? 8 : n;
+}
+
+// bw-port (libntr-aa70.patch, libntr-ios-msaa.patch): Antialiasing=off|4 samples, k = 1 or 2 (k x k samples per pixel). The gpu
+// renderer multisamples at Resolution (never lowered); vcore supersamples at Resolution x k and lowers k when that passes 8x, and
+// the bridges report what they used.
+// libntr-ios-smaa.patch: 3 = SMAA (the gpu renderer at Resolution 2 and up: one sample per pixel and SMAA on its 3D layer; vcore
+// draws it as off and reports 1)
+extern "C" int SIM_AntialiasWanted(void) {
+  return s_SIM_config.antialias == 3 ? 3 : s_SIM_config.antialias >= 2 ? 2 : 1;
+}
+extern "C" void SIM_RendererAAUsed(int k) { sAAUsed = k; }
+// bw-port (libntr-ios-fastgl.patch): Renderer3D=fast on the GPU renderer's core, as the bridge found it at the first frame that
+// wanted it: 1 it draws fast, 0 it cannot (the exact renderer draws), -1 not tried yet; how, or why not, in the core's words
+// ("Metal", "OpenGL ES: framebuffer fetch", "this GLES has no EXT_shader_framebuffer_fetch", ...: port/gpu gpu_fast_how)
+static int sFast3D = -1;
+static char sFast3DHow[200];
+extern "C" void SIM_Renderer3DFast(int ok, const char *how) {
+  snprintf(sFast3DHow, sizeof sFast3DHow, "%s", how != NULL ? how : "");
+  sFast3D = ok;
+}
+extern "C" int SIM_Renderer3DFastState(const char **how) {
+  if (how != NULL) *how = sFast3DHow;
+  return sFast3D;
+}
+// bw-port (libntr-fx71.patch): the grid the 3D is drawn on: Resolution x k, k the Antialiasing lowered until the product is
+// at most 8 (what both bridges do), or the k the bridge reported when that is lower
+extern "C" int SIM_InternalScale(void) {
+  int n = SIM_RenderScale();
+  int k = SIM_AntialiasWanted() == 2 ? 2 : 1; /* SMAA: one sample */
+  while (k > 1 && n * k > 8) k >>= 1;
+  if (sAAUsed > 0 && sAAUsed < k) k = sAAUsed;
+  return n * k;
+}
+// " AA 4 samples" when the setting is on and in force, " AA 4 samples not drawn (...)" when the renderer could not (vcore's 8x cap)
+static const char *AAText(char *buf, size_t n) {
+  int w = SIM_AntialiasWanted();
+  buf[0] = 0;
+  if (w <= 1) return buf;
+  if (w == 3) {
+    snprintf(buf, n, sAAUsed == 3 || sAAUsed == 0 ? ", AA SMAA" : ", AA SMAA not drawn (the GPU renderer at Resolution 2 and up)");
+    return buf;
+  }
+  if (sAAUsed == w || sAAUsed == 0) snprintf(buf, n, ", AA %d samples", w * w);
+  else snprintf(buf, n, ", AA %d samples not drawn (vcore draws at most 8x: %dx x %d)", w * w, SIM_RenderScale(), w);
+  return buf;
+}
+
+extern "C" int SIM_RendererWanted(void) {
+  int r = s_SIM_config.renderer;
+  if (r == SIM_CONFIG_RENDERER_AUTO) {
+    // (libntr-ios-gpuapi.patch: under Metal the GPU renderer is Metal's, and a Metal device is a GPU)
+    r = (sFrameRendererGL != NULL && (sMetal ? sMtlTexOf != NULL : SIM_GLIsHardware())) ? SIM_CONFIG_RENDERER_GPU
+                                                                                         : SIM_CONFIG_RENDERER_VCORE;
+  }
+  // under Metal the GPU renderer needs a program that draws it with Metal (SIM_SetFrameTextureMetal): vcore draws (said once)
+  if (sMetal && r == SIM_CONFIG_RENDERER_GPU && sMtlTexOf == NULL) {
+    static bool said;
+    if (!said) fprintf(stderr, "bwport: Present=metal: this program's GPU renderer draws with GL only; vcore draws\n");
+    said = true;
+    r = SIM_CONFIG_RENDERER_VCORE;
+  }
+  // a renderer the program did not register is not wanted
+  if (r == SIM_CONFIG_RENDERER_GPU && sFrameRendererGL == NULL) r = SIM_CONFIG_RENDERER_VCORE;
+  if (r == SIM_CONFIG_RENDERER_VCORE && sFrameRenderer == NULL && sFrameRendererGL != NULL) r = SIM_CONFIG_RENDERER_GPU;
+  return r;
+}
+
+extern "C" int SIM_RendererActive(void) { return sActive; }
+extern "C" unsigned SIM_RendererSerial(void) { return sRendererSerial; }
+extern "C" void SIM_RendererPicture(int *w, int *h) {
+  if (w) *w = sPicW;
+  if (h) *h = sPicH;
+}
+
+extern "C" void SIM_RendererFailed(const char *reason) {
+  snprintf(sFailReason, sizeof sFailReason, "%s", reason != NULL ? reason : "");
+  sFailWanted = SIM_RendererWanted();
+  sStatusUntil = *((u32 *)HW_VBLANK_COUNT_BUF) + 600;
+}
+
+extern "C" const char *SIM_RendererStatus(void) {
+  static char buf[400];
+  int want = SIM_RendererWanted(), n = SIM_RenderScale();
+  const char *wn = want == SIM_CONFIG_RENDERER_GPU ? "gpu" : "vcore";
+  char aa[160];
+  AAText(aa, sizeof aa);
+  if (sActive == 0) {
+    snprintf(buf, sizeof buf, "%s %dx: no picture yet", wn, n);
+    return buf;
+  }
+  const char *an = sActive == 2 ? "gpu" : "vcore";
+  char gl[100] = "";
+  if (sActive == 2) {
+    const char *name = sMetal ? SIM_PresentName() : SIM_GLRendererName();  // (libntr-ios-gpuapi.patch)
+    if (name == NULL || name[0] == 0) name = (const char *)glGetString(GL_RENDERER);
+    if (name != NULL) snprintf(gl, sizeof gl, " on %s", name);
+  }
+  if (sFailReason[0] != 0 && sFailWanted == want && sActive != (want == SIM_CONFIG_RENDERER_GPU ? 2 : 1)) {
+    snprintf(buf, sizeof buf, "%s %dx failed (%s): %s draws %dx%d, %.1f ms", wn, n, sFailReason, an, sPicW, sPicH, sCostMs);
+  } else if (sActive != (want == SIM_CONFIG_RENDERER_GPU ? 2 : 1)) {
+    snprintf(buf, sizeof buf, "%s %dx: %s draws %dx%d, %.1f ms", wn, n, an, sPicW, sPicH, sCostMs);
+  } else {
+    snprintf(buf, sizeof buf, "%s %dx: %dx%d, %.1f ms%s%s", an, n, sPicW, sPicH, sCostMs, aa, gl);
+  }
+  return buf;
+}
+
+// each frame, before the picture is drawn: a changed renderer or resolution bumps the serial, starts the overlay and
+// retitles the window
+// libntr-ios-cpubatch.patch: ImGui's frame is open this tick (only a presented tick builds one; BWPORT_UIEVERY=1: every tick, as before)
+static bool sUiBuilt = true;
+static int sUiEvery = -1;
+
+static void SIM_RendererPoll(void) {
+  int want = SIM_RendererWanted(), n = SIM_RenderScale();
+  u32 frame = *((u32 *)HW_VBLANK_COUNT_BUF);
+  if (want != sLastWanted || n != sLastRes || SIM_AntialiasWanted() != sLastAA) {
+    sLastWanted = want;
+    sLastRes = n;
+    sLastAA = SIM_AntialiasWanted();
+    sRendererSerial++;
+    sFailReason[0] = 0;
+    sStatusUntil = frame + 240;
+    sLogAt = frame + 8;
+  }
+  if (sLogAt != 0 && frame >= sLogAt) { // the log: what the settings gave, once the new renderer has drawn
+    sLogAt = 0;
+    fprintf(stderr, "bwport: renderer: %s\n", SIM_RendererStatus());
+    fflush(stderr);
+  }
+  if (window != NULL) {
+    char t[256];
+    int ok = sActive == (want == SIM_CONFIG_RENDERER_GPU ? 2 : 1);
+    char aat[16] = "";
+    if (SIM_AntialiasWanted() == 3) snprintf(aat, sizeof aat, sAAUsed == 3 || sAAUsed == 0 ? " SMAA" : " SMAA off");
+    else if (SIM_AntialiasWanted() > 1) snprintf(aat, sizeof aat, sAAUsed > 0 && sAAUsed < SIM_AntialiasWanted() ? " AA off (cap)" : " AA 4s");
+    char ffl[16];
+    FFLabel(ffl, sizeof ffl);
+    snprintf(t, sizeof t, "%s - %s %dx%s%s%s%s%s", sBaseTitle.c_str(), want == SIM_CONFIG_RENDERER_GPU ? "gpu" : "vcore", n, aat,
+             ok || sActive == 0 ? "" : (sActive == 2 ? " (gpu drawing)" : " (vcore drawing)"),
+             s_SIM_config.displayCap == SIM_CONFIG_DISPLAYCAP_UNLIMITED ? " - Frame rate: Unlimited" : "", ffl[0] ? " - " : "", ffl);
+    if (sShownTitle != t) {
+      sShownTitle = t;
+      SDL_SetWindowTitle(window, t);
+    }
+  }
+  {
+    char rate[64] = "";
+    if ((s32)(sRateOverlayUntil - frame) > 0) { // rn80: what Tab switched to
+      u8 d = s_SIM_config.displayCap;
+      snprintf(rate, sizeof rate, "Frame rate: %s", d == SIM_CONFIG_DISPLAYCAP_UNLIMITED ? "Unlimited" : d == SIM_CONFIG_DISPLAYCAP_MONITOR ? "Monitor"
+                                                                  : d == SIM_CONFIG_DISPLAYCAP_120 ? "120" : "60");
+    }
+    if ((s32)(sFFMsgUntil - frame) > 0) { // libntr-desktop-speed.patch: what Space switched to
+      char ffl[16];
+      size_t l = strlen(rate);
+      snprintf(rate + l, sizeof rate - l, "%sFast forward: %s", l ? "  |  " : "", FFLabel(ffl, sizeof ffl)[0] ? ffl + 3 : "off");
+    }
+    if (!sUiBuilt) {
+      // libntr-ios-cpubatch.patch: no ImGui frame this tick (not presented)
+    } else if (frame < sStatusUntil && rate[0]) {
+      char both[480];
+      snprintf(both, sizeof both, "%s  |  %s", SIM_RendererStatus(), rate);
+      SIM::GUI::DrawStatus(both);
+    } else if (frame < sStatusUntil) {
+      SIM::GUI::DrawStatus(SIM_RendererStatus());
+    } else if (rate[0]) {
+      SIM::GUI::DrawStatus(rate);
+    }
+  }
+}
+
+// BWPORT_SWITCH_TEST=renderer:N,renderer:N,...[/FRAMES]: the live switch test. Each step sets the renderer (auto, vcore,
+// gpu) and the resolution as the Config window would, runs FRAMES frames (default 90, 60 more at the start), and checks
+// at the end that the renderer in force drew a picture of 256N x 384N; the cost of a frame (render work in ms, the
+// last two thirds of the step) is printed to stderr and switch_test.txt. Exit status 0 when every step passed.
+// Example: BWPORT_SWITCH_TEST=vcore:1,gpu:1,gpu:2,gpu:4,gpu:1,vcore:1/60
+struct SwStep { int renderer, res, aa; };
+static std::vector<SwStep> sSwSteps;
+static int sSwFrames = 90, sSwIdx = -2, sSwFrame, sSwN, sSwFails;
+static double sSwCost, sSwPrevCost;
+static int sSwActive, sSwW, sSwH;
+
+// (rz68): what a step also measures. The picture's mean (a black picture fails: the maintainer's "screen goes black
+// after several Resolution changes"), the process memory, the live GL objects of the context (every id is asked with
+// glIs*, so a leak anywhere counts, ours or libntr's) and the bytes of the live textures. A step whose renderer and
+// Resolution were seen before must not cost more, hold more memory or more GL objects than the first time did.
+static int sSwStart = 60;    // BWPORT_SWITCH_START=N: frames the game runs before the first step (to reach a bright screen)
+static double sSwRefMean = -1; // the first step's picture mean
+static bool sSwMeanWanted;   // the next picture drawn is measured
+static double sSwMean = -1;  // mean of R, G, B over the last measured picture (0..255); -1: none
+static long sSwPicPx;
+static void SwMeanRgba(const unsigned char *p, int w, int h) {
+  unsigned long long sum = 0, n = 0;
+  size_t total = (size_t)w * h;
+  for (size_t i = 0; i < total; i += 3) {  // every third pixel
+    sum += p[i * 4] + p[i * 4 + 1] + p[i * 4 + 2];
+    n += 3;
+  }
+  sSwMean = n ? (double)sum / n : 0;
+  sSwPicPx = (long)total;
+}
+static void SwMeanTex(unsigned tex, int w, int h) {
+  if (w <= 0 || h <= 0) return;
+  unsigned char *buf = (unsigned char *)malloc((size_t)w * h * 4);
+  if (buf == NULL) return;
+  GLint prevRead = 0;
+  glGetIntegerv(GL_READ_FRAMEBUFFER_BINDING, &prevRead);
+  GLuint fbo = 0;
+  glGenFramebuffers(1, &fbo);
+  glBindFramebuffer(GL_READ_FRAMEBUFFER, fbo);
+  glFramebufferTexture2D(GL_READ_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, tex, 0);
+  GLint prevPack = 4;
+  glGetIntegerv(GL_PACK_ALIGNMENT, &prevPack);
+  glPixelStorei(GL_PACK_ALIGNMENT, 1);
+  if (glCheckFramebufferStatus(GL_READ_FRAMEBUFFER) == GL_FRAMEBUFFER_COMPLETE) {
+    glReadPixels(0, 0, w, h, GL_RGBA, GL_UNSIGNED_BYTE, buf);
+    SwMeanRgba(buf, w, h);
+  }
+  glPixelStorei(GL_PACK_ALIGNMENT, prevPack);
+  glBindFramebuffer(GL_READ_FRAMEBUFFER, (GLuint)prevRead);
+  glDeleteFramebuffers(1, &fbo);
+  free(buf);
+}
+
+// ---- libntr-look70.patch: the look options' live test --------------------------------------------------------------
+// BWPORT_LOOK_TEST=dot,line,edge,filter (any of them, in order) [BWPORT_LOOK_START=N: frames before the first]. Per option, with
+// the others at 0: keep the pictures drawn at calls 5 and 8 (A, A2: the scene's own change), flip the option to 1 at call 8
+// (the field that the Video window writes: s_SIM_config.gpuDot..), keep the one at call 11 (B), flip it back at 11, keep
+// the one at 14 (C). Prints "look-test: OPT noise=<A vs A2> flip=<A2 vs B> back=<B vs C> of <pixels> px (renderer, WxH)" to
+// stderr and look_test.txt; exits when all are done. The renderer and Resolution are the usual settings.
+static int sLookOpt[4], sLookN, sLookCall = -1, sLookStart = 300, sLookRound;
+static bool sLookWant;
+static int sLookSlot;
+static std::vector<unsigned char> sLookPic[4];
+static int sLookW[4], sLookH[4];
+static void LookRgba(const unsigned char *p, int w, int h) {
+  if (!sLookWant) return;
+  sLookWant = false;
+  sLookPic[sLookSlot].assign(p, p + (size_t)w * h * 4);
+  sLookW[sLookSlot] = w;
+  sLookH[sLookSlot] = h;
+}
+static void SwReadTex(unsigned tex, int w, int h, void (*use)(const unsigned char *, int, int)) {
+  if (w <= 0 || h <= 0) return;
+  unsigned char *buf = (unsigned char *)malloc((size_t)w * h * 4);
+  if (buf == NULL) return;
+  GLint prevRead = 0;
+  glGetIntegerv(GL_READ_FRAMEBUFFER_BINDING, &prevRead);
+  GLuint fbo = 0;
+  glGenFramebuffers(1, &fbo);
+  glBindFramebuffer(GL_READ_FRAMEBUFFER, fbo);
+  glFramebufferTexture2D(GL_READ_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, tex, 0);
+  GLint prevPack = 4;
+  glGetIntegerv(GL_PACK_ALIGNMENT, &prevPack);
+  glPixelStorei(GL_PACK_ALIGNMENT, 1);
+  if (glCheckFramebufferStatus(GL_READ_FRAMEBUFFER) == GL_FRAMEBUFFER_COMPLETE) {
+    glReadPixels(0, 0, w, h, GL_RGBA, GL_UNSIGNED_BYTE, buf);
+    use(buf, w, h);
+  }
+  glPixelStorei(GL_PACK_ALIGNMENT, prevPack);
+  glBindFramebuffer(GL_READ_FRAMEBUFFER, (GLuint)prevRead);
+  glDeleteFramebuffers(1, &fbo);
+  free(buf);
+}
+static void LookTex(unsigned tex, int w, int h) { SwReadTex(tex, w, h, LookRgba); }
+static long LookDiff(int a, int b) {
+  if (sLookW[a] != sLookW[b] || sLookH[a] != sLookH[b] || sLookPic[a].empty() || sLookPic[b].empty()) return -1;
+  long n = 0;
+  size_t px = (size_t)sLookW[a] * sLookH[a];
+  const unsigned char *x = sLookPic[a].data(), *y = sLookPic[b].data();
+  for (size_t i = 0; i < px; i++)
+    if (x[i * 4] != y[i * 4] || x[i * 4 + 1] != y[i * 4 + 1] || x[i * 4 + 2] != y[i * 4 + 2]) n++;
+  return n;
+}
+static void SIM_LookTest(void) {
+  if (sLookCall == -1) {
+    sLookCall = -2;
+    const char *e = getenv("BWPORT_LOOK_TEST");
+    if (e == NULL || !*e) return;
+    char *dup = strdup(e);
+    for (char *tok = strtok(dup, ","); tok != NULL && sLookN < 4; tok = strtok(NULL, ","))
+      sLookOpt[sLookN++] = strcmp(tok, "dot") == 0 ? 0 : strcmp(tok, "line") == 0 ? 1 : strcmp(tok, "edge") == 0 ? 2 : 3;
+    free(dup);
+    if (getenv("BWPORT_LOOK_START") != NULL) sLookStart = atoi(getenv("BWPORT_LOOK_START"));
+    if (sLookN == 0) return;
+    sLookCall = 0;
+    remove("look_test.txt");
+  }
+  if (sLookCall < 0) return;
+  sLookCall++;
+  int t = sLookCall - sLookStart - sLookRound * 16;
+  if (t < 0) return;
+  u8 *field[4] = {&s_SIM_config.gpuDot, &s_SIM_config.gpuLine, &s_SIM_config.gpuEdge, &s_SIM_config.texSmooth};
+  u8 *f = field[sLookOpt[sLookRound]];
+  if (t == 0) for (int i = 0; i < 4; i++) *field[i] = 0;
+  if (t == 4 || t == 7 || t == 10 || t == 13) {
+    sLookSlot = t == 4 ? 0 : t == 7 ? 1 : t == 10 ? 2 : 3;
+    sLookWant = true;
+  }
+  static const bool noflip = getenv("BWPORT_LOOK_NOFLIP") != NULL;
+  if (t == 8 && !noflip) *f = 1;
+  if (t == 11) *f = 0;
+  if (t == 16) {
+    static const char *const names[4] = {"dot", "line", "edge", "filter"};
+    char line[400], ref[200];
+    // the game is deterministic: a run without the flip (BWPORT_LOOK_NOFLIP=1) keeps the picture B, a run with it is
+    // compared against that one: effect = the pixels the option changed, with the scene's own change taken out
+    snprintf(ref, sizeof ref, "look_ref_%s_%s_%dx%d.raw", names[sLookOpt[sLookRound]], sActive == 2 ? "gpu" : "vcore", sLookW[2], sLookH[2]);
+    long effect = -2, back0 = LookDiff(2, 3);
+    if (noflip) {
+      FILE *r = fopen(ref, "wb");
+      if (r != NULL) { fwrite(sLookPic[2].data(), 1, sLookPic[2].size(), r); fclose(r); }
+    } else if (FILE *r = fopen(ref, "rb")) {
+      std::vector<unsigned char> rv(sLookPic[2].size());
+      if (fread(rv.data(), 1, rv.size(), r) == rv.size()) {
+        sLookPic[3].swap(rv);
+        effect = LookDiff(2, 3);
+      }
+      fclose(r);
+    }
+    snprintf(line, sizeof line, "look-test: %s effect=%ld (noise=%ld flip=%ld back=%ld) of %d px (%s, %dx%d, edge marking %s)\n",
+             names[sLookOpt[sLookRound]], effect, LookDiff(0, 1), LookDiff(1, 2), back0, sLookW[0] * sLookH[0],

+// bw-port (libntr-ios-cfgscript.patch): BWPORT_CFGSCRIPT="f11100:renderer=gpu,resolution=4;f11400:renderer=vcore,framerate=60;..." applies
+// settings at V-blank frames (the keys script's frame count), as the Config window does: the same fields of s_SIM_config, which the
+// frame loop reads (renderer, Resolution, Frame rate; the swap interval follows in SIM_Render). A step logs "cfgscript: fN ..." to
+// stderr when it applies. "pN:..." instead of "fN:..." applies N frames after the previous step and after any performance log has finished. Keys: renderer=auto|vcore|gpu, resolution=1..8, framerate=60|120|monitor|unlimited, antialias=1|2|4,
+// shot=NAME (the window's picture to NAME.png), quit=1 (ends the run), perflog=NAME (records 5 s of per-frame stage times to perf_NAME.txt, as Debug > Save performance log).
+// ablate=NAME+NAME (libntr-ios-ablate.patch: test-only, a piece of the frame taken out: r, e, pslow, p, c, gpu, present, spin; none = off).
+extern "C" void SIM_FrameForceDraw(void);
+static int sCfgPauseMs;    // pause=MS (libntr-ios-pacefix.patch): the next frame stands still MS ms at its top, as under the settings sheet
+static char sCfgShot[64];  // shot=NAME: SIM_ShotMaybe (libntr-ios-hidden.patch) writes NAME.png at the next present
+// bw-port (libntr-ios-pace.patch): more keys: speed=1..4, frameskip=0..3|auto, smooth=0|1, ff=0|1 (fast forward as Space / the
+// touch button), bench=NAME (a 4 s window of the pacing's work counters: one row, see sPc; pN steps wait for it), restore=1 (the
+// settings as they were when the script was loaded), perftest=1 (the iOS performance test's steps, next). SIM_CfgScriptLoad adds steps at
+// run time: after the step being applied, or at the end.
+static void BenchStart(const char *name);
+static bool BenchBusy(void);
+static void BenchDone(void);
+static void BenchCancel(void);
+struct CfgStep { u32 frame; bool rel; char text[256]; };  // (libntr-ios-cfglen.patch: was 96; a 110-character settings step lost its last keys)
+static int sTestNoSide, sTestPump;   // libntr-ios-testkeys.patch: cfgscript side=0 / pump=1 (measurement only, off unless set)
+extern "C" int SIM_VCapTestOff;      // libntr-ios-vcaplist.patch: cfgscript vcapwalk=0 (sim_vcapture.cpp)
+static std::vector<CfgStep> sCfgSteps;
+static size_t sCfgNext = 0;
+static SIM_config_type sCfgSaved;
+static FILE *sPresentLog;  // (BWPORT_PRESENTLOG, below)
+static void SIM_CfgScriptLoad(const char *e) {
+  if (sCfgNext >= sCfgSteps.size()) { sCfgSteps.clear(); sCfgNext = 0; }
+  size_t at = sCfgNext < sCfgSteps.size() ? sCfgNext + 1 : sCfgSteps.size();
+  sCfgSaved = s_SIM_config;
+  char *dup = strdup(e);
+  char *save = NULL;
+  for (char *tok = strtok_r(dup, ";", &save); tok != NULL; tok = strtok_r(NULL, ";", &save)) {
+    char *colon = strchr(tok, ':');
+    if ((tok[0] != 'f' && tok[0] != 'p') || colon == NULL) continue;
+    CfgStep st;
+    st.frame = (u32)atoi(tok + 1);
+    st.rel = tok[0] == 'p';
+    if (strlen(colon + 1) >= sizeof st.text) {  // (libntr-ios-cfglen.patch) a cut step would drop its last keys without a word
+      fprintf(stderr, "cfgscript: step '%.40s...' is %zu characters, over %zu: skipped\n", tok, strlen(colon + 1), sizeof st.text - 1);
+      continue;
+    }
+    snprintf(st.text, sizeof st.text, "%s", colon + 1);
+    sCfgSteps.insert(sCfgSteps.begin() + (long)at++, st);
+  }
+  free(dup);
+}

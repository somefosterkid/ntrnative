+// libntr-ios-input.patch: a touch press's latency: from the finger on the glass to the end of the tick that set the game's pad bits
+// ("read": the game reads them once SIM_Render returns), and to the first present that can show the game's answer ("shown": two ticks
+// on, as the renderers return the last tick's picture; the panel shows it a refresh or so later). "UIKit": how long UIKit held the
+// touch before SDL got it (on iOS the wait for the next event pump, plus anything the system held it for). Each press over 100 ms is
+// logged ("input:"), every one with BWPORT_PACELOG; the overlay's Detailed mode shows the last one; the pace line the second's.
+// libntr-ios-lag.patch: releases are followed the same way (sIn[1]: the finger leaving the glass to the picture that can show the
+// game's answer to it), and both to the end of the GPU's work on that picture ("gpu": the present's fence, LagPoll below). A press
+// or release whose glass-to-GPU-done passes 100 ms logs "input: ... shown N ms late (...)".
+struct InTrack { u64 t0, gate, tick, pad, end, present, serial; int stage; float read, shown, uikit, gpu; double sum, max; int n; };
+static InTrack sIn[2];  // 0 press, 1 release
+extern "C" float SIM_InputLatency(float *read, float *uikit) {
+  *read = sIn[0].read;
+  *uikit = sIn[0].uikit;
+  return sIn[0].shown;
+}
+// libntr-ios-lag.patch: the last press's / release's glass to GPU done (0: not yet), and to its present
+extern "C" float SIM_InputGpuLatency(int release, float *shown) {
+  *shown = sIn[release != 0].shown;
+  return sIn[release != 0].gpu;
+}
+static void InputTaken(int k, u64 t0, u64 gate) {
+  InTrack &in = sIn[k];
+  in.t0 = t0;
+  in.gate = gate;
+  in.tick = sPc.ticks;
+  in.pad = SpNowNs();
+  in.stage = 1;
+}
+static void InputTickEnd(void) {
+  for (InTrack &in : sIn) {
+    if (in.stage != 1) continue;
+    in.end = SpNowNs();
+    in.read = (float)((in.end - in.t0) / 1e6);
+    in.stage = 2;
+  }
+}
+static int sLagLog = -1;
+// libntr-ios-appfix.patch: a line that can repeat all session (slow settings, a drop condition) is printed at most `perMin` times a
+// minute; the lines left out are counted and the next one says how many
+struct LogBudget { u64 winStart; int used; int skipped; };
+static bool LogBudgetOk(LogBudget &b, int perMin, int *skippedBefore) {
+  struct timespec ts;
+  clock_gettime(CLOCK_MONOTONIC, &ts);
+  u64 now = (u64)ts.tv_sec * 1000000000ull + (u64)ts.tv_nsec;
+  if (b.winStart == 0 || now - b.winStart > 60000000000ull) { b.winStart = now; b.used = 0; }
+  if (b.used >= perMin) { b.skipped++; return false; }
+  b.used++;
+  *skippedBefore = b.skipped;
+  b.skipped = 0;
+  return true;
+}
+// bw-port (libntr-ios-stuckinput.patch): the stuck-input checks' line: "anomaly: WHAT, tick T" (T = the V-blank count, the game's
+// frames), at most 20 a minute (the next one says how many were left out); WHAT names the source, the buttons and the ages
+static LogBudget sAnomBudget;
+extern "C" unsigned SIM_InputTickNo(void) { return *((u32 *)HW_VBLANK_COUNT_BUF); }
+extern "C" void SIM_Anomaly(const char *fmt, ...) {
+  int skipped = 0;
+  if (!LogBudgetOk(sAnomBudget, 20, &skipped)) return;
+  char line[400];
+  va_list ap;
+  va_start(ap, fmt);
+  vsnprintf(line, sizeof line, fmt, ap);
+  va_end(ap);
+  fprintf(stderr, "anomaly: %s, tick %u", line, SIM_InputTickNo());
+  if (skipped > 0) fprintf(stderr, " (%d left out before)", skipped);
+  fputc('\n', stderr);
+}
+// the buttons of a mask (bit B_*: A B X Y L R Start Select Up Down Left Right) as "B+Down+Left", "-" for none; buf holds 64
+extern "C" const char *SIM_PadNames(unsigned m, char *buf) {
+  static const char *const nm[12] = {"A", "B", "X", "Y", "L", "R", "Start", "Select", "Up", "Down", "Left", "Right"};
+  buf[0] = 0;
+  for (int b = 0; b < 12; b++) {
+    if (!((m >> b) & 1)) continue;
+    if (buf[0] != 0) strcat(buf, "+");
+    strcat(buf, nm[b]);
+  }
+  if (buf[0] == 0) strcpy(buf, "-");
+  return buf;
+}
+static void InputGpuDone(InTrack &in, u64 done, int inflight) {

+/* bw-port (libntr-ios-reset.patch): the host files the game's FSFiles hold open, so the port's in-process restart can
+   close them (the FSFiles themselves are the machine's memory, put back as they were before the game started) */
+#define FSi_PORT_FILES_MAX 1024   /* Platinum and HGSS hold ~120 FSFiles open (their NARCs): 64 lost 58 host files per reset, hg40 */
+static FILE * s_portFiles[FSi_PORT_FILES_MAX];
+/* bw-port (libntr-openfiles.patch): host files open now and the most at once, FS_PortOpenFiles (port/src/run_frames.c's
+   guard against a game that opens a file and never closes it: Linux stops at ulimit -n, the CRT on win64 at 512) */
+static int s_portOpen, s_portPeak;
+
+int FS_PortOpenFiles(int * peak)
+{
+	if (peak != NULL) {
+		*peak = s_portPeak;
+	}
+	return s_portOpen;

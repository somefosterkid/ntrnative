+static u32 sCfgMark = 0;  // the frame a performance log was last running or a step last applied, for the pN steps
+static void SIM_CfgScript(void) {
+  std::vector<CfgStep> &sSteps = sCfgSteps;
+  size_t &sNext = sCfgNext;
+  static int sInit = 0;
+  if (!sInit) {
+    sInit = 1;
+    const char *e = getenv("BWPORT_CFGSCRIPT");
+    if (e != NULL && *e) SIM_CfgScriptLoad(e);
+  }
+  u32 now = *((u32 *)HW_VBLANK_COUNT_BUF);
+  u32 &sMark = sCfgMark;
+  while (sNext < sSteps.size()) {
+    bool busy = SIM::GUI::PerfLogBusy() || BenchBusy();
+    if (busy) sMark = now;
+    const CfgStep &cur = sSteps[sNext];
+    if (cur.rel ? (busy || now < sMark + cur.frame) : now < cur.frame) break;
+    sMark = now;
+    char *save = NULL;
+    char text[sizeof sSteps[sNext].text];
+    snprintf(text, sizeof text, "%s", sSteps[sNext].text);
+    for (char *kv = strtok_r(text, ",", &save); kv != NULL; kv = strtok_r(NULL, ",", &save)) {
+      char *eq = strchr(kv, '=');
+      if (eq == NULL) continue;
+      *eq = 0;
+      const char *v = eq + 1;
+      if (strcmp(kv, "renderer") == 0) {
+        s_SIM_config.renderer = (u8)(strcmp(v, "gpu") == 0 ? SIM_CONFIG_RENDERER_GPU : strcmp(v, "vcore") == 0 ? SIM_CONFIG_RENDERER_VCORE : SIM_CONFIG_RENDERER_AUTO);
+      } else if (strcmp(kv, "resolution") == 0) {
+        int n = atoi(v);
+        s_SIM_config.resolution = (u8)(n < 1 ? 1 : n > 8 ? 8 : n);
+      } else if (strcmp(kv, "renderer3d") == 0) {  // libntr-ios-fast3d.patch: exact|fast, applied live
+        s_SIM_config.gpuFast = (u8)(strcmp(v, "fast") == 0);
+      } else if (strcmp(kv, "texsmooth") == 0) {  // Texture smoothing: 0 off, 1 bilinear, 2 mipmaps (applied live; test aid: the setting row has no cfgscript key otherwise)
+        int n = atoi(v);
+        s_SIM_config.texSmooth = (u8)(n < 0 ? 0 : n > 2 ? 2 : n);
+      } else if (strcmp(kv, "antialias") == 0) {
+        int n = atoi(v);
+        s_SIM_config.antialias = (u8)(n == 3 ? 3 : n >= 2 ? 2 : 1); /* 3: SMAA (libntr-ios-smaa.patch); the old 4 is 4 samples */
+      } else if (strcmp(kv, "perflog") == 0) {  // a 5 s performance log into perf_NAME.txt
+        char fn[128];
+        snprintf(fn, sizeof fn, "perf_%s.txt", v);
+        SIM::GUI::PerfLogStartNamed(fn);
+      } else if (strcmp(kv, "settings") == 0) {  // settings=speed|rendering|sound|controls|display|debug|close: opens that settings window
+        SIM::GUI::OpenSettingsNamed(v);
+      } else if (strcmp(kv, "metrics") == 0) {  // metrics=off|compact|detailed (the Display and metrics row)
+        s_SIM_config.showMetrics = strcmp(v, "off") != 0;
+        if (strcmp(v, "compact") == 0) s_SIM_config.overlayDetail = 0;
+        if (strcmp(v, "detailed") == 0) s_SIM_config.overlayDetail = 1;
+      } else if (strcmp(kv, "padpanel") == 0) {  // padpanel=0|1: the controller panel
+        s_SIM_config.showInputPanel = atoi(v) != 0;
+      } else if (strcmp(kv, "shot") == 0) {  // the window's picture to NAME.png (BWPORT_HIDDEN)
+        snprintf(sCfgShot, sizeof sCfgShot, "%s", v);
+        SIM_FrameForceDraw();   // frame skip (libntr-ios-shotdraw.patch): the shot frame and the next two are drawn
+      } else if (strcmp(kv, "pause") == 0) {  // libntr-ios-pacefix.patch: a pause like the settings sheet's, at the next frame's top
+        sCfgPauseMs = atoi(v);
+      } else if (strcmp(kv, "stall") == 0) {  // libntr-ios-inputprio.patch: a frame that takes MS ms (the main thread busy, no events)
+        struct timespec ts = {atoi(v) / 1000, (long)(atoi(v) % 1000) * 1000000L};
+        fprintf(stderr, "cfgscript: stall %d ms\n", atoi(v));
+        nanosleep(&ts, NULL);
+      } else if (strcmp(kv, "restart") == 0) {  // libntr-ios-restart.patch: the game's soft reset (L+R+START+SELECT)
+        bwport_press_restart();
+      } else if (strcmp(kv, "games") == 0) {  // libntr-ios-launcher.patch: Game > Games... (macOS): the soft reset, then the launcher
+        bwport_press_games();
+      } else if (strcmp(kv, "quit") == 0) {  // end the run here (after this step's other keys; a shot needs a frame: put quit a few frames later)
+        BenchDone();
+        fprintf(stderr, "cfgscript: quit at f%u\n", now);
+        fflush(stderr);
+        if (sPresentLog != NULL) fflush(sPresentLog);  // libntr-ios-lag.patch: (_exit skips the atexit that closes it)
+        _exit(0);
+      } else if (strcmp(kv, "speed") == 0) {
+        int n = atoi(v);
+        SIM_SpeedSetUser(n < 1 ? 1 : n > 4 ? 4 : n);  // (libntr-ios-battlespeed.patch)
+      } else if (strcmp(kv, "battlespeed") == 0) {  // libntr-ios-battlespeed.patch: BattleSpeed 1..4
+        int n = atoi(v);
+        s_SIM_config.battleSpeed = (u8)(n < 1 ? 1 : n > 4 ? 4 : n);
+      } else if (strcmp(kv, "textspeed") == 0) {  // libntr-ios-textspeed.patch: TextSpeed 0..3 (game, faster, fastest, instant)
+        int n = atoi(v);
+        s_SIM_config.textSpeed = (u8)(n < 0 ? 0 : n > 3 ? 3 : n);
+      } else if (strcmp(kv, "fadespeed") == 0) {  // libntr-ios-fadespeed.patch: screen fades 0..3 (1x, 2x, 4x, instant)
+        int n = atoi(v);
+        s_SIM_config.fadeSpeed = (u8)(n < 0 ? 0 : n > 3 ? 3 : n);
+      } else if (strcmp(kv, "walkspeed") == 0) {  // libntr-ios-movesettings.patch: the player's walk speed 1, 2 or 4
+        int n = atoi(v);
+        s_SIM_config.walkSpeed = (u8)(n >= 4 ? 4 : n >= 2 ? 2 : 1);
+      } else if (strcmp(kv, "runspeed") == 0) {  // libntr-ios-movesettings.patch: the player's run speed 1, 2 or 4
+        int n = atoi(v);
+        s_SIM_config.runSpeed = (u8)(n >= 4 ? 4 : n >= 2 ? 2 : 1);
+      } else if (strcmp(kv, "savespeed") == 0) {  // libntr-ios-savespeed.patch: the save window's speed 1, 2 or 4
+        int n = atoi(v);
+        s_SIM_config.saveSpeed = (u8)(n >= 4 ? 4 : n >= 2 ? 2 : 1);
+      } else if (strcmp(kv, "surfspeed") == 0) {  // libntr-ios-movesettings.patch: the player's surf speed 1, 2 or 4
+        int n = atoi(v);
+        s_SIM_config.surfSpeed = (u8)(n >= 4 ? 4 : n >= 2 ? 2 : 1);
+      } else if (strcmp(kv, "frameskip") == 0) {
+        s_SIM_config.frameSkip = strcmp(v, "auto") == 0 ? SIM_CONFIG_FRAMESKIP_AUTO : (u8)(atoi(v) < 0 ? 0 : atoi(v) > 3 ? 3 : atoi(v));
+      } else if (strcmp(kv, "smooth") == 0) {
+        s_SIM_config.interpolation = (u8)(atoi(v) != 0);
+      } else if (strcmp(kv, "ff") == 0) {
+        sFastForward = atoi(v) != 0;
+      } else if (strcmp(kv, "perftest") == 0) {  // the iOS performance test's steps (they follow this script's remaining ones)
+        SIM_PerfTestStart();
+      } else if (strcmp(kv, "passes") == 0) {  // libntr-ios-passes.patch: the GPU path's parts, glFinish after each pass (see sPassOn)
+        sPassOn = atoi(v) != 0;
+        PassReset();
+      } else if (strcmp(kv, "ablate") == 0) {  // libntr-ios-ablate.patch: test-only ablations (AblateParse); none = all off
+        sAblate = AblateParse(v);
+        fprintf(stderr, "cfgscript: ablate mask 0x%x (%s)\n", sAblate, v);
+      } else if (strcmp(kv, "glate") == 0) {  // libntr-ios-smoothhold.patch: test aids (see SpIpLateGpu)
+        sIpTestLate = atoi(v);
+      } else if (strcmp(kv, "glowclock") == 0) {
+        sIpTestClock = atoi(v) != 0;
+      } else if (strcmp(kv, "bench") == 0) {
+        BenchStart(v);
+      } else if (strcmp(kv, "restore") == 0) {
+        PerfTestRestore();
+        BenchDone();
+        fprintf(stderr, "perftest: settings restored\n");
+      } else if (strcmp(kv, "side") == 0) {  // libntr-ios-testkeys.patch: side=0 does not draw the side panel (the picture is wrong)
+        sTestNoSide = atoi(v) == 0;
+      } else if (strcmp(kv, "pump") == 0) {  // pump=1 polls SDL's events only on a tick after a presented one
+        sTestPump = atoi(v) != 0;
+      } else if (strcmp(kv, "vcapwalk") == 0) {  // libntr-ios-vcaplist.patch: vcapwalk=0 records no 3D command (the picture is wrong)
+        SIM_VCapTestOff = atoi(v) == 0;
+      } else if (strcmp(kv, "soundquality") == 0) {  // 0 = DS (exact), 1 = Enhanced
+        s_SIM_config.soundQuality = (u8)(atoi(v) != 0);
+      } else if (strcmp(kv, "framerate") == 0) {
+        u8 r = strcmp(v, "unlimited") == 0 ? SIM_CONFIG_DISPLAYCAP_UNLIMITED : strcmp(v, "monitor") == 0 ? SIM_CONFIG_DISPLAYCAP_MONITOR
+             : atoi(v) >= 120 ? SIM_CONFIG_DISPLAYCAP_120 : SIM_CONFIG_DISPLAYCAP_60;
+        if (r != SIM_CONFIG_DISPLAYCAP_UNLIMITED) s_SIM_config.displayCapBack = r;
+        else if (s_SIM_config.displayCap != SIM_CONFIG_DISPLAYCAP_UNLIMITED) s_SIM_config.displayCapBack = s_SIM_config.displayCap;
+        s_SIM_config.displayCap = r;
+      } else {  // (libntr-ios-cfgunknown.patch) an unknown key did nothing without a word: overlay=0 rows measured nothing
+        fprintf(stderr, "cfgscript: unknown key '%s' (ignored)\n", kv);
+      }
+    }
+    fprintf(stderr, "cfgscript: %c%u (now f%u) %s\n", sSteps[sNext].rel ? 'p' : 'f', sSteps[sNext].frame, now, sSteps[sNext].text);
+    fflush(stderr);
+    sNext++;
+  }
+}

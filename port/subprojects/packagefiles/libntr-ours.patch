+// bw-port (libntr-ios-touch.patch): the touch buttons into the pad registers where the keyboard writes them (a bit changes only when
+// the touch state does, so a key held at the same time keeps working)
+static unsigned sTouchPadPrev;
+static void TouchPadWrite(unsigned now) {
+  unsigned long long t0, gate;
+  if (SimTouch_PressTaken(&t0, &gate)) InputTaken(0, t0, gate);  // libntr-ios-input.patch
+  if (SimTouch_ReleaseTaken(&t0)) InputTaken(1, t0, 0);           // libntr-ios-lag.patch

+int BarBegin(int windowW, int windowH, const float * touchRect) {
+    (void)windowW;
+    (void)windowH;
+    SIM_config_type * c = C();
+    sSideRect[2] = sSideRect[3] = 0.0f; // DrawSide sets it again when the side is drawn
+    if (SimTouch_Active()) {
+        sBarVisible = false;   // bw-port (libntr-ios-touch.patch): no menu bar on the phone
+        return 0;
+    }
+    int mx = 0, my = 0;
+    Uint32 b = SDL_GetMouseState(&mx, &my);
+    bool focus = SDL_GetMouseFocus() == sWindow;
+    bool popup = sImguiContext != nullptr && ImGui::IsPopupOpen(nullptr, ImGuiPopupFlags_AnyPopupId | ImGuiPopupFlags_AnyPopupLevel);
+    bool pinned = Pinned();
+    if (!pinned) {
+        // out when the mouse reaches the top edge (not while a button is down: a touch there is the game's)
+        if (focus && !(b & SDL_BUTTON_LMASK) && my <= 2) {
+            // over the touch screen's top rows (it starts at the window's top edge): the mouse must rest there for
+            // 0.35 s, so a quick click on the touch screen's first rows is a touch, not the bar coming out over it
+            bool overTouch = touchRect != nullptr && (float)mx + 0.5f >= touchRect[0] && (float)mx + 0.5f < touchRect[2] &&
+                             touchRect[1] < 3.0f && touchRect[3] > touchRect[1];
+            Uint32 now = SDL_GetTicks();
+            if (sBarDwell == 0) {
+                sBarDwell = now | 1u; // (odd: 0 means not at the edge)
+            }
+            if (!overTouch || (int)(now - sBarDwell) >= 350) {
+                sBarMouse = true;
+            }
+        } else if (!(focus && (float)my < sBarH + 6.0f) && !popup) {
+            sBarMouse = false;
+        }
+    } else {
+        sBarMouse = false;
+        sBarLatch = false;
+    }
+    if (!(focus && my <= 2) || pinned) {
+        sBarDwell = 0;
+    } else if (b & SDL_BUTTON_LMASK) {
+        sBarDwell = SDL_GetTicks() | 1u; // clicking at the top edge: the count starts again from the click
+    }
+    // a popup keeps the bar out only when the bar was already out: a combo in the side or a settings window opening a
+    // popup must not bring the bar out (a new window takes the focus and ImGui closes the popup: the combo opened and
+    // shut at once, fullscreen with the bar on auto-hide)
+    sBarVisible = pinned || sBarMouse || sBarLatch || (popup && sBarVisible);
+    sBarReserve = pinned ? (int)ceilf(sBarH) : 0;
+    return sBarReserve;
+}

+// the UI's rectangles as a line of text for BWPORT_TOUCHLOG: the bar (when drawn), the side, the settings windows drawn
+// ---- touch mode (libntr-ios-settings.patch): the performance overlay ----------------------------------------------------------
+// The settings are a native sheet (port/src/ios_settings.m) reading and writing through SIM_UISettingGet / Set at the end of this file.
+
+// a small box in the top corner of the game's picture (inside the safe area, clear of the controls): fps and game speed, and with
+// OverlayDetail=detailed the frame time, the game / draw split and what draws
+extern "C" float SIM_PresentRate(void);   // libntr-ios-pace.patch (sim_main.cpp)
+extern "C" float SIM_GameSpeedNow(void);
+extern "C" float SIM_InputLatency(float * read, float * uikit);   // libntr-ios-input.patch (sim_main.cpp)
+extern "C" float SIM_InputGpuLatency(int release, float * shown);  // libntr-ios-lag.patch (sim_main.cpp)
+extern "C" float SIM_DisplayLag(int * inflight, float * maxMs);
+extern "C" float SIM_DisplayShown(int * waiting, float * hz);
+static void TouchOverlay() {
+    SIM_config_type * c = C();
+    if (!c->overlay || SimTouch_MenuOpen()) {
+        return;
+    }
+    float scr[4];
+    SimTouch_Screens(scr);
+    if (scr[2] <= 0.0f) {
+        return;
+    }
+    const Snap & m = sSnap;
+    char l1[64], l2[64] = "", l3[64] = "", l4[64] = "", l5[64] = "", l6[64] = "", l7[64] = "", l8[64] = "", l9[64] = "";
+    // libntr-ios-pace.patch: the presents a second and the game's speed as it runs (m.fps counts game ticks)
+    snprintf(l1, sizeof l1, "%.0f fps  %.1fx", SIM_PresentRate(), SIM_GameSpeedNow());
+    if (c->overlayDetail) {
+        int pw = 0, ph = 0;
+        SIM_RendererPicture(&pw, &ph);
+        snprintf(l2, sizeof l2, "%.1f ms (%.1f+%.1f)", m.avgMs, m.gameMs, m.drawMs);
+        snprintf(l3, sizeof l3, "%s %dx %dx%d", ActiveRenderer(), SIM_RenderScale(), pw, ph);
+        // libntr-ios-input.patch: the last touch press, finger to present (and how long UIKit held it before the game saw it)
+        float rd = 0.0f, uk = 0.0f, in = SIM_InputLatency(&rd, &uk);
+        if (in > 0.0f) snprintf(l4, sizeof l4, "input %.0f ms (UIKit %.0f)", in, uk);
+        else snprintf(l4, sizeof l4, "input -");
+        // libntr-ios-lag.patch: the last press and release to the GPU done with the picture that can show the game's answer, and the
+        // GPU's queue over the last second (the swap call to the GPU done: mean ms, the most frames submitted and not finished)
+        float sp = 0.0f, sr = 0.0f, gp = SIM_InputGpuLatency(0, &sp), gr = SIM_InputGpuLatency(1, &sr);
+        if (gp > 0.0f || gr > 0.0f) snprintf(l5, sizeof l5, "to GPU: press %.0f, release %.0f ms", gp, gr);
+        else snprintf(l5, sizeof l5, "to GPU: -");
+        int fl = 0;
+        float lmax = 0.0f, lag = SIM_DisplayLag(&fl, &lmax);
+        int wait = 0;
+        float hz = 0.0f, shown = SIM_DisplayShown(&wait, &hz);   // (iOS: the swap call to the estimated refresh that shows it)
+        if (hz > 0.0f) snprintf(l6, sizeof l6, "display lag %.0f ms (GPU %.0f) / %d in flight, %d waiting, %.0f Hz", shown, lag, fl, wait, hz);
+        else snprintf(l6, sizeof l6, "display lag %.0f ms / %d in flight", lag, fl);
+        // libntr-ios-sysmetrics.patch: the CPU, the clock estimate and heat state, the GPU (short forms, port/src/sysmetrics.c)
+        if (bwport_sys_line != nullptr) {
+            char ck[32], th[32];
+            bwport_sys_line(4, l7, sizeof l7);
+            bwport_sys_line(5, ck, sizeof ck);
+            bwport_sys_line(7, th, sizeof th);
+            snprintf(l8, sizeof l8, "%s, %s", ck, th);
+            bwport_sys_line(6, l9, sizeof l9);
+        }
+    }
+    int diag = 0;
+#ifdef __ANDROID__
+    // libntr-android-diag.patch: a tester's first 20 seconds show what draws (renderer, Resolution, picture size) and the GL renderer
+    // string, even with the overlay's detail off: the screenshot of a bug report then says which GPU path it ran
+    if (!c->overlayDetail && SDL_GetTicks() < 20000) {
+        int pw = 0, ph = 0;
+        SIM_RendererPicture(&pw, &ph);
+        snprintf(l2, sizeof l2, "%s %dx %dx%d", ActiveRenderer(), SIM_RenderScale(), pw, ph);
+        snprintf(l3, sizeof l3, "%s", SIM_PresentName());
+        diag = 3;
+    }
+#endif
+    ImFont * font = ImGui::GetFont();
+    const float u = SimTouch_Unit();   // (Android: the window is in pixels; 1 elsewhere)
+    float fs = 9.5f * u;
+    float pad = 5.0f * u, gap = 2.0f * u;
+    int lines = diag ? diag : l3[0] ? (l7[0] ? 9 : 6) : 1;
+    const char * ls[9] = {l1, l2, l3, l4, l5, l6, l7, l8, l9};
+    float w = 0.0f;
+    for (int i = 0; i < lines; i++) {
+        w = std::max(w, font->CalcTextSizeA(fs, FLT_MAX, 0.0f, ls[i]).x);
+    }
+    float h = (float)lines * fs + (float)(lines - 1) * gap;
+    float bw = w + 2.0f * pad, bh = h + 2.0f * pad;
+    float x = c->overlayCorner ? scr[0] + scr[2] - 4.0f * u - bw : scr[0] + 4.0f * u, y = scr[1] + 4.0f * u;
+    ImDrawList * dl = ImGui::GetForegroundDrawList();
+    dl->AddRectFilled(ImVec2(x, y), ImVec2(x + bw, y + bh), IM_COL32(0, 0, 0, 120), 5.0f * u);
+    // green: the game keeps its speed (Game speed or fast forward); yellow / red: it falls behind
+    float keep = SIM_GameSpeedNow() / (float)(SpeedIndex() + 1);
+    ImU32 fc = keep >= 0.95f ? IM_COL32(140, 255, 140, 255) : keep >= 0.5f ? IM_COL32(255, 220, 90, 255) : IM_COL32(255, 110, 90, 255);
+    for (int i = 0; i < lines; i++) {
+        dl->AddText(font, fs, ImVec2(x + pad, y + pad + (float)i * (fs + gap)), i == 0 ? fc : IM_COL32(235, 235, 240, 235), ls[i]);
+    }
+}

+  u64 vs = 0, per = 0;
+  if (panelHz == 0 && SpLink(&vs, &per) && per >= 4000000 && per <= 50000000) {
+    // libntr-ios-pacefix.patch: a new rate is followed once it has held half a second. Every change restarts the pace timeline
+    // (the slots, Smooth motion's pairing of pictures); a ProMotion panel moving inside the link's 80-120 range, or one odd link
+    // period, restarted it on each flip
+    static int sHz, sCandHz;
+    static u64 sCandT;
+    int hz = (int)((1000000000ull + per / 2) / per);
+    u64 t = SpNowNs();
+    if (sHz == 0 || hz == sHz) {
+      sHz = hz;
+      sCandHz = 0;
+    } else if (hz != sCandHz) {
+      sCandHz = hz;
+      sCandT = t;
+    } else if (t - sCandT >= 500000000ull) {
+      sHz = hz;
+      sCandHz = 0;
+    }
+    panelHz = sHz;
+  }
+#endif
+  if (panelHz > 0) {
+    if (panelHz != sLoggedHz) {
+      fprintf(stderr, "bwport: the panel runs at %d Hz: Monitor's presents follow it\n", panelHz);
+      sLoggedHz = panelHz;
+    }
+    return 1000000000ull / (u64)panelHz;
+  }

+// The DS runs its sound on the clock of its frames: 560190 ARM7 cycles per frame, the driver's alarm every 174592, a
+// sample (the mixer's output) every 1024. Here the sound side is stepped by SIM_Audio_FrameTick, once per game frame
+// (the V-blank in SIM_Render), with sim7's driver and channels or with the program's backend (port/acore), and what it
+// makes goes into a ring of DS-rate samples. The audio callback plays the ring, resampled (cubic) to the device's
+// rate with a rate that follows the ring's fill: a game that runs at 60 fps neither starves nor overflows it, one
+// that runs uncapped fills it and the samples that do not fit are dropped, one that runs slow leaves silence.
+#define SND_CYC_FRAME 560190ull
+#define SND_CYC_TICK 174592ull
+#define SND_CYC_SAMPLE 1024ull
+#define SND_DS_RATE (33513982.0 / 1024.0)
+#define SND_RING 4096u // DS-rate frames (125 ms)
+#define SND_PRIME 820u // the callback starts (again) when the ring holds this much (1.5 frames)
+#define SND_TARGET 1100.0
+
+static int s_frameClock = 0;
+static int s_musicSlow = 1; // the factor the music's tempo is lowered by (libntr-sp76.patch)
+static int s_split = 0; // libntr-mu83.patch: the backend's music bus is split off (the music is not in the samples RingPush gets)
+extern "C" void SIM_Snd_SetMusicSlow(int aSlow); // libraries/snd/src/snd_interface.c
+extern "C" int SIM_FastForwarding(void); // sim_main.cpp (libntr-mu83.patch): Space held or the frame rate unlimited
+static u64 s_sndCyc = 0; // the sound's time: ARM7 cycles
+static u64 s_frameCyc = 0; // the games's frames x 560190
+static u64 s_nextTick = SND_CYC_TICK;
+static u64 s_nextSample = SND_CYC_SAMPLE;
+static s16 s_ring[SND_RING][2];
+static u64 s_ringWr = 0, s_ringRd = 0; // frames written / read (the callback and the tick are mutually exclusive)
+static u64 s_ringDropped = 0;
+static u64 s_ringUnderruns = 0;
+static int s_audioLog = -1; // BWPORT_AUDIOLOG=1: the ring's state once a second (stderr)
+static int s_ringPrimed = 0;
+static double s_ringFrac = 1.0; // position between the two samples at the middle of the resampler's window
+static unsigned s_devRate = 44100;
+static FILE * s_wav = NULL;
+static u64 s_wavFrames = 0;
+static u64 s_wavSince = 0;
+
+static FILE * s_outWav = NULL; // BWPORT_AUDIO_OUT=FILE: what the callback plays (the device's rate), silences included
+static u64 s_outFrames = 0;
+static void WavHeaderR(FILE * f, u64 frames, unsigned rate);
+static void WavHeader(FILE * f, u64 frames)
+{
+    WavHeaderR(f, frames, 32728); // the compare tool's form: a WAV says 32728 Hz
+}
+
+static void WavHeaderR(FILE * f, u64 frames, unsigned rate)
+{
+    unsigned char h[44];
+    unsigned data = (unsigned)(frames * 4);
+    unsigned v = 36 + data;
+    unsigned short s;
+    memcpy(h, "RIFF", 4);
+    memcpy(h + 4, &v, 4);
+    memcpy(h + 8, "WAVEfmt ", 8);
+    v = 16;
+    memcpy(h + 16, &v, 4);
+    s = 1;
+    memcpy(h + 20, &s, 2);
+    s = 2;
+    memcpy(h + 22, &s, 2);
+    v = rate;
+    memcpy(h + 24, &v, 4);
+    v = rate * 4;
+    memcpy(h + 28, &v, 4);
+    s = 4;
+    memcpy(h + 32, &s, 2);
+    s = 16;
+    memcpy(h + 34, &s, 2);
+    memcpy(h + 36, "data", 4);
+    memcpy(h + 40, &data, 4);
+    fseek(f, 0, SEEK_SET);
+    fwrite(h, 1, 44, f);
+    fseek(f, 0, SEEK_END);
+}
+
+static void WavClose(void)
+{
+    if(s_outWav) {
+        WavHeaderR(s_outWav, s_outFrames, s_devRate);
+        fclose(s_outWav);
+        s_outWav = NULL;
+    }
+    if(s_wav) {
+        WavHeader(s_wav, s_wavFrames);
+        fclose(s_wav);
+        s_wav = NULL;
+    }
+}
+
+// measuring switches (libntr-ios-sound.patch): BWPORT_AUDIO_TONE=HZ replaces every frame the ring takes by a sine (phase continuous
+// in the frames taken, as the music bus is), so BWPORT_AUDIO_OUT shows what the ring and its rate control do to a steady pitch;
+// BWPORT_AUDIO_MUTE=1 plays silence (BWPORT_AUDIO_OUT still gets the real output); BWPORT_AUDIO_SLOW=PCT makes the frame tick
+// PCT percent slower than the DS's 59.8261 Hz (a device that cannot keep up)
+static double s_toneInc = 0.0, s_tonePh = 0.0, s_tonePushInc = 0.0, s_tonePushPh = 0.0;
+static int s_mute = 0;
+static double s_slowPct = 0.0;
+
+static s32 ClampS16(s32 v) { return v > 32767 ? 32767 : v < -32768 ? -32768 : v; }
+
+// ---- bw-port (libntr-ios-sound.patch): the ring's fill ----
+// The producer (a game frame's 547 samples at once, or a time-stretched block) and the callback (~171 DS frames every 5 ms)
+// meet in the ring. The fill is held near SND_TARGET by the callback's playback rate (RateUpdate, slow and small: it was the
+// raw fill times 6 %, which wobbled the pitch of everything by +-25 cents with the frame rhythm and pinned it 85 cents sharp
+// at +5 % while the ring was full). What the rate cannot absorb is cut: when the fill reaches SND_CAP (the game runs uncapped:
+// Max fast forward, Frame rate Unlimited; or the device stopped taking samples) the incoming frames are skipped until the fill
+// is back at SND_RESUME, and the first SND_XF frames after a skip are cross-faded into the last ones in the ring, so the
+// sound is pieces of ~60 ms joined smoothly (single frames used to be dropped: 5 ms slices with hard joins, a buzz). The
+// music bus (s_split) takes a frame only for a frame appended, so the music stays continuous through the skips.
+#define SND_CAP 3100u
+#define SND_RESUME 1100u
+#define SND_XF 128
+static s16 s_ringDry[SND_RING][2]; // each ring frame without the music bus's share (what a cross-fade fades out)
+static int s_skip = 0;             // frames are being skipped
+static int s_xf = 0;               // frames of cross-fade left
+static u64 s_skips = 0;
+
+// whether the next frame goes into the ring (appended or cross-faded)
+static int RingTakes(void)
+{
+    u64 fill = s_ringWr - s_ringRd;
+    if(!s_skip && fill >= SND_CAP) {
+        s_skip = 1;
+        s_skips++;
+    }
+    if(s_skip && fill <= SND_RESUME) {
+        s_skip = 0;
+        s_xf = SND_XF;
+    }
+    return !s_skip && fill < SND_RING - 1;
+}
+
+// one DS-rate frame for the ring (after the time-stretch); aMus: the music bus's frame goes with it
+static void RingOutX(s16 l, s16 r, int aMus);
+static void RingOut(s16 l, s16 r) { RingOutX(l, r, 0); }
+
+// ---- bw-port (libntr-sp76.patch): Speed > 1 ----
+// At Speed S the game ticks S times as fast, so the sound side makes S times as many samples a second as the device
+// plays. The samples go through a time-stretch that gives them back at the real-time rate with the pitch unchanged:
+// WSOLA (waveform-similarity overlap-add; Verhelst & Roelands 1993, the public description). Output blocks of ST_HS
+// frames are made by overlap-adding Hann-windowed segments of ST_N frames; segment k is taken from the input near
+// k * S * ST_HS (so the input is consumed S times as fast as the output is made), at the offset within +-ST_DELTA whose
+// start best continues the previous segment (normalized cross-correlation over the overlap, on the mono sum). At Speed
+// 1 nothing of this runs: RingPush goes straight to the ring (the same samples as before). Engaging continues the
+// samples already played (the previous segment is the input itself, so there is no seam); disengaging cross-fades the
+// pending tail into the newest input and plays the rest of it as it is. All of it runs under SDL's audio lock, on the
+// producer side (a tick's samples), so the callback keeps playing a ring of normal-rate samples.
+#define ST_HS 512
+#define ST_N (2 * ST_HS)
+#define ST_DELTA 256
+#define ST_BUF 16384u
+
+static s16 st_in[ST_BUF][2];
+static u64 st_inN = 0;     // frames pushed since the start
+static int st_S = 1;       // 1 = bypassed
+static int st_armed = 0;   // engaged, the pending tail not made yet
+static s64 st_p = 0;       // engage position: the first input frame not played
+static s64 st_prevPos = 0; // where the previous segment starts
+static s64 st_nom = 0;     // nominal start of the next segment
+static float st_pend[ST_HS][2];
+static float st_win[ST_N];
+static int st_winInit = 0;
+
+static void RingOut(s16 l, s16 r);
+
+static inline s16 StIn(s64 i, int c) { return st_in[(u64)i % ST_BUF][c]; }
+static inline s16 StClamp(float v) { return (s16)(v > 32767.f ? 32767 : v < -32768.f ? -32768 : (int)(v < 0 ? v - 0.5f : v + 0.5f)); }
+
+static void StInit(void)
+{
+    if(!st_winInit) {
+        st_winInit = 1;
+        for(int i = 0; i < ST_N; i++) {
+            st_win[i] = (float)(0.5 - 0.5 * cos(2.0 * 3.14159265358979323846 * i / ST_N));
+        }
+    }
+}
+
+// the start in [lo, hi] whose ST_HS frames best continue the input from refPos (nearest to nom when nothing is better)
+static s64 StBestMatch(s64 lo, s64 hi, s64 refPos, s64 nom)
+{
+    s64 cn = nom < lo ? lo : nom > hi ? hi : nom;
+    if(hi <= lo) {
+        return lo;
+    }
+    float ref[ST_HS / 2];
+    double refE = 0;
+    for(int i = 0; i < ST_HS / 2; i++) {
+        s64 k = refPos + 2 * i;
+        ref[i] = (float)(StIn(k, 0) + StIn(k, 1));
+        refE += (double)ref[i] * ref[i];
+    }
+    if(refE < 1.0) {
+        return cn;
+    }
+    s64 best = cn;
+    double bestScore = -1e30;
+    for(s64 c = lo; c <= hi; c++) {
+        double corr = 0, en = 0;
+        for(int i = 0; i < ST_HS / 2; i++) {
+            s64 k = c + 2 * i;
+            float m = (float)(StIn(k, 0) + StIn(k, 1));
+            corr += (double)ref[i] * m;
+            en += (double)m * m;
+        }
+        double score = corr / sqrt(en + 1.0);
+        if(c == cn) {
+            score += 1e-6 * (fabs(score) + 1.0); // a tie goes to the nominal start
+        }
+        if(score > bestScore) {
+            bestScore = score;
+            best = c;
+        }
+    }
+    return best;
+}
+
+static void StEngage(int aS)
+{
+    StInit();
+    st_S = aS;
+    st_armed = 1;
+    st_p = (s64)st_inN;
+    st_prevPos = st_p - ST_HS;
+    st_nom = st_prevPos + (s64)aS * ST_HS;
+}
+
+// ---- bw-port (libntr-mu83.patch): the music bus ----
+// With the backend's music bus split off (Speed > 1 or fast forward, Music at normal speed) the samples RingPush gets hold no
+// music: the music players run on a clock of their own and the backend makes their frames as the output needs them. Every
+// output frame the ring takes gets the next music frame added (the music is never stretched), so the music plays in real
+// time whatever the game does: a frame the ring drops (Space, Tab: the game runs faster than the device plays) takes no
+// music frame with it. MusNeed tops the FIFO up to what the loop that follows plays (that is exact when nothing is
+// dropped: no music frame is made and left unplayed).
+#define MUS_MAX 4096
+static s16 s_mus[MUS_MAX][2];
+static int s_musN = 0, s_musRd = 0;
+
+static void MusNeed(int aN)
+{
+    if(!s_split || aN <= 0) {
+        s_musN = 0;
+        s_musRd = 0;
+        return;
+    }
+    int have = s_musN - s_musRd;
+    if(have >= aN) {
+        return;
+    }
+    if(s_musRd > 0) {
+        memmove(&s_mus[0][0], &s_mus[s_musRd][0], (size_t)have * sizeof s_mus[0]);
+        s_musN = have;
+        s_musRd = 0;
+    }
+    int want = aN - have;
+    if(have + want > MUS_MAX) {
+        want = MUS_MAX - have;
+    }
+    s_musN += SIM_soundBackend->busRun(&s_mus[have][0], want);
+}
+
+static void RingOutM(s16 l, s16 r) { RingOutX(l, r, s_split); }
+
+static void RingOutX(s16 l, s16 r, int aMus)
+{
+    if(!RingTakes()) {
+        s_ringDropped++;
+        return;
+    }
+    if(s_toneInc > 0.0) { // (the tone stands for the music: continuous in the frames appended, no cross-fade)
+        if(s_xf > 0) {
+            s_xf--;
+            return;
+        }
+        l = r = (s16)lrint(8000.0 * sin(s_tonePh));
+        s_tonePh += s_toneInc;
+        if(s_tonePh > 6.283185307179586) {
+            s_tonePh -= 6.283185307179586;
+        }
+        aMus = 0;
+    }
+    if(s_xf > 0) {
+        u64 j = s_ringWr - (u64)s_xf;
+        if(j > s_ringRd) { // (frames the callback already took are not faded)
+            int i = SND_XF - s_xf;
+            float w = 0.5f - 0.5f * cosf(3.14159265f * ((float)i + 0.5f) / (float)SND_XF);
+            s16 * o = s_ring[j % SND_RING];
+            s16 * d = s_ringDry[j % SND_RING];
+            o[0] = (s16)ClampS16((s32)lrintf((float)o[0] + w * (float)(l - d[0])));
+            o[1] = (s16)ClampS16((s32)lrintf((float)o[1] + w * (float)(r - d[1])));
+            d[0] = (s16)lrintf((float)d[0] + w * (float)(l - d[0]));
+            d[1] = (s16)lrintf((float)d[1] + w * (float)(r - d[1]));
+            s_xf--;
+            return;
+        }
+        s_xf = 0;
+    }
+    s16 dl = l, dr = r;
+    if(aMus) { // the ring takes this frame: its music frame goes with it
+        if(s_musRd >= s_musN) {
+            MusNeed(1);
+        }
+        if(s_musRd < s_musN) {
+            l = (s16)ClampS16((s32)l + s_mus[s_musRd][0]);
+            r = (s16)ClampS16((s32)r + s_mus[s_musRd][1]);
+            s_musRd++;
+        }
+    }
+    if(s_wav) { // libntr-mu83.patch: what the ring takes (a frame dropped at fast forward is not in the file)
+        s16 f[2] = {l, r};
+        fwrite(f, 4, 1, s_wav);
+        s_wavFrames++;
+    }
+    s_ring[s_ringWr % SND_RING][0] = l;
+    s_ring[s_ringWr % SND_RING][1] = r;
+    s_ringDry[s_ringWr % SND_RING][0] = dl;
+    s_ringDry[s_ringWr % SND_RING][1] = dr;
+    s_ringWr++;
+}
+
+// the time-stretched blocks the input allows
+static void StRun(void)
+{
+    if(st_S <= 1) {
+        return;
+    }
+    for(;;) {
+        if(st_armed) {
+            if((s64)st_inN < st_p + ST_HS) {
+                return;
+            }
+            for(int i = 0; i < ST_HS; i++) {
+                for(int c = 0; c < 2; c++) {
+                    st_pend[i][c] = st_win[ST_HS + i] * (float)StIn(st_p + i, c);
+                }
+            }
+            st_armed = 0;
+        }
+        s64 lo = st_nom - ST_DELTA;
+        if(lo < st_prevPos + 1) {
+            lo = st_prevPos + 1;
+        }
+        if((s64)st_inN - lo > (s64)ST_BUF - 2 * ST_N) { // far behind (a flood of input): jump to the newest
+            st_nom = (s64)st_inN - ST_N - ST_DELTA;
+            lo = st_nom - ST_DELTA;
+        }
+        if((s64)st_inN < lo + ST_N) {
+            return;
+        }
+        s64 hi = st_nom + ST_DELTA;
+        if(hi > (s64)st_inN - ST_N) {
+            hi = (s64)st_inN - ST_N;
+        }
+        s64 c = StBestMatch(lo, hi, st_prevPos + ST_HS, st_nom);
+        MusNeed(ST_HS);
+        for(int i = 0; i < ST_HS; i++) {
+            float l = st_pend[i][0] + st_win[i] * (float)StIn(c + i, 0);
+            float r = st_pend[i][1] + st_win[i] * (float)StIn(c + i, 1);
+            RingOutM(StClamp(l), StClamp(r));
+            st_pend[i][0] = st_win[ST_HS + i] * (float)StIn(c + ST_HS + i, 0);
+            st_pend[i][1] = st_win[ST_HS + i] * (float)StIn(c + ST_HS + i, 1);
+        }
+        st_prevPos = c;
+        st_nom += (s64)st_S * ST_HS;
+    }
+}
+
+// back to Speed 1: the pending tail cross-fades into the newest input, which then plays as it is
+static void StDisengage(void)
+{
+    if(st_S <= 1) {
+        return;
+    }
+    s64 from = st_p; // first input frame not played
+    if(!st_armed) {
+        s64 hi = (s64)st_inN - ST_HS;
+        s64 lo = hi - ST_DELTA;
+        if(lo < st_prevPos + 1) {
+            lo = st_prevPos + 1;
+        }
+        if(hi < lo) {
+            hi = lo;
+        }
+        s64 c = (s64)st_inN >= lo + ST_HS ? StBestMatch(lo, hi, st_prevPos + ST_HS, hi) : lo;
+        if((s64)st_inN >= c + ST_HS) {
+            MusNeed(ST_HS);
+            for(int i = 0; i < ST_HS; i++) {
+                float l = st_pend[i][0] + st_win[i] * (float)StIn(c + i, 0);
+                float r = st_pend[i][1] + st_win[i] * (float)StIn(c + i, 1);
+                RingOutM(StClamp(l), StClamp(r));
+            }
+            from = c + ST_HS;
+        } else {
+            from = (s64)st_inN;
+        }
+    }
+    for(s64 k = from; k < (s64)st_inN;) {
+        s64 n = (s64)st_inN - k;
+        MusNeed(n > MUS_MAX ? MUS_MAX : (int)n);
+        for(s64 e = k + (n > MUS_MAX ? MUS_MAX : n); k < e; k++) {
+            RingOutM(StIn(k, 0), StIn(k, 1));
+        }
+    }
+    st_S = 1;
+}
+
+// one DS-rate frame made by the sound side
+static void RingPush(s16 l, s16 r)
+{
+    if(s_tonePushInc > 0.0) { // BWPORT_AUDIO_TONEPUSH=HZ: the sine in the game's time, before the stretch and the ring's cuts
+        l = r = (s16)lrint(8000.0 * sin(s_tonePushPh));
+        s_tonePushPh += s_tonePushInc;
+        if(s_tonePushPh > 6.283185307179586) {
+            s_tonePushPh -= 6.283185307179586;
+        }
+    }
+    if(st_S > 1) {
+        st_in[st_inN % ST_BUF][0] = l;
+        st_in[st_inN % ST_BUF][1] = r;
+        st_inN++;
+        return;
+    }
+    if(s_split) {
+        RingOutM(l, r); // fast forward at Speed 1 with the music bus split off
+        return;
+    }
+    RingOut(l, r);
+}
+
+
+extern "C" void SIM_PxiRunPending(u64 aTickCycle, int aAll);
+extern "C" u64 SIM_Audio_NowCycle(void) { return s_sndCyc; }
+
+static void PanOutput(s32 in, s32 * left, s32 * right, int chNo);
+
+// one mixer sample of sim7's channels (the callback's old loop body without the master volume and the blip)
+static void Sim7Sample(void)
+{
+    s32 left = 0;
+    s32 right = 0;
+    for(int chNo = 0; chNo < 16; chNo++) {
+        s32 channel = SIM_Audio_RunChannel(512, chNo);
+        PanOutput(channel, &left, &right, chNo);
+    }
+    left >>= 8;
+    right >>= 8;
+    left += (0x200 << 6) - 0x8000;
+    right += (0x200 << 6) - 0x8000;
+    RingPush((s16)ClampS16(left), (s16)ClampS16(right));
+}
+
+// run the sound to cycle aTarget (the caller holds SDL's audio lock)
+static void SoundAdvance(u64 aTarget)
+{
+    if(aTarget <= s_sndCyc) {
+        return;
+    }
+    if(SIM_soundBackendOn) {
+        s16 buf[2048 * 2];
+        int n = SIM_soundBackend->run(aTarget, buf, 2048);
+        for(int i = 0; i < n; i++) {
+            RingPush(buf[2 * i], buf[2 * i + 1]);
+        }
+    } else {
+        for(;;) {
+            if(s_nextTick <= aTarget && s_nextTick <= s_nextSample) {
+                SND_UpdateExChannel();
+                SIM_PxiRunPending(s_nextTick, 0); // the command lists the game sent, due at this alarm
+                SND_SeqMain(TRUE);
+                SND_ExChannelMain(TRUE);
+                s_nextTick += SND_CYC_TICK;
+            } else if(s_nextSample <= aTarget) {
+                Sim7Sample();
+                s_nextSample += SND_CYC_SAMPLE;
+            } else {
+                break;
+            }
+        }
+    }
+    StRun();
+    s_sndCyc = aTarget;
+    if(s_wav && ++s_wavSince >= 60) {
+        WavHeader(s_wav, s_wavFrames);
+        fflush(s_wav);
+        s_wavSince = 0;
+    }
+}
+
+// libntr-ios-sound.patch: the playback rate's correction, from the fill after each frame tick (the audio locked). The fill is
+// low-passed (two poles at 0.2 s: the frame rhythm's 547-frame sawtooth is 70 dB down at 60 Hz) and drives a PI controller:
+// the proportional part at most +-0.25 % (4 cents), the integral part follows a producer that is really slower or faster
+// (a device that cannot hold 60 fps) by at most 0.3 % a second (and 0.1 % for a dry ring while the game ran), up to +-3 %. So
+// the pitch never moves faster than a slow glide; a fill far off is cut (SND_CAP above) or played dry (the callback's fade
+// below) instead of being corrected by pitch.
+static double s_rateAdj = 0.0, s_rateI = 0.0, s_lp1 = 0.0, s_lp2 = 0.0, s_tickT = 0.0;
+static int s_wasUnpaced = 0;
+#define SND_TPOST (SND_TARGET + 273.0) // the fill right after a frame's samples (the target is the mean)
+
+static void RateUpdate(void)
+{
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    double now = (double)ts.tv_sec + ts.tv_nsec * 1e-9;
+    double dt = s_tickT > 0.0 ? now - s_tickT : 1.0;
+    s_tickT = now;
+    double fill = (double)(s_ringWr - s_ringRd);
+    int unpaced = SIM_FastForwarding();
+    static u64 sUnder = 0;
+    if(s_ringUnderruns != sUnder) { // dry while the game ran at its pace (not a pause, not one long stall): it is slower than the rate
+        sUnder = s_ringUnderruns;
+        if(!unpaced && dt < 0.1 && s_rateI > -0.03) {
+            s_rateI -= 0.001;
+        }
+    }
+    dt = dt < 0.0 ? 0.0 : dt > 0.1 ? 0.1 : dt;
+    if(s_wasUnpaced && !unpaced && fill > SND_TPOST + 300.0 && !s_skip) { // back from Max: down to the target at once
+        s_skip = 1;
+        s_skips++;
+    }
+    s_wasUnpaced = unpaced;
+    static int sMode = -1; // a speed change starts the integral afresh (what it learnt is the old speed's shortfall: after a
+    int mode = sConfigPtr->speed * 2 + unpaced; // 4x the game could not hold it glided back for seconds)
+    if(mode != sMode) {
+        sMode = mode;
+        s_rateI = 0.0;
+    }
+    if(unpaced || s_skip) { // (the fill says nothing about the rates now)
+        s_lp1 = s_lp2 = fill;
+        s_rateAdj = s_rateI;
+        return;
+    }
+    if(!s_ringPrimed) {
+        s_rateAdj = s_rateI;
+        return;
+    }
+    double a = dt / 0.2;
+    a = a > 1.0 ? 1.0 : a;
+    s_lp1 += a * (fill - s_lp1);
+    s_lp2 += a * (s_lp1 - s_lp2);
+    if(s_lp2 > SND_TPOST + 600.0) { // lastingly too full (a burst after a stall): cut it rather than play it fast for seconds
+        s_skip = 1;
+        s_skips++;
+        return;
+    }
+    double e = (s_lp2 - SND_TPOST) / SND_TARGET;
+    e = e > 1.0 ? 1.0 : e < -1.0 ? -1.0 : e;
+    s_rateI += 0.003 * e * dt;
+    s_rateI = s_rateI > 0.03 ? 0.03 : s_rateI < -0.03 ? -0.03 : s_rateI;
+    double p = 0.018 * e;
+    p = p > 0.0025 ? 0.0025 : p < -0.0025 ? -0.0025 : p;
+    s_rateAdj = s_rateI + p;
+}

+// ---- bw-port (libntr-sp76.patch): game speed and display cap ----
+// The game ticks (one SIM_Render each) at 60 x Speed a second, on a timeline of absolute deadlines: tick n is due at
+// t0 + n * kSpFrame / Speed. The window presents on a second timeline, the slots t0 + phase + k * Q (Q = the DS frame
+// for DisplayCap=60, half of it for 120, the display's refresh period for monitor). The slots that fall inside a
+// tick's interval [due(n), due(n+1)) are that tick's presents: none = the tick is neither drawn nor presented (the frame
+// skip path), one = drawn and presented at the slot's time (so the presents are evenly spaced whatever the tick rate),
+// two = the same picture again at the second slot (1x at 120; where an in-between picture is slotted in later).
+// Uncapped (the cap off, Space held): every tick presents at once.
+static const u64 kSpFrame = 16715000; // ns: 59.8261 Hz, as the DS
+static struct {
+  bool on;
+  u64 t0, n;
+  int S;
+  u8 mode;
+  u64 Q;
+  s64 phase;
+  s64 first;
+  int count;
+  bool forced;
+  u64 waited; // ns spent waiting for the slot this tick
+} sPace;
+// bw-port (libntr-ib78.patch): the P lines of BWPORT_PRESENTLOG also say whether the slot showed an in-between picture and
+// the hash of the pixels it showed (BWPORT_PRESENTHASH=1; the vcore path's pictures only)
+static int sPresentMid;
+static u64 sPresentHash;
+static int sPresentHashOn = -1;
+static u64 SpHashRgba(const unsigned char *p, size_t n) {
+  u64 h = 1469598103934665603ull;
+  const u64 *q = (const u64 *)p;
+  for (size_t i = 0; i < n / 8; i++) h = (h ^ q[i]) * 1099511628211ull;
+  return h;
+}
+// bw-port (libntr-ib79.patch): the same hash of a GL texture's pixels (the GPU path's pictures), read back through an FBO
+static int SpHashWanted(void) {
+  if (sPresentLog != NULL && sPresentHashOn < 0) sPresentHashOn = getenv("BWPORT_PRESENTHASH") != NULL;
+  return sPresentHashOn > 0;
+}
+static u64 SpHashTex(unsigned tex, int w, int h) {
+  if (w <= 0 || h <= 0) return 0;
+  unsigned char *buf = (unsigned char *)malloc((size_t)w * h * 4);
+  if (buf == NULL) return 0;
+  GLint prevRead = 0, prevPack = 4;
+  glGetIntegerv(GL_READ_FRAMEBUFFER_BINDING, &prevRead);
+  glGetIntegerv(GL_PACK_ALIGNMENT, &prevPack);
+  GLuint fbo = 0;
+  glGenFramebuffers(1, &fbo);
+  glBindFramebuffer(GL_READ_FRAMEBUFFER, fbo);
+  glFramebufferTexture2D(GL_READ_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, tex, 0);
+  glPixelStorei(GL_PACK_ALIGNMENT, 1);
+  u64 r = 0;
+  if (glCheckFramebufferStatus(GL_READ_FRAMEBUFFER) == GL_FRAMEBUFFER_COMPLETE) {
+    glReadPixels(0, 0, w, h, GL_RGBA, GL_UNSIGNED_BYTE, buf);
+    r = SpHashRgba(buf, (size_t)w * h * 4);
+  }
+  glPixelStorei(GL_PACK_ALIGNMENT, prevPack);
+  glBindFramebuffer(GL_READ_FRAMEBUFFER, (GLuint)prevRead);
+  glDeleteFramebuffers(1, &fbo);
+  free(buf);
+  return r;
+}
 

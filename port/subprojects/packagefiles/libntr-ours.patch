+// ---- the native settings sheet's way in (port/src/ios_settings.m), libntr-ios-settings.patch ------------------------------------
+// Every setting is an int by name; a write applies it through the same helpers as the desktop menus and saves sim_config.ini.
+// renderer 0..2 (auto, vcore, gpu); resolution 1..8; antialias 0..2 (off, 4 samples, SMAA); smooth, filter (0 nearest, 1 bilinear), line, edge,
+// musicnormal, overlay, corner (0 left, 1 right), detail (0 compact, 1 detailed), skipslow (frame skip Auto on / off) 0/1; speed 1..4;
+// ffspeed 2..5 (5 = Max, the fast-forward button's speed); smooth also sets the frame rate (60 off, the screen's on); framerate 0..3 (60, 120, Monitor,
+// Unlimited); hidetouch 0/1 (touch buttons hidden while a controller is connected); frameskip 0..4 (off, 1, 2, 3, auto); volume 0..100. Read only: active (0 starting, 1 vcore, 2 gpu), scale.
+extern "C" int SIM_UISettingGet(const char * k) {
+    using namespace SIM::GUI;
+    SIM_config_type * c = C();
+    if (!strcmp(k, "renderer")) return c->renderer < 3 ? c->renderer : 0;
+    if (!strcmp(k, "resolution")) return c->resolution;
+    if (!strcmp(k, "antialias")) return AntialiasIndex(c->antialias);
+    if (!strcmp(k, "smooth")) return c->interpolation != 0;
+    if (!strcmp(k, "filter")) return c->texSmooth != 0;
+    if (!strcmp(k, "texsmooth")) return c->texSmooth < 3 ? c->texSmooth : 2;   // 0 Off, 1 Bilinear, 2 Mipmaps
+    if (!strcmp(k, "filter2d")) return c->filter2d < 3 ? c->filter2d : 1;      // 0 Off, 1 Scale2x, 2 MMPX
+    if (!strcmp(k, "fog")) return c->gpuFog != 0;
+    if (!strcmp(k, "color")) return c->gpuColor != 0;
+    if (!strcmp(k, "renderer3d")) return c->gpuFast != 0;   // libntr-ios-fast3d.patch: 0 exact, 1 fast
+    if (!strcmp(k, "fast3d")) return SIM_Renderer3DFastState(NULL);   // libntr-ios-fastgl.patch: 1 drawn, 0 cannot, -1 not tried
+    if (!strcmp(k, "line")) return c->gpuLine != 0;
+    if (!strcmp(k, "edge")) return c->gpuEdge != 0;
+    if (!strcmp(k, "speed")) return SpeedIndex() + 1;
+    if (!strcmp(k, "framerate")) return DisplayCapIndex();
+    if (!strcmp(k, "musicnormal")) return c->musicNormalSpeed != 0;
+    if (!strcmp(k, "soundquality")) return c->soundQuality != 0;
+    if (!strcmp(k, "frameskip")) return FrameSkipIndex();
+    if (!strcmp(k, "ffspeed")) return c->ffSpeed < 2 ? 2 : c->ffSpeed > 5 ? 5 : c->ffSpeed;   // libntr-ios-speedui.patch
+    if (!strcmp(k, "textspeed")) return TextSpeedIndex();   // libntr-ios-textspeed.patch: 0 (game) .. 3 (instant)
+    if (!strcmp(k, "fadespeed")) return FadeSpeedIndex();   // libntr-ios-fadespeed.patch: 0 (1x), 1 (2x), 2 (4x), 3 (instant)
+    if (!strcmp(k, "walkspeed")) return c->walkSpeed >= 4 ? 4 : c->walkSpeed >= 2 ? 2 : 1;   // libntr-ios-movesettings.patch: 1, 2 or 4
+    if (!strcmp(k, "runspeed")) return c->runSpeed >= 4 ? 4 : c->runSpeed >= 2 ? 2 : 1;   // libntr-ios-movesettings.patch: 1, 2 or 4
+    if (!strcmp(k, "surfspeed")) return c->surfSpeed >= 4 ? 4 : c->surfSpeed >= 2 ? 2 : 1;   // libntr-ios-movesettings.patch: 1, 2 or 4
+    if (!strcmp(k, "savespeed")) return c->saveSpeed >= 4 ? 4 : c->saveSpeed >= 2 ? 2 : 1;   // libntr-ios-savespeed.patch: 1 (off), 2 or 4
+    if (!strcmp(k, "battlespeed")) return BattleSpeedIndex() + 1;   // libntr-ios-battlespeed.patch: 1 (off) .. 4
+    if (!strcmp(k, "skipslow")) return c->frameSkip != 0;
+    if (!strcmp(k, "volume")) return (int)((c->masterVolume * 100 + 63) / 127);
+    if (!strcmp(k, "metrics")) return !(SimTouch_Active() ? c->overlay : c->showMetrics) ? 0 : c->overlayDetail ? 2 : 1;   // 0 Off, 1 Compact, 2 Detailed
+    if (!strcmp(k, "overlay")) return c->overlay != 0;
+    if (!strcmp(k, "corner")) return c->overlayCorner != 0;
+    if (!strcmp(k, "detail")) return c->overlayDetail != 0;
+    if (!strcmp(k, "hidetouch")) return c->hideTouch != 0;
+    if (!strcmp(k, "present")) return c->present != 0;   // libntr-ios-gpuapi.patch: 0 OpenGL, 1 Metal (at the next start)
+    if (!strcmp(k, "presentnow")) return SIM_PresentMetal();   // what this run presents with
+    if (!strcmp(k, "active")) return SIM_RendererActive();
+    if (!strcmp(k, "scale")) return SIM_RenderScale();
+    return -1;
+}

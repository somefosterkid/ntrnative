+// libntr-desktop-speed.patch: the Fast-forward speed (2x 3x 4x Max = ffSpeed 2..5); Space switches fast forward on and off (sim_main.cpp)
+extern "C" int SIM_FFOn(void);
+extern "C" void SIM_FFSet(int on);
+static int FFIndex() {
+    SIM_config_type * c = C();
+    return c->ffSpeed < 2 ? 0 : c->ffSpeed > 5 ? 3 : c->ffSpeed - 2;

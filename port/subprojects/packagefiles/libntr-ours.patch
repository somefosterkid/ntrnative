+#ifdef _WIN32
+extern "C" __declspec(dllimport) char * __stdcall GetCommandLineA(void);
+#endif
+
+static void RestartProgram() {
+    SIM_Config_SaveConfigFile(C());
+#if defined(__linux__)
+    FILE * f = fopen("/proc/self/cmdline", "rb");
+    if (f != nullptr) {
+        std::vector<char> buf;
+        int ch;
+        while ((ch = fgetc(f)) != EOF) {
+            buf.push_back((char)ch);
+        }
+        fclose(f);
+        std::vector<char *> argv;
+        size_t at = 0;
+        while (at < buf.size()) {
+            argv.push_back(&buf[at]);
+            at += strlen(&buf[at]) + 1;
+        }
+        argv.push_back(nullptr);
+        execv("/proc/self/exe", argv.data());
+    }
+#elif defined(_WIN32)
+    std::string cmd = std::string("start \"\" ") + GetCommandLineA();
+    system(cmd.c_str());
+    exit(0);
+#elif TARGET_OS_OSX
+    // bw-port (libntr-ios-metaltune.patch): macOS, as Linux: the program itself again, same arguments and environment
+    char path[4096];
+    uint32_t n = sizeof path;
+    if (_NSGetExecutablePath(path, &n) == 0) {
+        fprintf(stderr, "bwport: restarting %s\n", path);
+        fflush(stderr);
+        execv(path, *_NSGetArgv());
+    }
+#endif
+}

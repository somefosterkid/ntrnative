+static void UiLog() {
+    static FILE * f;
+    static int init;
+    if (!init) {
+        init = 1;
+        const char * p = getenv("BWPORT_UILOG");
+        if (p != nullptr && p[0] != 0) { f = fopen(p, "a"); }
+    }
+    if (f == nullptr) { return; }
+    ImGuiContext & g = *sImguiContext;
+    ImGuiIO & io = ImGui::GetIO();
+    int sx = 0, sy = 0, ww = 0, wh = 0, dw = 0, dh = 0, px = 0, py = 0;
+    Uint32 b = SDL_GetMouseState(&sx, &sy);
+    SDL_GetWindowSize(sWindow, &ww, &wh);
+    SDL_GL_GetDrawableSize(sWindow, &dw, &dh);
+    SDL_GetWindowPosition(sWindow, &px, &py);
+    Uint32 fl = SDL_GetWindowFlags(sWindow);
+    char line[600];
+    snprintf(line, sizeof line,
+             "sdl %d %d b%u imgui %.0f %.0f down%d disp %.0f %.0f fbs %.2f win %d %d at %d %d draw %d %d fl %x hov %s id %x want %d popup %d active %x",
+             sx, sy, b, io.MousePos.x, io.MousePos.y, (int)io.MouseDown[0], io.DisplaySize.x, io.DisplaySize.y, io.DisplayFramebufferScale.x,
+             ww, wh, px, py, dw, dh, fl & (SDL_WINDOW_INPUT_FOCUS | SDL_WINDOW_MOUSE_FOCUS | SDL_WINDOW_FULLSCREEN_DESKTOP),
+             g.HoveredWindow != nullptr ? g.HoveredWindow->Name : "-", g.HoveredId, (int)io.WantCaptureMouse,
+             (int)ImGui::IsPopupOpen(nullptr, ImGuiPopupFlags_AnyPopupId | ImGuiPopupFlags_AnyPopupLevel), g.ActiveId);
+    static char last[600];
+    if (strcmp(line, last) != 0) {
+        strcpy(last, line);
+        fprintf(f, "%u %s\n", SDL_GetTicks(), line);
+        fflush(f);
+    }
+}

+void PerfGlVersion(const char * version);
+bool WantMouse();         // ImGui has the mouse (over a window or the bar): the click is not a touch
+bool WantKeyboard();      // ImGui has the keyboard (a text field)
+void DrawStatus(const char * text); // libntr-onerender.patch: the renderer status over the picture
 void AppButton(const char * label, bool * state, void (*aInitFunc)(void), void (*aAppFunc)(bool *));
 
 

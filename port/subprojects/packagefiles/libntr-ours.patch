+// mi_dma_hblank.c records each channel's MI_HBlankDmaCopy (source, destination, bytes a line). The destination is mapped
+// to the engine's register offset (the io9 / io9b layout above: 0x00-0x6F), the frame renderer gets each line's bytes
+// (SIM_VCapHDma) and the register keeps the last line's entry after the frame (SIM_HDmaFrameDone), as on the DS.
+extern "C" int MIi_PortHDmaGet(u32 dmaNo, const void **src, void **dest, u32 *size);

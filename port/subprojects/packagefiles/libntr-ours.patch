+extern "C" int vcore_write_png(const char *path, const unsigned char *rgba, int w, int h) __attribute__((weak));
+// bw-port (libntr-ios-shotdraw.patch): a screenshot never shows a skipped frame's stale picture: SIM_FrameSkipDecide draws every
+// frame from 0.2 s before a BWPORT_SHOTS time (sShotDueAt: seconds of run time of the next shot, SIM_ShotDue); a cfgscript shot=
+// forces the frames that follow it
+static double sShotDueAt = 1e30;
+static Uint64 sShotT0;
+static bool SIM_ShotDue() { return sShotDueAt < 1e29 && (SDL_GetTicks64() - sShotT0) / 1000.0 >= sShotDueAt - 0.2; }
+static void SIM_ShotMaybe(SDL_Window *win) {
+  static int state = 0, n = 0, next = 0;   // 0: not read yet, 1: on, 2: off
+  static char dir[512] = ".";
+  static double at[64];
+  static Uint64 t0;
+  if ((state == 2 && !sCfgShot[0]) || vcore_write_png == NULL) return;
+  if (state == 0) {
+    const char *e = getenv("BWPORT_SHOTS");
+    state = 2;
+    if (e == NULL || !*e) return;   // (a cfgscript shot still works: dir ".")
+    char *copy = strdup(e), *save = NULL;
+    snprintf(dir, sizeof dir, "%s", strtok_r(copy, ",", &save));
+    for (char *p; (p = strtok_r(NULL, ",", &save)) != NULL && n < 64;) at[n++] = atof(p);
+    free(copy);
+    if (n == 0) return;
+    state = 1;
+    t0 = SDL_GetTicks64();
+    sShotT0 = t0;
+    sShotDueAt = at[0];
+  }
+  bool now = sCfgShot[0] != 0;
+  if (!now && (next >= n || (SDL_GetTicks64() - t0) / 1000.0 < at[next])) return;
+  int w = 0, h = 0;
+#if SIM_METAL
+  if (sMetal) {  // libntr-ios-metal.patch: the present reads its frame back (SIM_Swap)
+    static int midShot = -1;   // libntr-ios-shotmid.patch (a test aid: Smooth motion's in-betweens are presented outside this call)
+    if (midShot < 0) midShot = getenv("BWPORT_SHOTMID") != NULL;
+    if (now && midShot) snprintf(sMtlShotMid, sizeof sMtlShotMid, "%s/%s.png", dir, sCfgShot);
+    else if (now) snprintf(sMtlShot, sizeof sMtlShot, "%s/%s.png", dir, sCfgShot);
+    else snprintf(sMtlShot, sizeof sMtlShot, "%s/s%03d.png", dir, (int)at[next]);
+    if (now) sCfgShot[0] = 0;
+    else next++;
+    if (!now) sShotDueAt = next < n ? at[next] : 1e30;
+    return;
+  }
+#endif
+  SDL_GL_GetDrawableSize(win, &w, &h);
+  if (w <= 0 || h <= 0) return;
+  std::vector<unsigned char> px((size_t)w * h * 4), flip((size_t)w * h * 4);
+  glPixelStorei(GL_PACK_ALIGNMENT, 1);
+#if SIM_IOS
+  glBindFramebuffer(GL_FRAMEBUFFER, sDefaultFbo);
+#else
+  glReadBuffer(GL_BACK);
+#endif
+  glReadPixels(0, 0, w, h, GL_RGBA, GL_UNSIGNED_BYTE, px.data());
+  for (int y = 0; y < h; y++) memcpy(&flip[(size_t)y * w * 4], &px[(size_t)(h - 1 - y) * w * 4], (size_t)w * 4);
+  for (size_t i = 3; i < flip.size(); i += 4) flip[i] = 255;
+  char path[640];
+  if (now) snprintf(path, sizeof path, "%s/%s.png", dir, sCfgShot);
+  else snprintf(path, sizeof path, "%s/s%03d.png", dir, (int)at[next]);
+  vcore_write_png(path, flip.data(), w, h);
+  if (now) sCfgShot[0] = 0;
+  else next++;

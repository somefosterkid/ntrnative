+
+// before the frame's 2D is drawn: the state, if the frame is chosen (the capture of DISPCAPCNT runs in the draw)
+extern "C" void SIM_VCapFrameBegin(void) {
+  sSnap.taken = false;
+  if (!FileOn()) return;
+  u32 frame = *(u32 *)HW_VBLANK_COUNT_BUF;
+  if (!Wanted(frame)) return;
+  TakeSnapshot(frame);
+}
+
+// after both screens are drawn into the window's framebuffer (vx, vy, vw, vh: the screens' viewport there; fb3d, row3d:
+// the shown 3D frame's framebuffer and its rows for the main engine's screen at the internal resolution)
+// vertical: the window shows the screens top over bottom (the default layout, not swapped); else no LSHT pixels
+extern "C" void SIM_VCapFrameEnd(int vx, int vy, int vw, int vh, unsigned fb3d, int scale3d, int top3d, int vertical, int metal) {
+  if (!sSnap.taken) return;
+  Snapshot &s = sSnap;
+  s.taken = false;
+  std::vector<u8> shot, l3d;
+  GLint readFb = 0;
+  if (!metal) {  // (libntr-ios-vcapmetal.patch) the window is Metal's: no GL context to read it from (the read crashed)
+    glGetIntegerv(GL_READ_FRAMEBUFFER_BINDING, &readFb);
+    glBindFramebuffer(GL_READ_FRAMEBUFFER, 0);
+  }
+  if (metal) {
+    shot.assign(256 * 384 * 4, 0);
+    s.notes += "shot_not_read_metal_present ";
+  } else if (vertical) {
+    ReadRegion(vx, vy, vw, vh, 256, 384, shot);
+  } else {
+    shot.assign(256 * 384 * 4, 0);
+    s.notes += "shot_layout_not_vertical ";
+  }
+  // libntr has no 3D picture of its own any more (libntr-onerender.patch): L3D is zeros
+  (void)fb3d;
+  l3d.assign(256 * 192 * 4, 0);
+  if (!metal) glBindFramebuffer(GL_READ_FRAMEBUFFER, readFb);
+
+  char path[1024];
+  snprintf(path, sizeof path, "%s/f%06u.vcs", sDir.c_str(), s.frame);
+  FILE *f = fopen(path, "wb");
+  if (f == NULL) {
+    fprintf(stderr, "bwport: BWPORT_VCAPTURE: can't write %s\n", path);
+    return;
+  }
+  u32 hdr[2] = {0x54534356u /* "VCST" */, 1};
+  fwrite(hdr, 4, 2, f);
+  char info[1024];
+  int n = snprintf(info, sizeof info,
+                   "source=bwport libntr\nformat=VCS_FORMAT.md v1\nframe=%u\nlibntr=%s\ng3_commands=%u\ng3_prologue=%u\n"
+                   "g3_swap_frame=%u\nshot=libntr window %dx%d (internal scale %d)\nl3d_screen=%s\nnotes=%s\n",
+                   s.frame, SIM_GetLibntrGitHash(), s.g3Commands, s.g3Prologue, s.g3SwapFrame, vw, vh, scale3d,
+                   top3d ? "top" : "bottom", s.notes.c_str());
+  Chunk(f, "INFO", info, (u32)n);
+  Chunk(f, "IO9 ", s.io9.data(), (u32)s.io9.size());
+  Chunk(f, "IO9B", s.io9b.data(), (u32)s.io9b.size());
+  Chunk(f, "VRAM", s.vram.data(), (u32)s.vram.size());
+  Chunk(f, "PLTT", s.pltt.data(), (u32)s.pltt.size());
+  Chunk(f, "OAM ", s.oam.data(), (u32)s.oam.size());
+  Chunk(f, "GX3D", s.g3.data(), (u32)(s.g3.size() * 4));
+  Chunk(f, "LSHT", shot.data(), (u32)shot.size());
+  Chunk(f, "L3D ", l3d.data(), (u32)l3d.size());
+  if (!s.hdma.empty()) Chunk(f, "HDMA", s.hdma.data(), (u32)s.hdma.size());
+  fclose(f);
+}
+
+// bw-port (libntr-vbridge.patch): the frame's whole video state for the in-process renderer (port/vcore, through
+// port/bridge/vcore_bridge.c), the same as a .vcs file's chunks: io9 (0x700 bytes), io9b (0x70), vram (0xA4000, the
+// banks A-I), pltt (0x800), oam (0x800), and the GX3D words in *gx (grown with realloc to *cap words when short; the
+// caller frees it). Returns the GX3D words written (the prologue and the shown frame's commands).
+extern "C" uint32_t SIM_VCapGather(uint8_t *io9, uint8_t *io9b, uint8_t *vram, uint8_t *pltt, uint8_t *oam,
+                                   uint32_t **gx, uint32_t *cap) {
+  static std::vector<u32> sWords;
+  static int sOld = -1;  // BWPORT_VCAPGATHER=copy: the old way (the whole VRAM copied, the stream copied twice), for A/B
+  if (sOld < 0) sOld = getenv("BWPORT_VCAPGATHER") != NULL && !strcmp(getenv("BWPORT_VCAPGATHER"), "copy");
+  u32 prologue, commands, swapFrame;
+  FillRegs(io9, io9b);
+  if (sOld) FillMem(vram, pltt, oam);
+  else FillMemChanged(vram, pltt, oam);
+  // libntr-ios-cpubatch.patch: the prologue alone into sWords, the stream straight from sDone into *gx (it went through sWords too)
+  const Stream *src = sDoneValid && !sOld ? &sDone : NULL;
+  if (src != NULL) {
+    G3State st = src->start;
+    sWords.clear();
+    prologue = 0;
+    Prologue(st, sWords, prologue);
+  } else {
+    Fill3D(sWords, prologue, commands, swapFrame); // no SWAP_BUFFERS yet: the reset state's prologue only
+  }
+  u32 np = (u32)sWords.size(), n = np + (src != NULL ? (u32)src->words.size() : 0);
+  if (*gx == NULL || *cap < n) {
+    u32 want = n + n / 2 + 1024;
+    uint32_t *p = (uint32_t *)realloc(*gx, (size_t)want * 4);
+    if (p == NULL) return 0;
+    *gx = p;
+    *cap = want;
+  }
+  memcpy(*gx, sWords.data(), (size_t)np * 4);
+  if (src != NULL && n > np) memcpy(*gx + np, src->words.data(), (size_t)(n - np) * 4);
+  return n;
+}

+static void SIM_SwitchTest(void) {
+  if (sSwIdx == -2) {
+    const char *e = getenv("BWPORT_SWITCH_TEST");
+    sSwIdx = -3;
+    if (e == NULL || !*e) return;
+    char *dup = strdup(e);
+    char *slash = strchr(dup, '/');
+    if (slash != NULL) {
+      *slash = 0;
+      sSwFrames = atoi(slash + 1) > 6 ? atoi(slash + 1) : 90;
+    }
+    for (char *tok = strtok(dup, ","); tok != NULL; tok = strtok(NULL, ",")) {
+      char *colon = strchr(tok, ':');
+      SwStep st;
+      st.res = colon != NULL ? atoi(colon + 1) : 1;
+      st.res = st.res < 1 ? 1 : st.res > 8 ? 8 : st.res;
+      // "gpu:2a4" = Resolution 2 with Antialiasing 4x (a2, a4; no "a" = off)
+      char *at = colon != NULL ? strchr(colon, 'a') : NULL;
+      st.aa = at != NULL && atoi(at + 1) >= 4 ? 4 : at != NULL && atoi(at + 1) >= 2 ? 2 : 1;
+      st.renderer = strncmp(tok, "gpu", 3) == 0 ? SIM_CONFIG_RENDERER_GPU
+                  : strncmp(tok, "vcore", 5) == 0 ? SIM_CONFIG_RENDERER_VCORE : SIM_CONFIG_RENDERER_AUTO;
+      sSwSteps.push_back(st);
+    }
+    free(dup);
+    if (getenv("BWPORT_SWITCH_START") != NULL && atoi(getenv("BWPORT_SWITCH_START")) > 0) sSwStart = atoi(getenv("BWPORT_SWITCH_START"));
+    if (sSwSteps.empty()) return;
+    remove("switch_test.txt");
+    sSwIdx = -1;
+    sSwFrame = 0;
+    SwOut("switch-test: %d steps of %d frames\n", (int)sSwSteps.size(), sSwFrames);
+  }
+  if (sSwIdx == -3) return;
+  sSwFrame++;
+  sSwMeanWanted = sSwIdx >= 0 && sSwFrame >= sSwFrames - 2;
+  if (sSwIdx == -1) { // the game runs a while before the first step
+    if (sSwFrame >= sSwStart) { sSwIdx = 0; SwApply(0); }
+    return;
+  }
+  if (sSwFrame > sSwFrames / 3) { // the first third of a step settles (a renderer starting up takes long frames)
+    sSwCost += sRenderWorkTime / 1e6;
+    sSwN++;
+    sSwActive = sActive;
+    SIM_RendererPicture(&sSwW, &sSwH);
+  }
+  if (sSwFrame < sSwFrames) return;
+  SwStep st = sSwSteps[sSwIdx];
+  int want = st.renderer;
+  if (want == SIM_CONFIG_RENDERER_AUTO) want = SIM_RendererWanted();
+  int wantActive = want == SIM_CONFIG_RENDERER_GPU ? 2 : 1;
+  double cost = sSwN > 0 ? sSwCost / sSwN : 0;
+  bool ok = sSwActive == wantActive && sSwW == 256 * st.res && sSwH == 384 * st.res && cost > 0;
+  double rssMB, privMB;
+  SwMemory(&rssMB, &privMB);
+  SwGLCensus gc = SwCensus();
+  // libntr-switchrule.patch: programs are not counted: port/gpu makes each shader program once per context and keeps it
+  // (its fix for Apple's GL keeping deleted programs' pipelines), so a variant first used later (multisampling) adds one
+  int objs = gc.tex + gc.fbo + gc.buf + gc.vao + gc.rbo;
+  char why[200] = "";
+  if (sSwRefMean < 0 && sSwMean >= 0) sSwRefMean = sSwMean;
+  // black: nothing at all, or far darker than the first step's picture (a scene that stands still; the game itself may
+  // fade, so start it on a bright screen: BWPORT_SWITCH_START and a save)
+  if (ok && sSwMean >= 0 && (sSwMean < 1.0 || (sSwRefMean >= 10 && sSwMean < sSwRefMean * 0.25))) {
+    ok = false;
+    snprintf(why, sizeof why, " (BLACK picture, mean %.2f, the first step's %.2f)", sSwMean, sSwRefMean);
+  }
+  // drift: the same renderer and Resolution as an earlier step must not cost, hold or own more than it did then
+  int key = st.renderer * 256 + st.res * 16 + st.aa;
+  SwSeen *seen = NULL;
+  for (auto &e : sSwSeen) if (e.first == key) seen = &e.second;
+  if (ok && seen != NULL) {
+    if (cost > seen->cost * 2.0 + 2.0)
+      ok = false, snprintf(why, sizeof why, " (DRIFT: %.2f ms, first time %.2f)", cost, seen->cost);
+    else if (objs > seen->objs + 2)
+      ok = false, snprintf(why, sizeof why, " (DRIFT: %d GL objects, first time %d)", objs, seen->objs);
+    else if (gc.texMB > seen->texMB + 8.0)
+      ok = false, snprintf(why, sizeof why, " (DRIFT: %.0f MB of textures, first time %.0f)", gc.texMB, seen->texMB);
+  }
+  // memory: a step may not hold more than the most any earlier step of the same or a larger internal size held (the
+  // allocator keeps some freed memory, so a margin; the process keeps the other renderer's leftovers too, so every
+  // renderer's steps count). But the renderers differ (vcore at 8x holds ~410 MB, gpu ~270 MB): a renderer's first
+  // visit at an internal size no earlier step of ITS OWN reached is not judged; its later visits are, and a leak per
+  // change grows past the envelope within a few steps
+  if (ok) {
+    double env = -1;
+    // memory follows the internal size. libntr-switchrule.patch: Antialiasing is off or 4 samples (libntr-ios-msaa.patch):
+    // vcore supersamples at Resolution x 2 while that stays within 8x, gpu multisamples at the output size
+    int eff = st.aa > 1 && wantActive == 1 && st.res * 2 <= 8 ? st.res * 2 : st.res;
+    bool own = false;  // an earlier step of this renderer at this internal size or more
+    for (auto &h : sSwHist) {
+      if (h.res < eff) continue;
+      if (h.renderer == wantActive) own = true;
+      if (h.rss > env) env = h.rss;
+    }
+    if (own && env >= 0 && rssMB > env + 64.0 + env * 0.1)
+      ok = false, snprintf(why, sizeof why, " (DRIFT: %.0f MB resident, no earlier step at %dx or more held over %.0f)", rssMB, eff, env);
+  }
+  int effRes = st.aa > 1 && wantActive == 1 && st.res * 2 <= 8 ? st.res * 2 : st.res;  // as eff above
+  sSwHist.push_back({wantActive, effRes, rssMB});
+  if (seen == NULL) sSwSeen.push_back({key, {cost, rssMB, gc.texMB, objs}});
+  if (!ok) sSwFails++;
+  SwOut("switch-test step %d: %s:%d%s -> %s drew %dx%d (want %dx%d), render %.2f ms (was %.2f): %s\n", sSwIdx,
+        st.renderer == SIM_CONFIG_RENDERER_GPU ? "gpu" : st.renderer == SIM_CONFIG_RENDERER_VCORE ? "vcore" : "auto",
+        st.res, st.aa == 4 ? "a4" : st.aa == 2 ? "a2" : "", sSwActive == 2 ? "gpu" : sSwActive == 1 ? "vcore" : "nothing", sSwW, sSwH, 256 * st.res, 384 * st.res, cost,
+        sSwPrevCost, ok ? "ok" : "FAIL");
+  SwOut("    mem %.0f MB resident %.0f MB virtual; GL: %d textures (%.1f MB) %d fbo %d buffers %d programs %d vao %d rbo; picture mean %.1f%s\n",
+        rssMB, privMB, gc.tex, gc.texMB, gc.fbo, gc.buf, gc.prog, gc.vao, gc.rbo, sSwMean, why);
+  sSwPrevCost = cost;
+  if (++sSwIdx >= (int)sSwSteps.size()) {
+    SwOut("switch-test: %s\n", sSwFails == 0 ? "PASS" : "FAIL");
+    fflush(NULL);
+    _exit(sSwFails == 0 ? 0 : 1);
+  }
+  SwApply(sSwIdx);
+}

+// bw-port (libntr-acore.patch): a sound backend the program registers (port/src/acore_glue.c). With sim_config.ini's
+// Sound=acore (BWPORT_SOUND) SIM_Audio_Init calls start(); when that returns nonzero the backend plays: the audio
+// callback asks it for the samples instead of running sim7's driver and mixer, and the PXI thread skips sim7's sound
+// commands (the program's SIM_sndCaptureHook has them, sim7/pxi.c).
+typedef struct SIM_SoundBackend {
+    int (*start)(int aAudioFrequency);
+    void (*mix)(s16 * aStereo, int aFrames, int aMasterVolume); // aFrames interleaved L R frames
+    // bw-port (libntr-soundclock.patch): the frame clock. Runs the backend's sound to aToCycle (ARM7 cycles since the
+    // start, 33513982 Hz) and writes the DS-rate frames (32728.5 Hz, interleaved s16 L R, no master volume) that
+    // time produced into aStereo (room for aMaxFrames); returns their number. May be NULL (the device clock only).
+    int (*run)(u64 aToCycle, s16 * aStereo, int aMaxFrames);
+    // bw-port (libntr-mu83.patch): the music bus. A backend that has one (all three or none) lets the music players run on
+    // the real-time clock while the rest follows the game's speed: busSplit(1) takes the music players off the run() clock
+    // (run() then makes everything else), busRun makes aFrames DS-rate frames of the music alone on the music clock (the
+    // frames are as real time needs them), busSlot(aSlot, aMusic) says what the next sequence started on a driver slot is.
+    void (*busSplit)(int aOn);
+    int (*busRun)(s16 * aStereo, int aFrames);
+    void (*busSlot)(int aSlot, int aMusic);
+    // bw-port (libntr-ios-soundq.patch): 1 = Enhanced output, 0 = the DS's exact output (SoundQuality); may be NULL. Called with the audio locked.
+    void (*setQuality)(int aEnhanced);
+    // bw-port (libntr-ios-audiowait.patch): a command wait (SIM_Audio_WaitPump) had no reply for 300 ms: write the backend's
+    // command state into aState (one line), and if the backend holds no list the game still waits for, count one list finished
+    // (the game's finished tag moves, so the wait ends). 1 when it did. May be NULL. Called with the audio locked.
+    int (*waitStuck)(char * aState, int aSize);
+} SIM_SoundBackend;
+// libntr-mu83.patch: snd_interface.c tells the backend which driver slot starts a music sequence
+void SIM_Audio_SlotMusic(int aSlot, int aMusic);
+extern const SIM_SoundBackend * SIM_soundBackend;
+extern int SIM_soundBackendOn;
+
+// bw-port (libntr-soundclock.patch): the sound clock follows the game's frames, not the audio device's real time. One
+// game frame is 560190 ARM7 cycles; the driver's alarm ticks every 174592 and a channel advances 512 timer ticks per
+// 1024 cycles, whatever the speed of the game or of the device. SIM_Audio_FrameTick (once per V-blank, SIM_Render)
+// runs the sound for one frame into a ring of DS-rate samples; the audio callback only plays the ring (resampled to the
+// device's rate; silence when it runs dry, a sample dropped when it is full). BWPORT_SOUNDCLOCK=device brings back
+// the old behaviour (the callback runs the sound).
+void SIM_Audio_FrameTick(void);
+// The ARM9 side waits for a sound command's completion (SND_RecvCommandReply): iteration 0 only lets the PXI thread
+// finish the lists sent so far, later ones advance the sound by one driver tick (the DS's ARM7 would have run it).
+// libntr-ios-audiowait.patch: after 64 ticks the sound is stepped once a millisecond only, and a wait still unanswered after
+// 300 ms logs "audio: command reply wait timed out (...)" and asks the backend's waitStuck to release it.
+void SIM_Audio_WaitPump(int aIteration);
+// sim7/pxi.c: waits (20 ms at most) until the PXI thread has handled every message sent so far
+void SIM_PxiDrain(void);
+int SIM_Audio_FrameClock(void);

+static void SideController(float px, float py, float pw, float ph, unsigned pressed) {
+    ImGui::SetNextWindowPos(ImVec2(px, py));
+    ImGui::SetNextWindowSize(ImVec2(pw, ph));
+    ImGui::PushStyleVar(ImGuiStyleVar_WindowPadding, ImVec2(0.0f, 0.0f));
+    bool vis = ImGui::Begin("##pad", nullptr, kSideFlags | ImGuiWindowFlags_NoScrollbar | ImGuiWindowFlags_NoScrollWithMouse);
+    ImGui::PopStyleVar();
+    if (!vis) {
+        ImGui::End();
+        return;
+    }
+    static bool sShowJoy = false;
+    ImDrawList * dl = ImGui::GetWindowDrawList();
+    ImFont * font = ImGui::GetFont();
+    SIM_config_type * cfg = C();
+    const SIM_config_pad_settings_type & pad = cfg->padSettings;
+    const float CW = 240.0f, CH = 300.0f;    // the drawing's own units
+    float u = std::min(pw / (CW + 24.0f), ph / (CH + 24.0f));
+    if (u <= 0.0f) {
         ImGui::End();
+        return;
+    }
+    float ox = roundf(px + (pw - CW * u) / 2.0f), oy = roundf(py + (ph - CH * u) / 2.0f);
+
+    // whole pixels for every edge and every text, so lines and glyphs are sharp at any size
+    auto P = [&](float x, float y) { return ImVec2(roundf(ox + x * u), roundf(oy + y * u)); };
+    const float lw = std::max(1.0f, roundf(u));
+    auto Text = [&](float cx, float cy, float size, const std::string & s, ImU32 col, float maxW) {
+        float fs = std::max(7.0f, roundf(size * u));
+        ImVec2 sz = font->CalcTextSizeA(fs, 100000.0f, 0.0f, s.c_str());
+        if (sz.x > maxW * u) {
+            fs = std::max(7.0f, floorf(fs * maxW * u / sz.x));
+            sz = font->CalcTextSizeA(fs, 100000.0f, 0.0f, s.c_str());
+        }
+        ImVec2 c = P(cx, cy);
+        dl->AddText(font, fs, ImVec2(roundf(c.x - sz.x / 2.0f), roundf(c.y - sz.y / 2.0f)), col, s.c_str());
+    };
+    auto Rect = [&](float x, float y, float w, float h, float r, bool lit) {
+        dl->AddRectFilled(P(x, y), P(x + w, y + h), lit ? cLit : cBtn, r * u);
+        dl->AddRect(P(x, y), P(x + w, y + h), cEdge, r * u, 0, lw);
+    };
+    auto Circle = [&](float cx, float cy, float r, bool lit) {
+        int seg = std::max(24, (int)(r * u * 1.5f));
+        dl->AddCircleFilled(P(cx, cy), r * u, lit ? cLit : cBtn, seg);
+        dl->AddCircle(P(cx, cy), r * u, cEdge, seg, lw);
+    };
+    auto Lit = [&](int bit) { return (pressed >> bit & 1) != 0; };
+    auto Key = [&](int kb, int joy) { return sShowJoy ? JoyLabel(joy) : KeyLabel(kb); };
+    auto KeyShort = [&](int kb, int joy) {
+        if (!sShowJoy) {
+            return KeyLabel(kb);
+        }
+        std::string s = JoyLabel(joy);
+        if (s.compare(0, 7, "Button ") == 0) { s = s.substr(7); }
+        else if (s.compare(0, 4, "Hat ") == 0) { s = s.substr(4); }
+        return s;
+    };
+
+    dl->AddRectFilled(P(-8, -8), P(CW + 8, CH + 8), cBody, 16.0f * u);
+
+    // shoulder buttons
+    Rect(8, 6, 100, 30, 8, Lit(4));
+    Text(58, 21, 13, "L   " + Key(pad.lKey, pad.lJoyKey), Lit(4) ? cTextLit : cText, 92);
+    Rect(132, 6, 100, 30, 8, Lit(5));
+    Text(182, 21, 13, "R   " + Key(pad.rKey, pad.rJoyKey), Lit(5) ? cTextLit : cText, 92);
+
+    // D-pad, arms of 34
+    struct Arm { float x, y; int bit; int key; int joy; const char * name; };
+    const Arm arms[] = {{45, 64, 8, pad.upKey, pad.upJoyKey, "Up"}, {45, 132, 9, pad.downKey, pad.downJoyKey, "Down"},
+                        {11, 98, 10, pad.leftKey, pad.leftJoyKey, "Left"}, {79, 98, 11, pad.rightKey, pad.rightJoyKey, "Right"}};
+    dl->AddRectFilled(P(45, 98), P(79, 132), cBtn);
+    for (const Arm & a : arms) {
+        Rect(a.x, a.y, 34, 34, 5, Lit(a.bit));
+        Text(a.x + 17, a.y + 17, 11, KeyShort(a.key, a.joy), Lit(a.bit) ? cTextLit : cText, 30);
+    }
+
+    // A B X Y
+    struct Face { float x, y; int bit; const char * name; int key; int joy; };
+    const Face faces[] = {{178, 78, 2, "X", pad.xKey, pad.xJoyKey}, {144, 112, 3, "Y", pad.yKey, pad.yJoyKey},
+                          {212, 112, 0, "A", pad.aKey, pad.aJoyKey}, {178, 146, 1, "B", pad.bKey, pad.bJoyKey}};
+    for (const Face & f : faces) {
+        Circle(f.x, f.y, 19, Lit(f.bit));
+        Text(f.x, f.y - 7, 15, f.name, Lit(f.bit) ? cTextLit : cText, 30);
+        Text(f.x, f.y + 9, 10, KeyShort(f.key, f.joy), Lit(f.bit) ? cTextLit : cText, 32);
+    }
+
+    // Start, Select
+    Rect(130, 196, 102, 28, 14, Lit(6));
+    Text(181, 210, 12, "START  " + Key(pad.startKey, pad.startJoyKey), Lit(6) ? cTextLit : cText, 94);
+    Rect(130, 232, 102, 28, 14, Lit(7));
+    Text(181, 246, 12, "SELECT  " + Key(pad.selectKey, pad.selectJoyKey), Lit(7) ? cTextLit : cText, 94);
+
+    // the program's own keys
+    const std::string hints[] = {
+        "F1  hide this panel", KeyLabel(pad.frameCapToggleKey) + "  unlimited frame rate on/off",
+        KeyLabel(pad.frameCapKey) + "  fast forward: tap on/off, or hold", KeyLabel(pad.guiKey) + "  menu bar",
+    };
+    {
+        // one size for the four lines: the largest at which the longest fits
+        float fs = std::max(7.0f, roundf(10.0f * u));
+        for (const std::string & h : hints) {
+            ImVec2 sz = font->CalcTextSizeA(fs, 100000.0f, 0.0f, h.c_str());
+            if (sz.x > 106.0f * u) {
+                fs = std::max(7.0f, floorf(fs * 106.0f * u / sz.x));
+            }
+        }
+        float hy = 206.0f;
+        for (const std::string & h : hints) {
+            ImVec2 c = P(10, hy);
+            dl->AddText(font, fs, ImVec2(c.x, roundf(c.y - fs / 2.0f)), cDim, h.c_str());
+            hy += 16.0f;
+        }
+    }
+
+    // a click on the card's top margin switches the labels between the keyboard's and the gamepad's
+    {
+        ImVec2 a = P(8, -2), b = P(CW - 8, 4);
+        ImGui::SetCursorScreenPos(a);
+        if (ImGui::InvisibleButton("##joy", ImVec2(b.x - a.x, std::max(6.0f, b.y - a.y)))) {
+            sShowJoy = !sShowJoy;
+            sJoyClicks++;
+        }
+        ItemRect(2);
+        float fs = std::max(7.0f, roundf(9.0f * u));
+        const char * l = sShowJoy ? "gamepad (click: keyboard)" : "keyboard (click: gamepad)";
+        dl->AddText(font, fs, ImVec2(a.x + 4.0f * u, roundf(P(0, -2).y - fs / 2.0f)), cDim, l);
+    }
+    ImGui::End();

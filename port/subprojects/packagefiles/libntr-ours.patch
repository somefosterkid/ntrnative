 #ifdef SDK_PORT
+#include <stdio.h>
+#include <stdlib.h>
+#include <unistd.h>
+
+// bw-port (libntr-alarmframes.patch): under BWPORT_BENCH_CLOCK (routes, tests) an OS alarm fires at a game frame, not
+// after real milliseconds on SDL's timer thread (wc1's audit a3: game frames, not wall clock). Its time is counted in
+// frame ticks, the V-blank count times a DS frame (560190 cycles / 64), and the alarms that are due run on the game
+// thread at the end of each frame (OSi_PinnedAlarmsRun from SIM_PostRenderVBlank), earliest first; a one-shot alarm is
+// taken out of the queue and its handler cleared before it is called, a periodic one fires as many times as its period
+// fits (at most 64 a frame), as on the DS. Without the pin the SDL timers stay (normal play). One host lock (recursive)
+// guards the queue in the pinned mode: OS_DisableInterrupts stops no host thread. BWPORT_ALARMLOG=FILE writes the first
+// 64 alarms set (handler, tick, period, pinned or not) to FILE.PID
+#define OSi_PIN_FRAME_TICKS (560190u / 64u)
+static int OSi_AlarmPin = -1;
+static SDL_mutex * OSi_AlarmMx = NULL;
+static const char * OSi_AlarmLog = NULL;
+static int OSi_AlarmLogN = 0;
+
+static BOOL OSi_AlarmPinned(void)
+{
+    if (OSi_AlarmPin < 0) {
+        OSi_AlarmLog = getenv("BWPORT_ALARMLOG");
+        if (OSi_AlarmLog != NULL && OSi_AlarmLog[0] == 0) {
+            OSi_AlarmLog = NULL;
+        }
+        if (getenv("BWPORT_BENCH_CLOCK") != NULL) {
+            OSi_AlarmMx = SDL_CreateMutex();
+        }
+        OSi_AlarmPin = OSi_AlarmMx != NULL;
+    }
+    return OSi_AlarmPin;
+}
+
+static void OSi_AlarmLock(void)
+{
+    if (OSi_AlarmPinned()) {
+        SDL_LockMutex(OSi_AlarmMx);
+    }
+}
+
+static void OSi_AlarmUnlock(void)
+{
+    if (OSi_AlarmPinned()) {
+        SDL_UnlockMutex(OSi_AlarmMx);
+    }
+}
+
+static OSTick OSi_PinNow(void)
+{
+    return (OSTick)OS_GetVBlankCount() * OSi_PIN_FRAME_TICKS;
+}
+
+static void OSi_AlarmLogSet(OSAlarm * alarm, OSTick tick, OSTick period)
+{
+    char path[1024];
+    FILE * f;
+
+    (void)OSi_AlarmPinned();
+    if (OSi_AlarmLog == NULL || OSi_AlarmLogN >= 64) {
+        return;
+    }
+    snprintf(path, sizeof(path), "%s.%d", OSi_AlarmLog, (int)getpid());
+    f = fopen(path, OSi_AlarmLogN == 0 ? "w" : "a");
+    if (f != NULL) {
+        fprintf(f, "alarm %p handler %p tick %llu period %llu frame %u pinned %d\n", (void *)alarm, (void *)alarm->handler,
+                (unsigned long long)tick, (unsigned long long)period, (unsigned)OS_GetVBlankCount(), OSi_AlarmPin);
+        fclose(f);
+    }
+    OSi_AlarmLogN++;
+}
+
+// out of the queue (the lock held), as OS_CancelAlarm does, without its timer
+static void OSi_PinnedUnlink(OSAlarm * alarm)
+{
+    OSAlarm * next = alarm->next;
+
+    if (next == NULL) {
+        OSi_AlarmQueue.tail = alarm->prev;
+    } else {
+        next->prev = alarm->prev;
+    }
+    if (alarm->prev) {
+        alarm->prev->next = next;
+    } else {
+        OSi_AlarmQueue.head = next;
+    }
+    alarm->next = NULL;
+    alarm->prev = NULL;
+}
+
+void OSi_PinnedAlarmsRun(void)
+{
+    OSTick now;
+    int round;
+
+    if (!OSi_AlarmPinned() || !OSi_UseAlarm) {
+        return;
+    }
+    now = OSi_PinNow();
+    for (round = 0; round < 64; round++) {
+        OSAlarm * a;
+        OSAlarm * due = NULL;
+        OSAlarmHandler handler;
+        void * arg;
+
+        SDL_LockMutex(OSi_AlarmMx);
+        for (a = OSi_AlarmQueue.head; a; a = a->next) {
+            if (a->handler != NULL && (s64)(a->fire - now) <= 0 && (due == NULL || (s64)(a->fire - due->fire) < 0)) {
+                due = a;
+            }
+        }
+        if (due == NULL) {
+            SDL_UnlockMutex(OSi_AlarmMx);
+            break;
+        }
+        handler = due->handler;
+        arg = due->arg;
+        if (due->period > 0) {
+            due->fire += due->period;
+        } else {
+            OSi_PinnedUnlink(due);
+            due->handler = NULL;
+        }
+        SDL_UnlockMutex(OSi_AlarmMx);
+        handler(arg);
+    }
+}
+

+	// The SDK reads unchecked. HeartGold's field moves the BGM fader to 128 when the player leaves a soundplate or
+	// warps (field_control.c, field_warp_tasks.c): the DS reads the halfword after the table, 0 in HeartGold's arm9
+	// (full volume, = [127]); the PC read SNDi_DecibelSquareTable[0] = -32768 (a silent BGM). Past the ends: the end entries
+	if (scale < 0) {
+		scale = 0;
+	} else if (scale > SND_CALC_DECIBEL_SCALE_MAX) {
+		scale = SND_CALC_DECIBEL_SCALE_MAX;
+	}
 	return SNDi_DecibelTable[scale];
 }
 

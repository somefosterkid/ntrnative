+extern "C" void SIM_Audio_FrameTick(void)
+{
+    struct timespec lockT0, lockT1; // BWPORT_AUDIOLOG: the longest the audio was locked by a frame tick, each second
+    static double sLockMax = 0.0;
+    if(!s_frameClock) {
+        return;
+    }
+    if(s_slowPct > 0.0) { // BWPORT_AUDIO_SLOW: ticks no closer than the slowed period (deadlines, so the game's own work is inside it)
+        static double sNext = 0.0;
+        struct timespec ts;
+        clock_gettime(CLOCK_MONOTONIC, &ts);
+        double now = (double)ts.tv_sec + ts.tv_nsec * 1e-9, per = (1.0 + s_slowPct / 100.0) / 59.8261;
+        if(sNext > now && sNext - now < 1.0) {
+            double w = sNext - now;
+            ts.tv_sec = (time_t)w;
+            ts.tv_nsec = (long)((w - (double)ts.tv_sec) * 1e9);
+            nanosleep(&ts, NULL);
+            sNext += per;
+        } else {
+            sNext = now + per;
+        }
+    }
+    SIM_PxiDrain();
+    s_frameCyc += SND_CYC_FRAME;
+    {
+        // libntr-sp76.patch: Speed > 1: the samples are time-stretched back to real time; the music's tempo is lowered by the
+        // same factor (the sound effects keep the speed)
+        int want = sConfigPtr->speed < 1 ? 1 : sConfigPtr->speed > 4 ? 4 : sConfigPtr->speed;
+        // a backend with a music bus keeps the music at its normal speed by running it on the real-time clock (libntr-mu83.patch);
+        // without one (sim7) the music's tempo is lowered by the speed (libntr-sp76.patch, sp77)
+        static int busEnv = -1; // BWPORT_MUSICBUS=off: no bus (the sp76 tempo division), for measuring the before
+        if(busEnv < 0) {
+            const char * e = getenv("BWPORT_MUSICBUS");
+            busEnv = (e != NULL && (!strcmp(e, "off") || !strcmp(e, "0"))) ? 0 : 1;
+        }
+        int busOk = busEnv && SIM_soundBackendOn && SIM_soundBackend->busRun != NULL && SIM_soundBackend->busSplit != NULL;
+        int wantSplit = (sConfigPtr->musicNormalSpeed && (want > 1 || SIM_FastForwarding()) && busOk) ? 1 : 0;
+        int slow = (sConfigPtr->musicNormalSpeed && want > 1 && !busOk) ? want : 1;
+        static int sMode = -1; // BWPORT_AUDIOLOG: where each speed change lands in BWPORT_AUDIO_OUT
+        int mode = want * 2 + (SIM_FastForwarding() ? 1 : 0);
+        if(s_audioLog > 0 && mode != sMode) {
+            fprintf(stderr, "audio: mode speed %d unpaced %d at out frame %llu\n", want, mode & 1, (unsigned long long)s_outFrames);
+        }
+        sMode = mode;
+        if(slow != s_musicSlow) {
+            s_musicSlow = slow;
+            SIM_Snd_SetMusicSlow(slow);
+        }
+        SDL_LockAudio();
+        clock_gettime(CLOCK_MONOTONIC, &lockT0);
+        if(want != st_S || wantSplit != s_split) {
+            if(st_S > 1 && (want == 1 || wantSplit != s_split)) {
+                StDisengage(); // with the bus as it was: the tail it plays has the music added
+            }
+            if(wantSplit != s_split) {
+                s_split = wantSplit;
+                s_musN = 0; // the frames the old split left in the FIFO are not the new one's
+                s_musRd = 0;
+                SIM_soundBackend->busSplit(wantSplit);
+            }
+            if(want > 1) {
+                if(st_S == 1) {
+                    StEngage(want);
+                } else {
+                    st_S = want;
+                }
+            }
+        }
+    }
+    {
+        // libntr-ios-soundq.patch: SoundQuality reaches the backend (the audio is locked)
+        static int qApplied = -1;
+        int q = sConfigPtr->soundQuality != 0;
+        if(q != qApplied) {
+            qApplied = q;
+            if(SIM_soundBackendOn && SIM_soundBackend->setQuality != NULL) {
+                SIM_soundBackend->setQuality(q);
+            }
+        }
+    }
+    SoundAdvance(s_frameCyc); // nothing when a wait for a command (WaitPump) ran the sound ahead of the frames
+    RateUpdate();
+    if(s_audioLog < 0) {
+        s_audioLog = getenv("BWPORT_AUDIOLOG") != NULL;
+    }
+    clock_gettime(CLOCK_MONOTONIC, &lockT1);
+    double lockMs = (double)(lockT1.tv_sec - lockT0.tv_sec) * 1e3 + (double)(lockT1.tv_nsec - lockT0.tv_nsec) * 1e-6;
+    sLockMax = lockMs > sLockMax ? lockMs : sLockMax;
+    if(s_audioLog && (s_frameCyc / SND_CYC_FRAME) % 60 == 0) {
+        fprintf(stderr, "audio: frame %llu ring %llu dropped %llu underruns %llu skips %llu rate %+.3f%% (i %+.3f%%) locked %.2f ms\n",
+                (unsigned long long)(s_frameCyc / SND_CYC_FRAME), (unsigned long long)(s_ringWr - s_ringRd),
+                (unsigned long long)s_ringDropped, (unsigned long long)s_ringUnderruns, (unsigned long long)s_skips,
+                s_rateAdj * 100.0, s_rateI * 100.0, sLockMax);
+        sLockMax = 0.0;
+    }
+    SDL_UnlockAudio();
+}
+
+// libntr-ios-audiowait.patch: the wait's safety net. A list finishes at the driver's next tick (one or two iterations); a wait
+// that goes on had its reply lost (nothing the backend runs will move the finished tag), and stepping the sound a tick per
+// spin ran it ahead by seconds a second at 100 % CPU, for ever. After 64 ticks the sound steps once a millisecond (real time,
+// a few times faster than the DS), and after 300 ms the wait is logged with the backend's state and the backend releases it.
+#define SND_WAIT_TICKS 64
+#define SND_WAIT_MS 300.0
+
+static double WaitNowMs(void)
+{
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return (double)ts.tv_sec * 1e3 + ts.tv_nsec * 1e-6;
+}
+
+extern "C" void SIM_Audio_WaitPump(int aIteration)
+{
+    static double sT0 = 0.0, sNextLog = 0.0;
+    if(!s_frameClock) {
+        return;
+    }
+    SIM_PxiDrain();
+    if(aIteration == 0) {
+        sT0 = WaitNowMs();
+        sNextLog = sT0 + SND_WAIT_MS;
+        return;
+    }
+    if(aIteration > SND_WAIT_TICKS) {
+        SDL_Delay(1);
+    }
+    SDL_LockAudio();
+    SoundAdvance(s_sndCyc + SND_CYC_TICK);
+    double now = WaitNowMs();
+    if(now >= sNextLog) {
+        char st[512] = "";
+        int released = 0;
+        if(SIM_soundBackendOn && SIM_soundBackend->waitStuck != NULL) {
+            released = SIM_soundBackend->waitStuck(st, (int)sizeof st);
+            SoundAdvance(s_sndCyc + SND_CYC_TICK); // (the backend copies its state out after a step)
+        }
+        fprintf(stderr, "audio: command reply wait timed out (%.0f ms, %d spins, frame %llu, sound at frame %.2f, %s backend; %s)%s\n",
+                now - sT0, aIteration, (unsigned long long)(s_frameCyc / SND_CYC_FRAME), (double)s_sndCyc / SND_CYC_FRAME,
+                SIM_soundBackendOn ? "the program's" : "sim7's", st[0] ? st : "no state", released ? ": released" : "");
+        sNextLog = now + 1000.0;
+    }
+    SDL_UnlockAudio();
+}
+
+// ---- bw-port (libntr-ios-soundq.patch): the resampler to the device's rate (both SoundQuality modes) ----
+//
+// The DS-rate ring is played at the device's rate by a windowed-sinc interpolator: SQ_TAPS source samples (32 each side of
+// the point), a Kaiser window (beta 8), the cutoff at 0.93 of the DS rate's Nyquist (15.2 kHz), so that the images the
+// upsampling makes above 16.4 kHz are some 80 dB down (the 4-point cubic it replaces: a 10 kHz tone had -17 dB of images and
+// distortion with it, 14 kHz -6 dB; the sinc: -83 dB at both, bwport docs/acore.md "Sound quality"). The
+// kernel is tabulated at SQ_PHASES fractions of a sample, the weights between two rows are linearly interpolated. The
+// ring's own rate follows its fill (+-5 %) as before: the interpolator does not care what the step is.
+#define SQ_TAPS 64
+#define SQ_PHASES 512
+static float s_sqTab[SQ_PHASES + 1][SQ_TAPS];
+static int s_sqReady = 0;
+static float s_sqHist[2][2 * SQ_TAPS]; // each channel's last samples, written twice so that a window is contiguous
+static int s_sqPos = 0;                // index of the newest sample in the first half
+
+static double SqBessel0(double x)
+{
+    double sum = 1.0, term = 1.0;
+    for(int k = 1; k < 40; k++) {
+        term *= (x / (2.0 * k)) * (x / (2.0 * k));
+        sum += term;
+    }
+    return sum;
+}
+
+static void SqInit(void)
+{
+    const double fc = 0.93, beta = 8.0, pi = 3.14159265358979323846;
+    const double half = SQ_TAPS / 2;
+    for(int p = 0; p <= SQ_PHASES; p++) {
+        double t = (double)p / SQ_PHASES, sum = 0.0, w[SQ_TAPS];
+        for(int j = 0; j < SQ_TAPS; j++) {
+            double x = (j - (half - 1)) - t; // tap j sits at j, the point at half - 1 + t
+            double a = x * fc * pi;
+            double s = fabs(a) < 1e-9 ? 1.0 : sin(a) / a;
+            double r = x / half;
+            double win = fabs(r) >= 1.0 ? 0.0 : SqBessel0(beta * sqrt(1.0 - r * r)) / SqBessel0(beta);
+            w[j] = s * win;
+            sum += w[j];
+        }
+        for(int j = 0; j < SQ_TAPS; j++) {
+            s_sqTab[p][j] = (float)(w[j] / sum);
+        }
+    }
+    s_sqReady = 1;
+}
+
+static void SqPush(s16 l, s16 r)
+{
+    s_sqPos = (s_sqPos + 1) % SQ_TAPS;
+    s_sqHist[0][s_sqPos] = s_sqHist[0][s_sqPos + SQ_TAPS] = (float)l;
+    s_sqHist[1][s_sqPos] = s_sqHist[1][s_sqPos + SQ_TAPS] = (float)r;
+}
+
+// one output frame at the fraction aT (0..1) of the point between the two samples before the newest SQ_TAPS/2 - 1 later ones
+static void SqOut(double aT, float aVol, s16 * aOut)
+{
+    double q = aT * SQ_PHASES;
+    int p = (int)q;
+    if(p >= SQ_PHASES) {
+        p = SQ_PHASES - 1;
+    }
+    float f = (float)(q - p);
+    const float * c0 = s_sqTab[p];
+    const float * c1 = s_sqTab[p + 1];
+    for(int c = 0; c < 2; c++) {
+        const float * h = s_sqHist[c] + s_sqPos + 1; // the oldest of the window ... the newest is at h[SQ_TAPS - 1]
+        float d0 = 0.0f, d1 = 0.0f;
+        for(int j = 0; j < SQ_TAPS; j++) {
+            d0 += c0[j] * h[j];
+            d1 += c1[j] * h[j];
+        }
+        float v = (d0 + f * (d1 - d0)) * aVol;
+        aOut[c] = (s16)(v >= 32767.0f ? 32767 : v <= -32768.0f ? -32768 : (int)lrintf(v));
+    }
+}
+
+// the callback, frame clock: the ring played at the device's rate (SDL holds the audio lock).
+// libntr-ios-sound.patch: the rate is RateUpdate's. A dry ring used to cut to zero mid-buffer and, refilled, replay the 64
+// samples the interpolator held from before the gap: now the output fades from its last value to zero in 1.5 ms, the
+// interpolator restarts from silence and the output fades in over 3 ms (s_gain). SIM_Audio_Pause fades out and in the same way.
+static float s_gain = 1.0f, s_gainTarget = 1.0f; // the output's gain, moving to the target by 1/128 a sample
+static float s_lastOut[2] = {0.0f, 0.0f};        // the last frame played (before the volume)
+static int s_dryLeft = 0;                        // samples of the fade after a dry ring left
+
+static void RingSilence(s16 * aOut, int aFrom, int aFrames)
+{
+    for(int i = aFrom; i < aFrames; i++) {
+        float g = s_dryLeft > 0 ? (float)s_dryLeft-- / 65.0f : 0.0f;
+        aOut[2 * i] = (s16)lrintf(s_lastOut[0] * g);
+        aOut[2 * i + 1] = (s16)lrintf(s_lastOut[1] * g);
+    }
+}
+
+static void PlayRing(s16 * aOut, int aFrames, int aVolume)
+{
+    if(!s_sqReady) {
+        SqInit();
+    }
+    double step = SND_DS_RATE / (double)s_devRate * (1.0 + s_rateAdj);
+    float vol = aVolume >= 127 ? 1.0f : (float)aVolume / 127.0f;
+
+    if(!s_ringPrimed) {
+        if(s_ringWr - s_ringRd >= SND_PRIME) {
+            s_ringPrimed = 1;
+            memset(s_sqHist, 0, sizeof s_sqHist);
+            s_ringFrac = 1.0;
+            s_gain = 0.0f;
+        } else {
+            RingSilence(aOut, 0, aFrames);
+            return;
+        }
+    }
+    for(int i = 0; i < aFrames; i++) {
+        while(s_ringFrac >= 1.0) {
+            if(s_ringRd >= s_ringWr) {
+                // dry: the fade, then silence until the ring has filled again
+                s_ringPrimed = 0;
+                s_ringUnderruns++;
+                s_dryLeft = 64;
+                RingSilence(aOut, i, aFrames);
+                return;
+            }
+            SqPush(s_ring[s_ringRd % SND_RING][0], s_ring[s_ringRd % SND_RING][1]);
+            s_ringRd++;
+            s_ringFrac -= 1.0;
+        }
+        if(s_gain != s_gainTarget) {
+            s_gain += s_gain < s_gainTarget ? 1.0f / 128.0f : -1.0f / 128.0f;
+            if(fabsf(s_gain - s_gainTarget) < 0.5f / 128.0f) {
+                s_gain = s_gainTarget;
+            }
+        }
+        SqOut(s_ringFrac, vol * s_gain, aOut + 2 * i);
+        s_lastOut[0] = (float)aOut[2 * i];
+        s_lastOut[1] = (float)aOut[2 * i + 1];
+        s_ringFrac += step;
+    }
+}
+
+// libntr-ios-sound.patch: SDL_PauseAudio with a fade (the settings sheet, the background): pausing mid-waveform clicked
+extern "C" void SIM_Audio_Pause(int aPause)
+{
+    if(!aPause) {
+        SDL_LockAudio();
+        s_gainTarget = 1.0f;
+        SDL_UnlockAudio();
+        SDL_PauseAudio(0);
+        return;
+    }
+    SDL_LockAudio();
+    s_gainTarget = 0.0f;
+    SDL_UnlockAudio();
+    for(int t = 0; s_frameClock && t < 40 && SDL_GetAudioStatus() == SDL_AUDIO_PLAYING; t++) { // (a callback or two)
+        SDL_LockAudio();
+        int done = s_gain <= 0.0f || !s_ringPrimed;
+        SDL_UnlockAudio();
+        if(done) {
+            break;
+        }
+        SDL_Delay(1);
+    }
+    SDL_PauseAudio(1);
+}

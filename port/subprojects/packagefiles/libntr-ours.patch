+/* bw-port (libntr-ios-speedui.patch, libntr-desktop-speed.patch): play is always 1x; fast forward (the iOS button, Space on the desktop)
+   switches to FastForwardSpeed. A file that has no FastForwardSpeed yet (an older one) hands its GameSpeed over to it once (the file is
+   written with the key from then on). A fixed Frame skip is Auto (the sheet / windows only have the "Skip frames when slow" switch; a
+   BWPORT_FRAMESKIP value is applied after this). On iOS there is also no Frame rate row: it follows Smooth motion (the screen's with it
+   on, else 60). The desktop keeps its Frame rate. */
+static void SpeedModel(SIM_config_type * aConfig)
+{
+    if(!sSeenFFSpeed && aConfig->speed > 1) aConfig->ffSpeed = aConfig->speed;
+    aConfig->speed = 1;
+    if(aConfig->frameSkip != 0) aConfig->frameSkip = SIM_CONFIG_FRAMESKIP_AUTO;
+#if defined(__APPLE__) && TARGET_OS_IOS
+    aConfig->displayCap = aConfig->interpolation ? SIM_CONFIG_DISPLAYCAP_MONITOR : SIM_CONFIG_DISPLAYCAP_60;
+    aConfig->displayCapBack = SIM_CONFIG_DISPLAYCAP_60;
+#endif
+}

index 0000000..50c7c26
--- /dev/null
+++ b/libraries/sim/src/sim_touch.cpp
@@ -0,0 +1,879 @@
+// bw-port (libntr-ios-touch.patch): the phone's on-screen controls. Active on iOS, and on a desktop when BWPORT_TOUCH=WxH is
+// set (a phone-shaped window for quick tests; BWPORT_TOUCH_INSETS=l,t,r,b for its safe area).
+//
+// Layout (points): portrait = both DS screens stacked at the top as wide as the window allows, the controls in the space below;
+// landscape = the screens stacked in the middle at full height, a control group on each side. Nothing goes into the safe area
+// (the notch / Dynamic Island, the home indicator). Input: real multi-touch from SDL's finger events (SDL's touch -> mouse
+// synthesis is switched off): a finger that starts on a button stays that button; the D-pad follows its finger (diagonals); the
+// bottom screen is the stylus (its own finger, also while another holds a button); the menu button opens the touch settings.
+#ifdef __APPLE__
+#include <TargetConditionals.h>
+#endif
+#include <SDL2/SDL.h>
+#include <math.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <vector>
+
+#include "simulator/imgui/imgui.hpp"
+
+#if defined(__APPLE__) && TARGET_OS_IOS
+#define SIM_TOUCH_IOS 1
+extern "C" int bwport_ios_safe_area(SDL_Window * window, float * l, float * t, float * r, float * b);
+extern "C" void bwport_ios_set_orientation(int landscape);
+// libntr-ios-input.patch: the newest touch UIKit delivered, when it touched the glass and how long UIKit held it (port/src/ios_input.m)
+extern "C" int bwport_ios_touch_time(unsigned long long * hwNs, unsigned long long * gateNs, unsigned * seq);
+// libntr-ios-inputprio.patch: a touch's hardware time and arrival in the app, for its start (up 0) or end (up 1); the window's
+// gesture recognizers no longer hold touches back
+extern "C" int bwport_ios_touch_rec(unsigned long long finger, int up, unsigned long long * hwNs, unsigned long long * appNs);
+extern "C" void bwport_ios_touch_setup(SDL_Window * window);
+// libntr-ios-stuckinput.patch: what UIKit knows of a touch (its end's arrival, the last touch event that listed it, the last one)
+extern "C" int bwport_ios_touch_state(unsigned long long finger, unsigned long long * endApp, unsigned long long * seen,
+                                      unsigned long long * lastEv);
+#else
+#define SIM_TOUCH_IOS 0
+#endif
+#ifdef __ANDROID__
+// libntr-android-touch.patch: port/src/android_main.c. The density (pixels per dp, 2.625 on a 420 dpi phone) and the display's
+// insets in pixels (the cutout and the system bars; the Java activity reports them)
+extern "C" float bwport_android_density(void);
+extern "C" int bwport_android_insets(float * l, float * t, float * r, float * b);
+#endif
+// libntr-ios-inputprio.patch: when the key script (port/src/keys_script.c) let go of its finger (its pushed fingers' "hardware time")
+extern "C" unsigned long long bwport_keys_touch_ns(long long finger);
+
+// libntr-ios-stuckinput.patch: sim_main.cpp's anomaly line (rate-limited, with the game's tick) and the buttons' names
+extern "C" void SIM_Anomaly(const char * fmt, ...);
+extern "C" const char * SIM_PadNames(unsigned m, char * buf);
+extern "C" unsigned SIM_InputTickNo(void);
+extern "C" int SIM_UISettingGet(const char * k);   // sim_gui.cpp: "ffspeed" 2..5 (5 = Max)
+extern "C" int SIM_PerfTestProgress(int * done, int * rows);   // sim_main.cpp (libntr-ios-testbadge.patch): the performance test runs
+
+namespace {
+
+enum { B_A, B_B, B_X, B_Y, B_L, B_R, B_START, B_SELECT, B_UP, B_DOWN, B_LEFT, B_RIGHT, B_COUNT };
+enum { K_NONE, K_BTN, K_DPAD, K_STYLUS, K_TOGGLE, K_DEAD };
+
+struct Finger {
+    bool used;
+    SDL_FingerID id;
+    int kind;
+    int idx;     // K_BTN: the button
+    float x, y;  // points
+    unsigned long long downAt;   // libntr-ios-stuckinput.patch: when the touch layer got it (NowNs)
+    bool missLogged;             // (its "missing from UIKit's touch events" line is out)
+};
+
+struct Btn {
+    float x, y, w, h;  // the drawn rectangle (a circle when round)
+    bool round;
+    const char * label;
+};
+
+struct Layout {
+    int winW, winH;
+    float safe[4];                // l, t, r, b
+    float scr[4];                 // both screens: x, y, w, h
+    float bottom[4];              // the touch screen: x0, y0, x1, y1
+    Btn btn[B_COUNT];             // (the four directions are not used: the D-pad is below)
+    float dcx, dcy, dc;           // the D-pad's centre and cell
+    Btn menu, ff;
+    bool landscape;
+};
+
+Layout sL;
+bool sActive, sInit;
+Finger sF[10];
+bool sMenuOpen;
+// libntr-ios-input2.patch: a controller is connected; with the setting "hidetouch" (default on) the buttons and the D-pad are not shown
+// and take no touch (the menu and fast-forward buttons stay, and the touch screen is still the stylus)
+bool sController;
+bool Hidden() { return sController && SIM_UISettingGet("hidetouch") != 0; }
+bool sFF;
+int sFFEdge = -1;
+unsigned sLiveMask;               // buttons held by fingers now
+unsigned sLatchUntil[B_COUNT];    // a tap lasts at least 3 frames (the game reads the pad once a frame)
+unsigned sFrame;
+unsigned sPressed;                // the mask the game sees (live + latched)
+bool sStylusPending;              // a press not yet reported to the stylus
+float sStylusX, sStylusY;
+int sStylusDown;                  // the finger is down
+int sLogStylus;
+volatile bool sBackground;
+SDL_Window * sWindow;
+int sForceW, sForceH;
+// libntr-ios-input.patch: the input latency. A finger that presses a button, the D-pad or the touch screen stamps the time it touched
+// the glass (sPendT0); SimTouch_Pressed hands it over when the game's pad bits (or the stylus) change, the main loop times the rest
+unsigned long long sPendT0, sPendGate, sPendAt, sTakenT0, sTakenGate;
+bool sTaken;
+// libntr-ios-inputprio.patch: the fingers are handled the moment SDL gets them (an event filter on the main thread: on iOS inside
+// UIKit's delivery, which the game's waits now serve), not at the next frame's event loop. A release is followed to the pad bits
+// the game sees: one later than 50 ms after the finger left the glass logs "input: release N ms late" and where it was held.
+struct Rel { unsigned mask; unsigned long long hw, app, sdl; bool tap; };
+Rel sRel[10];
+int sRelN;
+// libntr-ios-lag.patch: the last release the pad bits show, for sim_main.cpp to follow to the picture (SimTouch_ReleaseTaken)
+unsigned long long sRelTakenT0;
+bool sRelTaken;
+SDL_threadID sMainThread;
+int sTouchLog = -1;
+bool TouchLog() {
+    if (sTouchLog < 0) sTouchLog = getenv("BWPORT_TOUCH_LOG") != NULL;
+    return sTouchLog != 0;
+}
+
+unsigned long long NowNs() {   // sim_main.cpp's SpNowNs (on iOS the clock of UITouch.timestamp)
+    Uint64 c = SDL_GetPerformanceCounter(), f = SDL_GetPerformanceFrequency();
+    return (c / f) * 1000000000ull + (c % f) * 1000000000ull / f;
+}
+
+// a finger's start (up 0) or end (up 1): when it touched or left the glass and when the app got it (ns); 0 when unknown
+void FingerTimes(const SDL_Event * e, int up, unsigned long long now, unsigned long long * hw, unsigned long long * app) {
+#if SIM_TOUCH_IOS
+    if (bwport_ios_touch_rec((unsigned long long)e->tfinger.fingerId, up, hw, app) && *hw <= now) return;
+#endif
+    *hw = *app = 0;
+    unsigned long long k = up ? bwport_keys_touch_ns((long long)e->tfinger.fingerId) : 0;
+    if (k != 0 && k <= now) *hw = *app = k;
+}
+
+void PressTime(const SDL_Event * e) {
+    if (sPendT0 != 0) return;
+    unsigned long long now = NowNs(), hw = 0, gate = 0;
+    unsigned seq = 0;
+    static unsigned sSeqSeen;
+    sPendAt = now;
+    // a real touch: UIKit's record of it (SDL turned it into this event inside the same sendEvent:)
+#if SIM_TOUCH_IOS
+    if (bwport_ios_touch_time(&hw, &gate, &seq) && seq != sSeqSeen && hw <= now) {
+        sSeqSeen = seq;
+        sPendT0 = hw;
+        sPendGate = gate;
+        return;
+    }
+#endif
+    // a pushed one (BWPORT_KEYS tap:, a desktop): the event's own time, in ms
+    Uint32 age = SDL_GetTicks() - e->tfinger.timestamp;
+    sPendT0 = now - (unsigned long long)(age < 1000 ? age : 0) * 1000000ull;
+    sPendGate = 0;
+}
+
+// libntr-android-touch.patch: pixels per layout unit. The layout below is in points (iOS: the window's own unit, 1 pt = 1/163 in) or
+// dp (Android: 1/160 in); an Android window is in pixels, so everything is laid out in dp and scaled by the density (BWPORT_TOUCH_SCALE=N
+// pretends a density on a desktop test). 1 everywhere else: nothing changes on iOS, macOS, Windows, Linux.
+float sU = 1.0f;
+float Unit() {
+    float u = 1.0f;
+#ifdef __ANDROID__
+    u = bwport_android_density();
+#endif
+    const char * e = getenv("BWPORT_TOUCH_SCALE");
+    if (e != NULL && atof(e) > 0.0) u = (float)atof(e);
+    return u >= 0.5f && u <= 8.0f ? u : 1.0f;
+}
+
+void ReadInsets(float * s) {
+    s[0] = s[1] = s[2] = s[3] = 0;
+    bool ok = false;
+#if SIM_TOUCH_IOS
+    ok = bwport_ios_safe_area(sWindow, &s[0], &s[1], &s[2], &s[3]) != 0;
+#endif
+#ifdef __ANDROID__
+    ok = bwport_android_insets(&s[0], &s[1], &s[2], &s[3]) != 0;   // (pixels)
+#endif
+    const char * e = getenv("BWPORT_TOUCH_INSETS");
+    if (e != NULL && sscanf(e, "%f,%f,%f,%f", &s[0], &s[1], &s[2], &s[3]) == 4) {
+        return;
+    }
+    (void)ok;
+}
+
+void ComputeUnits(int W, int H, const float * safe);
+// the layout in points / dp (ComputeUnits), then every length in pixels: the window (W, H) and the insets are pixels
+void Compute(int W, int H, const float * safe) {
+    const float u = sU;
+    float s[4] = {safe[0] / u, safe[1] / u, safe[2] / u, safe[3] / u};
+    ComputeUnits((int)((float)W / u + 0.5f), (int)((float)H / u + 0.5f), s);
+    Layout & L = sL;
+    if (u != 1.0f) {
+        auto sc = [u](float * v, int n) { for (int i = 0; i < n; i++) v[i] *= u; };
+        sc(L.safe, 4); sc(L.scr, 4); sc(L.bottom, 4);
+        for (Btn & b : L.btn) sc(&b.x, 4);
+        sc(&L.menu.x, 4); sc(&L.ff.x, 4);
+        L.dcx *= u; L.dcy *= u; L.dc *= u;
+    }
+    L.winW = W;
+    L.winH = H;
+    L.landscape = W > H;
+}
+
+void ComputeUnits(int W, int H, const float * safe) {
+    Layout & L = sL;
+    memset(&L, 0, sizeof L);
+    L.winW = W;
+    L.winH = H;
+    L.landscape = W > H;
+    float * s = L.safe;
+    memcpy(s, safe, 4 * sizeof(float));
+    const float pad = 8.0f;
+    float zl = s[0] + pad, zr = (float)W - s[2] - pad, zt = s[1] + pad, zb = (float)H - s[3] - pad;
+    float c;  // the D-pad's cell
+
+    if (!L.landscape) {
+        float availH = (float)H - s[1] - s[3];
+        float sw = fminf((float)W, (availH - 200.0f) / 1.5f);
+        L.scr[2] = sw;
+        L.scr[3] = sw * 1.5f;
+        L.scr[0] = ((float)W - sw) * 0.5f;
+        L.scr[1] = s[1];
+        float ay = L.scr[1] + L.scr[3];  // the controls' area
+        float rowH = 46.0f;
+        float rowY = ay + 4.0f;
+        L.btn[B_L] = {zl, rowY, 100, rowH, false, "L"};
+        L.btn[B_R] = {zr - 100, rowY, 100, rowH, false, "R"};
+        float cx = (float)W * 0.5f;
+        L.menu = {cx - 24, rowY, 48, rowH, false, ""};
+        float top = rowY + rowH + 6.0f, bot = zb;
+        float ch = bot - top;
+        c = fminf(48.0f, ch / 3.0f);
+        // libntr-android-touch.patch: a window narrower than an iPhone Pro Max (Android: 360-411 dp) has no room for the D-pad, the middle
+        // column and the diamond side by side at 48: the Y button covered SELECT. The cells shrink to fit (only where the unit is not 1)
+        if (sU != 1.0f) c = fminf(c, fminf(((float)W * 0.5f - 62.0f) / 3.0f, ((float)W * 0.5f - 60.0f) / 3.4f));
+        float my = top + ch * 0.5f;
+        L.dc = c;
+        L.dcx = zl + 1.5f * c + 4.0f;
+        L.dcy = my;
+        float ro = 1.08f * c, rb = 0.62f * c;
+        float ax = zr - ro - rb - 2.0f;
+        L.btn[B_X] = {ax - rb, my - ro - rb, 2 * rb, 2 * rb, true, "X"};
+        L.btn[B_B] = {ax - rb, my + ro - rb, 2 * rb, 2 * rb, true, "B"};
+        L.btn[B_Y] = {ax - ro - rb, my - rb, 2 * rb, 2 * rb, true, "Y"};
+        L.btn[B_A] = {ax + ro - rb, my - rb, 2 * rb, 2 * rb, true, "A"};
+        // libntr-ios-speedui.patch: the fast-forward button is the third pill of the middle column (above SELECT and START, the same size
+        // and look): a thumb from either side reaches it, and the column between the D-pad and the A/B/X/Y diamond is free
+        L.ff = {cx - 44, my - 59, 88, 34, false, ""};
+        L.btn[B_SELECT] = {cx - 44, my - 17, 88, 34, false, "SELECT"};
+        L.btn[B_START] = {cx - 44, my + 25, 88, 34, false, "START"};
+    } else {
+        float sh = (float)H - s[1] - s[3];
+        float sw = sh * (256.0f / 384.0f);
+        L.scr[2] = sw;
+        L.scr[3] = sh;
+        L.scr[0] = ((float)W - sw) * 0.5f;
+        L.scr[1] = s[1];
+        float lz0 = zl, lz1 = L.scr[0] - pad, rz0 = L.scr[0] + sw + pad, rz1 = zr;
+        float zw = fminf(lz1 - lz0, rz1 - rz0);
+        c = fminf(54.0f, (zw - 16.0f) / 3.5f);
+        L.dc = c;
+        float rowH = 46.0f;
+        L.btn[B_L] = {lz0, zt, 100, rowH, false, "L"};
+        L.menu = {lz1 - 48, zt, 48, rowH, false, ""};
+        L.btn[B_R] = {rz1 - 100, zt, 100, rowH, false, "R"};
+        L.ff = {rz0, zt, 64, rowH, false, ""};   // (mirrors the menu button across the screens; the bottom has no room that fits every phone)
+        L.btn[B_SELECT] = {(lz0 + lz1) * 0.5f - 44, zb - 34, 88, 34, false, "SELECT"};
+        L.btn[B_START] = {(rz0 + rz1) * 0.5f - 44, zb - 34, 88, 34, false, "START"};
+        float my = (zt + rowH + zb - 34) * 0.5f;
+        L.dcx = (lz0 + lz1) * 0.5f;
+        L.dcy = my;
+        float ro = 1.08f * c, rb = 0.62f * c;
+        float ax = (rz0 + rz1) * 0.5f;
+        L.btn[B_X] = {ax - rb, my - ro - rb, 2 * rb, 2 * rb, true, "X"};
+        L.btn[B_B] = {ax - rb, my + ro - rb, 2 * rb, 2 * rb, true, "B"};
+        L.btn[B_Y] = {ax - ro - rb, my - rb, 2 * rb, 2 * rb, true, "Y"};
+        L.btn[B_A] = {ax + ro - rb, my - rb, 2 * rb, 2 * rb, true, "A"};
+    }
+    L.bottom[0] = L.scr[0];
+    L.bottom[1] = L.scr[1] + L.scr[3] * 0.5f;
+    L.bottom[2] = L.scr[0] + L.scr[2];
+    L.bottom[3] = L.scr[1] + L.scr[3];
+}
+
+// what is under a point: a button, the D-pad, the menu / fast-forward buttons, the touch screen
+int HitTest(float x, float y, int * idx) {
+    const Layout & L = sL;
+    *idx = 0;
+    // round buttons: the nearest centre within the radius + a margin
+    float best = 1e9f;
+    int bi = -1;
+    const bool hide = Hidden();
+    for (int i = 0; i < B_UP && !hide; i++) {
+        const Btn & b = L.btn[i];
+        if (b.w <= 0) continue;
+        if (b.round) {
+            float cx = b.x + b.w * 0.5f, cy = b.y + b.h * 0.5f;
+            float d = hypotf(x - cx, y - cy);
+            if (d <= b.w * 0.5f + 7.0f * sU && d < best) { best = d; bi = i; }
+        } else if (x >= b.x - 6 * sU && x < b.x + b.w + 6 * sU && y >= b.y - 6 * sU && y < b.y + b.h + 6 * sU) {
+            float d = hypotf(x - (b.x + b.w * 0.5f), y - (b.y + b.h * 0.5f));
+            if (d < best) { best = d; bi = i; }
+        }
+    }
+    if (bi >= 0) { *idx = bi; return K_BTN; }
+    if (!hide && hypotf(x - L.dcx, y - L.dcy) <= L.dc * 2.0f) return K_DPAD;
+    const Btn * t[2] = {&L.menu, &L.ff};
+    for (int i = 0; i < 2; i++) {
+        if (x >= t[i]->x - 6 * sU && x < t[i]->x + t[i]->w + 6 * sU && y >= t[i]->y - 6 * sU && y < t[i]->y + t[i]->h + 6 * sU) {
+            *idx = i;
+            return K_TOGGLE;
+        }
+    }
+    if (x >= L.bottom[0] && x < L.bottom[2] && y >= L.bottom[1] && y < L.bottom[3]) return K_STYLUS;
+    return K_DEAD;
+}
+
+// the D-pad's directions from a point: a dead zone in the middle; a diagonal when both axes are well off the centre
+unsigned DpadMask(float x, float y) {
+    float dx = x - sL.dcx, dy = y - sL.dcy, dz = sL.dc * 0.30f;
+    unsigned m = 0;
+    float ax = fabsf(dx), ay = fabsf(dy);
+    if (ax < dz && ay < dz) return 0;
+    if (ax > dz && ax * 2.4f > ay) m |= dx > 0 ? 1u << B_RIGHT : 1u << B_LEFT;
+    if (ay > dz && ay * 2.4f > ax) m |= dy > 0 ? 1u << B_DOWN : 1u << B_UP;
+    return m;
+}
+
+void Recompute() {
+    unsigned m = 0;
+    for (const Finger & f : sF) {
+        if (!f.used) continue;
+        if (f.kind == K_BTN) m |= 1u << f.idx;
+        if (f.kind == K_DPAD) m |= DpadMask(f.x, f.y);
+    }
+    unsigned added = m & ~sLiveMask;
+    for (int i = 0; i < B_COUNT; i++) {
+        if (added & (1u << i)) sLatchUntil[i] = sFrame + 3;
+    }
+    sLiveMask = m;
+}
+
+Finger * FindFinger(SDL_FingerID id) {
+    for (Finger & f : sF) if (f.used && f.id == id) return &f;
+    return NULL;
+}
+
+void ReleaseAll() {
+    for (Finger & f : sF) {
+        if (f.used) f.kind = K_DEAD;
+    }
+    sLiveMask = 0;
+    sStylusDown = 0;
+    sStylusPending = false;
+}
+
+// the buttons a finger holds now
+unsigned HeldBy(const Finger & f) {
+    return f.kind == K_BTN ? 1u << f.idx : f.kind == K_DPAD ? DpadMask(f.x, f.y) : 0;
+}
+
+// a finger leaves the glass (its up, or libntr-ios-stuckinput.patch: UIKit ended it and the up did not come): its buttons are let go and
+// the release is followed to the pad bits (hw, app: when it left the glass and when the app got that; 0 unknown)
+void Lift(Finger * f, unsigned long long hw, unsigned long long app) {
+    unsigned held = HeldBy(*f);
+    if (held != 0 || TouchLog()) {
+        Rel r = {held, hw, app, NowNs(), false};
+        if (r.hw > r.sdl || r.app > r.sdl) r.hw = r.app = 0;
+        for (int i = 0; i < B_COUNT; i++) {
+            if ((held >> i & 1) && sFrame <= sLatchUntil[i]) r.tap = true;   // (a tap: held its 3 frames whatever the finger does)
+        }
+        if (TouchLog()) {
+            fprintf(stderr, "bwport: touch finger %llx up at %.0f,%.0f held %03x: glass to app %.1f ms, app to touch layer %.1f ms\n",
+                    (unsigned long long)f->id, f->x, f->y, held, r.hw ? (r.app - r.hw) / 1e6 : -1.0, r.hw ? (r.sdl - r.app) / 1e6 : -1.0);
+        }
+        if (held != 0) {
+            if (sRelN == 10) memmove(&sRel[0], &sRel[1], 9 * sizeof(Rel));
+            sRel[sRelN < 10 ? sRelN++ : 9] = r;
+        }
+    }
+    if (f->kind == K_STYLUS) {
+        sStylusX = f->x; sStylusY = f->y;
+        sStylusDown = 0;   // (a press not reported yet still is: SimTouch_Stylus)
+    }
+    f->kind = K_DEAD;
+    f->used = false;
+    Recompute();
+}
+
+#if SIM_TOUCH_IOS
+// libntr-ios-stuckinput.patch: once a frame, every finger the layer holds against UIKit's own record of the touch. One whose end UIKit
+// dispatched more than 100 ms ago is let go (SimTouch_UIKitEnded does that at the dispatch itself; this is the net under it); one
+// that UIKit's later touch events no longer list (each lists every touch on the glass) for 500 ms is only logged.
+void CheckFingers() {
+    if (sL.winW == 0) return;
+    const unsigned long long now = NowNs();
+    for (Finger & f : sF) {
+        unsigned long long endApp, seen, lastEv;
+        if (!f.used || !bwport_ios_touch_state((unsigned long long)f.id, &endApp, &seen, &lastEv)) continue;
+        char nm[64];
+        if (endApp != 0 && now > endApp && now - endApp > 100000000ull) {
+            SIM_Anomaly("touch finger %llx (%s, kind %d, %.0f ms) ended in UIKit %.0f ms ago and no finger up came: let go",
+                        (unsigned long long)f.id, SIM_PadNames(HeldBy(f), nm), f.kind, (now - f.downAt) / 1e6, (now - endApp) / 1e6);
+            Lift(&f, 0, 0);
+        } else if (endApp == 0 && !f.missLogged && seen != 0 && lastEv > seen && now - seen > 500000000ull) {
+            f.missLogged = true;
+            SIM_Anomaly("touch finger %llx (%s, kind %d, %.0f ms) missing from UIKit's touch events for %.0f ms, no end seen: still held",
+                        (unsigned long long)f.id, SIM_PadNames(HeldBy(f), nm), f.kind, (now - f.downAt) / 1e6, (now - seen) / 1e6);
+        }
+    }
+}
+#endif
+
+void Event(const SDL_Event * e) {
+    float x = e->tfinger.x * (float)sL.winW, y = e->tfinger.y * (float)sL.winH;
+    SDL_FingerID id = e->tfinger.fingerId;
+    if (e->type == SDL_FINGERDOWN) {
+        if (Finger * old = FindFinger(id)) {   // libntr-ios-stuckinput.patch: (SDL sends a lost up itself: this should never show)
+            char nm[64];
+            SIM_Anomaly("touch finger %llx down again while the layer still holds it (%s, kind %d, %.0f ms): let go", (unsigned long long)id,
+                        SIM_PadNames(HeldBy(*old), nm), old->kind, (NowNs() - old->downAt) / 1e6);
+            Lift(old, 0, 0);
+        }
+        Finger * f = NULL;
+        for (Finger & g : sF) if (!g.used) { f = &g; break; }
+        if (f == NULL) return;
+        *f = {true, id, K_DEAD, 0, x, y, NowNs(), false};
+        if (sMenuOpen) { f->kind = K_DEAD; return; }   // (the native settings sheet is up)
+        int idx;
+        int k = HitTest(x, y, &idx);
+        f->kind = k;
+        f->idx = idx;
+        if (k == K_BTN || k == K_DPAD || k == K_STYLUS) PressTime(e);
+        if (TouchLog()) {
+            unsigned long long now = NowNs(), hw, app;
+            FingerTimes(e, 0, now, &hw, &app);
+            fprintf(stderr, "bwport: touch finger %llx down at %.0f,%.0f kind %d: glass to app %.1f ms, app to touch layer %.1f ms\n",
+                    (unsigned long long)id, x, y, k, hw ? (app - hw) / 1e6 : -1.0, hw ? (now - app) / 1e6 : -1.0);
+        }
+        if (k == K_TOGGLE) {
+            if (idx == 0) { sMenuOpen = true; ReleaseAll(); f->kind = K_DEAD; }   // (libntr-ios-ffkeep.patch: fast forward stays on)
+            else if (!SIM_PerfTestProgress(nullptr, nullptr)) { sFF = !sFF; sFFEdge = sFF; }   // (the test owns the speed: libntr-ios-testbadge.patch)
+        } else if (k == K_STYLUS) {
+            if (sStylusDown) { f->kind = K_DEAD; return; }
+            sStylusDown = 1;
+            sStylusPending = true;
+            sStylusX = x; sStylusY = y;
+        } else if (k == K_BTN || k == K_DPAD) {
+            Recompute();
+        }
+    } else if (e->type == SDL_FINGERMOTION) {
+        Finger * f = FindFinger(id);
+        if (f == NULL) return;
+        f->x = x; f->y = y;
+        if (f->kind == K_DPAD) Recompute();
+        else if (f->kind == K_STYLUS) { sStylusX = x; sStylusY = y; }
+    } else if (e->type == SDL_FINGERUP) {
+        Finger * f = FindFinger(id);
+        if (f == NULL) return;
+        unsigned long long hw = 0, app = 0;
+        FingerTimes(e, 1, NowNs(), &hw, &app);
+        f->x = x; f->y = y;   // (SDL's up repeats the last motion's place)
+        Lift(f, hw, app);
+    }
+}
+
+int Watch(void *, SDL_Event * e) {
+    if (e->type >= SDL_APP_TERMINATING && e->type <= SDL_APP_DIDENTERFOREGROUND) {   // (a few a session: libntr-ios-appfix.patch)
+        fprintf(stderr, "bwport: app event %s\n", e->type == SDL_APP_TERMINATING ? "terminating" : e->type == SDL_APP_LOWMEMORY ? "low memory"
+                : e->type == SDL_APP_WILLENTERBACKGROUND ? "will enter background" : e->type == SDL_APP_DIDENTERBACKGROUND ? "did enter background"
+                : e->type == SDL_APP_WILLENTERFOREGROUND ? "will enter foreground" : "did enter foreground");
+    }
+    // on the delegate's callback itself (the event queue is read too late: iOS kills an app that draws in the background)
+    if (e->type == SDL_APP_WILLENTERBACKGROUND || e->type == SDL_APP_DIDENTERBACKGROUND) {
+        // libntr-ios-appfix.patch: nothing stays held across a trip to the background (a finger whose cancel never comes, or fast
+        // forward the player did not switch off): the fingers die (their slots free when they lift), fast forward goes off
+        if (!sBackground) {
+            ReleaseAll();
+            if (sFF) { sFF = false; sFFEdge = 0; }
+        }
+        sBackground = true;
+    }
+    if (e->type == SDL_APP_WILLENTERFOREGROUND || e->type == SDL_APP_DIDENTERFOREGROUND) sBackground = false;
+    return 0;
+}
+
+// libntr-ios-inputprio.patch: a finger event pushed on the game's thread (UIKit's delivery, SDL's pump) is handled now and not
+// queued; one from another thread waits for the event loop, as before
+int Filter(void *, SDL_Event * e) {
+    if (e->type != SDL_FINGERDOWN && e->type != SDL_FINGERMOTION && e->type != SDL_FINGERUP) return 1;
+    if (sL.winW == 0 || SDL_ThreadID() != sMainThread) return 1;
+    Event(e);
+    return 0;
+}
+
+// the releases the pad bits now show: each one logged when it came late
+void ReleasesShown(unsigned m) {
+    unsigned long long now = NowNs();
+    int k = 0;
+    for (int i = 0; i < sRelN; i++) {
+        Rel & r = sRel[i];
+        bool shown = (m & r.mask) == 0, old = now - r.sdl > 2000000000ull;   // (another finger still holds it: no release)
+        if (shown && r.hw != 0 && !r.tap) {
+            if (!sRelTaken) { sRelTaken = true; sRelTakenT0 = r.hw; }
+            double late = (now - r.hw) / 1e6;
+            static unsigned long long sWin;
+            static int sUsed, sSkipped;
+            if (now - sWin > 60000000000ull) { sWin = now; sUsed = 0; }
+            if ((late > 50.0 && sUsed < 30) || TouchLog()) {   // (libntr-ios-stuckinput.patch: 30 a minute; the buttons and the tick)
+                char nm[64];
+                fprintf(stderr, "input: release %.0f ms late (glass to app %.0f, app to touch layer %.0f, touch layer to pad %.0f): touch %s, tick %u",
+                        late, (r.app - r.hw) / 1e6, (r.sdl - r.app) / 1e6, (now - r.sdl) / 1e6, SIM_PadNames(r.mask, nm), SIM_InputTickNo());
+                if (sSkipped > 0) fprintf(stderr, " (%d left out before)", sSkipped);
+                fputc('\n', stderr);
+                sUsed++;
+                sSkipped = 0;
+            } else if (late > 50.0) {
+                sSkipped++;
+            }
+        }
+        if (!shown && !old) sRel[k++] = r;
+    }
+    sRelN = k;
+}
+
+}  // namespace
+
+extern "C" {
+
+int SimTouch_Active(void) {
+    if (!sInit) {
+        sInit = true;
+        const char * e = getenv("BWPORT_TOUCH");
+        if (e != NULL && sscanf(e, "%dx%d", &sForceW, &sForceH) != 2) sForceW = sForceH = 0;
+#if SIM_TOUCH_IOS || defined(__ANDROID__)
+        sActive = true;   // (libntr-android-gles.patch: Android's fingers too)
+#else
+        sActive = sForceW > 0;
+#endif
+    }
+    return sActive;
+}
+
+// the window size a desktop test asks for (0: the normal one)
+int SimTouch_ForcedSize(int * w, int * h) {
+    SimTouch_Active();
+    *w = sForceW; *h = sForceH;
+    return sForceW > 0;
+}
+
+// before the window exists
+void SimTouch_Hints(void) {
+    if (!SimTouch_Active()) return;
+    SDL_SetHint(SDL_HINT_TOUCH_MOUSE_EVENTS, "0");   // the fingers are handled here
+}
+
+void SimTouch_Window(SDL_Window * w) {
+    sWindow = w;
+    SDL_AddEventWatch(Watch, NULL);
+    if (SimTouch_Active()) {
+        sMainThread = SDL_ThreadID();
+        SDL_SetEventFilter(Filter, NULL);
+    }
+#if SIM_TOUCH_IOS
+    const char * o = getenv("BWPORT_TOUCH_ORIENT");
+    if (o != NULL) bwport_ios_set_orientation(strcmp(o, "landscape") == 0);
+#endif
+}
+
+// the screens' rectangle in points (top-left origin) for a window of this size
+void SimTouch_Layout(int winW, int winH, float * x, float * y, float * w, float * h) {
+    static int pw, ph;
+    static float pins[4];
+    static float pu;
+    float cur[4];
+    ReadInsets(cur);
+    float unit = Unit();
+    if (winW != pw || winH != ph || unit != pu || memcmp(cur, pins, sizeof cur) != 0 || sL.winW == 0) {
+        pu = sU = unit;
+        pw = winW;
+        ph = winH;
+        memcpy(pins, cur, sizeof cur);
+        float s[4];
+        memcpy(s, cur, sizeof s);
+        if (sForceW > 0 && getenv("BWPORT_TOUCH_INSETS") == NULL) {
+            // the test window: an iPhone 16 Pro Max's insets
+            if (winW > winH) { s[0] = s[2] = 62 * sU; s[3] = 21 * sU; } else { s[1] = 62 * sU; s[3] = 34 * sU; }
+        }
+        bool wasLandscape = sL.landscape;
+        Compute(winW, winH, s);
+        if (wasLandscape != sL.landscape) {
+            // libntr-ios-input2.patch: a finger on a button or the D-pad stays on it only as long as the layout does: after a turn it is
+            // measured against the new centre (the held direction would change under it), so it is let go until it lifts
+            for (Finger & f : sF) {
+                if (f.used && (f.kind == K_BTN || f.kind == K_DPAD)) f.kind = K_DEAD;
+            }
+            sLiveMask = 0;
+        }
+#if SIM_TOUCH_IOS
+        bwport_ios_touch_setup(sWindow);   // libntr-ios-inputprio.patch: (again: a rotation may bring new recognizers)
+#endif
+        fprintf(stderr, "bwport: touch scale %.3f px per point (dp)\n", sU);
+        fprintf(stderr, "bwport: touch layout %dx%d %s, safe area %.0f %.0f %.0f %.0f, screens %.0f %.0f %.0f %.0f\n", winW, winH,
+                sL.landscape ? "landscape" : "portrait", sL.safe[0], sL.safe[1], sL.safe[2], sL.safe[3], sL.scr[0], sL.scr[1],
+                sL.scr[2], sL.scr[3]);
+        {
+            static const char * const nm[] = {"A", "B", "X", "Y", "L", "R", "Start", "Select"};
+            fprintf(stderr, "bwport: touch centres: dpad %.0f,%.0f (cell %.0f)", sL.dcx, sL.dcy, sL.dc);
+            for (int i = 0; i < 8; i++) fprintf(stderr, " %s %.0f,%.0f", nm[i], sL.btn[i].x + sL.btn[i].w * 0.5f, sL.btn[i].y + sL.btn[i].h * 0.5f);
+            fprintf(stderr, " menu %.0f,%.0f ff %.0f,%.0f\n", sL.menu.x + sL.menu.w * 0.5f, sL.menu.y + sL.menu.h * 0.5f,
+                    sL.ff.x + sL.ff.w * 0.5f, sL.ff.y + sL.ff.h * 0.5f);
+        }
+    }
+    *x = sL.scr[0]; *y = sL.scr[1]; *w = sL.scr[2]; *h = sL.scr[3];
+}
+
+// a finger event: 1 when it was one
+int SimTouch_Event(const SDL_Event * e) {
+    if (e->type != SDL_FINGERDOWN && e->type != SDL_FINGERMOTION && e->type != SDL_FINGERUP) return 0;
+    if (sL.winW > 0) Event(e);
+    return 1;
+}
+
+// once a frame, after the events: the pad bits the game should see (bit B_*: A B X Y L R Start Select Up Down Left Right)
+// libntr-ios-inputprio.patch: SimTouch_PadNow is the same without counting a frame: sim_main.cpp asks again after the frame's waits,
+// so a touch that came while it waited reaches the tick that starts now
+static unsigned Pad(void);
+unsigned SimTouch_Pressed(void) {
+    sFrame++;
+#if SIM_TOUCH_IOS
+    CheckFingers();   // libntr-ios-stuckinput.patch
+#endif
+    return Pad();
+}
+unsigned SimTouch_PadNow(void) { return Pad(); }
+static unsigned Pad(void) {
+    unsigned m = sLiveMask;
+    for (int i = 0; i < B_COUNT; i++) {
+        if (sFrame <= sLatchUntil[i]) m |= 1u << i;
+    }
+    if (sPendT0 != 0 && ((m & ~sPressed) != 0 || sStylusPending)) {
+        sTakenT0 = sPendT0;
+        sTakenGate = sPendGate;
+        sTaken = true;
+        sPendT0 = 0;
+    } else if (sPendT0 != 0 && NowNs() - sPendAt > 250000000ull) {
+        sPendT0 = 0;   // (a finger that pressed nothing: the D-pad's centre)
+    }
+    if (m != sPressed || sStylusDown != sLogStylus) {
+        static int sLog = -1;
+        if (sLog < 0) sLog = getenv("BWPORT_TOUCH_LOG") != NULL;
+        if (sLog) fprintf(stderr, "bwport: touch pad %03x stylus %d frame %u\n", m, sStylusDown, sFrame);
+        sLogStylus = sStylusDown;
+    }
+    if (sRelN > 0) ReleasesShown(m);
+    sPressed = m;
+    return m;
+}
+
+// the stylus: 1 while down (a press that came and went between two calls is reported once), at x, y in points
+int SimTouch_Stylus(float * x, float * y) {
+    *x = sStylusX; *y = sStylusY;
+    if (sStylusPending) { sStylusPending = false; return 1; }
+    return sStylusDown;
+}
+
+// -1: no change; 0 / 1: the fast-forward button was tapped (off / on)
+int SimTouch_FFEdge(void) {
+    int e = sFFEdge;
+    sFFEdge = -1;
+    return e;
+}
+
+int SimTouch_MenuOpen(void) { return sMenuOpen; }
+// libntr-ios-input2.patch: a controller was connected / taken away
+void SimTouch_Controller(int present) {
+    sController = present != 0;
+    if (Hidden()) {   // (fingers on the controls that are gone)
+        for (Finger & f : sF) {
+            if (f.used && (f.kind == K_BTN || f.kind == K_DPAD)) f.kind = K_DEAD;
+        }
+        sLiveMask = 0;
+    }
+}
+// libntr-ios-input.patch: every finger is forgotten when the sheet closes. The finger that tapped the menu button lifts while the sheet
+// is up, and SimTouchSettingsWait flushes that SDL_FINGERUP with the rest: its slot stayed taken, so after ten openings no finger could
+// press anything (the maintainer's "the game stops taking button presses after changing settings"). A finger still down now is ignored
+// until it lifts (FindFinger finds nothing).
+void SimTouch_MenuClose(void) {
+    // libntr-ios-ffkeep.patch: the maintainer's "exiting settings shouldn't disable fast forward": fast forward stays as it was across
+    // the settings, and comes back at the Fast-forward speed the settings may just have changed; a performance test the settings
+    // started owns the speed, so then it goes off (as a tap on it does nothing while the test runs)
+    if (sFF) {
+        if (SIM_PerfTestProgress(nullptr, nullptr)) { sFF = false; sFFEdge = 0; }
+        else sFFEdge = 1;
+    }
+#if SIM_TOUCH_IOS
+    bwport_ios_touch_setup(sWindow);   // libntr-ios-inputprio.patch: (again: the sheet's presentation may bring new recognizers)
+#endif
+    sMenuOpen = false;
+    for (Finger & f : sF) f.used = false;
+    sLiveMask = 0;
+    sStylusDown = 0;
+    sStylusPending = false;
+    sPendT0 = 0;
+}
+// a press the game's pad bits now show: when it touched the glass and how long UIKit held it (ns; once per press)
+int SimTouch_PressTaken(unsigned long long * t0, unsigned long long * gate) {
+    if (!sTaken) return 0;
+    sTaken = false;
+    *t0 = sTakenT0;
+    *gate = sTakenGate;
+    return 1;
+}
+// libntr-ios-lag.patch: a release the game's pad bits now show (not a tap): when the finger left the glass (ns; once per release)
+int SimTouch_ReleaseTaken(unsigned long long * t0) {
+    if (!sRelTaken) return 0;
+    sRelTaken = false;
+    *t0 = sRelTakenT0;
+    return 1;
+}
+int SimTouch_Background(void) { return sBackground; }
+// libntr-ios-savemax.patch: the same for C (bw-port's port/src/hang_watch.c holds its watch while the app is in the background)
+extern "C" int SIM_InBackground(void) { return sBackground; }
+
+// libntr-ios-stuckinput.patch (port/src/ios_input.m, main thread): UIKit has dispatched a touch's end or cancel. SDL's view turns it
+// into the finger up inside that dispatch, so a finger the layer still holds now had its end held back from the view (a gesture
+// recognizer that delays ends): it is let go now and logged.
+void SimTouch_UIKitEnded(unsigned long long finger, int cancelled, unsigned long long hwNs, unsigned long long appNs) {
+    if (sL.winW == 0) return;
+    Finger * f = FindFinger((SDL_FingerID)finger);
+    if (f == NULL) return;
+    if (f->kind != K_DEAD) {
+        char nm[64];
+        SIM_Anomaly("touch finger %llx (%s, kind %d, %.0f ms) %s by UIKit but the end did not reach the game's view: let go", finger,
+                    SIM_PadNames(HeldBy(*f), nm), f->kind, (NowNs() - f->downAt) / 1e6, cancelled ? "cancelled" : "ended");
+    }
+    Lift(f, hwNs <= appNs ? hwNs : 0, appNs);
+}
+// a cancel SDL's view got (a recognizer or the system took the touch): logged; SDL sends the up
+void SimTouch_UIKitCancel(unsigned long long finger) {
+    Finger * f = sL.winW != 0 ? FindFinger((SDL_FingerID)finger) : NULL;
+    if (f == NULL || f->kind == K_DEAD) return;
+    char nm[64];
+    SIM_Anomaly("touch finger %llx (%s, kind %d, %.0f ms) cancelled by UIKit (a recognizer or the system took it)", finger,
+                SIM_PadNames(HeldBy(*f), nm), f->kind, (NowNs() - f->downAt) / 1e6);
+}
+
+// libntr-android-touch.patch: pixels per point / dp, for the overlay
+float SimTouch_Unit(void) { return sU; }
+
+// the safe area (l, t, r, b), for the settings window
+void SimTouch_Safe(float * s) { memcpy(s, sL.safe, sizeof sL.safe); }
+
+// libntr-ios-settings.patch: the game's screens (x, y, w, h), where the performance overlay sits; a native sheet asks to open
+void SimTouch_Screens(float * r) { memcpy(r, sL.scr, sizeof sL.scr); }
+void SimTouch_MenuRequest(void) { sMenuOpen = true; ReleaseAll(); }   // (libntr-ios-ffkeep.patch: fast forward stays on)
+
+// the controls, in the frame being built (under the settings window)
+void SimTouch_Draw(void) {
+    if (sMenuOpen || sL.winW == 0) return;
+    ImDrawList * dl = ImGui::GetBackgroundDrawList();
+    ImFont * font = ImGui::GetFont();
+    const ImU32 body = IM_COL32(30, 32, 46, 130), edge = IM_COL32(215, 220, 238, 170), lit = IM_COL32(255, 196, 64, 215),
+                ink = IM_COL32(245, 246, 250, 235), inkLit = IM_COL32(28, 24, 12, 255), shade = IM_COL32(0, 0, 0, 70);
+    const Layout & L = sL;
+    unsigned m = sPressed;
+    const bool hide = Hidden();
+    const float u = sU;   // (the lengths below are in points / dp)
+
+    for (int i = 0; i < B_UP && !hide; i++) {
+        const Btn & b = L.btn[i];
+        if (b.w <= 0) continue;
+        bool on = (m >> i) & 1;
+        ImVec2 p0(b.x, b.y), p1(b.x + b.w, b.y + b.h);
+        float fs;
+        if (b.round) {
+            ImVec2 ctr(b.x + b.w * 0.5f, b.y + b.h * 0.5f);
+            dl->AddCircleFilled(ImVec2(ctr.x, ctr.y + 2 * u), b.w * 0.5f, shade, 32);
+            dl->AddCircleFilled(ctr, b.w * 0.5f, on ? lit : body, 32);
+            dl->AddCircle(ctr, b.w * 0.5f, edge, 32, 2.0f * u);
+            fs = b.w * 0.5f;
+        } else {
+            float r = b.h * 0.5f;
+            // L and R are slabs; the middle buttons are pills
+            if (i == B_L || i == B_R) r = 14.0f * u;
+            dl->AddRectFilled(ImVec2(p0.x, p0.y + 2 * u), ImVec2(p1.x, p1.y + 2 * u), shade, r);
+            dl->AddRectFilled(p0, p1, on ? lit : body, r);
+            dl->AddRect(p0, p1, edge, r, 0, 2.0f * u);
+            fs = ((i == B_L || i == B_R) ? 22.0f : 14.0f) * u;
+        }
+        ImVec2 ts = font->CalcTextSizeA(fs, 1000.0f, 0.0f, b.label);
+        dl->AddText(font, fs, ImVec2(b.x + (b.w - ts.x) * 0.5f, b.y + (b.h - ts.y) * 0.5f), on ? inkLit : ink, b.label);
+    }
+
+    // the D-pad: a plus of two slabs, arrows on the arms, the held arm lit
+    if (!hide) {
+        float c = L.dc, x = L.dcx, y = L.dcy, rr = c * 0.28f;
+        // the plus as one outline (corners cut), so no line crosses its middle
+        {
+            const float a = 0.5f * c, b = 1.5f * c;
+            const float vx[12] = {-a, a, a, b, b, a, a, -a, -a, -b, -b, -a}, vy[12] = {-b, -b, -a, -a, a, a, b, b, a, a, -a, -a};
+            ImVec2 pts[24];
+            for (int i = 0; i < 12; i++) {
+                int pi = (i + 11) % 12, ni = (i + 1) % 12;
+                float px = vx[pi] - vx[i], py = vy[pi] - vy[i], nx = vx[ni] - vx[i], ny = vy[ni] - vy[i];
+                float pl = hypotf(px, py), nl = hypotf(nx, ny), r = rr;
+                pts[2 * i] = ImVec2(x + vx[i] + px / pl * r, y + vy[i] + py / pl * r);
+                pts[2 * i + 1] = ImVec2(x + vx[i] + nx / nl * r, y + vy[i] + ny / nl * r);
+            }
+            ImVec2 sh[24];
+            for (int i = 0; i < 24; i++) sh[i] = ImVec2(pts[i].x, pts[i].y + 2 * u);
+            dl->AddConcavePolyFilled(sh, 24, shade);
+            dl->AddConcavePolyFilled(pts, 24, body);
+            dl->AddPolyline(pts, 24, edge, ImDrawFlags_Closed, 2.0f * u);
+        }
+        struct Arm { int bit; float dx, dy; } arms[4] = {{B_UP, 0, -1}, {B_DOWN, 0, 1}, {B_LEFT, -1, 0}, {B_RIGHT, 1, 0}};
+        for (const Arm & a : arms) {
+            bool on = (m >> a.bit) & 1;
+            float cx = x + a.dx * c, cy = y + a.dy * c;
+            if (on) dl->AddRectFilled(ImVec2(cx - 0.5f * c + 3 * u, cy - 0.5f * c + 3 * u), ImVec2(cx + 0.5f * c - 3 * u, cy + 0.5f * c - 3 * u), lit, rr * 0.7f);
+            float t = c * 0.22f;
+            ImVec2 tip(cx + a.dx * t, cy + a.dy * t), b1(cx - a.dx * t + a.dy * t * 1.2f, cy - a.dy * t + a.dx * t * 1.2f),
+                b2(cx - a.dx * t - a.dy * t * 1.2f, cy - a.dy * t - a.dx * t * 1.2f);
+            dl->AddTriangleFilled(tip, b1, b2, on ? inkLit : ink);
+        }
+    }
+
+    // menu (three bars) and fast-forward (two arrows, lit while on)
+    {
+        const Btn & b = L.menu;
+        ImVec2 p0(b.x, b.y), p1(b.x + b.w, b.y + b.h);
+        dl->AddRectFilled(p0, p1, body, 12.0f * u);
+        dl->AddRect(p0, p1, edge, 12.0f * u, 0, 2.0f * u);
+        for (int i = 0; i < 3; i++) {
+            float yy = b.y + b.h * 0.5f + (i - 1) * 8.0f * u;
+            dl->AddRectFilled(ImVec2(b.x + 12 * u, yy - 1.5f * u), ImVec2(b.x + b.w - 12 * u, yy + 1.5f * u), ink, 1.5f * u);
+        }
+        // the fast-forward button: a pill like SELECT / START, two arrows and the speed it gives ("4x", "MAX"), lit while on
+        const Btn & f = L.ff;
+        ImVec2 q0(f.x, f.y), q1(f.x + f.w, f.y + f.h);
+        float fr = f.h * 0.5f;
+        dl->AddRectFilled(ImVec2(q0.x, q0.y + 2 * u), ImVec2(q1.x, q1.y + 2 * u), shade, fr);
+        dl->AddRectFilled(q0, q1, sFF ? lit : body, fr);
+        dl->AddRect(q0, q1, edge, fr, 0, 2.0f * u);
+        int sp = SIM_UISettingGet("ffspeed");
+        char lab[16];
+        snprintf(lab, sizeof lab, sp >= 5 ? "MAX" : "%dx", sp);
+        float fs = (f.h > 40.0f * u ? 16.0f : 14.0f) * u;
+        // libntr-ios-testbadge.patch: while the performance test runs the pill says so, with the rows done ("TEST 7/30"), lit
+        int tDone = 0, tRows = 0;
+        if (SIM_PerfTestProgress(&tDone, &tRows)) {
+            snprintf(lab, sizeof lab, "TEST %d/%d", tDone + 1 > tRows ? tRows : tDone + 1, tRows);
+            dl->AddRectFilled(q0, q1, lit, fr);
+            dl->AddRect(q0, q1, edge, fr, 0, 2.0f * u);
+            ImVec2 ls = font->CalcTextSizeA(fs, 1000.0f, 0.0f, lab);
+            dl->AddText(font, fs, ImVec2(f.x + (f.w - ls.x) * 0.5f, f.y + (f.h - ls.y) * 0.5f), inkLit, lab);
+            return;
+        }
+        ImVec2 ts = font->CalcTextSizeA(fs, 1000.0f, 0.0f, lab);
+        float ah = f.h * 0.22f, aw = ah * 0.9f, total = 2 * aw + 9.0f * u + ts.x;
+        float x0 = f.x + (f.w - total) * 0.5f, cy = f.y + f.h * 0.5f;
+        ImU32 col = sFF ? inkLit : ink;
+        for (int i = 0; i < 2; i++) {
+            float ox = x0 + i * (aw + 3.0f * u);
+            dl->AddTriangleFilled(ImVec2(ox, cy - ah), ImVec2(ox, cy + ah), ImVec2(ox + aw, cy), col);
+        }
+        dl->AddText(font, fs, ImVec2(x0 + 2 * aw + 9.0f * u, cy - ts.y * 0.5f), col, lab);
+    }
+}
+
+}  // extern "C"

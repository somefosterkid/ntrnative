+// libntr-ios-sound.patch: the playback rate's correction, from the fill after each frame tick (the audio locked). The fill is
+// low-passed (two poles at 0.2 s: the frame rhythm's 547-frame sawtooth is 70 dB down at 60 Hz) and drives a PI controller:
+// the proportional part at most +-0.25 % (4 cents), the integral part follows a producer that is really slower or faster
+// (a device that cannot hold 60 fps) by at most 0.3 % a second (and 0.1 % for a dry ring while the game ran), up to +-3 %. So
+// the pitch never moves faster than a slow glide; a fill far off is cut (SND_CAP above) or played dry (the callback's fade
+// below) instead of being corrected by pitch.
+static double s_rateAdj = 0.0, s_rateI = 0.0, s_lp1 = 0.0, s_lp2 = 0.0, s_tickT = 0.0;
+static int s_wasUnpaced = 0;
+#define SND_TPOST (SND_TARGET + 273.0) // the fill right after a frame's samples (the target is the mean)
+
+static void RateUpdate(void)
+{
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    double now = (double)ts.tv_sec + ts.tv_nsec * 1e-9;
+    double dt = s_tickT > 0.0 ? now - s_tickT : 1.0;
+    s_tickT = now;
+    double fill = (double)(s_ringWr - s_ringRd);
+    int unpaced = SIM_FastForwarding();
+    static u64 sUnder = 0;
+    if(s_ringUnderruns != sUnder) { // dry while the game ran at its pace (not a pause, not one long stall): it is slower than the rate
+        sUnder = s_ringUnderruns;
+        if(!unpaced && dt < 0.1 && s_rateI > -0.03) {
+            s_rateI -= 0.001;
+        }
+    }
+    dt = dt < 0.0 ? 0.0 : dt > 0.1 ? 0.1 : dt;
+    if(s_wasUnpaced && !unpaced && fill > SND_TPOST + 300.0 && !s_skip) { // back from Max: down to the target at once
+        s_skip = 1;
+        s_skips++;
+    }
+    s_wasUnpaced = unpaced;
+    static int sMode = -1; // a speed change starts the integral afresh (what it learnt is the old speed's shortfall: after a
+    int mode = sConfigPtr->speed * 2 + unpaced; // 4x the game could not hold it glided back for seconds)
+    if(mode != sMode) {
+        sMode = mode;
+        s_rateI = 0.0;
+    }
+    if(unpaced || s_skip) { // (the fill says nothing about the rates now)
+        s_lp1 = s_lp2 = fill;
+        s_rateAdj = s_rateI;
+        return;
+    }
+    if(!s_ringPrimed) {
+        s_rateAdj = s_rateI;
+        return;
+    }
+    double a = dt / 0.2;
+    a = a > 1.0 ? 1.0 : a;
+    s_lp1 += a * (fill - s_lp1);
+    s_lp2 += a * (s_lp1 - s_lp2);
+    if(s_lp2 > SND_TPOST + 600.0) { // lastingly too full (a burst after a stall): cut it rather than play it fast for seconds
+        s_skip = 1;
+        s_skips++;
+        return;
+    }
+    double e = (s_lp2 - SND_TPOST) / SND_TARGET;
+    e = e > 1.0 ? 1.0 : e < -1.0 ? -1.0 : e;
+    s_rateI += 0.003 * e * dt;
+    s_rateI = s_rateI > 0.03 ? 0.03 : s_rateI < -0.03 ? -0.03 : s_rateI;
+    double p = 0.018 * e;
+    p = p > 0.0025 ? 0.0025 : p < -0.0025 ? -0.0025 : p;
+    s_rateAdj = s_rateI + p;
+}

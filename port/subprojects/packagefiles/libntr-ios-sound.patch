+// libntr-ios-sound.patch: SDL_PauseAudio with a fade (the settings sheet, the background): pausing mid-waveform clicked
+extern "C" void SIM_Audio_Pause(int aPause)
+{
+    if(!aPause) {
+        SDL_LockAudio();
+        s_gainTarget = 1.0f;
+        SDL_UnlockAudio();
+        SDL_PauseAudio(0);
+        return;
+    }
+    SDL_LockAudio();
+    s_gainTarget = 0.0f;
+    SDL_UnlockAudio();
+    for(int t = 0; s_frameClock && t < 40 && SDL_GetAudioStatus() == SDL_AUDIO_PLAYING; t++) { // (a callback or two)
+        SDL_LockAudio();
+        int done = s_gain <= 0.0f || !s_ringPrimed;
+        SDL_UnlockAudio();
+        if(done) {
+            break;
+        }
+        SDL_Delay(1);
+    }
+    SDL_PauseAudio(1);
+}

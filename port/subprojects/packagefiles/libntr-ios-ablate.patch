+// libntr-ios-ablate.patch: test-only ablations (the maintainers' notes): cfgscript ablate=NAME+NAME..., a piece of the frame taken out or
+// faked so a bench row measures the frame without it (a ceiling for making that piece cheaper). Metal only for the GPU pieces.
+// Off (0) by default and reset by ablate=none; the pictures are wrong while one is on.
+static unsigned sAblate;
+extern "C" unsigned SIM_Ablation(void) { return sAblate; }
+static unsigned AblateParse(const char *v) {
+  static const struct { const char *name; unsigned bit; } k[] = {
+    {"r", 1},         // pass R draws no polygon (GPU_ABL_R)
+    {"e", 2},         // no pass E
+    {"pslow", 4},     // pass P without its slow-pixel draw
+    {"p", 8},         // no pass P
+    {"c", 16},        // no pass C
+    {"gpu", 32},      // no GL/Metal half at all (uploads, S, R, E, P, C; the in-between pictures too): the picture stays
+    {"present", 64},  // the present commits an empty command buffer: no drawable, no quad, no UI draw (the screen keeps its picture)
+    {"spin", 128},    // the pacing sleep's last 150 us are slept, not spun
+  };
+  unsigned m = 0;
+  for (const char *q = v; *q != 0;) {
+    const char *e = strchr(q, '+');
+    size_t n = e != NULL ? (size_t)(e - q) : strlen(q);
+    for (size_t i = 0; i < sizeof k / sizeof k[0]; i++) {
+      if (strlen(k[i].name) == n && strncmp(k[i].name, q, n) == 0) m |= k[i].bit;
+    }
+    q += n + (e != NULL ? 1 : 0);
+  }
+  return m;
+}

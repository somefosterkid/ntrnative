+// libntr-ios-vcaplist.patch: the stream's words (a std::vector before): Grow hands out room for a list's worst case at
+// once, so a list is written by plain stores and its length set once (push_back checked the capacity at every word)
+struct Words {
+  u32 *p = NULL;
+  u32 n = 0, cap = 0;
+  u32 size() const { return n; }
+  const u32 *data() const { return p; }
+  const u32 *begin() const { return p; }
+  const u32 *end() const { return p + n; }
+  void clear() { n = 0; }
+  // room for k more words at the end (not counted until the caller sets n)
+  u32 *Grow(u32 k) {
+    if (n + k > cap) {
+      u32 want = (n + k) + (n + k) / 2 + 4096;
+      u32 *q = (u32 *)realloc(p, (size_t)want * 4);
+      if (q == NULL) abort();
+      p = q;
+      cap = want;
+    }
+    return p + n;
+  }
+};
+

+// bw-port (libntr-ios-touch.patch): the app is in the background (iOS kills an app that issues OpenGL ES commands there): no
+// drawing, the game and the sound stand still until it is back
+static void SimTouchBackgroundWait(void) {
+  if (!SimTouch_Active() || !SimTouch_Background()) return;
+  fprintf(stderr, "bwport: in the background: paused\n");
+  SDL_PauseAudio(1);
+  while (SimTouch_Background()) {
+    SDL_PumpEvents();
+    SDL_Delay(50);
+  }
+  SDL_PauseAudio(0);
+  fprintf(stderr, "bwport: back in the foreground\n");
+}

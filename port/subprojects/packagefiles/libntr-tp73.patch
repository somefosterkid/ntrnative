+static bool TouchOnScreen(float px, float py) { // px, py: the pixel's centre
+  const float *r = s_TouchPanelCoords;
+  return px >= r[0] && px < r[2] && py >= r[1] && py < r[3];
+}
+// the game took a touch sample (tp.c): the latch may end; BWPORT_TOUCHLOG gets "tp VBLANK touch X Y" for the touched samples
+// and the first untouched one after
+extern "C" void SIM_TouchSampled(const TPData *d) {
+  sTouchSamples++;
+  FILE *tl = TouchLogFile();
+  if (tl != NULL && (d->touch || sTouchLogPrev)) {
+    fprintf(tl, "tp %u touch %d %d %d\n", *((u32 *)HW_VBLANK_COUNT_BUF), (int)d->touch, (int)d->x, (int)d->y);
+    fflush(tl);
+  }
+  sTouchLogPrev = d->touch ? 1 : 0;
+}

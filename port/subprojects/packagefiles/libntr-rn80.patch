+static u8 FrameRateFromString(const char * v)
+{
+    if(strcmp(v, "unlimited") == 0 || strcmp(v, "off") == 0) return SIM_CONFIG_DISPLAYCAP_UNLIMITED;
+    if(strcmp(v, "monitor") == 0) return SIM_CONFIG_DISPLAYCAP_MONITOR;
+    return atoi(v) >= 120 ? SIM_CONFIG_DISPLAYCAP_120 : SIM_CONFIG_DISPLAYCAP_60;
+}
+
+static const char * FrameRateToString(u8 r)
+{
+    return r == SIM_CONFIG_DISPLAYCAP_UNLIMITED ? "unlimited" : r == SIM_CONFIG_DISPLAYCAP_MONITOR ? "monitor"
+         : r == SIM_CONFIG_DISPLAYCAP_120 ? "120" : "60";
+}
+
+static int OnOffFromString(const char * v)
+{
+    return strcmp(v, "on") == 0 || strcmp(v, "1") == 0 || strcmp(v, "true") == 0;
+}
+
+/* the old keys of a file that has no new key for the same setting (defaults and the file's other keys are already in aConfig) */
+static void FinishOldKeys(SIM_config_type * aConfig)
+{
+    if(!sSeenGameSpeed && sOldSpeed > 0) aConfig->speed = (u8)sOldSpeed;
+    if(!sSeenSmooth && sOldInterp >= 0) aConfig->interpolation = (u8)sOldInterp;
+    if(!sSeenFrameRate) {
+        if(sOldCapOff) aConfig->displayCap = SIM_CONFIG_DISPLAYCAP_UNLIMITED;
+        else if(sOldDisplayCap >= 0) aConfig->displayCap = (u8)sOldDisplayCap;
+    }
+    if(!sSeenRestore) {
+        if(sOldDisplayCap >= 0) aConfig->displayCapBack = (u8)sOldDisplayCap;
+        else if(aConfig->displayCap != SIM_CONFIG_DISPLAYCAP_UNLIMITED) aConfig->displayCapBack = aConfig->displayCap;
+    }
+}

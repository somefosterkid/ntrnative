+// Games that write the TEXCOORD and NORMAL registers themselves (reg_G3_TEXCOORD = st, as the DS's geometry engine
+// takes them: Black's mcss.c, its sprites' quads) only set the variables that stand for the registers here, which send
+// no command. The values last sent as commands are kept in the variables; a vertex takes a register's value that
+// differs from it as a command first
+static u32 s_sentTexCoord;
+static u32 s_sentNormal;
+
+static void CatchUpRegisterWrites(void) {
+  if (s_reg_G3_TEXCOORD != s_sentTexCoord) {
+    s_sentTexCoord = s_reg_G3_TEXCOORD;
+    G3SIM_TexCoord(s_sentTexCoord);
+  }
+  if (s_reg_G3_NORMAL != s_sentNormal) {
+    s_sentNormal = s_reg_G3_NORMAL;
+    G3SIM_Normal(s_sentNormal);
+  }
+}

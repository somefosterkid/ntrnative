+// bw-port (libntr-frameskip.patch): frame skip. The game's logic runs every frame; the picture is drawn only on some.
+// SIM_FrameSkipDecide runs at the top of each frame (SIM_Render) and sets sDrawNow; the frame renderers' bridges ask
+// SIM_FrameSkipping() and, when it is 1, hand back the picture they showed last instead of gathering and drawing a new
+// one (they still run: a pipelined bridge keeps its worker). A frame is always drawn when the display capture is on
+// (the game reads the capture's bank next), when SIGUSR2 / SIM_FrameForceDraw asked for the next few frames (a
+// screenshot, port_run.py --skip), when the renderer is libntr's own (its 2D draws each frame, FrameSkip is ignored)
+// or when no frame renderer is registered. FrameSkip=N draws the frames whose V-blank count is a multiple of N + 1;
+// auto skips only when drawing would take the frame past 60 fps with the cap on: a credit of the frame time left over
+// (the cap's wait counts), drawn when the credit covers a drawn frame's cost, at most 4 skipped in a row.
+static int sDrawNow = 1;
+static volatile sig_atomic_t sFrameForce;
+static unsigned sFSRun;                 // frames skipped in a row
+static s64 sFSCredit;                   // ns of frame time in hand (auto)
+static s64 sFSBusyDrawn, sFSBusySkipped; // moving averages of the busy time of drawn / skipped frames (auto), ns
+static int sFSWasDrawn = 1;
+static unsigned sFSNDrawn, sFSNSkipped, sFSLongest; // BWPORT_FPSLOG: per second
+extern "C" int SIM_FrameSkipping(void) { return !sDrawNow; }
+extern "C" void SIM_FrameForceDraw(void) { sFrameForce = 3; }
+static void SIM_FrameForceHandler(int) { sFrameForce = 3; }
+
+static bool SIM_FrameSkipDecide(void) {
+  static bool installed;
+  if (!installed) {
+    installed = true;
+#ifndef SDK_BUILD_WIN64
+    signal(SIGUSR2, SIM_FrameForceHandler);
+#endif
+  }
+  const u8 fs = s_SIM_config.frameSkip;
+  const s64 kFrame = 16715000;
+  bool can = (sFrameRenderer != NULL || sFrameRendererGL != NULL) && s_SIM_config.renderer != SIM_CONFIG_RENDERER_LIBNTR;
+  bool force = sFrameForce > 0;
+  if (force) sFrameForce = sFrameForce - 1;
+  bool draw = true;
+  if (can && fs != 0 && !force && !(s_reg_GX_DISPCAPCNT & 0x80000000u) && sFSRun < 4 + (fs != SIM_CONFIG_FRAMESKIP_AUTO ? 100 : 0)) {
+    if (fs == SIM_CONFIG_FRAMESKIP_AUTO) {
+      if (s_SIM_config.capFrameRate && !sFastForward && sFSBusyDrawn > 0) {
+        // no skipped frame seen yet: skip one only when a drawn frame took more than the frame time
+        draw = sFSBusySkipped == 0 ? sFSBusyDrawn <= kFrame : sFSCredit + kFrame >= sFSBusyDrawn;
+      }
+    } else {
+      draw = (*((u32 *)HW_VBLANK_COUNT_BUF) % ((u32)fs + 1)) == 0;
+    }
+  }
+  sFSRun = draw ? 0 : sFSRun + 1;
+  if (draw) sFSNDrawn++; else sFSNSkipped++;
+  if (sFSRun > sFSLongest) sFSLongest = sFSRun;
+  sFSWasDrawn = draw;
+  sDrawNow = draw;
+  return draw;
+}
+
+// after the frame's swap (busy: ns from the last frame's end to here, the cap's wait not included)
+static void SIM_FrameSkipEnd(u64 busy) {
+  const s64 kFrame = 16715000;
+  s64 b = (s64)busy;
+  s64 &avg = sFSWasDrawn ? sFSBusyDrawn : sFSBusySkipped;
+  {
+    static int sLog = -1;
+    static u64 sLast;
+    if (sLog < 0) sLog = getenv("BWPORT_FPSLOG") != NULL;
+    if (sLog && s_SIM_config.frameSkip != 0) {
+      u64 now = SDL_GetPerformanceCounter(), fq = SDL_GetPerformanceFrequency();
+      if (sLast == 0) sLast = now;
+      if (now - sLast >= fq) {
+        fprintf(stderr, "skip drawn %u skipped %u longest %u busy drawn %.1f skipped %.1f ms\n", sFSNDrawn, sFSNSkipped, sFSLongest,
+                sFSBusyDrawn / 1e6, sFSBusySkipped / 1e6);
+        sFSNDrawn = sFSNSkipped = sFSLongest = 0;
+        sLast = now;
+      }
+    }
+  }
+  avg = avg == 0 ? b : avg + (b - avg) / 4;
+  if (s_SIM_config.frameSkip == SIM_CONFIG_FRAMESKIP_AUTO) {
+    sFSCredit += kFrame - b;
+    if (sFSCredit > kFrame) sFSCredit = kFrame;
+    if (sFSCredit < -3 * kFrame) sFSCredit = -3 * kFrame;
+  }
+}

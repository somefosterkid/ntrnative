--- a/meson.build
+++ b/meson.build
@@ -58,6 +58,11 @@
 
 c_args = shared_args
 cpp_args = shared_args
+if build_target != 'arm'
+    # The SDK's C was written for a compiler that never exploited signed overflow, type punning or a dereference

+// The BIOS's CpuSet (swi 0x0b): bits 0-20 of dmaCntData count units, bit 26 makes them words (else halfwords), bit 24
+// fills with the first unit at srcp (else copies)
 void SVC_CpuSet(const void *srcp, void *destp, u32 dmaCntData) {
-  // TODO: stubbed
+  u32 count = dmaCntData & 0x1fffff;
+  BOOL fill = (dmaCntData & (1 << 24)) != 0;
+  u32 i;
+
+  if (dmaCntData & (1 << 26)) {
+    const u32 *s = (const u32 *)srcp;
+    u32 *d = (u32 *)destp;
+    u32 v = *s;
+    for (i = 0; i < count; i++) {
+      d[i] = fill ? v : s[i];
+    }
+  } else {
+    const u16 *s = (const u16 *)srcp;
+    u16 *d = (u16 *)destp;
+    u16 v = *s;
+    for (i = 0; i < count; i++) {
+      d[i] = fill ? v : s[i];
+    }
+  }
 }
 
+// CpuFastSet (swi 0x0c): words only, the count rounded up to a multiple of 8
 void SVC_CpuSetFast(const void *srcp, void *destp, u32 dmaCntData) {
-  // TODO: stubbed
+  u32 count = ((dmaCntData & 0x1fffff) + 7) & ~7u;
+  const u32 *s = (const u32 *)srcp;
+  u32 *d = (u32 *)destp;
+  u32 v = *s;
+  u32 i;
+

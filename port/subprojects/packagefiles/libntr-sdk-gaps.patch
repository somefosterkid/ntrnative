-u16 SVC_GetCRC16(u32 start, const void *datap, u32 size) { return 0; }
+// GetCRC16 (swi 0x0e): CRC-16 with the reflected polynomial 0xa001 (CRC-16/ARC, CRC-16/MODBUS from 0xffff) from start,
+// over size bytes taken a halfword at a time (an odd last byte is left out, as the BIOS does)
+u16 SVC_GetCRC16(u32 start, const void *datap, u32 size) {
+  const u8 *p = (const u8 *)datap;
+  u32 crc = start & 0xffff;
+  u32 i;
+  int bit;
+
+  for (i = 0; i < (size & ~1u); i++) {
+    crc ^= p[i];
+    for (bit = 0; bit < 8; bit++) {
+      crc = (crc & 1) ? (crc >> 1) ^ 0xa001 : crc >> 1;
+    }
+  }
+  return (u16)crc;
+}
 
 #endif
 
diff --git a/libraries/spi/src/pm.c b/libraries/spi/src/pm.c
index 6c0f97c..cf3db88 100644
--- a/libraries/spi/src/pm.c
+++ b/libraries/spi/src/pm.c
@@ -408,6 +408,47 @@ void PMi_CommonCallback (PXIFifoTag tag, uPtr data, BOOL err)
 }
 
 #if SDK_VERSION_MAJOR == 5
+#ifdef SDK_PORT
+// Nothing answers PM on PC (the ARM7 simulator has no PM handler, PMi_WaitBusy doesn't wait): a synchronous call
+// returned an uninitialized result and PMi_TryToSendPxiDataTillSuccess waited forever. PMi_TryToSendPxiData answers
+// at once instead, as a DS with a full battery on its adapter, both backlights and the sound power on and the mic amp
+// off would. The PMIC registers that READREG, WRITEREG and SET_AMP use are kept here
+static u16 PMi_PortPmicReg[8] = {PMIC_CTL_SND_PWR | PMIC_CTL_BKLT1 | PMIC_CTL_BKLT2};
+
+static u16 PMi_PortAnswer(const u32 *sendData, int num) {
+  u32 command = (sendData[0] >> 8) & 0xff;
+  u32 number = sendData[0] & 0xff;
+  u32 param = (num > 1) ? (sendData[1] & SPI_PXI_DATA_MASK) : 0;
+
+  if (command != SPI_PXI_COMMAND_PM_UTILITY) {
+    return 0; // sync, sleep, LCD power ...: done
+  }
+  switch (number) {
+  case PMi_UTIL_READREG:
+    return PMi_PortPmicReg[param & 7];
+  case PMi_UTIL_WRITEREG:
+    PMi_PortPmicReg[(param >> 8) & 7] = (u16)(param & 0xff);
+    return 0;
+  case PM_UTIL_SET_AMP:
+    PMi_PortPmicReg[REG_PMIC_OP_CTL_ADDR] = (u16)(param ? PMIC_OP_CTL : 0);
+    return 0;
+  case PM_UTIL_GET_STATUS:
+    switch (param) {
+    case PM_UTIL_PARAM_BATTERY_LEVEL:
+      return PM_BATTERY_LEVEL_MAX;
+    case PM_UTIL_PARAM_AC_ADAPTER:
+    case PM_UTIL_PARAM_SOUND_POWER:
+      return 1;
+    case PM_UTIL_PARAM_AMP:
+      return (u16)(PMi_PortPmicReg[REG_PMIC_OP_CTL_ADDR] & PMIC_OP_CTL);
+    default:
+      return 0; // PM_UTIL_PARAM_BATTERY 0: not low
+    }
+  }
+  return 0;
+}
+#endif
+

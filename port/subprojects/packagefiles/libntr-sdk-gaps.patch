                                 PMCallback callback, void *arg) {
   int n;
@@ -423,12 +464,25 @@ static u32 PMi_TryToSendPxiData(u32 *sendData, int num, u16 *retValue,
   PMi_Work.callback = callback;
   PMi_Work.callbackArg = arg;
 
+#ifdef SDK_PORT
+  {
+    u16 value = PMi_PortAnswer(sendData, num);

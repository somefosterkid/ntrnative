+    fprintf(stderr, "bwport: smooth motion off for %d s: the game fell behind\n", sIpOffLen / 60);
+    sIpOffLen = sIpOffLen * 2 > 3600 ? 3600 : sIpOffLen * 2;
+    sIpGood = 0;
+  } else if (sIpOff > 0) {
+    sIpOff--;

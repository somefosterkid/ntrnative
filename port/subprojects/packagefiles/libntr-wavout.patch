+// bw-port: UpdateSharedWork's channel word (snd_work.c's, ARM7 only): bit n = channel n busy. The callback's SND_SeqMain
+// and the wave-out commands (pxi.c) refresh it, as the DS ARM7 does after each wake and each START/STOP_TIMER
+void SND_UpdateChannelStatus7(void)
+{
+    u16 status = 0;
+    int chNo;
+
+    if (SNDi_SharedWork == NULL)
+        return;
+    for (chNo = 0; chNo < SND_CHANNEL_NUM; chNo++) {
+        if (SND_IsChannelActive7(chNo))
+            status |= (u16)(1 << chNo);
+    }
+    SNDi_SharedWork->channelStatus = status;
+}

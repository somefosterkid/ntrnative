@@ -3,6 +3,25 @@
 
 #ifdef SDK_PORT
 #include <SDL2/SDL.h>
+#include <pthread.h>
+
+// bw-port (libntr-msgqlock.patch): a message queue is shared by host threads that run at the same time (the game's,
+// the PXI threads, the ARM7's WM request thread), and OS_DisableInterrupts stops none of them, so a send and a receive
+// at once lost one of the two usedCount updates: the message was gone, the queue said empty (Black 2's wireless: a WM
+// request never ran, its command buffer was never given back, and the next WM call failed into the net error screen,
+// or each frame waited its second for the lost request). The queue is changed under one host lock now, let go around
+// OS_SleepThread (OS_DisableInterrupts noted the wake epoch first, so a wakeup between the two is not lost).
+#ifdef __APPLE__
+#define OSi_MQ_HOST __attribute__((section("__DATA,__data")))
+#else
+#define OSi_MQ_HOST __attribute__((section(".bwhost")))   /* the host's, out of the machine's restart (os_thread.c) */
+#endif
+static pthread_mutex_t s_mqLock OSi_MQ_HOST = PTHREAD_MUTEX_INITIALIZER;
+#define MQ_LOCK()   pthread_mutex_lock(&s_mqLock)
+#define MQ_UNLOCK() pthread_mutex_unlock(&s_mqLock)
+#else
+#define MQ_LOCK()   ((void)0)
+#define MQ_UNLOCK() ((void)0)
 #endif
 
 void OS_InitMessageQueue (OSMessageQueue * mq, OSMessage * msgArray, s32 msgCount)
@@ -22,14 +41,17 @@
     s32 lastIndex;
 
     enabled = OS_DisableInterrupts();
+    MQ_LOCK();
 
     while (mq->msgCount <= mq->usedCount) {
         if (!(flags & OS_MESSAGE_BLOCK)) {
+            MQ_UNLOCK();
             (void)OS_RestoreInterrupts(enabled);
             return FALSE;
         } else {
-
+            MQ_UNLOCK();

 extern "C" void SIM_RendererAAUsed(int k) { sAAUsed = k; }
+// bw-port (libntr-fx71.patch): the grid the 3D is drawn on: Resolution x k, k the Antialiasing lowered until the product is
+// at most 8 (what both bridges do), or the k the bridge reported when that is lower
+extern "C" int SIM_InternalScale(void) {
+  int n = SIM_RenderScale();
+  int k = SIM_AntialiasWanted();
+  while (k > 1 && n * k > 8) k >>= 1;
+  if (sAAUsed > 0 && sAAUsed < k) k = sAAUsed;
+  return n * k;
+}

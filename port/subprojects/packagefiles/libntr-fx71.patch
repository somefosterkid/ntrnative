+// bw-port (libntr-fx71.patch): the look options (Dot, Line, Edge, Filter) act on the grid the 3D is drawn on, Resolution x the
+// Antialiasing k in use (SIM_InternalScale), in both renderers: true when they can act now, else why not in 'why'
+// the head of a look option's menu: when the options cannot act, say so and grey the items (BeginDisabled .. EndDisabled)
+static void LookMenuBegin() {
+    bool on = SIM_InternalScale() > 1;
+    if (!on) {
+        ImGui::TextDisabled("Only at 2x and above (the 3D is drawn at 1x now)");
+        ImGui::Separator();
+    }
+    ImGui::BeginDisabled(!on);
+}
+static void NoteText(const char * fmt, const char * s) {
+    ImGui::PushStyleColor(ImGuiCol_Text, ImGui::GetStyleColorVec4(ImGuiCol_TextDisabled));
+    ImGui::TextWrapped(fmt, s);
+    ImGui::PopStyleColor();
+}
+static bool LookNote(char * why, size_t n) {
+    int in = SIM_InternalScale();
+    int res = SIM_RenderScale();
+    if (in > 1) {
+        if (res > 1) {
+            snprintf(why, n, "In force: the 3D is drawn at %dx.", in);
+        } else {
+            snprintf(why, n, "In force: the 3D is drawn at %dx (Resolution 1x, Antialiasing %dx), then averaged to 1x.", in, in);
+        }
+        return true;
+    }
+    snprintf(why, n, "Only at 2x and above: the 3D is drawn at 1x now. Raise Resolution, or turn Antialiasing on.");
+    return false;
+}

+// bw-port (libntr-soundclock.patch): the sound clock steps when the game's frame ends; every command the game sent
+// before it must have reached the sound side then, or which frame a command lands in would depend on the thread
+// scheduler. A message that never finishes (blocked on the game's lock) is not waited for beyond 20 ms.
+void SIM_PxiDrain(void)
+{
+	Uint32 t0 = SDL_GetTicks();
+	while( s_pxiPending > 0 && SDL_GetTicks() - t0 < 20 )
+	{
+		SDL_Delay( 0 );
+	}
+}

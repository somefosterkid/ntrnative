+// bw-port (libntr-wmreset.patch): a beacon is sent (and its indication goes to the ARM9) only while the ARM7 is a
+// parent, as on the DS. The state is read under the callback buffer's lock, which WMSP_Reset holds while it leaves
+// the parent's state. A parent's Reset and End (WM_Reset in MP_PARENT, then WM_End: the ARM9's WM_Finish takes its
+// PXI callback away) left the simulator's beacon going: its indication was dropped with the buffer still marked busy,
+// and the next beacon (the main thread, in SIM_Render) waited for that buffer forever (White 2's boat leg).
 void WMSP_IndicateSendBeacon()
 {
-    if (WMSP_GetStatusStructure()->beaconIndicateFlag > 0)
-    {
-        WMStartParentCallback *callback = (WMStartParentCallback *)WMSP_GetBuffer4Callback2Wm9();
+    WMStatus *status = WMSP_GetStatusStructure();
+    WMStartParentCallback *callback;
 
-        callback->apiid = WM_APIID_START_PARENT;
-        callback->errcode = WM_ERRCODE_SUCCESS;
-        callback->state = WM_STATECODE_BEACON_SENT;
-        WMSP_ReturnResult2Wm9(callback);
+    OS_LockMutex(&(wmspW.fifoExclusive));
+    if (status->beaconIndicateFlag <= 0
+        || (status->state != WM_STATE_PARENT && status->state != WM_STATE_MP_PARENT))
+    {
+        OS_UnlockMutex(&(wmspW.fifoExclusive));
+        return;
     }
+    while (OS_GetSystemWork()->wm_callback_control & WM_EXCEPTION_CB_MASK)
+    {
+        SVC_WaitByLoop(256);
+    }
+    OS_GetSystemWork()->wm_callback_control |= WM_EXCEPTION_CB_MASK;
+    callback = (WMStartParentCallback *)(wmspW.wm7buf->fifo7to9);
+
+    callback->apiid = WM_APIID_START_PARENT;
+    callback->errcode = WM_ERRCODE_SUCCESS;
+    callback->state = WM_STATECODE_BEACON_SENT;
+    WMSP_ReturnResult2Wm9(callback);   // (lets the lock go)
 }
 

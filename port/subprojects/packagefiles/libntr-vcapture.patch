+
+// before the frame's 2D is drawn: the state, if the frame is chosen (the capture of DISPCAPCNT runs in the draw)
+extern "C" void SIM_VCapFrameBegin(void) {
+  sSnap.taken = false;
+  if (!On()) return;
+  u32 frame = *(u32 *)HW_VBLANK_COUNT_BUF;
+  if (!Wanted(frame)) return;
+  TakeSnapshot(frame);
+}
+
+// after both screens are drawn into the window's framebuffer (vx, vy, vw, vh: the screens' viewport there; fb3d, row3d:
+// the shown 3D frame's framebuffer and its rows for the main engine's screen at the internal resolution)
+// vertical: the window shows the screens top over bottom (the default layout, not swapped); else no LSHT pixels
+extern "C" void SIM_VCapFrameEnd(int vx, int vy, int vw, int vh, unsigned fb3d, int scale3d, int top3d, int vertical) {
+  if (!sSnap.taken) return;
+  Snapshot &s = sSnap;
+  s.taken = false;
+  GLint readFb;
+  glGetIntegerv(GL_READ_FRAMEBUFFER_BINDING, &readFb);
+  std::vector<u8> shot, l3d;
+  glBindFramebuffer(GL_READ_FRAMEBUFFER, 0);
+  if (vertical) {
+    ReadRegion(vx, vy, vw, vh, 256, 384, shot);
+  } else {
+    shot.assign(256 * 384 * 4, 0);
+    s.notes += "shot_layout_not_vertical ";
+  }
+  glBindFramebuffer(GL_READ_FRAMEBUFFER, fb3d);
+  ReadRegion(0, top3d ? 192 * scale3d : 0, 256 * scale3d, 192 * scale3d, 256, 192, l3d);
+  glBindFramebuffer(GL_READ_FRAMEBUFFER, readFb);
+
+  char path[1024];
+  snprintf(path, sizeof path, "%s/f%06u.vcs", sDir.c_str(), s.frame);
+  FILE *f = fopen(path, "wb");
+  if (f == NULL) {
+    fprintf(stderr, "bwport: BWPORT_VCAPTURE: can't write %s\n", path);
+    return;
+  }
+  u32 hdr[2] = {0x54534356u /* "VCST" */, 1};
+  fwrite(hdr, 4, 2, f);
+  char info[1024];
+  int n = snprintf(info, sizeof info,
+                   "source=bwport libntr\nformat=VCS_FORMAT.md v1\nframe=%u\nlibntr=%s\ng3_commands=%u\ng3_prologue=%u\n"
+                   "g3_swap_frame=%u\nshot=libntr window %dx%d (internal scale %d)\nl3d_screen=%s\nnotes=%s\n",
+                   s.frame, SIM_GetLibntrGitHash(), s.g3Commands, s.g3Prologue, s.g3SwapFrame, vw, vh, scale3d,
+                   top3d ? "top" : "bottom", s.notes.c_str());
+  Chunk(f, "INFO", info, (u32)n);
+  Chunk(f, "IO9 ", s.io9.data(), (u32)s.io9.size());
+  Chunk(f, "IO9B", s.io9b.data(), (u32)s.io9b.size());
+  Chunk(f, "VRAM", s.vram.data(), (u32)s.vram.size());
+  Chunk(f, "PLTT", s.pltt.data(), (u32)s.pltt.size());
+  Chunk(f, "OAM ", s.oam.data(), (u32)s.oam.size());
+  Chunk(f, "GX3D", s.g3.data(), (u32)(s.g3.size() * 4));
+  Chunk(f, "LSHT", shot.data(), (u32)shot.size());
+  Chunk(f, "L3D ", l3d.data(), (u32)l3d.size());
+  fclose(f);
+}

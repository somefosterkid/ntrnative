+// ---- the frame ----
+namespace {
+
+struct Snapshot {
+  bool taken = false;
+  u32 frame = 0;
+  std::vector<u8> io9, io9b, vram, pltt, oam;
+  std::vector<u32> g3;
+  u32 g3Commands = 0, g3Prologue = 0, g3SwapFrame = 0;
+  std::string notes;
+};
+static Snapshot sSnap;
+
+static bool Wanted(u32 frame) {
+  for (const Range &r : sFrames) {
+    if (frame >= r.a && frame <= r.b && (frame - r.a) % r.step == 0) return true;
+  }
+  return false;
+}
+
+template <typename T> static void Put(std::vector<u8> &io, u32 ofs, T v) { memcpy(&io[ofs], &v, sizeof(T)); }
+
+static void Emit(std::vector<u32> &out, u32 &count, u32 op, const u32 *p, u32 n) {
+  out.push_back(op | (n << 8) | (FLAG_PROLOGUE << 16));
+  for (u32 i = 0; i < n; i++) out.push_back(p[i]);
+  count++;
+}
+static void EmitMtx(std::vector<u32> &out, u32 &count, u32 mode, const Mtx &m) {
+  u32 md = mode;
+  Emit(out, count, G3OP_MTX_MODE, &md, 1);
+  Emit(out, count, G3OP_MTX_LOAD_4x4, (const u32 *)m.m, 16);
+}
+
+// commands that take a geometry engine from its reset state to s
+static void Prologue(const G3State &s, std::vector<u32> &out, u32 &count) {
+  u32 p[2];
+  for (int l = 0; l < 4; l++) {
+    if (s.lightVecSet & (1u << l)) {
+      EmitMtx(out, count, 2, s.lightVecMtx[l]);
+      Emit(out, count, G3OP_LIGHT_VECTOR, &s.lightVec[l], 1);
+    }
+    if (s.lightColorSet & (1u << l)) Emit(out, count, G3OP_LIGHT_COLOR, &s.lightColor[l], 1);
+  }
+  if (s.set & SET_SHIN) Emit(out, count, G3OP_SHININESS, s.shin, 32);
+  if (s.set & SET_DIFAMB) { p[0] = s.difAmb & ~0x8000u; Emit(out, count, G3OP_DIF_AMB, p, 1); }
+  if (s.set & SET_SPEEMI) Emit(out, count, G3OP_SPE_EMI, &s.speEmi, 1);
+  if (s.set & SET_TEX) Emit(out, count, G3OP_TEXIMAGE_PARAM, &s.texParam, 1);
+  if (s.set & SET_PLTT) Emit(out, count, G3OP_TEXPLTT_BASE, &s.plttBase, 1);
+  if (s.set & SET_POLY) Emit(out, count, G3OP_POLYGON_ATTR, &s.polyAttr, 1);
+  if (s.set & SET_VIEWPORT) Emit(out, count, G3OP_VIEWPORT, &s.viewport, 1);
+  if (s.set & SET_TEXCOORD) {
+    EmitMtx(out, count, 3, s.texcoordTex);
+    Emit(out, count, G3OP_TEXCOORD, &s.texcoord, 1);
+  }
+  if (s.lastColorSrc == 1) Emit(out, count, G3OP_COLOR, &s.color, 1);
+  else if (s.lastColorSrc == 2) Emit(out, count, G3OP_DIF_AMB, &s.difAmb, 1);
+  else if (s.lastColorSrc == 3) {
+    EmitMtx(out, count, 2, s.normalVec);
+    EmitMtx(out, count, 3, s.normalTex);
+    Emit(out, count, G3OP_NORMAL, &s.normal, 1);
+  }
+  if (s.vtxSet) {
+    // the last vertex, for a relative vertex command before the stream's first full one (POS_TEST sets it, as on the
+    // DS; its result registers are not part of the state)
+    p[0] = (u32)(u16)s.vtx[0] | ((u32)(u16)s.vtx[1] << 16);
+    p[1] = (u32)(u16)s.vtx[2];
+    Emit(out, count, G3OP_POS_TEST, p, 2);
+  }
+  // the stacks: their pointers by pushes, then each entry by a store
+  EmitMtx(out, count, 0, s.projStk);
+  if (s.projSP & 1) Emit(out, count, G3OP_MTX_PUSH, p, 0);
+  else { p[0] = 0; Emit(out, count, G3OP_MTX_STORE, p, 1); }
+  EmitMtx(out, count, 3, s.texStk);
+  if (s.texSP & 1) Emit(out, count, G3OP_MTX_PUSH, p, 0);
+  else { p[0] = 0; Emit(out, count, G3OP_MTX_STORE, p, 1); }
+  p[0] = 1;
+  Emit(out, count, G3OP_MTX_MODE, p, 1);
+  for (int i = 0; i < (s.posSP & 31); i++) Emit(out, count, G3OP_MTX_PUSH, p, 0);
+  for (int i = 0; i < 31; i++) {
+    if (!(s.posStkUsed & (1u << i))) continue;
+    EmitMtx(out, count, 2, s.vecStk[i]);
+    EmitMtx(out, count, 1, s.posStk[i]);
+    p[0] = (u32)i;
+    Emit(out, count, G3OP_MTX_STORE, p, 1);
+  }
+  EmitMtx(out, count, 0, s.proj);
+  EmitMtx(out, count, 3, s.tex);
+  EmitMtx(out, count, 2, s.vec);
+  EmitMtx(out, count, 1, s.pos);
+  p[0] = s.mode;
+  Emit(out, count, G3OP_MTX_MODE, p, 1);
+}
+
+static void TakeSnapshot(u32 frame) {
+  Snapshot &s = sSnap;
+  s = Snapshot();
+  s.taken = true;
+  s.frame = frame;
+  // engine A's registers and the system ones, as 0x04000000-0x040006FF
+  s.io9.assign(0x700, 0);
+  std::vector<u8> &io = s.io9;
+  Put<u32>(io, 0x000, s_reg_GX_DISPCNT);
+  Put<u16>(io, 0x004, s_reg_GX_DISPSTAT);
+  Put<u16>(io, 0x008, s_reg_G2_BG0CNT); Put<u16>(io, 0x00A, s_reg_G2_BG1CNT);
+  Put<u16>(io, 0x00C, s_reg_G2_BG2CNT); Put<u16>(io, 0x00E, s_reg_G2_BG3CNT);
+  // the scroll: libntr's 2D draws from the 32-bit BGxOFS variables (the 16-bit HOFS/VOFS ones are apart)
+  Put<u32>(io, 0x010, s_reg_G2_BG0OFS); Put<u32>(io, 0x014, s_reg_G2_BG1OFS);
+  Put<u32>(io, 0x018, s_reg_G2_BG2OFS); Put<u32>(io, 0x01C, s_reg_G2_BG3OFS);
+  Put<u16>(io, 0x020, s_reg_G2_BG2PA); Put<u16>(io, 0x022, s_reg_G2_BG2PB);
+  Put<u16>(io, 0x024, s_reg_G2_BG2PC); Put<u16>(io, 0x026, s_reg_G2_BG2PD);
+  Put<u32>(io, 0x028, s_reg_G2_BG2X); Put<u32>(io, 0x02C, s_reg_G2_BG2Y);
+  Put<u16>(io, 0x030, s_reg_G2_BG3PA); Put<u16>(io, 0x032, s_reg_G2_BG3PB);
+  Put<u16>(io, 0x034, s_reg_G2_BG3PC); Put<u16>(io, 0x036, s_reg_G2_BG3PD);
+  Put<u32>(io, 0x038, s_reg_G2_BG3X); Put<u32>(io, 0x03C, s_reg_G2_BG3Y);
+  Put<u16>(io, 0x040, s_reg_G2_WIN0H); Put<u16>(io, 0x042, s_reg_G2_WIN1H);
+  Put<u16>(io, 0x044, s_reg_G2_WIN0V); Put<u16>(io, 0x046, s_reg_G2_WIN1V);
+  Put<u16>(io, 0x048, s_reg_G2_WININ); Put<u16>(io, 0x04A, s_reg_G2_WINOUT);
+  Put<u16>(io, 0x04C, s_reg_G2_MOSAIC); Put<u16>(io, 0x050, s_reg_G2_BLDCNT);
+  Put<u16>(io, 0x052, s_reg_G2_BLDALPHA); Put<u16>(io, 0x054, s_reg_G2_BLDY);
+  Put<u16>(io, 0x060, s_reg_G3X_DISP3DCNT);
+  Put<u32>(io, 0x064, s_reg_GX_DISPCAPCNT);
+  Put<u16>(io, 0x06C, s_reg_GX_MASTER_BRIGHT);
+  Put<u8>(io, 0x240, s_reg_GX_VRAMCNT_A); Put<u8>(io, 0x241, s_reg_GX_VRAMCNT_B);
+  Put<u8>(io, 0x242, s_reg_GX_VRAMCNT_C); Put<u8>(io, 0x243, s_reg_GX_VRAMCNT_D);
+  Put<u8>(io, 0x244, s_reg_GX_VRAMCNT_E); Put<u8>(io, 0x245, s_reg_GX_VRAMCNT_F);
+  Put<u8>(io, 0x246, s_reg_GX_VRAMCNT_G); Put<u8>(io, 0x247, s_reg_GX_VRAMCNT_WRAM);
+  Put<u8>(io, 0x248, s_reg_GX_VRAMCNT_H); Put<u8>(io, 0x249, s_reg_GX_VRAMCNT_I);
+  Put<u16>(io, 0x304, s_reg_GX_POWCNT);
+  Put<u16>(io, 0x320, s_reg_G3X_RDLINES_COUNT);
+  // the tables: the SDK copies them over the register variables from the first one (G3X_SetEdgeColorTable,
+  // G3X_SetFogTable, G3X_SetToonTable), so they are read back from there
+  memcpy(&io[0x330], (const void *)&s_reg_G3X_EDGE_COLOR_0_L, 16);
+  Put<u16>(io, 0x340, s_reg_G3X_ALPHA_TEST_REF);
+  Put<u32>(io, 0x350, s_reg_G3X_CLEAR_COLOR);
+  Put<u16>(io, 0x354, s_reg_G3X_CLEAR_DEPTH);
+  Put<u16>(io, 0x356, s_reg_G3X_CLRIMAGE_OFFSET);
+  Put<u32>(io, 0x358, s_reg_G3X_FOG_COLOR);
+  Put<u16>(io, 0x35C, s_reg_G3X_FOG_OFFSET);
+  memcpy(&io[0x360], (const void *)&s_reg_G3X_FOG_TABLE_0, 32);
+  memcpy(&io[0x380], (const void *)&s_reg_G3X_TOON_TABLE_0_L, 64);
+  Put<u16>(io, 0x610, s_reg_G3X_DISP_1DOT_DEPTH);
+  // engine B, 0x04001000-0x0400106F
+  s.io9b.assign(0x70, 0);
+  std::vector<u8> &ib = s.io9b;
+  Put<u32>(ib, 0x000, s_reg_GXS_DB_DISPCNT);
+  Put<u16>(ib, 0x008, s_reg_G2S_DB_BG0CNT); Put<u16>(ib, 0x00A, s_reg_G2S_DB_BG1CNT);
+  Put<u16>(ib, 0x00C, s_reg_G2S_DB_BG2CNT); Put<u16>(ib, 0x00E, s_reg_G2S_DB_BG3CNT);
+  Put<u32>(ib, 0x010, s_reg_G2S_DB_BG0OFS); Put<u32>(ib, 0x014, s_reg_G2S_DB_BG1OFS);
+  Put<u32>(ib, 0x018, s_reg_G2S_DB_BG2OFS); Put<u32>(ib, 0x01C, s_reg_G2S_DB_BG3OFS);
+  Put<u16>(ib, 0x020, s_reg_G2S_DB_BG2PA); Put<u16>(ib, 0x022, s_reg_G2S_DB_BG2PB);
+  Put<u16>(ib, 0x024, s_reg_G2S_DB_BG2PC); Put<u16>(ib, 0x026, s_reg_G2S_DB_BG2PD);
+  Put<u32>(ib, 0x028, s_reg_G2S_DB_BG2X); Put<u32>(ib, 0x02C, s_reg_G2S_DB_BG2Y);
+  Put<u16>(ib, 0x030, s_reg_G2S_DB_BG3PA); Put<u16>(ib, 0x032, s_reg_G2S_DB_BG3PB);
+  Put<u16>(ib, 0x034, s_reg_G2S_DB_BG3PC); Put<u16>(ib, 0x036, s_reg_G2S_DB_BG3PD);
+  Put<u32>(ib, 0x038, s_reg_G2S_DB_BG3X); Put<u32>(ib, 0x03C, s_reg_G2S_DB_BG3Y);
+  Put<u16>(ib, 0x040, s_reg_G2S_DB_WIN0H); Put<u16>(ib, 0x042, s_reg_G2S_DB_WIN1H);
+  Put<u16>(ib, 0x044, s_reg_G2S_DB_WIN0V); Put<u16>(ib, 0x046, s_reg_G2S_DB_WIN1V);
+  Put<u16>(ib, 0x048, s_reg_G2S_DB_WININ); Put<u16>(ib, 0x04A, s_reg_G2S_DB_WINOUT);
+  Put<u16>(ib, 0x04C, s_reg_G2S_DB_MOSAIC); Put<u16>(ib, 0x050, s_reg_G2S_DB_BLDCNT);
+  Put<u16>(ib, 0x052, s_reg_G2S_DB_BLDALPHA); Put<u16>(ib, 0x054, s_reg_G2S_DB_BLDY);
+  Put<u16>(ib, 0x06C, s_reg_GXS_DB_MASTER_BRIGHT);
+  // the banks, each from where its data is now (libntr-vram.patch)
+  static const u32 kBankSize[9] = {0x20000, 0x20000, 0x20000, 0x20000, 0x10000, 0x4000, 0x4000, 0x8000, 0x4000};
+  for (int b = 0; b < 9; b++) {
+    const u8 *home = GXi_SimVramBankHome(b);
+    s.vram.insert(s.vram.end(), home, home + kBankSize[b]);
+  }
+  s.pltt.insert(s.pltt.end(), s_HW_BG_PLTT, s_HW_BG_PLTT + 0x200);
+  s.pltt.insert(s.pltt.end(), s_HW_OBJ_PLTT, s_HW_OBJ_PLTT + 0x200);
+  s.pltt.insert(s.pltt.end(), s_HW_DB_BG_PLTT, s_HW_DB_BG_PLTT + 0x200);
+  s.pltt.insert(s.pltt.end(), s_HW_DB_OBJ_PLTT, s_HW_DB_OBJ_PLTT + 0x200);
+  s.oam.insert(s.oam.end(), s_HW_OAM, s_HW_OAM + 0x400);
+  s.oam.insert(s.oam.end(), s_HW_DB_OAM, s_HW_DB_OAM + 0x400);
+  // the 3D: the last complete stream (the frame the 3D layer shows), its prologue first
+  G3State st;
+  const Stream *src = sDoneValid ? &sDone : NULL;
+  if (src != NULL) st = src->start;
+  else G3Reset(st);
+  Prologue(st, s.g3, s.g3Prologue);
+  s.g3Commands = s.g3Prologue;
+  if (src != NULL) {
+    s.g3.insert(s.g3.end(), src->words.begin(), src->words.end());
+    s.g3Commands += src->commands;
+    s.g3SwapFrame = src->swapFrame;
+  } else {
+    s.notes += "no_swap_yet ";
+  }
+  // notes for the readers
+  if ((s_reg_G2_BG0HOFS | s_reg_G2_BG0VOFS | s_reg_G2_BG1HOFS | s_reg_G2_BG1VOFS | s_reg_G2_BG2HOFS |
+       s_reg_G2_BG2VOFS | s_reg_G2_BG3HOFS | s_reg_G2_BG3VOFS) != 0)
+    s.notes += "main_16bit_scroll_written ";
+  if (((s_reg_GX_DISPCNT >> 16) & 3) == 3) s.notes += "main_memory_display_not_captured ";
+}
+
+static void Chunk(FILE *f, const char *tag, const void *data, u32 size) {
+  fwrite(tag, 1, 4, f);
+  fwrite(&size, 4, 1, f);
+  if (size) fwrite(data, 1, size, f);
+  static const u8 pad[4] = {0, 0, 0, 0};
+  if (size & 3) fwrite(pad, 1, 4 - (size & 3), f);
+}
+
+// a GL framebuffer region scaled to w x h by its pixels' centres, rows top first, RGBA8
+static void ReadRegion(int x, int y, int rw, int rh, int w, int h, std::vector<u8> &out) {
+  std::vector<u8> px((size_t)rw * rh * 4);
+  glPixelStorei(GL_PACK_ALIGNMENT, 1);
+  glReadPixels(x, y, rw, rh, GL_RGBA, GL_UNSIGNED_BYTE, px.data());
+  out.resize((size_t)w * h * 4);
+  for (int j = 0; j < h; j++) {
+    int sy = rh - 1 - (int)(((2 * j + 1) * (long)rh) / (2 * h)); // GL rows go up
+    for (int i = 0; i < w; i++) {
+      int sx = (int)(((2 * i + 1) * (long)rw) / (2 * w));
+      memcpy(&out[((size_t)j * w + i) * 4], &px[((size_t)sy * rw + sx) * 4], 4);
+    }
+  }
+}

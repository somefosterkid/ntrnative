+// bw-port: the frame-state capture (BWPORT_VCAPTURE=DIR,FRAMES): the full video state of chosen frames in the
+// VCoreState file format of bw-port's port/vcore (docs/vcore.md): the video registers as the DS's I/O map, the VRAM
+// banks A-I as their own memories (libntr-vram.patch keeps a mapped bank in the BG/OBJ arrays: each bank is read from
+// its home), the palette RAM, OAM, the 3D geometry commands of the frame the 3D layer shows (as the DS's FIFO takes
+// them: the immediate G3_* calls, MI_SendGXCommand's lists as their raw words, the register writes libntr catches up)
+// after a prologue that rebuilds the geometry engine's state at the stream's start (matrices and stacks, lights,
+// materials), and libntr's own picture of the frame. FRAMES: N, A-B or A-B/STEP, comma-separated (OS_GetVBlankCount's
+// frames, as BWPORT_KEYS); files DIR/fNNNNNN.vcs. Off (one flag test per command) unless the variable is set.
+// The format: <ref>/VCS_FORMAT.md (bw-port's docs/vcore.md).
+// The hooks: SIM_VCapMsg at the top of the command processor's HandleCommandMessage, SIM_VCapList for a raw list
+// (DRAW_CMD_G3_CMD_LIST, G3_Direct2/3) with SIM_VCapSuppress around its decoding, SIM_VCapFrameBegin/End around
+// SIM_Render's drawing of the two screens, GXi_SimVramBankHome (gx_vramcnt.c) for the banks.
+#include <simulator/sim_opengl.h>
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <string>
+#include <vector>
+
+#include <nitro/gx/g3.h>
+#include <nitro/hw/X86/mmap_shared.h>
+#include <simulator/drawmsg.h>
+#include <simulator/simvariables.h>
+#include <simulator/config/sim_config.h>
+#include <simulator/sim.h>
+
+extern "C" const u8 *GXi_SimVramBankHome(int bank);
+
+namespace {
+
+// ---- the geometry engine's persistent state, followed command by command (GBATEK "DS 3D Matrix ...") ----
+struct Mtx {
+  s32 m[16]; // row-major, 20.12 fixed point, as the commands send them
+};
+
+static Mtx Identity() {
+  Mtx r;
+  memset(&r, 0, sizeof r);
+  r.m[0] = r.m[5] = r.m[10] = r.m[15] = 0x1000;
+  return r;
+}
+
+// C = M * C (the parameter matrix on the left), 64-bit sums >> 12
+static void MulInto(Mtx &c, const Mtx &mm) {
+  Mtx r;
+  for (int i = 0; i < 4; i++) {
+    for (int j = 0; j < 4; j++) {
+      s64 s = 0;
+      for (int k = 0; k < 4; k++) s += (s64)mm.m[i * 4 + k] * c.m[k * 4 + j];
+      r.m[i * 4 + j] = (s32)(s >> 12);
+    }
+  }
+  c = r;
+}
+
+struct G3State {
+  u32 mode;
+  Mtx proj, pos, vec, tex;
+  Mtx projStk, texStk, posStk[32], vecStk[32];
+  u32 posStkUsed; // the entries ever written
+  int projSP, posSP, texSP;
+  u32 lightVec[4], lightColor[4];
+  Mtx lightVecMtx[4];
+  u32 lightVecSet, lightColorSet;
+  u32 difAmb, speEmi, polyAttr, texParam, plttBase, viewport, color, normal, texcoord;
+  u32 set; // bits: SET_*
+  Mtx normalVec, normalTex, texcoordTex;
+  int lastColorSrc; // 0 none, 1 COLOR, 2 DIF_AMB bit 15, 3 NORMAL
+  u32 shin[32];
+  s16 vtx[3]; // the last vertex (VTX_XY/XZ/YZ/DIFF are relative to it; POS_TEST sets it too)
+  bool vtxSet;
+};
+enum { SET_DIFAMB = 1, SET_SPEEMI = 2, SET_POLY = 4, SET_TEX = 8, SET_PLTT = 16, SET_VIEWPORT = 32, SET_TEXCOORD = 64,
+       SET_SHIN = 128 };
+
+static G3State sG3;
+
+static void G3Reset(G3State &g) {
+  memset(&g, 0, sizeof g);
+  g.proj = g.pos = g.vec = g.tex = g.projStk = g.texStk = Identity();
+  for (int i = 0; i < 32; i++) g.posStk[i] = g.vecStk[i] = Identity();
+}
+
+static Mtx ParamMtx(const u32 *p, int rows, int cols) {
+  // 4x4, 4x3 (rows 0-3, column 3 = 0,0,0,1) or 3x3 (row 3 = 0,0,0,1)
+  Mtx r = Identity();
+  for (int i = 0; i < rows; i++) {
+    for (int j = 0; j < cols; j++) r.m[i * 4 + j] = (s32)p[i * cols + j];
+    if (cols == 3) r.m[i * 4 + 3] = (i == 3) ? 0x1000 : 0;
+  }
+  return r;
+}
+
+static void G3Apply(G3State &g, u32 op, const u32 *p) {
+  switch (op) {
+  case G3OP_MTX_MODE: g.mode = p[0] & 3; break;
+  case G3OP_MTX_PUSH:
+    if (g.mode == 0) { g.projStk = g.proj; g.projSP = (g.projSP + 1) & 1; }
+    else if (g.mode == 3) { g.texStk = g.tex; g.texSP = (g.texSP + 1) & 1; }
+    else { int i = g.posSP & 31; g.posStk[i] = g.pos; g.vecStk[i] = g.vec; g.posStkUsed |= 1u << i; g.posSP = (g.posSP + 1) & 63; }
+    break;
+  case G3OP_MTX_POP:
+    if (g.mode == 0) { g.projSP = (g.projSP - 1) & 1; g.proj = g.projStk; }
+    else if (g.mode == 3) { g.texSP = (g.texSP - 1) & 1; g.tex = g.texStk; }
+    else {
+      int n = (s8)(u8)((p[0] & 0x3F) << 2) >> 2;
+      g.posSP = (g.posSP - n) & 63;
+      g.pos = g.posStk[g.posSP & 31];
+      g.vec = g.vecStk[g.posSP & 31];
+    }
+    break;
+  case G3OP_MTX_STORE:
+    if (g.mode == 0) g.projStk = g.proj;
+    else if (g.mode == 3) g.texStk = g.tex;
+    else { int i = p[0] & 31; g.posStk[i] = g.pos; g.vecStk[i] = g.vec; g.posStkUsed |= 1u << i; }
+    break;
+  case G3OP_MTX_RESTORE:
+    if (g.mode == 0) g.proj = g.projStk;
+    else if (g.mode == 3) g.tex = g.texStk;
+    else { int i = p[0] & 31; g.pos = g.posStk[i]; g.vec = g.vecStk[i]; }
+    break;
+  case G3OP_MTX_IDENTITY:
+  case G3OP_MTX_LOAD_4x4:
+  case G3OP_MTX_LOAD_4x3: {
+    Mtx m = op == G3OP_MTX_IDENTITY ? Identity() : ParamMtx(p, op == G3OP_MTX_LOAD_4x4 ? 4 : 4, op == G3OP_MTX_LOAD_4x4 ? 4 : 3);
+    if (g.mode == 0) g.proj = m;
+    else if (g.mode == 1) g.pos = m;
+    else if (g.mode == 2) g.pos = g.vec = m;
+    else g.tex = m;
+  } break;
+  case G3OP_MTX_MULT_4x4:
+  case G3OP_MTX_MULT_4x3:
+  case G3OP_MTX_MULT_3x3: {
+    Mtx m = ParamMtx(p, op == G3OP_MTX_MULT_3x3 ? 3 : 4, op == G3OP_MTX_MULT_4x4 ? 4 : 3);
+    if (g.mode == 0) MulInto(g.proj, m);
+    else if (g.mode == 1) MulInto(g.pos, m);
+    else if (g.mode == 2) { MulInto(g.pos, m); MulInto(g.vec, m); }
+    else MulInto(g.tex, m);
+  } break;
+  case G3OP_MTX_SCALE:
+  case G3OP_MTX_TRANS: {
+    Mtx m = Identity();
+    if (op == G3OP_MTX_SCALE) { m.m[0] = (s32)p[0]; m.m[5] = (s32)p[1]; m.m[10] = (s32)p[2]; }
+    else { m.m[12] = (s32)p[0]; m.m[13] = (s32)p[1]; m.m[14] = (s32)p[2]; }
+    if (g.mode == 0) MulInto(g.proj, m);
+    else if (g.mode == 1) MulInto(g.pos, m);
+    else if (g.mode == 2) { MulInto(g.pos, m); if (op == G3OP_MTX_TRANS) MulInto(g.vec, m); }
+    else MulInto(g.tex, m);
+  } break;
+  case G3OP_COLOR: g.color = p[0]; g.lastColorSrc = 1; break;
+  case G3OP_NORMAL: g.normal = p[0]; g.normalVec = g.vec; g.normalTex = g.tex; g.lastColorSrc = 3; break;
+  case G3OP_TEXCOORD: g.texcoord = p[0]; g.texcoordTex = g.tex; g.set |= SET_TEXCOORD; break;
+  case G3OP_POLYGON_ATTR: g.polyAttr = p[0]; g.set |= SET_POLY; break;
+  case G3OP_TEXIMAGE_PARAM: g.texParam = p[0]; g.set |= SET_TEX; break;
+  case G3OP_TEXPLTT_BASE: g.plttBase = p[0]; g.set |= SET_PLTT; break;
+  case G3OP_DIF_AMB: g.difAmb = p[0]; g.set |= SET_DIFAMB; if (p[0] & 0x8000) g.lastColorSrc = 2; break;
+  case G3OP_SPE_EMI: g.speEmi = p[0]; g.set |= SET_SPEEMI; break;
+  case G3OP_LIGHT_VECTOR: { int l = p[0] >> 30; g.lightVec[l] = p[0]; g.lightVecMtx[l] = g.vec; g.lightVecSet |= 1u << l; } break;
+  case G3OP_LIGHT_COLOR: { int l = p[0] >> 30; g.lightColor[l] = p[0]; g.lightColorSet |= 1u << l; } break;
+  case G3OP_SHININESS: memcpy(g.shin, p, sizeof g.shin); g.set |= SET_SHIN; break;
+  case G3OP_VIEWPORT: g.viewport = p[0]; g.set |= SET_VIEWPORT; break;
+  case G3OP_VTX_16:
+  case G3OP_POS_TEST:
+    g.vtx[0] = (s16)(p[0] & 0xFFFF); g.vtx[1] = (s16)(p[0] >> 16); g.vtx[2] = (s16)(p[1] & 0xFFFF); g.vtxSet = true;
+    break;
+  case G3OP_VTX_10:
+    g.vtx[0] = (s16)((p[0] & 0x3FF) << 6); g.vtx[1] = (s16)(((p[0] >> 10) & 0x3FF) << 6);
+    g.vtx[2] = (s16)(((p[0] >> 20) & 0x3FF) << 6); g.vtxSet = true;
+    break;
+  case G3OP_VTX_XY: g.vtx[0] = (s16)(p[0] & 0xFFFF); g.vtx[1] = (s16)(p[0] >> 16); g.vtxSet = true; break;
+  case G3OP_VTX_XZ: g.vtx[0] = (s16)(p[0] & 0xFFFF); g.vtx[2] = (s16)(p[0] >> 16); g.vtxSet = true; break;
+  case G3OP_VTX_YZ: g.vtx[1] = (s16)(p[0] & 0xFFFF); g.vtx[2] = (s16)(p[0] >> 16); g.vtxSet = true; break;
+  case G3OP_VTX_DIFF:
+    // 10-bit signed offsets added to the last vertex's 4.12 coordinates (as libntr's VTXDIFF does)
+    g.vtx[0] = (s16)(g.vtx[0] + ((s16)((p[0] & 0x3FF) << 6) >> 6));
+    g.vtx[1] = (s16)(g.vtx[1] + ((s16)(((p[0] >> 10) & 0x3FF) << 6) >> 6));
+    g.vtx[2] = (s16)(g.vtx[2] + ((s16)(((p[0] >> 20) & 0x3FF) << 6) >> 6));
+    g.vtxSet = true;
+    break;
+  default: break;
+  }
+}
+
+// ---- the command streams ----
+// An entry: a header word op | nparams << 8 | flags << 16, then the parameters
+enum { FLAG_PROLOGUE = 1, FLAG_LIST = 2, FLAG_REG = 4 };
+
+static int NumParams(u32 op) {
+  switch (op) {
+  case G3OP_MTX_MODE: case G3OP_MTX_POP: case G3OP_MTX_STORE: case G3OP_MTX_RESTORE: return 1;
+  case G3OP_MTX_LOAD_4x4: case G3OP_MTX_MULT_4x4: return 16;
+  case G3OP_MTX_LOAD_4x3: case G3OP_MTX_MULT_4x3: return 12;
+  case G3OP_MTX_MULT_3x3: return 9;
+  case G3OP_MTX_SCALE: case G3OP_MTX_TRANS: return 3;
+  case G3OP_COLOR: case G3OP_NORMAL: case G3OP_TEXCOORD: return 1;
+  case G3OP_VTX_16: return 2;
+  case G3OP_VTX_10: case G3OP_VTX_XY: case G3OP_VTX_XZ: case G3OP_VTX_YZ: case G3OP_VTX_DIFF: return 1;
+  case G3OP_POLYGON_ATTR: case G3OP_TEXIMAGE_PARAM: case G3OP_TEXPLTT_BASE: return 1;
+  case G3OP_DIF_AMB: case G3OP_SPE_EMI: case G3OP_LIGHT_VECTOR: case G3OP_LIGHT_COLOR: return 1;
+  case G3OP_SHININESS: return 32;
+  case G3OP_BEGIN: return 1;
+  case G3OP_SWAP_BUFFERS: case G3OP_VIEWPORT: return 1;
+  case G3OP_BOX_TEST: return 3;
+  case G3OP_POS_TEST: return 2;
+  case G3OP_VEC_TEST: return 1;
+  default: return 0; // NOP, PUSH, IDENTITY, END, unknown
+  }
+}
+
+struct Stream {
+  G3State start; // the engine's state when the stream began
+  std::vector<u32> words;
+  u32 commands = 0;
+  u32 swapFrame = 0; // the V-blank count when its SWAP_BUFFERS came
+};
+
+static int sEnabled = -1; // -1: not looked at yet
+static std::string sDir;
+struct Range { u32 a, b, step; };
+static std::vector<Range> sFrames;
+static Stream sCur, sDone;
+static bool sDoneValid;
+static int sSuppress;
+static bool sSkipVtx16; // the VTX16 libntr makes of a VTX_10/XY/XZ/YZ/DIFF it was given
+static u32 sLastNormal, sLastTexcoord; // the last NORMAL / TEXCOORD recorded
+
+static void ParseEnv() {
+  const char *e = getenv("BWPORT_VCAPTURE");
+  sEnabled = 0;
+  if (e == NULL || !*e) return;
+  std::string s(e);
+  size_t c = s.find(',');
+  sDir = s.substr(0, c);
+  std::string rest = c == std::string::npos ? "" : s.substr(c + 1);
+  size_t at = 0;
+  while (at < rest.size()) {
+    size_t n = rest.find(',', at);
+    std::string tok = rest.substr(at, n == std::string::npos ? std::string::npos : n - at);
+    at = n == std::string::npos ? rest.size() : n + 1;
+    if (tok.empty()) continue;
+    Range r;
+    unsigned a = 0, b = 0, st = 1;
+    if (sscanf(tok.c_str(), "%u-%u/%u", &a, &b, &st) == 3 || sscanf(tok.c_str(), "%u-%u", &a, &b) == 2) {
+      r.a = a; r.b = b; r.step = st ? st : 1;
+    } else {
+      r.a = r.b = (u32)strtoul(tok.c_str(), NULL, 10); r.step = 1;
+    }
+    sFrames.push_back(r);
+  }
+  G3Reset(sG3);
+  sCur.start = sG3;
+  sEnabled = 1;
+  fprintf(stderr, "bwport: BWPORT_VCAPTURE: %zu frame ranges into %s\n", sFrames.size(), sDir.c_str());
+}
+
+static inline bool On() {
+  if (sEnabled < 0) ParseEnv();
+  return sEnabled > 0;
+}
+
+static void Record(u32 op, const u32 *p, u32 n, u32 flags) {
+  if (sCur.words.size() > (1u << 24)) {
+    // 64 MB of commands with no SWAP_BUFFERS (tests only, never drawn): start again from the state here
+    sCur = Stream();
+    sCur.start = sG3;
+  }
+  sCur.words.push_back(op | (n << 8) | (flags << 16));
+  for (u32 i = 0; i < n; i++) sCur.words.push_back(p[i]);
+  sCur.commands++;
+  if (n < (u32)NumParams(op)) return; // a list cut short: the command is kept as it came, the state not followed
+  if (op == G3OP_NORMAL) sLastNormal = p[0];
+  if (op == G3OP_TEXCOORD) sLastTexcoord = p[0];
+  G3Apply(sG3, op, p);
+  if (op == G3OP_SWAP_BUFFERS) {
+    sCur.swapFrame = *(u32 *)HW_VBLANK_COUNT_BUF;
+    sDone = std::move(sCur);
+    sDoneValid = true;
+    sCur = Stream();
+    sCur.start = sG3;
+  }
+}
+
+static u32 Pack16(s32 a, s32 b) { return (u32)(u16)a | ((u32)(u16)b << 16); }
+
+} // namespace
+
+// ---- the hooks ----
+// the TEXCOORD / NORMAL registers the game wrote itself (reg_G3_TEXCOORD = st: mcss.c's sprite quads), which on the DS
+// were commands when written; libntr catches them up before a vertex (libntr-g3regs.patch), and so do we, before it
+static void CatchUpRegs() {
+  u32 t = s_reg_G3_TEXCOORD, nn = s_reg_G3_NORMAL;
+  if (t != sLastTexcoord) Record(G3OP_TEXCOORD, &t, 1, FLAG_REG);
+  if (nn != sLastNormal) Record(G3OP_NORMAL, &nn, 1, FLAG_REG);
+}
+
+extern "C" void SIM_VCapSuppress(int delta) {
+  if (sEnabled > 0) sSuppress += delta;
+}
+
+// a raw command list (packed command words, then each command's parameters), as MI_SendGXCommand sends it; its
+// commands are recorded with the parameter counts libntr's list parser (RunCommandList) gives them
+extern "C" void SIM_VCapList(const void *data, u32 bytes) {
+  if (!On() || sSuppress) return;
+  // libntr catches the registers up at the list's first vertex; a TEXCOORD the list sends before it overrides ours
+  CatchUpRegs();
+  const u32 *w = (const u32 *)data;
+  u32 nw = bytes / 4, i = 0;
+  while (i < nw) {
+    u32 cmds = w[i++];
+    for (int k = 0; k < 4; k++) {
+      u32 op = (cmds >> (8 * k)) & 0xFF;
+      u32 n = NumParams(op);
+      if (op == 0) continue;
+      if (i + n > nw) n = nw - i;
+      Record(op, w + i, n, FLAG_LIST);
+      i += n;
+    }
+  }
+}
+
+// a libntr draw message, before libntr runs it
+extern "C" void SIM_VCapMsg(const draw_msg_t *msg) {
+  if (!On() || sSuppress) return;
+  u32 p[16];
+  const draw_msg_data_t &d = msg->data;
+  switch (msg->type) {
+  case DRAW_CMD_G3_MTXMODE: p[0] = d.numU8; Record(G3OP_MTX_MODE, p, 1, 0); break;
+  case DRAW_CMD_G3_PUSHMTX: Record(G3OP_MTX_PUSH, p, 0, 0); break;
+  case DRAW_CMD_G3_POPMTX: p[0] = d.numU8 & 0x3F; Record(G3OP_MTX_POP, p, 1, 0); break;
+  case DRAW_CMD_G3_STOREMTX: p[0] = d.numU8 & 0x1F; Record(G3OP_MTX_STORE, p, 1, 0); break;
+  case DRAW_CMD_G3_RESTOREMTX: p[0] = d.numU8 & 0x1F; Record(G3OP_MTX_RESTORE, p, 1, 0); break;
+  case DRAW_CMD_G3_IDENTITY: Record(G3OP_MTX_IDENTITY, p, 0, 0); break;
+  case DRAW_CMD_G3_LOADMTX44: Record(G3OP_MTX_LOAD_4x4, (const u32 *)&d.mtx44, 16, 0); break;
+  case DRAW_CMD_G3_LOADMTX43: Record(G3OP_MTX_LOAD_4x3, (const u32 *)&d.mtx43, 12, 0); break;
+  case DRAW_CMD_G3_MTXMULT44: Record(G3OP_MTX_MULT_4x4, (const u32 *)&d.mtx44, 16, 0); break;
+  case DRAW_CMD_G3_MTXMULT43: Record(G3OP_MTX_MULT_4x3, (const u32 *)&d.mtx43, 12, 0); break;
+  case DRAW_CMD_G3_MTXMULT33: Record(G3OP_MTX_MULT_3x3, (const u32 *)&d.mtx33, 9, 0); break;
+  case DRAW_CMD_G3_SCALE: Record(G3OP_MTX_SCALE, (const u32 *)d.scale, 3, 0); break;
+  case DRAW_CMD_G3_TRANSLATE: Record(G3OP_MTX_TRANS, (const u32 *)d.scale, 3, 0); break;
+  case DRAW_CMD_G3_COLOR: p[0] = d.numU16; Record(G3OP_COLOR, p, 1, 0); break;
+  case DRAW_CMD_G3_NORMAL: p[0] = d.numU32; Record(G3OP_NORMAL, p, 1, 0); break;
+  case DRAW_CMD_G3_TEXCOORD: p[0] = d.numU32; Record(G3OP_TEXCOORD, p, 1, 0); break;
+  case DRAW_CMD_G3_VTX16: // (DRAW_CMD_G3_VTX: no handler in libntr, nothing makes one)
+    if (sSkipVtx16) { sSkipVtx16 = false; break; }
+    CatchUpRegs();
+    p[0] = Pack16(d.xyz.x, d.xyz.y); p[1] = (u32)(u16)d.xyz.z; Record(G3OP_VTX_16, p, 2, 0);
+    break;
+  case DRAW_CMD_G3_VTX10: CatchUpRegs(); p[0] = d.numU32; Record(G3OP_VTX_10, p, 1, 0); sSkipVtx16 = true; break;
+  case DRAW_CMD_G3_VTXXY: CatchUpRegs(); p[0] = d.numU32; Record(G3OP_VTX_XY, p, 1, 0); sSkipVtx16 = true; break;
+  case DRAW_CMD_G3_VTXXZ: CatchUpRegs(); p[0] = d.numU32; Record(G3OP_VTX_XZ, p, 1, 0); sSkipVtx16 = true; break;
+  case DRAW_CMD_G3_VTXYZ: CatchUpRegs(); p[0] = d.numU32; Record(G3OP_VTX_YZ, p, 1, 0); sSkipVtx16 = true; break;
+  case DRAW_CMD_G3_VTXDIFF: CatchUpRegs(); p[0] = d.numU32; Record(G3OP_VTX_DIFF, p, 1, 0); sSkipVtx16 = true; break;
+  case DRAW_CMD_G3_POLYGONATTR: p[0] = d.numU32; Record(G3OP_POLYGON_ATTR, p, 1, 0); break;
+  case DRAW_CMD_G3_TEXIMAGEPARAM: p[0] = d.numU32; Record(G3OP_TEXIMAGE_PARAM, p, 1, 0); break;
+  case DRAW_CMD_G3_TEXPLTTBASE: p[0] = d.numU32; Record(G3OP_TEXPLTT_BASE, p, 1, 0); break;
+  case DRAW_CMD_G3_DIFF_AMB: p[0] = d.numU32; Record(G3OP_DIF_AMB, p, 1, 0); break;
+  case DRAW_CMD_G3_SPEC_EMI: p[0] = d.numU32; Record(G3OP_SPE_EMI, p, 1, 0); break;
+  case DRAW_CMD_G3_LIGHTVECTOR: p[0] = d.numU32; Record(G3OP_LIGHT_VECTOR, p, 1, 0); break;
+  case DRAW_CMD_G3_LIGHTCOLOR: p[0] = d.numU32; Record(G3OP_LIGHT_COLOR, p, 1, 0); break;
+  case DRAW_CMD_G3_BEGIN: p[0] = d.numU8 & 3; Record(G3OP_BEGIN, p, 1, 0); break;
+  case DRAW_CMD_G3_END: Record(G3OP_END, p, 0, 0); break;
+  case DRAW_CMD_G3_SWAPBUFFERS: p[0] = d.numU32; Record(G3OP_SWAP_BUFFERS, p, 1, 0); break;
+  case DRAW_CMD_G3_VIEWPORT: p[0] = d.numU32; Record(G3OP_VIEWPORT, p, 1, 0); break;
+  case DRAW_CMD_G3_BOXTEST:
+    p[0] = Pack16(d.boxtest.x, d.boxtest.y);
+    p[1] = Pack16(d.boxtest.z, d.boxtest.width);
+    p[2] = Pack16(d.boxtest.height, d.boxtest.depth);
+    Record(G3OP_BOX_TEST, p, 3, 0);
+    break;
+  case DRAW_CMD_G3_POSITIONTEST:
+    p[0] = Pack16(d.xyz.x, d.xyz.y); p[1] = (u32)(u16)d.xyz.z; Record(G3OP_POS_TEST, p, 2, 0);
+    break;
+  case DRAW_CMD_G3_VECTORTEST: p[0] = d.numU32; Record(G3OP_VEC_TEST, p, 1, 0); break;
+  case DRAW_CMD_G3_SHININESS: Record(G3OP_SHININESS, d.numsU32, 32, 0); break;
+  // DIRECT0/1 (their decoded command comes back here), CMD_LIST and DIRECT2/3 (SIM_VCapList), NOP, DUMMY
+  default: break;
+  }
+}

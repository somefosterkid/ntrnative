+// ---- bw-port (libntr-mu83.patch): the music bus ----
+// With the backend's music bus split off (Speed > 1 or fast forward, Music at normal speed) the samples RingPush gets hold no
+// music: the music players run on a clock of their own and the backend makes their frames as the output needs them. Every
+// output frame the ring takes gets the next music frame added (the music is never stretched), so the music plays in real
+// time whatever the game does: a frame the ring drops (Space, Tab: the game runs faster than the device plays) takes no
+// music frame with it. MusNeed tops the FIFO up to what the loop that follows plays (that is exact when nothing is
+// dropped: no music frame is made and left unplayed).
+#define MUS_MAX 4096
+static s16 s_mus[MUS_MAX][2];
+static int s_musN = 0, s_musRd = 0;
+
+static void MusNeed(int aN)
+{
+    if(!s_split || aN <= 0) {
+        s_musN = 0;
+        s_musRd = 0;
+        return;
+    }
+    int have = s_musN - s_musRd;
+    if(have >= aN) {
+        return;
+    }
+    if(s_musRd > 0) {
+        memmove(&s_mus[0][0], &s_mus[s_musRd][0], (size_t)have * sizeof s_mus[0]);
+        s_musN = have;
+        s_musRd = 0;
+    }
+    int want = aN - have;
+    if(have + want > MUS_MAX) {
+        want = MUS_MAX - have;
+    }
+    s_musN += SIM_soundBackend->busRun(&s_mus[have][0], want);
+}
+
+static void RingOutM(s16 l, s16 r)
+{
+    if(s_split && s_ringWr - s_ringRd < SND_RING - 1) { // the ring takes this frame: its music frame goes with it
+        if(s_musRd >= s_musN) {
+            MusNeed(1);
+        }
+        if(s_musRd < s_musN) {
+            l = (s16)ClampS16((s32)l + s_mus[s_musRd][0]);
+            r = (s16)ClampS16((s32)r + s_mus[s_musRd][1]);
+            s_musRd++;
+        }
+    }
+    RingOut(l, r);
+}

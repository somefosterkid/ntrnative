diff --git a/include/sim_host_section.h b/include/sim_host_section.h
--- a/include/sim_host_section.h
+++ b/include/sim_host_section.h
@@ -1,4 +1,4 @@
 /* bw-port (libntr-ios-reset.patch): libsim's C files are the host's (GL loader, config, queues ...): back to the
  * default sections after sim_machine_section.h. sim_vars.c (the DS's memory and registers) sets the machine sections
- * again itself. */
-#pragma clang section data = "" bss = ""
+ * again itself. libntr-ios-romfill.patch: their read-only data too. */
+#pragma clang section data = "" bss = "" rodata = "" relro = ""
diff --git a/include/sim_machine_section.h b/include/sim_machine_section.h
--- a/include/sim_machine_section.h
+++ b/include/sim_machine_section.h
@@ -3,3 +3,7 @@
  * The port's in-process restart (port/src/machine.c) copies them at the start and puts them back at a reset.
  * libsim's other files include sim_host_section.h after this one: they are the host's. -fno-common goes with it. */
 #pragma clang section data = "__DATA,__machdata" bss = "__DATA,__machbss,zerofill"
+/* bw-port (libntr-ios-romfill.patch): their read-only data (const data with pointers too) in a writable section of the
+ * port's group s, __DATA,__bwrom_s: tools/port_romfill.py zeroes the bytes the player's ROM holds after the link and
+ * the port fills them from the ROM at the game's start (bw-port port/machine/macos_rom_section.h). */
+#pragma clang section rodata = "__DATA,__bwrom_s" relro = "__DATA,__bwrom_s"

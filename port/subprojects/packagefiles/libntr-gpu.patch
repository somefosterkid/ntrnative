+// libntr-gpu.patch: the GL variant (port/gpu through port/bridge/gpu_bridge.c, sim_config.ini Renderer=gpu): fn runs with
+// libntr's GL context current, draws the picture into a GL texture of its own and returns its name and size (256 N x
+// 384 N, the top screen in the upper half), which the screen quads draw (the bridge keeps it GL_NEAREST). It saves and
+// restores the GL state it changes. 0: no picture this frame (the vcore renderer draws it). The bridge gets its GL
+// functions by name from SIM_GLGetProc and the scale from SIM_GLRendererScale.
+typedef unsigned (*SIM_FrameRendererGLFn)(int *w, int *h);
+static SIM_FrameRendererGLFn sFrameRendererGL;
+extern "C" void SIM_SetFrameRendererGL(SIM_FrameRendererGLFn fn) { sFrameRendererGL = fn; }
+extern "C" void *SIM_GLGetProc(const char *name) { return (void *)SDL_GL_GetProcAddress(name); }
 extern "C" void SIM_SetFrameRenderer(SIM_FrameRendererFn fn) { sFrameRenderer = fn; }
 extern "C" int SIM_HasFrameRenderer(void) { return sFrameRenderer != NULL; }
 extern "C" int SIM_FrameRendererActive(void) { return sFrameRendererDrew; }

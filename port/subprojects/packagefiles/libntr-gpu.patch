+static void SIM_FrameInit(void) {
+  if (s_frameProgram != 0) return;
+  GLint prevTex = 0, prevUnit = 0;
+  glGetIntegerv(GL_ACTIVE_TEXTURE, &prevUnit);
+  glActiveTexture(GL_TEXTURE0);
+  glGetIntegerv(GL_TEXTURE_BINDING_2D, &prevTex);
+  glGenTextures(1, &s_frameTexture);
+  glBindTexture(GL_TEXTURE_2D, s_frameTexture);
+  glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+  glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+  glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+  glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+  glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA8, SIM_NDS_SCREEN_WIDTH, SIM_NDS_SCREEN_HEIGHT * 2, 0, GL_RGBA,
+               GL_UNSIGNED_BYTE, NULL);
+  GLuint vs = SIM_FrameShader(GL_VERTEX_SHADER, kFrameVertexShader);
+  GLuint fs = SIM_FrameShader(GL_FRAGMENT_SHADER, kFrameFragmentShader);
+  s_frameProgram = glCreateProgram();
+  glAttachShader(s_frameProgram, vs);
+  glAttachShader(s_frameProgram, fs);
+  glLinkProgram(s_frameProgram);
+  glProgramUniform1i(s_frameProgram, glGetUniformLocation(s_frameProgram, "frameTexture"), 0);
+  glBindTexture(GL_TEXTURE_2D, (GLuint)prevTex);
+  glActiveTexture((GLenum)prevUnit);
+}
+
+// the screen quads with the picture in texture tex (unit 0), libntr's state back after
+static void SIM_DrawFrameTexture(GLuint tex) {
+  GLint prevTex = 0, prevUnit = 0;
+  glGetIntegerv(GL_ACTIVE_TEXTURE, &prevUnit);
+  glActiveTexture(GL_TEXTURE0);
+  glGetIntegerv(GL_TEXTURE_BINDING_2D, &prevTex);
+  glBindTexture(GL_TEXTURE_2D, tex);
+  glUseProgram(s_frameProgram);
+  DrawScreenQuad();
+  glUseProgram(g2shaderProgramID);
+  glBindTexture(GL_TEXTURE_2D, (GLuint)prevTex);
+  glActiveTexture((GLenum)prevUnit);
+}

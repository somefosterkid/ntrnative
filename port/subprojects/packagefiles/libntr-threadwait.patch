diff --git a/libraries/os/src/os_thread.c b/libraries/os/src/os_thread.c
--- a/libraries/os/src/os_thread.c
+++ b/libraries/os/src/os_thread.c
@@ -11,6 +11,34 @@
 
 pthread_mutex_t osiThreadMutex = PTHREAD_MUTEX_INITIALIZER;
 
+// bw-port (libntr-threadwait.patch): OS_SleepThread blocks until a wakeup instead of returning after a millisecond
+// (the SDK's callers loop on their condition, so that was a 1 kHz poll per waiting thread). Host threads run at the
+// same time and OS_DisableInterrupts stops none of them, so a wakeup may come between a caller's check and its sleep:
+// s_wakeEpoch counts the wakeups, a thread notes it when it disables interrupts (where the SDK checks its condition)
+// and when a sleep ends, and a sleep that sees it moved since returns at once (the caller checks again). The timed
+// wait is a backstop for a wakeup the host never sends (no IRQ handler wakes OSi_IrqThreadQueue here)
+#include <errno.h>
+#include <time.h>
+#define OSi_WAIT_BACKSTOP_MS 50
+static pthread_mutex_t s_waitLock = PTHREAD_MUTEX_INITIALIZER;
+static pthread_cond_t s_waitCond = PTHREAD_COND_INITIALIZER;
+static u32 s_wakeEpoch;
+static __thread u32 t_seenEpoch;
+
+void OSi_NoteWakeEpoch(void)
+{
+    t_seenEpoch = __atomic_load_n(&s_wakeEpoch, __ATOMIC_ACQUIRE);
+}
+
+// s_waitLock held: a wakeup happened; anyone it made ready gets the signal
+static void OSi_WakeLocked(BOOL woke)
+{
+    __atomic_add_fetch(&s_wakeEpoch, 1, __ATOMIC_RELEASE);
+    if (woke) {
+        pthread_cond_broadcast(&s_waitCond);
+    }
+}
+
 typedef struct {
     SDL_threadID threadId;
     OSThread * thread;
@@ -163,7 +191,9 @@
 static void OSi_RescheduleThread(void);
 
 #ifdef SDK_PORT
-static OSThread s_WIN_unknownThread;
+// a host thread libntr didn't make (the game's main thread, PXI, audio): one each, so two of them can sleep and be
+// woken apart
+static __thread OSThread s_WIN_unknownThread;
 
 OSThread * WIN_OS_GetCurrentThread(void)
 {
@@ -976,8 +1006,46 @@
     }
 }
 
+#ifdef SDK_PORT
 void OS_SleepThread (OSThreadQueue * queue)
 {
+    OSThread * currentThread = OSi_GetCurrentThread();
+
+    pthread_mutex_lock(&s_waitLock);
+    if (s_wakeEpoch == t_seenEpoch) {
+        struct timespec deadline;
+        int rc = 0;
+
+        if (queue) {
+            currentThread->queue = queue;
+            OSi_InsertLinkToQueue(queue, currentThread);
+        }
+        currentThread->state = OS_THREAD_STATE_WAITING;
+
+        clock_gettime(CLOCK_REALTIME, &deadline);
+        deadline.tv_nsec += OSi_WAIT_BACKSTOP_MS * 1000000L;
+        if (deadline.tv_nsec >= 1000000000L) {
+            deadline.tv_sec++;
+            deadline.tv_nsec -= 1000000000L;
+        }
+        while (currentThread->state == OS_THREAD_STATE_WAITING && rc != ETIMEDOUT) {
+            rc = pthread_cond_timedwait(&s_waitCond, &s_waitLock, &deadline);
+        }
+
+        // the backstop, or OS_WakeupThreadDirect: still in the queue
+        if (currentThread->queue) {
+            (void)OSi_RemoveSpecifiedLinkFromQueue(currentThread->queue, currentThread);
+            currentThread->queue = NULL;
+            currentThread->link.prev = currentThread->link.next = NULL;
+        }
+        currentThread->state = OS_THREAD_STATE_READY;
+    }
+    t_seenEpoch = s_wakeEpoch;
+    pthread_mutex_unlock(&s_waitLock);
+}
+#else
+void OS_SleepThread (OSThreadQueue * queue)
+{
     OSIntrMode enable;
     OSThread * currentThread;
 
@@ -1006,14 +1074,12 @@
 
         currentThread->state = OS_THREAD_STATE_WAITING;
         OSi_RescheduleThread();
-        #ifdef SDK_PORT
-        SDL_Delay(1);
-        #endif
     }
 #endif
     (void)OS_RestoreInterrupts(enable);
 
 }
+#endif
 
 void OS_WakeupThread (OSThreadQueue * queue)
 {
@@ -1042,6 +1108,23 @@
         OS_InitThreadQueue(queue);
         OSi_RescheduleThread();
     }
+#elif defined(SDK_PORT)
+    {
+        BOOL woke = FALSE;
+
+        pthread_mutex_lock(&s_waitLock);
+        while (queue->head) {
+            OSThread * thread = OSi_RemoveLinkFromQueue(queue);
+
+            woke |= (thread->state == OS_THREAD_STATE_WAITING);
+            thread->state = OS_THREAD_STATE_READY;
+            thread->queue = NULL;
+            thread->link.prev = thread->link.next = NULL;
+        }
+        OS_InitThreadQueue(queue);
+        OSi_WakeLocked(woke);
+        pthread_mutex_unlock(&s_waitLock);
+    }
 #else
     if (queue->head) {
         while (queue->head) {
@@ -1070,12 +1153,20 @@
     enable = OS_DisableInterrupts();
 
     {
-        thread->state = OS_THREAD_STATE_READY;
-        OSi_RescheduleThread();
         #ifdef SDK_PORT
+        BOOL woke;
+
+        pthread_mutex_lock(&s_waitLock);
+        woke = (thread->state == OS_THREAD_STATE_WAITING);
+        thread->state = OS_THREAD_STATE_READY;
+        OSi_WakeLocked(woke);
+        pthread_mutex_unlock(&s_waitLock);
         while(thread->win_threadState == 0){
             SDL_Delay(1);
         }
+        #else
+        thread->state = OS_THREAD_STATE_READY;
+        OSi_RescheduleThread();
         #endif
     }
 

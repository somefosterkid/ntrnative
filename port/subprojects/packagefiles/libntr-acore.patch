+// bw-port: BWPORT_SOUND=acore|libntr overrides sim_config.ini's Sound for a run
+static void SoundFromEnv(SIM_config_type * aConfig)
+{
+    const char * e = getenv("BWPORT_SOUND");
+    if(e != NULL && strcmp(e, "libntr") == 0) {
+        aConfig->sound = SIM_CONFIG_SOUND_LIBNTR;
+    } else if(e != NULL && strcmp(e, "acore") == 0) {
+        aConfig->sound = SIM_CONFIG_SOUND_ACORE;
+    }
+}

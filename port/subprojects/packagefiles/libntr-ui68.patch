+// a settings window: centred in the window under the bar when it opens, a fixed width, as high as its content, Esc closes
+static bool BeginSettings(int id, const char * title, float width) {
+    Win & w = sWins[id];
+    if (!w.open) {
+        return false;
+    }
+    ImGuiViewport * vp = ImGui::GetMainViewport();
+    ImVec2 c(vp->Pos.x + vp->Size.x * 0.5f, vp->Pos.y + (sBarH + vp->Size.y) * 0.5f);
+    ImGui::SetNextWindowPos(c, ImGuiCond_Appearing, ImVec2(0.5f, 0.5f));
+    ImGui::SetNextWindowSizeConstraints(ImVec2(0, 0), ImVec2(vp->Size.x - 20.0f, vp->Size.y - sBarH - 20.0f));
+    if (!ImGui::Begin(title, &w.open, ImGuiWindowFlags_NoCollapse | ImGuiWindowFlags_AlwaysAutoResize | ImGuiWindowFlags_NoSavedSettings)) {
+        ImGui::End();
+        return false;
+    }

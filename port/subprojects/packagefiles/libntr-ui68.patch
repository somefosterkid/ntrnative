+static void LayoutSize(int * w, int * h) {
+    switch (C()->screenLayout) {
+    default:
+    case SIM_CONFIG_SCREEN_LAYOUT_VERTICAL: *w = 256; *h = 384; break;
+    case SIM_CONFIG_SCREEN_LAYOUT_HORIZONTAL: *w = 512; *h = 192; break;
+    case SIM_CONFIG_SCREEN_LAYOUT_LARGE: *w = 768; *h = 384; break;
+    }
+}
+
+static std::string ResolutionLabel(int n) {
+    int w, h;
+    LayoutSize(&w, &h);
+    return std::format("{}x ({}x{})", n, w * n, h * n);
+}
+
+static int FrameSkipIndex() {
+    SIM_config_type * c = C();
+    return c->frameSkip == SIM_CONFIG_FRAMESKIP_AUTO ? 4 : c->frameSkip > 3 ? 3 : c->frameSkip;
+}
+
+static void SetFrameSkip(int i) {
+    // a value from BWPORT_FRAMESKIP (above 3) stays unless the choice was changed
+    if (i != FrameSkipIndex()) {
+        C()->frameSkip = i == 4 ? SIM_CONFIG_FRAMESKIP_AUTO : (u8)i;
+        Dirty();
+    }
+}

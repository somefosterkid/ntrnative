+            ImGui::EndMenu();
+        }
+        ImGui::EndMenu();
+    }
+    if (ImGui::BeginMenu("Audio")) {
+        if (ImGui::MenuItem("Audio settings...")) {
+            OpenWin(W_AUDIO);
+        }
+        ImGui::Separator();
+        if (ImGui::BeginMenu("Sound engine")) {
+            if (MenuRadio("acore (the port's DS sound core)", c->sound == SIM_CONFIG_SOUND_ACORE)) {
+                c->sound = SIM_CONFIG_SOUND_ACORE;
+                Dirty();
+            }
+            if (MenuRadio("libntr (libntr's sound driver)", c->sound == SIM_CONFIG_SOUND_LIBNTR)) {
+                c->sound = SIM_CONFIG_SOUND_LIBNTR;

+// ---- Main: once a frame, between NewFrame and Render --------------------------------------------------------------
+
+void Main() {
+    SIM_config_type * c = C();
+    // the bar's real height (ImGui's), for the next frame's layout
+    float fh = ImGui::GetFrameHeight();
+    if (fabsf(fh - sBarH) > 0.5f) {
+        sBarH = fh;
+    }
+    if (sBarVisible) {
+        MenuBar();
+    }
+    VideoWindow();
+    AudioWindow();
+    ControlsWindow();
+    ViewWindow();
+    DebugWindow();
+    if (sWins[W_LEGACY_CONFIG].open) { AppConfigMain(&sWins[W_LEGACY_CONFIG].open); }
+    if (sWins[W_LEGACY_INPUT].open) { AppPadMain(&sWins[W_LEGACY_INPUT].open); }
+    if (sWins[W_NET].open) { AppNetMain(&sWins[W_NET].open); }
+    if (sWins[W_DEMO].open) { ImGui::ShowDemoWindow(&sWins[W_DEMO].open); }
+    if (sWins[W_APP].open) { PrjMain(&sWins[W_APP].open); }
+
+    if (sResetAsk) {
+        ImGui::OpenPopup("Reset the game");
+        sResetAsk = false;
+    }
+    ImGuiViewport * vp = ImGui::GetMainViewport();
+    ImGui::SetNextWindowPos(ImVec2(vp->Size.x * 0.5f, (sBarH + vp->Size.y) * 0.5f), ImGuiCond_Always, ImVec2(0.5f, 0.5f));
+    if (ImGui::BeginPopupModal("Reset the game", nullptr, ImGuiWindowFlags_AlwaysAutoResize | ImGuiWindowFlags_NoMove)) {
+        ImGui::Text("The game starts again from the title.");
+        ImGui::Text("Whatever was not saved in the game is lost.");
+        ImGui::Spacing();
+        if (ImGui::Button("Reset", ImVec2(120.0f * sUiScale, 0.0f))) {
+            RestartProgram();
+        }
+        ImGui::SameLine();
+        if (ImGui::Button("Cancel", ImVec2(120.0f * sUiScale, 0.0f)) || ImGui::IsKeyPressed(ImGuiKey_Escape)) {
+            ImGui::CloseCurrentPopup();
+        }
+        ImGui::EndPopup();
+    }
+
+    // the settings are written when the mouse is up (a slider is not written at every step)
+    if (sDirty && !ImGui::IsMouseDown(0) && sCap.target == nullptr) {
+        sDirty = false;
+        SIM_Config_SaveConfigFile(c);
+    }
+}

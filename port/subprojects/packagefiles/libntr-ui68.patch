+int BarBegin(int windowW, int windowH) {
+    (void)windowW;
+    (void)windowH;
+    SIM_config_type * c = C();
+    int mx = 0, my = 0;
+    Uint32 b = SDL_GetMouseState(&mx, &my);
+    bool focus = SDL_GetMouseFocus() == sWindow;
+    bool popup = sImguiContext != nullptr && ImGui::IsPopupOpen(nullptr, ImGuiPopupFlags_AnyPopupId | ImGuiPopupFlags_AnyPopupLevel);
+    bool pinned = !c->fullScreen && c->showMenuBar;
+    if (!pinned) {
+        // out when the mouse reaches the top edge (not while a button is down: a touch there is the game's)
+        if (focus && !(b & SDL_BUTTON_LMASK) && my <= 2) {
+            sBarMouse = true;
+        } else if (!(focus && (float)my < sBarH + 6.0f) && !popup) {
+            sBarMouse = false;
+        }
+    } else {
+        sBarMouse = false;
+        sBarLatch = false;
+    }
+    sBarVisible = pinned || sBarMouse || sBarLatch || popup;
+    sBarReserve = pinned ? (int)ceilf(sBarH) : 0;
+    return sBarReserve;

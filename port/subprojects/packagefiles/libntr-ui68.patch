+static void DebugWindow() {
+    if (!BeginSettings(W_DEBUG, "Debug", 520.0f)) {
+        return;
+    }
+    ImGui::Text("Git rev: %s", SIM_GetLibntrGitHash());
+    float renderTimeMs = static_cast<float>(SIM_GetRenderFrameTime()) / 1000000.0f;
+    ImGui::Text("Render time: %.3fms", renderTimeMs);
+    static float sPeriodMs = 16.7f;
+    float periodMs = static_cast<float>(SIM_GetRealFrameTime()) / 1000000.0f;
+    if (periodMs > 0.0f) {
+        sPeriodMs += (periodMs - sPeriodMs) * 0.1f;
+    }
+    ImGui::Text("%.0ffps", 1000.0f / sPeriodMs);
+    {
+        static float sGameMs = 0.0f, sRenderMs = 0.0f;
+        float g = static_cast<float>(SIM_GetGameWorkTime()) / 1000000.0f;
+        float r = static_cast<float>(SIM_GetRenderWorkTime()) / 1000000.0f;
+        sGameMs += (g - sGameMs) * 0.1f;
+        sRenderMs += (r - sRenderMs) * 0.1f;
+        const float kFrameMs = 16.715f;
+        float total = (sGameMs + sRenderMs) * 100.0f / kFrameMs;
+        ImVec4 col = total > 100.0f ? ImVec4(1.0f, 0.4f, 0.3f, 1.0f) : ImVec4(0.5f, 1.0f, 0.5f, 1.0f);
+        ImGui::TextColored(col, "Frame budget: %.0f%% of 16.7 ms", total);
+        ImGui::Text("  game %.1f ms (%.0f%%), render %.1f ms (%.0f%%)", sGameMs, sGameMs * 100.0f / kFrameMs, sRenderMs,
+                    sRenderMs * 100.0f / kFrameMs);
+    }
+    ImGui::Checkbox("Pause game logic", &sPauseGameLogic);
+    ImGui::SeparatorText("Tools");
+    auto tool = [](const char * label, int w, void (*init)(void)) {
+        if (ImGui::Button(label, ImVec2(150.0f * sUiScale, 0.0f))) {
+            if (!sWins[w].open && init) {
+                init();
+            }
+            if (sWins[w].open) {
+                sWins[w].open = false;
+            } else {
+                OpenWin(w);
+            }
+        }
+    };
+    tool("Old Config window", W_LEGACY_CONFIG, AppConfigInit);
+    ImGui::SameLine();
+    tool("Old Input window", W_LEGACY_INPUT, AppPadInit);
+    tool("Multiplayer", W_NET, AppNetInit);
+    ImGui::SameLine();
+    tool("ImGui demo", W_DEMO, nullptr);
+    ImGui::SameLine();
+    tool("Application", W_APP, nullptr);
+
+    if (ImGuiFileDialog::Instance()->Display("ChooseFileDlgKey", ImGuiWindowFlags_NoCollapse, ImVec2(200, 200))) {
+        if (ImGuiFileDialog::Instance()->IsOk()) {
+            std::string filePathName = ImGuiFileDialog::Instance()->GetFilePathName();
+            if (sFileDialogCallback) {
+                sFileDialogCallback(filePathName);
+            }
+        }
+        ImGuiFileDialog::Instance()->Close();
+    }
+    ImGui::End();
+}

+// ---- the display's scale ------------------------------------------------------------------------------------------
+
+float DisplayScale() {
+    float ddpi = 96.0f;
+    if (SDL_GetDisplayDPI(0, &ddpi, nullptr, nullptr) != 0) {
+        ddpi = 96.0f;
+    }
+    float s = ddpi / 96.0f;
+    s = roundf(s * 4.0f) / 4.0f;
+    return s < 1.0f ? 1.0f : s > 3.0f ? 3.0f : s;
+}
+
+static float WantedScale() {
+    SIM_config_type * c = C();
+    if (c->uiScale >= 50) {
+        return (float)c->uiScale / 100.0f;
+    }
+    const char * e = getenv("BWPORT_UISCALE");
+    if (e != nullptr && atof(e) >= 0.5) {
+        return (float)atof(e);
+    }
+    return DisplayScale();
+}
+
+static void ApplyScale(float s) {
+    sUiScale = s;
+    ImGuiStyle & st = ImGui::GetStyle();
+    st = sBaseStyle;
+    st.ScaleAllSizes(s);
+    st.FontScaleMain = s;
+    sBarH = ceilf(st.FontSizeBase * s) + 2.0f * st.FramePadding.y;
+}
+

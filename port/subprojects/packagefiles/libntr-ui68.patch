+static void MenuBar() {
+    SIM_config_type * c = C();
+    if (!ImGui::BeginMainMenuBar()) {
+        return;
+    }
+    if (ImGui::BeginMenu("Game")) {
+        ImGui::MenuItem("Pause", nullptr, &sPauseGameLogic);
+        if (RestartSupported() && ImGui::MenuItem("Reset...")) {
+            sResetAsk = true;
+        }
+        ImGui::Separator();
+        if (ImGui::MenuItem("Quit")) {
+            SIM_Config_SaveConfigFile(c);
+            exit(0);
+        }
+        ImGui::EndMenu();
+    }
+    if (ImGui::BeginMenu("Video")) {
+        if (ImGui::MenuItem("Video settings...")) {
+            OpenWin(W_VIDEO);
+        }
+        ImGui::Separator();
+        if (ImGui::BeginMenu("Renderer")) {
+            for (int i = 0; i < 3; i++) {
+                if (MenuRadio(RendererNames[i], c->renderer == i)) {
+                    c->renderer = (u8)i;
+                    Dirty();
+                }
+            }
+            ImGui::EndMenu();
+        }
+        if (ImGui::BeginMenu("Resolution")) {
+            for (int n = 1; n <= 8; n++) {
+                if (MenuRadio(ResolutionLabel(n).c_str(), c->resolution == n)) {
+                    c->resolution = (u8)n;
+                    Dirty();
+                }
+            }
+            ImGui::Separator();
+            ImGui::TextDisabled("%s", SIM_RendererStatus());
+            ImGui::EndMenu();
+        }
+        if (ImGui::BeginMenu("Texture filter")) {
+            for (int i = 0; i < 2; i++) {
+                if (MenuRadio(FilterNames[i], c->gpuFilter == i)) {
+                    c->gpuFilter = (u8)i;
+                    Dirty();
+                }
+            }
+            ImGui::EndMenu();
+        }
+        if (ImGui::BeginMenu("Dots")) {
+            for (int i = 0; i < 2; i++) {
+                if (MenuRadio(DotNames[i], c->gpuDot == i)) { c->gpuDot = (u8)i; Dirty(); }
+            }
+            ImGui::EndMenu();
+        }
+        if (ImGui::BeginMenu("Lines")) {
+            for (int i = 0; i < 2; i++) {
+                if (MenuRadio(LineNames[i], c->gpuLine == i)) { c->gpuLine = (u8)i; Dirty(); }
+            }
+            ImGui::EndMenu();
+        }
+        if (ImGui::BeginMenu("Edge marking")) {
+            for (int i = 0; i < 2; i++) {
+                if (MenuRadio(EdgeNames[i], c->gpuEdge == i)) { c->gpuEdge = (u8)i; Dirty(); }
+            }
+            ImGui::EndMenu();
+        }
+        ImGui::Separator();
+        bool is = c->integerScale;
+        if (ImGui::MenuItem("Integer scale", nullptr, &is)) { c->integerScale = is; Dirty(); }

+bool ProcessEvent(SDL_Event * event) {
+    // a key being assigned (Controls window): the next key or gamepad input, Esc cancels; the game does not see it
+    if (sCap.target != nullptr) {
+        if (event->type == SDL_KEYDOWN) {
+            if (event->key.keysym.sym != SDLK_ESCAPE && !sCap.joy) {
+                *sCap.target = event->key.keysym.sym;
+                Dirty();
+            }
+            if (event->key.keysym.sym == SDLK_ESCAPE || !sCap.joy) {
+                sCap.target = nullptr;
+            }
+            return true;
+        }
+        if (sCap.joy) {
+            int v = SIM_CONFIG_JOY_INVALID_KEY;
+            SIM_config_type * c = C();
+            if (event->type == SDL_JOYBUTTONDOWN) {
+                v = event->jbutton.button;
+            } else if (event->type == SDL_JOYHATMOTION && event->jhat.value != SDL_HAT_CENTERED) {
+                v = event->jhat.value | SIM_CONFIG_JOY_HAT_MASK;
+            } else if (event->type == SDL_JOYAXISMOTION && (event->jaxis.value > c->padSettings.joyAxisDeadzone ||
+                                                              event->jaxis.value < -c->padSettings.joyAxisDeadzone)) {
+                v = event->jaxis.axis | (event->jaxis.value > 0 ? SIM_CONFIG_JOY_AXIS_PLUS_MASK : SIM_CONFIG_JOY_AXIS_MINUS_MASK);
+            }
+            if (v != SIM_CONFIG_JOY_INVALID_KEY) {
+                *sCap.target = v;
+                sCap.target = nullptr;
+                Dirty();
+                return true;
+            }
+        }
+    }
+    if (event->type == SDL_KEYDOWN && event->key.keysym.sym == SDLK_ESCAPE && !event->key.repeat) {
+        // Esc closes the settings window last used
+        int best = -1;
+        for (int i = 0; i < W_COUNT; i++) {
+            if (sWins[i].open && (best < 0 || sWins[i].order > sWins[best].order)) {
+                best = i;
+            }
+        }
+        if (best >= 0) {
+            sWins[best].open = false;
+            return true;
+        }
+    }
+    if (event->type == SDL_KEYDOWN || event->type == SDL_KEYUP) {
+        int k = event->key.keysym.sym;
+        bool alt = k == SDLK_LALT || k == SDLK_RALT;
+        if (event->type == SDL_KEYDOWN) {
+            if (alt) {
+                sAltDown = true;
+                sAltOther = false;
+            } else {
+                sAltOther = true;
+            }
+        } else if (alt) {
+            // Alt pressed and released alone: the bar out or away
+            if (sAltDown && !sAltOther && !(!C()->fullScreen && C()->showMenuBar)) {
+                sBarLatch = !sBarLatch;
+            }
+            sAltDown = false;
+        }
+    }
+    ImGui_ImplSDL2_ProcessEvent(event);
+    return false;
+}

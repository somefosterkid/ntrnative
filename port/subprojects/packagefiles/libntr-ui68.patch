+
+static bool ComboIndex(const char * label, int * idx, const char * const * names, int n) {
+    bool ch = false;
+    if (ImGui::BeginCombo(label, names[*idx < n ? *idx : 0])) {
+        for (int i = 0; i < n; i++) {
+            if (ImGui::Selectable(names[i], i == *idx)) {
+                *idx = i;
+                ch = true;
+            }
+        }
+        ImGui::EndCombo();
+    }
+    return ch;
+}
+
+static bool RendererCombo(const char * label, bool longNames) {
+    int r = C()->renderer;
+    static const char * const shortNames[] = {"auto", "vcore (CPU)", "gpu (OpenGL)"};
+    if (ComboIndex(label, &r, longNames ? RendererNames : shortNames, 3)) {
+        C()->renderer = (u8)r;
+        Dirty();
+        return true;
+    }
+    return false;
+}
+
+static bool ResolutionCombo(const char * label) {
+    int res = C()->resolution;
+    bool ch = false;
+    if (ImGui::BeginCombo(label, ResolutionLabel(res).c_str())) {
+        for (int n = 1; n <= 8; n++) {
+            if (ImGui::Selectable(ResolutionLabel(n).c_str(), n == res)) {
+                C()->resolution = (u8)n;
+                Dirty();
+                ch = true;

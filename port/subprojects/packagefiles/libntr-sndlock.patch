+
+// bw-port (libntr-soundclock.patch): with the sound clock on the frame's ticks, a list does not run when the PXI
+// thread gets it but at the DS driver's next alarm tick (every 174592 ARM7 cycles) after the game sent it, or at once
+// when a wakeup word follows (SND_COMMAND_IMMEDIATE). The game's wait lengths (a cry: PokeVoice_IsPlaying) depend on
+// when the channel starts.
+#define PEND_MAX 512
+static struct { SNDCommand * list; u64 ready; } s_pend[PEND_MAX];
+static unsigned s_pendRd = 0, s_pendWr = 0;
+static SDL_mutex * s_pendMx = NULL;
+u64 SIM_Audio_NowCycle(void);
+int SIM_Audio_FrameClock(void);
+
+static u64 PendDelay( void )
+{
+	static long long d = -1;
+	if( d < 0 )
+	{
+		const char * e = getenv( "BWPORT_SNDDELAY" );
+		d = e ? atoll( e ) : 0;
+	}
+	return (u64)d;
+}
+
+void SIM_PxiQueueSoundList( SNDCommand * list )
+{
+	if( !SIM_Audio_FrameClock() )
+	{
+		ProcSoundList( list );
+		return;
+	}
+	if( s_pendMx == NULL )
+	{
+		s_pendMx = SDL_CreateMutex();
+	}
+	SDL_LockMutex( s_pendMx );
+	if( s_pendWr - s_pendRd >= PEND_MAX )
+	{
+		SDL_UnlockMutex( s_pendMx );
+		ProcSoundList( list );
+		return;
+	}
+	s_pend[s_pendWr % PEND_MAX].list = list;
+	s_pend[s_pendWr % PEND_MAX].ready = SIM_Audio_NowCycle() + PendDelay();
+	s_pendWr++;
+	SDL_UnlockMutex( s_pendMx );
+}
+
+// run the lists due at aTickCycle (all of them for a wakeup word)
+void SIM_PxiRunPending( u64 aTickCycle, int aAll )
+{
+	if( s_pendMx == NULL )
+	{
+		return;
+	}
+	for( ;; )
+	{
+		SNDCommand * list;
+		SDL_LockMutex( s_pendMx );
+		if( s_pendRd == s_pendWr || ( !aAll && s_pend[s_pendRd % PEND_MAX].ready > aTickCycle ) )
+		{
+			SDL_UnlockMutex( s_pendMx );
+			break;
+		}
+		list = s_pend[s_pendRd % PEND_MAX].list;
+		s_pendRd++;
+		SDL_UnlockMutex( s_pendMx );
+		ProcSoundList( list );
+	}
+}
+
+void SIM_procPXI(void)
+{
+
+	void * data;
+	data = SIM_queue_read( pxiQueuePtr );
+	while( data != NULL )
+	{
+		WIN_PXIFifoMessage * msg;
+		msg = (WIN_PXIFifoMessage *)data;
+
+		switch( msg->e.tag )
+		{
+			case PXI_FIFO_TAG_TOUCHPANEL:
+
+				break;
+			case PXI_FIFO_TAG_SOUND:
+				{
+					SNDCommand * sndCommandList;
+					sndCommandList = (SNDCommand * )msg->e.data;
+
+					// bw-port: the sound capture (port/src/acapture.c) sees each list before it runs, and each wakeup word
+					if( SIM_sndCaptureHook != NULL )
+					{
+						SIM_sndCaptureHook( sndCommandList );
+					}
+
+					if( sndCommandList == NULL )
+					{
+						SIM_PxiRunPending( 0, 1 ); // bw-port: a wakeup word
+						break;
+					}
+					// bw-port: the program's sound backend (sim_audio.h) has taken the list through the hook above
+					if( SIM_soundBackendOn )
+					{
+						break;
+					}
+					// The DS's ARM7 runs its sound commands and its sequencer in one thread; here the commands run in
+					// this one and the sequencer and channels in SDL's audio callback (sim_audio.cpp): a player stopped
+					// or started under a running sequencer read freed banks. SDL_LockAudio keeps the callback out
+					SIM_PxiQueueSoundList( sndCommandList );
 					
 				}
 				break;

+struct FrameRec { unsigned long long end; float ms; unsigned short bin; };
+struct Bucket { unsigned stamp; unsigned short n; float mn, mx, sum; };
+struct PeriodStat { unsigned long long tail, count; double sumMs; unsigned hist[kHistBins]; };
+struct Col { unsigned long long abs; bool final; unsigned short n; float mn, mx, avg; };

+void FrameRecord(unsigned long long ns, unsigned long long gameNs, unsigned long long drawNs) {
+    if (ns == 0 || ns > 10000000000ull) {
+        return;
+    }
+    static int sCost = -1;
+    unsigned long long t0 = 0;
+    if (sCost < 0) { sCost = getenv("BWPORT_GRAPHCOST") != nullptr; }
+    if (sCost) { t0 = SDL_GetPerformanceCounter(); }
+    float ms = (float)((double)ns / 1e6);
+    int bin = BinOf(ms);
+    for (PeriodStat & ps : sPer) {      // the ring is full: the oldest frame goes first
+        while (ps.count && sRingHead - ps.tail >= (unsigned long long)kRing) {
+            const FrameRec & o = sRing[ps.tail % kRing];
+            ps.hist[o.bin]--; ps.count--; ps.sumMs -= o.ms; ps.tail++;
+        }
+        if (ps.count == 0) { ps.tail = sRingHead; }
+    }
+    sTotalNs += ns;
+    FrameRec & r = sRing[sRingHead % kRing];
+    r.end = sTotalNs; r.ms = ms; r.bin = (unsigned short)bin;
+    sRingHead++;
+    unsigned long long bi = sTotalNs / 10000000ull;
+    Bucket & bk = sBuckets[bi % kBuckets];
+    if (bk.stamp != (unsigned)bi + 1u) {
+        bk.stamp = (unsigned)bi + 1u; bk.n = 0; bk.mn = ms; bk.mx = ms; bk.sum = 0.0f;
+    }
+    bk.n++; bk.sum += ms; bk.mn = std::min(bk.mn, ms); bk.mx = std::max(bk.mx, ms);

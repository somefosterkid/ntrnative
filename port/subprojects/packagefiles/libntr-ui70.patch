+        ps.hist[bin]++; ps.count++; ps.sumMs += ms;
+        unsigned long long lim = (unsigned long long)(kPeriodS[p] * 1e9);
+        while (ps.count > 1 && sTotalNs - sRing[ps.tail % kRing].end > lim) {
+            const FrameRec & o = sRing[ps.tail % kRing];
+            ps.hist[o.bin]--; ps.count--; ps.sumMs -= o.ms; ps.tail++;
+        }
+    }
+    sWinN++; sWinNs += ns; sWinMaxNs = std::max(sWinMaxNs, ns); sWinGameNs += gameNs; sWinDrawNs += drawNs;

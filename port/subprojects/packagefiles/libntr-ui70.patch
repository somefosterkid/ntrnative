+void PeriodSnapshot(bool settle) {
+    SIM_config_type * c = C();
+    int p = c->graphPeriod < 4 ? c->graphPeriod : 1;
+    PeriodStat & ps = sPer[p];
+    sSnap.period = p;
+    if (ps.count == 0) {
+        return;
+    }
+    sSnap.pAvg = (float)(ps.sumMs / (double)ps.count);
+    unsigned long long want = (ps.count + 99) / 100, got = 0;
+    double sum = 0.0;
+    float p99 = 0.0f;
+    for (int b = kHistBins - 1; b >= 0 && got < want; b--) {
+        unsigned n = ps.hist[b];
+        if (n == 0) { continue; }
+        unsigned long long take = std::min<unsigned long long>(n, want - got);
+        sum += (double)take * BinMs(b);
+        got += take;
+        p99 = BinMs(b);
+    }

+int BinOf(float ms) {
+    if (ms < 0.01f) {
+        return 0;
+    }
+    int b = (int)(log2f(ms * 100.0f) * 32.0f);
+    return b < 0 ? 0 : b >= kHistBins ? kHistBins - 1 : b;
+}
+float BinMs(int b) { return 0.01f * exp2f(((float)b + 0.5f) / 32.0f); }
+
+float NiceTop(float v) {
+    static const float steps[] = {1.0f, 1.5f, 2.0f, 3.0f, 4.0f, 5.0f, 6.0f, 8.0f, 10.0f};
+    float e = powf(10.0f, floorf(log10f(v)));
+    for (float st : steps) {
+        if (v <= st * e * 1.0001f) { return st * e; }
+    }
+    return 10.0f * e;
+}

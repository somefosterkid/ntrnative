+    float pMin = 0.0f, pAvg = 0.0f, pMax = 0.0f, pLowMs = 0.0f, pP99 = 0.0f;           // the graph period
+    float top = 0.0f;                                                                 // the graph's y axis (ms)
+    int lowerCount = 0;
+    int period = -1;
+} sSnap;
+double sCostFrameUs, sCostDrawUs;     // BWPORT_GRAPHCOST=1: mean cost of FrameRecord and of the graph's drawing
+unsigned long long sCostN;

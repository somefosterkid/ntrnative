+const int kRing = 1 << 18;      // frames kept: 120 s at up to 2180 fps (older ones leave when the ring is full)
+const int kHistBins = 640;      // 32 bins an octave from 0.01 ms up
+const int kBuckets = 16384;     // 10 ms each: 163 s
+const int kColCap = 4096;
+const double kPeriodS[4] = {15.0, 30.0, 60.0, 120.0};

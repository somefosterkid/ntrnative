+FrameRec sRing[kRing];
+unsigned long long sRingHead;
+unsigned long long sTotalNs;    // the sum of the periods: the graph's clock
+Bucket sBuckets[kBuckets];
+PeriodStat sPer[4];
+Col sCols[kColCap];
+unsigned sColsKey;

+// A command list as the DS's geometry FIFO takes it: a word of four command bytes, then each command's parameters
+static void RunCommandList(const void *data, u64 size) {
+  const G3SIM_CommandBlock_t *cmdBlockPtr = static_cast<const G3SIM_CommandBlock_t *>(data);
+  draw_msg_t tempMsg;
+  u64 curOffset = 0;
+  u8 numParams;
+  const void *paramPtr;
+  u8 paramSize;
+  u8 paramSigned;
+  while (curOffset < size) {
+    paramPtr = (const void *)((uPtr)cmdBlockPtr + 4);
+    curOffset += 4;
+    for (int i = 0; i < 4; i++) {
+      tempMsg.type = DecodeG3Op(cmdBlockPtr->ops[i]);
+      numParams = GetNumParamsFromCommandType(tempMsg.type);
+      paramSize = GetParamSizeFromCommandType(tempMsg.type);
+      paramSigned = isParamSigned(tempMsg.type);
+      for (int j = 1; j < numParams + 1; j++) {
+        switch (paramSize) {
+        case 1:
+          if (paramSigned) {
+            tempMsg.data.numsS64[j] = (s64) * (const s8 *)paramPtr;
+          } else {
+            tempMsg.data.numsU64[j] = *(const u8 *)paramPtr;
+          }
+          break;
+        case 2:
+          if (paramSigned) {
+            tempMsg.data.numsS64[j] = (s64) * (const s16 *)paramPtr;
+          } else {
+            tempMsg.data.numsU64[j] = *(const u16 *)paramPtr;
+          }
+          break;
+        case 4:
+          if (paramSigned) {
+            tempMsg.data.numsS64[j] = (s64) * (const s32 *)paramPtr;
+          } else {
+            tempMsg.data.numsU64[j] = *(const u32 *)paramPtr;
+          }
+          break;
+        default:
+          break;
+        }
+        paramPtr = (const void *)((uPtr)paramPtr + paramSize);
+        curOffset += paramSize;
+      }
+
+      ConvertMsgParams(&tempMsg);
+      SIM_HandleG3Command(&tempMsg);
+    }
+    cmdBlockPtr = static_cast<const G3SIM_CommandBlock_t *>(paramPtr);
+  }
+}

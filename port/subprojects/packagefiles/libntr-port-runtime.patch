+	if (type == CARD_BACKUP_TYPE_NOT_USE) {
+		OS_TPanic("cannot specify CARD_BACKUP_TYPE_NOT_USE.");
+	}
+	cardi_common.cmd->result = CARD_RESULT_SUCCESS;
+	CARDi_IdentifyBackupCore2(type);
+	if (cardi_common.cmd->result == CARD_RESULT_SUCCESS &&
+	    !CARDi_PortPrepareBackupFile(cardi_common.cmd->spec.total_size)) {
+		cardi_common.cmd->result = CARD_RESULT_NO_RESPONSE;
+	}
+	return (cardi_common.cmd->result == CARD_RESULT_SUCCESS);
+	#elif SDK_VERSION_MAJOR == 4
 	CARDiCommon *const p = &cardi_common;
 
 	SDK_USING_BACKUP();
diff --git a/libraries/fs/src/fs_file.c b/libraries/fs/src/fs_file.c
index b5b6523..1154043 100644
--- a/libraries/fs/src/fs_file.c
+++ b/libraries/fs/src/fs_file.c
@@ -22,6 +22,78 @@
 #include <simulator/sim_RomExtractor.h>
 #endif
 
+#if defined(SDK_PORT) && SDK_VERSION_MAJOR == 5
+/* PC (bw-port): TwlSDK's FS sends every command to an archive, and the "rom" archive has no card behind it on PC
+   (its tables are kept in 32-bit fields, its reads go to CARD). A file FS_OpenFile opens is a host file under the
+   working directory instead, as libntr's SDK 4 path has it (the extracted ROM's files), and a file
+   FS_CreateFileFromMemory makes is a block of memory: both with arc NULL, top 0, bottom the size, pos the position.
+   These do their reads, seeks, lengths and positions; every other file goes to its archive as before. */
+static BOOL FSi_PortIsMemFile(const FSFile *f)
+{
+	return f->pcFilePtr == NULL && f->arc == NULL && f->userdata != NULL && (f->stat & FS_FILE_STATUS_IS_FILE);
+}
+
+static BOOL FSi_PortIsFile(const FSFile *f)
+{
+	return f->pcFilePtr != NULL || FSi_PortIsMemFile(f);
+}
+
+static s32 FSi_PortReadFile(FSFile *f, void *dst, s32 len)
+{
+	u32 rest = f->prop.file.bottom - f->prop.file.pos;
+	if (len < 0)
+		len = 0;
+	if ((u32)len > rest)
+		len = (s32)rest;
+	if (f->pcFilePtr != NULL) {
+		if (fseek(f->pcFilePtr, (long)f->prop.file.pos, SEEK_SET) != 0)
+			return -1;
+		len = (s32)fread(dst, 1, (size_t)len, f->pcFilePtr);
+	} else {
+		memcpy(dst, (const u8 *)f->userdata + f->prop.file.pos, (size_t)len);
+	}
+	f->prop.file.pos += (u32)len;
+	return len;
+}
+
+static BOOL FSi_PortSeekFile(FSFile *f, s32 offset, FSSeekFileMode origin)
+{
+	s64 pos;
+	switch (origin) {
+	case FS_SEEK_SET:
+		pos = (s64)f->prop.file.top + offset;
+		break;
+	case FS_SEEK_CUR:
+		pos = (s64)f->prop.file.pos + offset;
+		break;
+	case FS_SEEK_END:
+		pos = (s64)f->prop.file.bottom + offset;
+		break;
+	default:
+		return FALSE;
+	}
+	if (pos < (s64)f->prop.file.top)
+		pos = f->prop.file.top;
+	if (pos > (s64)f->prop.file.bottom)
+		pos = f->prop.file.bottom;
+	f->prop.file.pos = (u32)pos;
+	return TRUE;
+}
+
+BOOL FSi_PortCreateFileFromMemory(FSFile *f, void *buf, u32 size)
+{
+	f->arc = NULL;
+	f->pcFilePtr = NULL;
+	f->userdata = buf;
+	f->stat |= FS_FILE_STATUS_IS_FILE;
+	f->stat &= ~FS_FILE_STATUS_IS_DIR;
+	f->prop.file.top = 0;
+	f->prop.file.bottom = size;
+	f->prop.file.pos = 0;
+	return buf != NULL;
+}
+#endif

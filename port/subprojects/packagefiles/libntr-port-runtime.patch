index 62e05c5..355e259 100644
--- a/libraries/card/src/card_backup.c
+++ b/libraries/card/src/card_backup.c
@@ -567,9 +567,46 @@ u32 CARD_GetBackupPageSize (void)
 	return cardi_common.cmd->spec.page_size;
 }
 
+#if defined(SDK_PORT) && SDK_VERSION_MAJOR == 5
+/* PC (bw-port): the backup chip is the host file save.bin in the working directory, which nitro/card/backup.h's
+   PC inlines read and write. Make it the chip's size, its new bytes 0xFF as an erased flash reads. */
+static BOOL CARDi_PortPrepareBackupFile(u32 size)
+{
+	static const u8 erased[256] = {[0 ... 255] = 0xFF};
+	FILE *f = fopen("save.bin", "rb+");
+	long have;
+	if (f == NULL)
+		f = fopen("save.bin", "wb+");
+	if (f == NULL)
+		return FALSE;
+	fseek(f, 0, SEEK_END);
+	have = ftell(f);
+	while (have >= 0 && (u32)have < size) {
+		u32 n = size - (u32)have > sizeof(erased) ? sizeof(erased) : size - (u32)have;
+		if (fwrite(erased, 1, n, f) != n)
+			break;
+		have += (long)n;
+	}
+	fclose(f);
+	return have >= 0 && (u32)have >= size;
+}
+#endif

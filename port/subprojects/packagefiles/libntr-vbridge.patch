+// the bank's memory where its data lives now (writable): the in-process renderer stores a display capture there
+extern "C" uint8_t *SIM_VCapBankHome(int bank) {
+  if (bank < 0 || bank > 8) return NULL;
+  return (uint8_t *)GXi_SimVramBankHome(bank);
+}

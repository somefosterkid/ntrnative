+// bw-port (libntr-vbridge.patch): the frame renderer's picture, a 256x384 RGBA8 texture (top screen in its first
+// rows) drawn with the window's screen quads (sim_screenquads.c: the layout and the swap), which sample the top screen
+// from the upper half of t: t is flipped for the picture's rows, which go down
+static const char *kFrameVertexShader = R""(
+#version 420 core
+layout (location = 0) in vec3 position;
+layout (location = 1) in vec2 texCoord;
+smooth out vec2 fragTexCoord;
+void main()
+{
+    gl_Position = vec4(position.x, position.y, position.z, 1.);
+    fragTexCoord = vec2(texCoord.x, 1.0 - texCoord.y);
+}
+)"";
+static const char *kFrameFragmentShader = R""(
+#version 420 core
+smooth in vec2 fragTexCoord;
+out vec4 fragColor;
+uniform sampler2D frameTexture;
+void main()
+{
+    fragColor = vec4(texture(frameTexture, fragTexCoord).rgb, 1.0);
+}
+)"";
+static GLuint s_frameProgram, s_frameTexture;
+
+static GLuint SIM_FrameShader(GLenum kind, const char *src) {
+  GLuint id = glCreateShader(kind);
+  GLint status = GL_FALSE;
+  glShaderSource(id, 1, &src, NULL);
+  glCompileShader(id);
+  glGetShaderiv(id, GL_COMPILE_STATUS, &status);
+  if (status != GL_TRUE) {
+    char log[1024] = {0};
+    glGetShaderInfoLog(id, sizeof log - 1, NULL, log);
+    printf("bwport: the frame renderer's shader: %s\n", log);
+  }
+  return id;
+}
+
+static bool SIM_DrawFrameRenderer(void) {
+  sFrameRendererDrew = 0;
+  if (sFrameRenderer == NULL || s_SIM_config.renderer != SIM_CONFIG_RENDERER_VCORE) {
+    return false;
+  }
+  const unsigned char *rgba = sFrameRenderer();
+  if (rgba == NULL) {
+    return false;
+  }
+  GLint prevTex = 0, prevUnit = 0;
+  glGetIntegerv(GL_ACTIVE_TEXTURE, &prevUnit);
+  glActiveTexture(GL_TEXTURE0);
+  glGetIntegerv(GL_TEXTURE_BINDING_2D, &prevTex);
+  if (s_frameProgram == 0) {
+    glGenTextures(1, &s_frameTexture);
+    glBindTexture(GL_TEXTURE_2D, s_frameTexture);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+    glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA8, SIM_NDS_SCREEN_WIDTH, SIM_NDS_SCREEN_HEIGHT * 2, 0, GL_RGBA,
+                 GL_UNSIGNED_BYTE, NULL);
+    GLuint vs = SIM_FrameShader(GL_VERTEX_SHADER, kFrameVertexShader);
+    GLuint fs = SIM_FrameShader(GL_FRAGMENT_SHADER, kFrameFragmentShader);
+    s_frameProgram = glCreateProgram();
+    glAttachShader(s_frameProgram, vs);
+    glAttachShader(s_frameProgram, fs);
+    glLinkProgram(s_frameProgram);
+    glProgramUniform1i(s_frameProgram, glGetUniformLocation(s_frameProgram, "frameTexture"), 0);
+  }
+  glBindTexture(GL_TEXTURE_2D, s_frameTexture);
+  glTexSubImage2D(GL_TEXTURE_2D, 0, 0, 0, SIM_NDS_SCREEN_WIDTH, SIM_NDS_SCREEN_HEIGHT * 2, GL_RGBA,
+                  GL_UNSIGNED_BYTE, rgba);
+  glUseProgram(s_frameProgram);
+  DrawScreenQuad();
+  glUseProgram(g2shaderProgramID);
+  glBindTexture(GL_TEXTURE_2D, (GLuint)prevTex);
+  glActiveTexture((GLenum)prevUnit);
+  // the DS clears DISPCAPCNT's enable bit when the captured frame ends; the renderer has stored the capture in its
+  // bank (libntr's own capture, in DrawEngine, does the same)
+  s_reg_GX_DISPCAPCNT &= ~0x80000000u;
+  sFrameRendererDrew = 1;
+  return true;
+}

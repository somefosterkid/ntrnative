+// bw-port (libntr-vbridge.patch): the frame's whole video state for the in-process renderer (port/vcore, through
+// port/bridge/vcore_bridge.c), the same as a .vcs file's chunks: io9 (0x700 bytes), io9b (0x70), vram (0xA4000, the
+// banks A-I), pltt (0x800), oam (0x800), and the GX3D words in *gx (grown with realloc to *cap words when short; the
+// caller frees it). Returns the GX3D words written (the prologue and the shown frame's commands).
+extern "C" uint32_t SIM_VCapGather(uint8_t *io9, uint8_t *io9b, uint8_t *vram, uint8_t *pltt, uint8_t *oam,
+                                   uint32_t **gx, uint32_t *cap) {
+  static std::vector<u32> sWords;
+  u32 prologue, commands, swapFrame;
+  FillRegs(io9, io9b);
+  FillMem(vram, pltt, oam);
+  Fill3D(sWords, prologue, commands, swapFrame); // no SWAP_BUFFERS yet: the reset state's prologue only
+  u32 n = (u32)sWords.size();
+  if (*gx == NULL || *cap < n) {
+    u32 want = n + n / 2 + 1024;
+    uint32_t *p = (uint32_t *)realloc(*gx, (size_t)want * 4);
+    if (p == NULL) return 0;
+    *gx = p;
+    *cap = want;
+  }
+  memcpy(*gx, sWords.data(), (size_t)n * 4);
+  return n;
+}

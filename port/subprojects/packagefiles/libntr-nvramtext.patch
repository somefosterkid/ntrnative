+/* bw-port (libntr-nvramtext.patch): the maintainer's nickname and comment are the DS's UTF-16 (u16 str[] and a length), not wchar_t,
+ * which is 4 bytes on Apple and Linux. There the save's %ls read two u16s as one bad character and the whole save failed
+ * ("write failed (Illegal byte sequence); the old file stays": no setting changed in the app outlived a restart, once the file had
+ * been read), and the default's wcscpy and the comment's swprintf wrote past their arrays. Here they are u16; the ini holds UTF-8. */
+static u8 NvramTextFromIni(u16 * dst, int max, const char * s)
+{
+    const unsigned char * p = (const unsigned char *)s;
+    int n = 0;
+    memset(dst, 0, (size_t)max * sizeof(u16));
+    while (*p != 0 && n < max) {
+        unsigned c = *p++;
+        if (c >= 0xF0) {   /* beyond the DS's 16 bits */
+            while ((*p & 0xC0) == 0x80) p++;
+            c = '?';
+        } else if (c >= 0xE0 && (p[0] & 0xC0) == 0x80 && (p[1] & 0xC0) == 0x80) {
+            c = (c & 0x0F) << 12 | (p[0] & 0x3Fu) << 6 | (p[1] & 0x3Fu);
+            p += 2;
+        } else if (c >= 0xC0 && (p[0] & 0xC0) == 0x80) {
+            c = (c & 0x1F) << 6 | (p[0] & 0x3Fu);
+            p += 1;
+        }
+        dst[n++] = (u16)c;
+    }
+    return (u8)n;
+}
+
+static void NvramTextToIni(FILE * f, const u16 * s, int max)
+{
+    for (int i = 0; i < max && s[i] != 0; i++) {
+        unsigned c = s[i];
+        if (c < 0x20) {
+            fputc('?', f);   /* (a line break would end the ini line) */
+        } else if (c < 0x80) {
+            fputc((int)c, f);
+        } else if (c < 0x800) {
+            fputc((int)(0xC0 | c >> 6), f);
+            fputc((int)(0x80 | (c & 0x3F)), f);
+        } else {
+            fputc((int)(0xE0 | c >> 12), f);
+            fputc((int)(0x80 | (c >> 6 & 0x3F)), f);
+            fputc((int)(0x80 | (c & 0x3F)), f);
+        }
+    }
+}
 
 

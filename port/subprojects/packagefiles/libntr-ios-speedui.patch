+#if defined(__APPLE__) && TARGET_OS_IOS
+static void IosSpeedModel(SIM_config_type * aConfig)
+{
+    if(!sSeenFFSpeed && aConfig->speed > 1) aConfig->ffSpeed = aConfig->speed;

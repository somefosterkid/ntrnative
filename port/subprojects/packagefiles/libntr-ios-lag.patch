+// libntr-ios-lag.patch: the GPU's queue. Each present puts a GL fence after the frame's drawing (just before the swap); LagPoll
+// (each frame, and while the pacing sleeps: about every millisecond while one is open) asks with timeout 0 which ones the GPU has
+// finished. "lag" = the swap call to the GPU done with that frame, "in flight" = frames submitted that the GPU has not finished.
+// Neither Apple's OpenGL ES (on Metal) nor a desktop driver promises a swap that waits for the GPU, so the game could run frames
+// ahead of what the GPU has drawn, each one shown later. The bound: before a present's swap, the frame two presents back must be
+// done (glClientWaitSync, at most 100 ms): at most two frames in flight. BWPORT_GPUQUEUE=N allows N (0: no bound, as before),
+// BWPORT_GPUSLOW=N adds N full-screen blended draws a present offscreen (a forced slow GPU, to test the bound).
+typedef GLsync(APIENTRYP LagFenceFn)(GLenum, GLbitfield);
+typedef GLenum(APIENTRYP LagWaitFn)(GLsync, GLbitfield, GLuint64);
+typedef void(APIENTRYP LagDeleteFn)(GLsync);
+static LagFenceFn sLagFence;
+static LagWaitFn sLagWait;
+static LagDeleteFn sLagDelete;
+static int sLagInit, sLagBound = 2, sLagSlow;
+struct LagRec { GLsync f; u64 serial, submit; int inflight; };
+static LagRec sLagQ[16];
+static int sLagN;          // fences not signalled yet (oldest first)
+static u64 sLagSerial;     // the last present's serial
+static struct LagCount { u64 n, sumNs, maxNs, waitNs, bMaxNs; int maxIn, bMaxIn; } sLc;  // (b: the bench window's)
+static float sLagMean, sLagMaxMs;  // the last second's (the overlay)
+static int sLagMaxIn;
+extern "C" float SIM_DisplayLag(int *inflight, float *maxMs) {
+  *inflight = sLagMaxIn;
+  *maxMs = sLagMaxMs;
+  return sLagMean;
+}
+static bool LagReady(void) {
+  if (!sLagInit) {
+    sLagInit = 1;
+    sLagFence = (LagFenceFn)SDL_GL_GetProcAddress("glFenceSync");
+    sLagWait = (LagWaitFn)SDL_GL_GetProcAddress("glClientWaitSync");
+    sLagDelete = (LagDeleteFn)SDL_GL_GetProcAddress("glDeleteSync");
+    const char *e = getenv("BWPORT_GPUQUEUE");
+    if (e != NULL && *e) sLagBound = atoi(e) < 0 ? 0 : atoi(e) > 15 ? 15 : atoi(e);
+    e = getenv("BWPORT_GPUSLOW");
+    if (e != NULL && *e) sLagSlow = atoi(e);
+    fprintf(stderr, "bwport: GPU queue: fences %s, at most %d frames in flight%s\n",
+            sLagFence && sLagWait && sLagDelete ? "on" : "unavailable", sLagBound, sLagSlow > 0 ? " (BWPORT_GPUSLOW on)" : "");
   }
+  return sLagFence != NULL && sLagWait != NULL && sLagDelete != NULL;
 }
+// libntr-ios-lag.patch, iOS: the panel. A present can be on the glass at the first display refresh after the GPU finished it, and the
+// panel shows one picture a refresh: shown(p) = max(next refresh after GPU done, shown(p-1) + period), from the CADisplayLink's phase
+// and period (port/src/ios_input.m). "shown lag" = the swap call to that estimate; presents whose estimate is still ahead are
+// "waiting for the panel". If presents outrun the panel (a refresh rate below what the pacing assumes: Low Power Mode, ProMotion
+// lowering it) and the system does not block the swap, that queue grows; LagSubmit then drops presents (BWPORT_PRESENTDROP=0: never).
+#if SIM_IOS
+extern "C" int bwport_ios_vsync(unsigned long long *lastNs, unsigned long long *periodNs);  // port/src/ios_input.m
+#endif
+static u64 sShownQ[16];   // the estimates of the last presents (a ring)
+static int sShownI;
+static u64 sShownPrev, sVsPeriod;
+static struct ShownCount { u64 n, sumNs, maxNs, drops; int maxWait; } sSc;
+static float sShownMean;
+static int sShownMaxWait;
+extern "C" float SIM_DisplayShown(int *waiting, float *hz) {
+  *waiting = sShownMaxWait;
+  *hz = sVsPeriod ? (float)(1e9 / (double)sVsPeriod) : 0.0f;
+  return sShownMean;
+}
+static void LagShown(u64 submit, u64 done) {
+#if SIM_IOS
+  u64 vs = 0, per = 0;
+  if (!bwport_ios_vsync(&vs, &per) || per < 2000000 || per > 50000000) return;
+  sVsPeriod = per;
+  u64 at = done <= vs ? vs : vs + ((done - vs + per - 1) / per) * per;
+  if (sShownPrev != 0 && at < sShownPrev + per - per / 4) at = sShownPrev + per;
+  sShownPrev = at;
+  sShownQ[sShownI++ & 15] = at;
+  sSc.n++;
+  sSc.sumNs += at - submit;
+  if (at - submit > sSc.maxNs) sSc.maxNs = at - submit;
+#else
+  (void)submit, (void)done;
+#endif
+}
+// presents the model says are not on the glass yet (GPU done, waiting for the panel)
+static int LagWaiting(u64 now) {
+  int n = 0;
+  for (u64 t : sShownQ) n += t > now;
+  return n;
+}
+static void LagDone(u64 now) {
+  LagRec &r = sLagQ[0];
+  sLagDelete(r.f);
+  LagShown(r.submit, now);
+  u64 lag = now - r.submit;
+  sLc.n++;
+  sLc.sumNs += lag;
+  if (lag > sLc.maxNs) sLc.maxNs = lag;
+  if (lag > sLc.bMaxNs) sLc.bMaxNs = lag;
+  for (InTrack &in : sIn) {
+    if (in.stage == 3 && in.serial == r.serial) InputGpuDone(in, now, r.inflight);
+  }
+  memmove(&sLagQ[0], &sLagQ[1], (size_t)(sLagN - 1) * sizeof(LagRec));
+  sLagN--;
+}
+static void LagPoll(void) {
+  while (sLagN > 0) {
+    GLenum st = sLagWait(sLagQ[0].f, 0, 0);
+    if (st != GL_ALREADY_SIGNALED && st != GL_CONDITION_SATISFIED && st != GL_WAIT_FAILED) return;
+    LagDone(SpNowNs());
+  }
+}
+// a forced slow GPU (BWPORT_GPUSLOW=N): N blended draws of the picture into an offscreen target of the window's size
+static void LagSlowGpu(void) {
+  static GLuint sFbo, sTex;
+  static int sW, sH;
+  int w = 0, h = 0;
+  SDL_GL_GetDrawableSize(window, &w, &h);
+  if (sLastPicTex == 0 || w <= 0 || h <= 0) return;
+  GLint prevFbo = 0, prevTex = 0;
+  glGetIntegerv(GL_FRAMEBUFFER_BINDING, &prevFbo);
+  if (sFbo == 0 || w != sW || h != sH) {
+    if (sTex == 0) glGenTextures(1, &sTex);
+    if (sFbo == 0) glGenFramebuffers(1, &sFbo);
+    glGetIntegerv(GL_TEXTURE_BINDING_2D, &prevTex);
+    glBindTexture(GL_TEXTURE_2D, sTex);
+    glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA8, w, h, 0, GL_RGBA, GL_UNSIGNED_BYTE, NULL);
+    glBindTexture(GL_TEXTURE_2D, (GLuint)prevTex);
+    glBindFramebuffer(GL_FRAMEBUFFER, sFbo);
+    glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, sTex, 0);
+    sW = w;
+    sH = h;
+  }
+  glBindFramebuffer(GL_FRAMEBUFFER, sFbo);
+  GLint vp[4];
+  glGetIntegerv(GL_VIEWPORT, vp);
+  glViewport(0, 0, w, h);
+  GLboolean blend = glIsEnabled(GL_BLEND);
+  GLint bs = 0, bd = 0;
+  glGetIntegerv(GL_BLEND_SRC_RGB, &bs);
+  glGetIntegerv(GL_BLEND_DST_RGB, &bd);
+  glEnable(GL_BLEND);
+  glBlendFunc(GL_ONE, GL_ONE);
+  GLuint keep = sLastPicTex;
+  for (int i = 0; i < sLagSlow; i++) SIM_DrawFrameTexture(keep);
+  sLastPicTex = keep;
+  glBlendFunc((GLenum)bs, (GLenum)bd);
+  if (!blend) glDisable(GL_BLEND);
+  glViewport(vp[0], vp[1], vp[2], vp[3]);
+  glBindFramebuffer(GL_FRAMEBUFFER, (GLuint)prevFbo);
+}
+// just before a swap: the bound, then this frame's fence; false: drop this present (iOS: the panel is two pictures behind)
+static bool LagSubmit(void) {
+  if (!LagReady()) return true;
+  if (sLagSlow > 0) LagSlowGpu();
+  LagPoll();
+  if (sLagBound > 0 && sLagN >= sLagBound) {
+    u64 t0 = SpNowNs();
+    while (sLagN >= sLagBound) {
+      GLenum st = sLagWait(sLagQ[0].f, GL_SYNC_FLUSH_COMMANDS_BIT, 100000000ull);
+      if (st == GL_TIMEOUT_EXPIRED) break;  // (a GPU that hangs: don't hang the game with it)
+      LagDone(SpNowNs());
+    }
+    sLc.waitNs += SpNowNs() - t0;
+  }
+  if (sLagN == 16) LagDone(SpNowNs());  // (no bound and the GPU 16 frames behind: forget the oldest)
+  {
+    static int sDrop = -1;
+    if (sDrop < 0) sDrop = getenv("BWPORT_PRESENTDROP") == NULL || atoi(getenv("BWPORT_PRESENTDROP")) != 0;
+    int w = LagWaiting(SpNowNs());
+    if (w > sSc.maxWait) sSc.maxWait = w;
+    if (sDrop && w >= 2) {
+      sSc.drops++;
+      return false;
+    }
+  }
+  LagRec &r = sLagQ[sLagN];
+  r.f = sLagFence(GL_SYNC_GPU_COMMANDS_COMPLETE, 0);
+  if (r.f == NULL) return true;
+  sLagN++;
+  r.serial = ++sLagSerial;
+  r.submit = SpNowNs();
+  r.inflight = sLagN;
+  if (sLagN > sLc.maxIn) sLc.maxIn = sLagN;
+  if (sLagN > sLc.bMaxIn) sLc.bMaxIn = sLagN;
+  return true;
+}

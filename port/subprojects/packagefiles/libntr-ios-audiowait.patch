@@ -1,21 +1,36 @@
 #include <stddef.h>
+#include <stdio.h>
+#include <SDL2/SDL_atomic.h>
 #include <simulator/queue.h>
 
+// bw-port (libntr-ios-audiowait.patch): the queues (PXI's two) are written and read by different threads. Without a lock
+// or barrier an ARM64 reader could see the new head before the slot's write and take the message as NULL (the end of the
+// queue): the message, a sound command list, was lost and the game waited for its reply for ever. One lock for all queues
+// (a few hundred messages a second).
+static SDL_SpinLock s_lock = 0;
+
 void* SIM_queue_read(SIM_queue_t *queue) {
+    SDL_AtomicLock(&s_lock);
     if (queue->tail == queue->head) {
+        SDL_AtomicUnlock(&s_lock);
         return NULL;
     }
     void* handle = queue->data[queue->tail];
     queue->data[queue->tail] = NULL;
     queue->tail = (queue->tail + 1) % queue->size;
+    SDL_AtomicUnlock(&s_lock);
     return handle;
 }
 
 int SIM_queue_write(SIM_queue_t *queue, void* handle) {
+    SDL_AtomicLock(&s_lock);
     if (((queue->head + 1) % queue->size) == queue->tail) {
+        SDL_AtomicUnlock(&s_lock);
+        fprintf(stderr, "queue: full (%zu), a message is lost\n", queue->size); // (PXI's callers do not check)
         return -1;
     }
     queue->data[queue->head] = handle;
     queue->head = (queue->head + 1) % queue->size;
+    SDL_AtomicUnlock(&s_lock);
     return 0;
-}

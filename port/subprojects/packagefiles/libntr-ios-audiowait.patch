diff --git a/libraries/sim/src/sim_audio.cpp b/libraries/sim/src/sim_audio.cpp
index 746d843..a80426c 100644
--- a/libraries/sim/src/sim_audio.cpp
+++ b/libraries/sim/src/sim_audio.cpp
@@ -742,17 +742,51 @@ extern "C" void SIM_Audio_FrameTick(void)
     SDL_UnlockAudio();
 }
 
+// libntr-ios-audiowait.patch: the wait's safety net. A list finishes at the driver's next tick (one or two iterations); a wait
+// that goes on had its reply lost (nothing the backend runs will move the finished tag), and stepping the sound a tick per
+// spin ran it ahead by seconds a second at 100 % CPU, for ever. After 64 ticks the sound steps once a millisecond (real time,
+// a few times faster than the DS), and after 300 ms the wait is logged with the backend's state and the backend releases it.
+#define SND_WAIT_TICKS 64
+#define SND_WAIT_MS 300.0
+
+static double WaitNowMs(void)
+{
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return (double)ts.tv_sec * 1e3 + ts.tv_nsec * 1e-6;
+}
+
 extern "C" void SIM_Audio_WaitPump(int aIteration)
 {
+    static double sT0 = 0.0, sNextLog = 0.0;
     if(!s_frameClock) {
         return;
     }
     SIM_PxiDrain();
-    if(aIteration > 0) {
-        SDL_LockAudio();
-        SoundAdvance(s_sndCyc + SND_CYC_TICK);
-        SDL_UnlockAudio();
+    if(aIteration == 0) {
+        sT0 = WaitNowMs();
+        sNextLog = sT0 + SND_WAIT_MS;
+        return;
+    }
+    if(aIteration > SND_WAIT_TICKS) {
+        SDL_Delay(1);
     }
+    SDL_LockAudio();
+    SoundAdvance(s_sndCyc + SND_CYC_TICK);
+    double now = WaitNowMs();
+    if(now >= sNextLog) {
+        char st[512] = "";
+        int released = 0;
+        if(SIM_soundBackendOn && SIM_soundBackend->waitStuck != NULL) {
+            released = SIM_soundBackend->waitStuck(st, (int)sizeof st);
+            SoundAdvance(s_sndCyc + SND_CYC_TICK); // (the backend copies its state out after a step)
+        }
+        fprintf(stderr, "audio: command reply wait timed out (%.0f ms, %d spins, frame %llu, sound at frame %.2f, %s backend; %s)%s\n",
+                now - sT0, aIteration, (unsigned long long)(s_frameCyc / SND_CYC_FRAME), (double)s_sndCyc / SND_CYC_FRAME,
+                SIM_soundBackendOn ? "the program's" : "sim7's", st[0] ? st : "no state", released ? ": released" : "");
+        sNextLog = now + 1000.0;
+    }
+    SDL_UnlockAudio();
 }
 

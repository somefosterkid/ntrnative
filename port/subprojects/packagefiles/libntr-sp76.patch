+
+static u64 SpMonitorNs(void) {
+  static u64 ns;
+  static int calls;
+  if (ns == 0 || (++calls % 240) == 0) {
+    int hz = 60;
+    SDL_DisplayMode dm;
+    int di = window != NULL ? SDL_GetWindowDisplayIndex(window) : 0;
+    if (di >= 0 && SDL_GetCurrentDisplayMode(di, &dm) == 0 && dm.refresh_rate > 0) hz = dm.refresh_rate;
+    ns = 1000000000ull / (u64)hz;
+  }
+  return ns;
+}
+
+static s64 SpCeilDiv(s64 x, s64 q) { return x >= 0 ? (x + q - 1) / q : -((-x) / q); }
+static u64 SpSlotAbs(s64 k) { return (u64)((s64)sPace.t0 + sPace.phase + k * (s64)sPace.Q); }
+static u64 SpTickDue(u64 n) { return sPace.t0 + n * kSpFrame / (u64)sPace.S; }
+
+// at the top of a tick: which slots are this tick's
+static void SpPaceBegin(void) {
+  bool capped = s_SIM_config.capFrameRate && !sFastForward;
+  static int sLogInit;
+  if (!sLogInit) {
+    sLogInit = 1;
+    const char *lf = getenv("BWPORT_PRESENTLOG");
+    if (lf != NULL && *lf && (sPresentLog = fopen(lf, "w")) != NULL) {
+      setvbuf(sPresentLog, NULL, _IOFBF, 1 << 16);
+      atexit([]() { if (sPresentLog != NULL) { fclose(sPresentLog); sPresentLog = NULL; } });
+    }
+  }
+  if (!capped) {
+    sPace.on = false;
+    sPace.count = 1;
+    sPace.waited = 0;
+    sTickPresent = 1;
+    return;
+  }
+  int S = s_SIM_config.speed < 1 ? 1 : s_SIM_config.speed > 4 ? 4 : s_SIM_config.speed;
+  u8 mode = s_SIM_config.displayCap;
+  u64 Q = mode == SIM_CONFIG_DISPLAYCAP_MONITOR ? SpMonitorNs() : mode == SIM_CONFIG_DISPLAYCAP_120 ? kSpFrame / 2 : kSpFrame;
+  u64 now = SpNowNs();
+  if (sPace.on && (S != sPace.S || mode != sPace.mode || Q != sPace.Q)) sPace.on = false;
+  // behind by more than three ticks (a slow machine, a pause, a window drag): start the timeline again
+  if (sPace.on && now > SpTickDue(sPace.n) + 3 * kSpFrame / (u64)S) sPace.on = false;
+  if (!sPace.on) {
+    sPace.on = true;
+    sPace.t0 = now;
+    sPace.n = 0;
+    sPace.S = S;
+    sPace.mode = mode;
+    sPace.Q = Q;
+    sPace.phase = 0;
+  }
+  s64 a = (s64)(sPace.n * kSpFrame / (u64)S), b = (s64)((sPace.n + 1) * kSpFrame / (u64)S);
+  s64 q = (s64)Q;
+  s64 k0 = SpCeilDiv(a - sPace.phase, q), k1 = SpCeilDiv(b - sPace.phase, q);
+  sPace.first = k0;
+  sPace.count = k1 > k0 ? (int)(k1 - k0) : 0;
+  sPace.forced = false;
+  sPace.waited = 0;
+  if (sFrameForce > 0 && sPace.count == 0) { // a screenshot asked for this frame
+    sPace.count = 1;
+    sPace.forced = true;
+  }
+  sTickPresent = sPace.count > 0;
+  if (sPresentLog != NULL) fprintf(sPresentLog, "T %llu %llu\n", (unsigned long long)(now / 1000), (unsigned long long)sPace.n);
+}
+
+// wait for the first slot of the tick (before the swap)
+static void SpWaitSlot(void) {
+  if (!sPace.on || sPace.forced) return;
+  u64 t = SpSlotAbs(sPace.first);
+  if (sPace.mode == SIM_CONFIG_DISPLAYCAP_MONITOR && t > 1500000) t -= 1500000; // the swap waits for the V-blank
+  u64 t0 = SpNowNs();
+  if (t > t0) {
+    SpSleepUntil(t);
+    sPace.waited += SpNowNs() - t0;
+  }
+}
+
+// after a swap that was the r-th present of the tick: the log; the monitor's slots follow the V-blank
+static void SpAfterSwap(int r, u64 callNs) {
+  u64 now = SpNowNs();
+  if (sPresentLog != NULL) fprintf(sPresentLog, "P %llu %llu %d\n", (unsigned long long)(now / 1000), (unsigned long long)sPace.n, r);
+  if (sPace.on && !sPace.forced && sPace.mode == SIM_CONFIG_DISPLAYCAP_MONITOR && now - callNs > 300000) {
+    s64 q = (s64)sPace.Q;
+    s64 e = ((s64)(now - sPace.t0) - sPace.phase - (sPace.first + r) * q) % q; // how late the V-blank came after the slot
+    if (e > q / 2) e -= q;
+    if (e < -q / 2) e += q;
+    sPace.phase += e / 8;
+  }
+}

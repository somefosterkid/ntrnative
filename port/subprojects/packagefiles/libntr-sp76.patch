+/* bw-port (libntr-sp76.patch): Speed > 1 plays the music at its normal tempo: the sound side makes Speed times as many
+ * samples a second (and the time-stretch gives them back at real time), so a music player's tempo ratio is divided by the
+ * Speed, whatever the game sets (the game's own ratio is kept and composed: sGameRatio), and a player that starts gets the
+ * division again (a start resets the ratio to 256). Which players are music: SIM_Snd_MusicPlayer. */
+static int SIM_Snd_MusicPlayerMask(void)
+{
+    static int mask = -2;
+    if (mask == -2) {
+        const char *e = getenv("BWPORT_MUSICPLAYERS"); /* a hex mask of the music players (BWPORT_SNDLOG=1 lists the starts) */
+        mask = e != NULL && *e ? (int)strtol(e, NULL, 16) : 0x41;
+    }
+    return mask;
+}
+static int sMusicSlow = 1;
+static int sGameRatio[32];
+
+static int MusicPlayer(int playerNo)
+{
+    return playerNo >= 0 && playerNo < 32 && ((SIM_Snd_MusicPlayerMask() >> playerNo) & 1);
+}
+
+static int ScaledRatio(int playerNo, int ratio)
+{
+    if (sMusicSlow > 1 && MusicPlayer(playerNo)) {
+        ratio = (ratio * 2 + sMusicSlow) / (2 * sMusicSlow);
+        if (ratio < 1) {
+            ratio = 1;
+        }
+    }
+    return ratio;
+}
+
+static void PushRatio(int playerNo)
+{
+    SNDi_SetPlayerParam(playerNo, GetOffset(SNDPlayer, tempo_ratio),
+                        (u32)ScaledRatio(playerNo, sGameRatio[playerNo] ? sGameRatio[playerNo] : 256),
+                        GetSize(SNDPlayer, tempo_ratio));
+}
+
+void SIM_Snd_SetMusicSlow(int aSlow)
+{
+    int p;
+    if (aSlow == sMusicSlow) {
+        return;
+    }
+    sMusicSlow = aSlow;
+    for (p = 0; p < 32; p++) {
+        if (MusicPlayer(p)) {
+            PushRatio(p);
+        }
+    }
+}
+
+static void MusicStarted(int playerNo)
+{
+    if (getenv("BWPORT_SNDLOG") != NULL) {
+        fprintf(stderr, "snd: start player %d\n", playerNo);
+    }
+    if (playerNo >= 0 && playerNo < 32) {
+        sGameRatio[playerNo] = 0;
+        if (sMusicSlow > 1 && MusicPlayer(playerNo)) {
+            PushRatio(playerNo);
+        }
+    }
+}
+#endif

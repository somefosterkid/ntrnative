 #include <simulator/sim_RomExtractor.h>
+
+/* bw-port (libntr-ios-reset.patch): the host files the game's FSFiles hold open, so the port's in-process restart can
+   close them (the FSFiles themselves are the machine's memory, put back as they were before the game started) */
+#define FSi_PORT_FILES_MAX 64
+static FILE * s_portFiles[FSi_PORT_FILES_MAX];
+
+static FILE * FSi_PortFopen(const char * path, const char * mode)
+{
+	FILE * f = fopen(path, mode);
+	int i;
+	for (i = 0; f != NULL && i < FSi_PORT_FILES_MAX; i++) {
+		if (s_portFiles[i] == NULL) {
+			s_portFiles[i] = f;
+			break;
+		}
+	}
+	return f;
+}
+
+static int FSi_PortFclose(FILE * f)
+{
+	int i;
+	for (i = 0; i < FSi_PORT_FILES_MAX; i++) {
+		if (s_portFiles[i] == f) {
+			s_portFiles[i] = NULL;
+		}
+	}
+	return fclose(f);
+}
+
+int FS_PortCloseAll(void)
+{
+	int i, n = 0;
+	for (i = 0; i < FSi_PORT_FILES_MAX; i++) {
+		if (s_portFiles[i] != NULL) {
+			fclose(s_portFiles[i]);
+			s_portFiles[i] = NULL;
+			n++;
+		}
+	}
+	return n;
+}
+#define fopen FSi_PortFopen
+#define fclose FSi_PortFclose

@@ -0,0 +1,4 @@
+/* bw-port (libntr-ios-reset.patch): libsim's C files are the host's (GL loader, config, queues ...): back to the
+ * default sections after sim_machine_section.h. sim_vars.c (the DS's memory and registers) sets the machine sections
+ * again itself. */
+#pragma clang section data = "" bss = ""

+// bw-port (libntr-ios-input2.patch): the pad bits are the OR of three sources (keyboard, controller, touch), each with its own mask of
+// held buttons (bit B_*: A B X Y L R Start Select Up Down Left Right), so letting go on one source keeps a button another still holds
+static unsigned sPadSrc[3];  // 0 keyboard, 1 controller, 2 touch
+static unsigned sPadFrame;
+static void PadSrcSet(int src, int b, bool down) {
+  static const u8 padBit[12] = {0, 1, 0xff, 0xff, 9, 8, 3, 2, 6, 7, 5, 4};
+  sPadSrc[src] = down ? sPadSrc[src] | (1u << b) : sPadSrc[src] & ~(1u << b);
+  bool any = ((sPadSrc[0] | sPadSrc[1] | sPadSrc[2]) >> b) & 1;
+  if (padBit[b] != 0xff) {
+    s_reg_PAD_KEYINPUT = (u16)(any ? s_reg_PAD_KEYINPUT & ~(1u << padBit[b]) : s_reg_PAD_KEYINPUT | (1u << padBit[b]));
+  } else {
+    vu16 *xy = (vu16 *)HW_BUTTON_XY_BUF;
+    u16 bit = (u16)(1u << (b == 2 ? 10 : 11));
+    *xy = (u16)(any ? *xy & ~bit : *xy | bit);
+  }
 }
+static void PadSrcClear(int src) {
+  for (int b = 0; b < 12; b++) if ((sPadSrc[src] >> b) & 1) PadSrcSet(src, b, false);
+}
 
+// bw-port (libntr-ios-input2.patch): the controller. The first one that is there is opened, and again whenever one is added or taken
+// away (a pad that slept or lost its cable comes back). The desktop reads the raw joystick (the buttons of padSettings); iOS (and
+// BWPORT_PAD_GC=1) the SDL game controller with the same layout as the desktop's defaults: A B X Y, Back = Select, Start, the
+// shoulders = L R, the D-pad. BWPORT_VPAD="f200:attach f260:down0 f300:up0 f320:detach" (frames of the event loop) drives a virtual one.
+static SDL_GameController *sPadGC;
+static bool sPadUseGC;
+extern "C" void SimTouch_Controller(int present);   // sim_touch.cpp
+static void PadRescan() {
+  if (s_SIM_SDLJoystick != NULL && !SDL_JoystickGetAttached(s_SIM_SDLJoystick)) {
+    fprintf(stderr, "bwport: controller disconnected\n");
+    if (sPadGC != NULL) SDL_GameControllerClose(sPadGC);
+    else SDL_JoystickClose(s_SIM_SDLJoystick);
+    sPadGC = NULL;
+    s_SIM_SDLJoystick = NULL;
+    PadSrcClear(1);
+    SimTouch_Controller(0);
+  }
+  if (s_SIM_SDLJoystick != NULL) return;
+  for (int i = 0; i < SDL_NumJoysticks(); i++) {
+    if (sPadUseGC) {
+      if (!SDL_IsGameController(i)) continue;
+      sPadGC = SDL_GameControllerOpen(i);
+      if (sPadGC == NULL) continue;
+      s_SIM_SDLJoystick = SDL_GameControllerGetJoystick(sPadGC);
+      fprintf(stderr, "bwport: controller connected: %s (game controller)\n", SDL_GameControllerName(sPadGC));
+    } else {
+      s_SIM_SDLJoystick = SDL_JoystickOpen(i);
+      if (s_SIM_SDLJoystick == NULL) continue;
+      fprintf(stderr, "bwport: controller connected: %s (joystick)\n", SDL_JoystickName(s_SIM_SDLJoystick));
+    }
+    SimTouch_Controller(1);
+    return;
+  }
+}
+// a game controller's buttons as the desktop layout
+static void PadControllerButton(int button, bool down) {
+  static const s8 map[SDL_CONTROLLER_BUTTON_MAX] = {
+      [SDL_CONTROLLER_BUTTON_A] = 0, [SDL_CONTROLLER_BUTTON_B] = 1, [SDL_CONTROLLER_BUTTON_X] = 2, [SDL_CONTROLLER_BUTTON_Y] = 3,
+      [SDL_CONTROLLER_BUTTON_BACK] = 7, [SDL_CONTROLLER_BUTTON_GUIDE] = -1, [SDL_CONTROLLER_BUTTON_START] = 6,
+      [SDL_CONTROLLER_BUTTON_LEFTSTICK] = -1, [SDL_CONTROLLER_BUTTON_RIGHTSTICK] = -1, [SDL_CONTROLLER_BUTTON_LEFTSHOULDER] = 4,
+      [SDL_CONTROLLER_BUTTON_RIGHTSHOULDER] = 5, [SDL_CONTROLLER_BUTTON_DPAD_UP] = 8, [SDL_CONTROLLER_BUTTON_DPAD_DOWN] = 9,
+      [SDL_CONTROLLER_BUTTON_DPAD_LEFT] = 10, [SDL_CONTROLLER_BUTTON_DPAD_RIGHT] = 11};
+  if (button < 0 || button >= SDL_CONTROLLER_BUTTON_MAX) return;
+  int b = map[button];
+  if (b >= 0 && b < 12) PadSrcSet(1, b, down);
+}
+// the test's virtual pad: BWPORT_VPAD steps "fN:op[arg]": attach, detach, down/up (a virtual button), key (the keyboard source's
+// button b down; key16+b = up), pad (log the register)
+static void PadTestScript(unsigned frame) {
+  static const char *script;
+  static int virt = -1, pos;
+  static SDL_Joystick *vj;
+  if (script == NULL) script = getenv("BWPORT_VPAD") != NULL ? getenv("BWPORT_VPAD") : "";
+  while (script[pos] != 0) {
+    unsigned f;
+    char op[16];
+    int n = 0, arg = 0;
+    if (sscanf(script + pos, " f%u:%15[a-z]%n", &f, op, &n) < 2) { pos = (int)strlen(script); break; }
+    if (f > frame) break;
+    pos += n;
+    if (sscanf(script + pos, "%d%n", &arg, &n) == 1) pos += n;
+    if (!strcmp(op, "attach")) {
+      virt = SDL_JoystickAttachVirtual(SDL_JOYSTICK_TYPE_GAMECONTROLLER, SDL_CONTROLLER_AXIS_MAX, SDL_CONTROLLER_BUTTON_MAX, 1);
+      vj = virt >= 0 ? SDL_JoystickOpen(virt) : NULL;   // (the test's own handle: the game opens another)
+    } else if (!strcmp(op, "detach")) {
+      if (vj != NULL) SDL_JoystickClose(vj);
+      if (virt >= 0) SDL_JoystickDetachVirtual(virt);
+      vj = NULL;
+      virt = -1;
+    } else if (!strcmp(op, "down") && vj != NULL) {
+      SDL_JoystickSetVirtualButton(vj, arg, 1);
+    } else if (!strcmp(op, "up") && vj != NULL) {
+      SDL_JoystickSetVirtualButton(vj, arg, 0);
+    } else if (!strcmp(op, "swap")) {   // a turn of the window (desktop test of a rotation)
+      int w, h;
+      SDL_GetWindowSize(window, &w, &h);
+      SDL_SetWindowSize(window, h, w);
+    } else if (!strcmp(op, "key")) {
+      PadSrcSet(0, arg & 15, arg < 16);
+    }
+    fprintf(stderr, "bwport: vpad frame %u %s %d pad %04x srcs %03x %03x %03x\n", frame, op, arg, (unsigned)s_reg_PAD_KEYINPUT,
+            sPadSrc[0], sPadSrc[1], sPadSrc[2]);
+  }
+}

--- a/src/applications/party_menu/form_change.c
+++ b/src/applications/party_menu/form_change.c
@@ -175,8 +175,8 @@
 {
     ParticleSystem_ZeroAll();
 
-    void *heap = Heap_Alloc(HEAP_ID_PARTY_MENU, 0x4800);
-    formChanger->ps = ParticleSystem_New(AllocTexVram, AllocPaletteVram, heap, 0x4800, TRUE, HEAP_ID_PARTY_MENU);
+    void *heap = Heap_Alloc(HEAP_ID_PARTY_MENU, PARTICLE_HEAP_HOST_SIZE(0x4800));
+    formChanger->ps = ParticleSystem_New(AllocTexVram, AllocPaletteVram, heap, PARTICLE_HEAP_HOST_SIZE(0x4800), TRUE, HEAP_ID_PARTY_MENU);
     Camera *camera = ParticleSystem_GetCamera(formChanger->ps);
 
     Camera_SetClipping(FX32_ONE, FX32_CONST(900), camera);

-void StringList_AddFromMessageBank(StringList *list, const MessageLoader *loader, u32 bankEntry, u32 index)
+// PC port: the index is pointer-sized (menus keep their callbacks in it). The menus' sentinels (MENU_CANCEL,
+// MENU_HEADER, ...) arrive as an int (-2) or as a u32 (0xfffffffe): store both sign-extended, as the menus compare them
+// with the int constants. A host address is never in 0xfffffff0-0xffffffff.
+static uintptr_t WideIndex(uintptr_t index)
+{
+    if (index >= 0xfffffff0u && index <= 0xffffffffu) {
+        return (uintptr_t)(intptr_t)(s32)(u32)index;
+    }
+
+    return index;
+}
+
+void StringList_AddFromMessageBank(StringList *list, const MessageLoader *loader, u32 bankEntry, uintptr_t index)
 {
     u32 tmp;
@@ -44,9 +56,9 @@
     if (list) {
         list->entry = MessageLoader_GetNewString(loader, bankEntry);
-        list->index = index;
+        list->index = WideIndex(index);
     }
 }
 
-void StringList_AddFromString(StringList *list, const String *string, u32 index)
+void StringList_AddFromString(StringList *list, const String *string, uintptr_t index)
 {
     u32 heapID;
@@ -55,5 +67,5 @@

+// bw-port: the Transitions setting's window (docs/speed-options.md "Platinum and HeartGold/SoulSilver"). Each field frame the
+// field task chain is walked (FieldTask->prev, like Black's event chain); while one of the map-change tasks is in it (a door,
+// warp, Fly, a script's map change, the Waterfall climb, the Pokemon Center heal) the game runs at the Transitions speed
+// (port/game/speed_gen4.c; libntr's SIM_SetTransition). Each predicate compares a task function of its own file.
+void PortSpeed4_TransitionWindow(int on);
+BOOL PortSpeed4_IsMapChangeTask(FieldTaskFunc func);   // field_map_change.c
+BOOL PortSpeed4_IsFadeTask(FieldTaskFunc func);        // field_transition.c
+BOOL PortSpeed4_IsDoorTask(FieldTaskFunc func);        // unk_02056B30.c
+BOOL PortSpeed4_IsHealTask(FieldTaskFunc func);        // overlay006/healing_machine_animation/pokecenter.c
+BOOL PortSpeed4_IsWaterfallTask(FieldTaskFunc func);   // overlay005/ov5_021DFB54.c
+
+static void PortSpeed4_TransitionFrame(FieldSystem *fieldSystem)
+{
+    BOOL on = FALSE;
+
+    for (FieldTask *task = fieldSystem->task; task != NULL && !on; task = task->prev) {
+        on = PortSpeed4_IsMapChangeTask(task->func) || PortSpeed4_IsFadeTask(task->func) || PortSpeed4_IsDoorTask(task->func)
+            || PortSpeed4_IsHealTask(task->func) || PortSpeed4_IsWaterfallTask(task->func);
+    }
+
+    PortSpeed4_TransitionWindow(on);
+}

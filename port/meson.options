# libntr's own options (yield: true there, so these values reach the libntr subproject).
# Black is a TWL hybrid on TwlSDK 5; the PC build runs it as an original DS (OS_IsRunOnTwl is FALSE on PC).
option('build_target', type: 'combo', choices: ['arm', 'win64', 'linux', 'nx', 'prospero'], value: 'linux',
       description: 'libntr target: linux or win64 (the others are not set up for the game)', yield: true)
option('sdk_version_major', type: 'integer', value: 5, description: 'libntr SDK: 5 (TwlSDK), Black\'s', yield: true)
option('hardware_type', type: 'combo', choices: ['ntr', 'twl_hyb', 'twl_ltd'], value: 'twl_hyb',
       description: 'libntr hardware type: twl_hyb, as Black is built', yield: true)
option('tracy_enable', type: 'boolean', value: false, yield: true)
# The PC build's own
option('rom_dir', type: 'string', value: '',
       description: 'the folder of the base ROMs the link\'s ROM fill reads (tools/port_romfill.py); default <repo>/orig, Apple tools/mac_rom.sh\'s; an empty folder: a build with no ROM')
option('allow_undefined', type: 'boolean', value: true,
       description: 'link the exe even with undefined symbols (they resolve to address 0: a call to one faults)')
option('platinum', type: 'boolean', value: true,
       description: 'build Pokemon Platinum\'s pl.o (docs/platinum.md) into the exe, as Black 2 and White 2 (-Dplatinum=false leaves it out)')
option('hgss_cov', type: 'boolean', value: false,
       description: 'HG/SS function coverage for the crash sweep (tools/hg_sweep.py): the module compiled with -fsanitize-coverage=func,inline-bool-flag,pc-table, port/game/hg_cov.c writes BWPORT_HG_COV')
option('hgss', type: 'boolean', value: true,
       description: 'build Pokemon HeartGold\'s and SoulSilver\'s hg.o (docs/hgss.md; pret\'s C and data) into the exe (-Dhgss=false leaves it out). The ROMs (orig/baserom_hg_us.nds, baserom_ss_us.nds), when they are there, give its overlay addresses and fill its data')
option('lld', type: 'feature', value: 'auto',
       description: 'link the Linux exe with lld (-fuse-ld=lld) instead of GNU ld: about half the link time; auto = when the compilers can (apt install lld)')
option('b2w2', type: 'feature', value: 'auto',
       description: 'Black 2 and White 2 in the exe (docs/b2w2.md): auto = built (their data from their ROMs at start)')
option('white', type: 'feature', value: 'auto',
       description: 'Pokemon White in the exe (docs/white.md): auto = built (its data from its ROM at start)')
